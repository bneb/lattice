--- kernel/arch/x86_64/preempt_stub.S
+++ kernel/arch/x86_64/preempt_stub.S
@@ -308,6 +308,9 @@
  * RDI = stack_top (highest usable kernel stack address)
  * RSI = entry_addr (user-space entry point, e.g. _ring3_start)
  * RDX = user_rsp (user-space stack pointer)
+ * RCX = arg1 (RDI in user space)
+ * R8  = arg2 (RSI in user space)
+ * R9  = arg3 (RDX in user space)
  * Returns: RAX = initial ctx_ptr (saved RSP for invoke_preemptive_thread)
  *
@@ -348,15 +351,19 @@
     sub  rax, 8
     mov  [rax], rsi                      /* RIP = entry_addr */
 
-    /* 15 zeroed GPRs: RAX, RBX, RCX, RDX, RSI, RDI, RBP, R8-R15 */
-    sub  rax, 120                        /* 15 * 8 = 120 bytes */
-    mov  rcx, 15
-    lea  rdi, [rax]
-    xor  edx, edx
-.Lzero_user_gprs:
-    mov  [rdi], rdx
-    add  rdi, 8
-    dec  rcx
-    jnz  .Lzero_user_gprs
+    /* R15..R8 */
+    sub  rax, 64
+    mov  qword ptr [rax], 0       /* R15 */
+    mov  qword ptr [rax+8], 0     /* R14 */
+    mov  qword ptr [rax+16], 0    /* R13 */
+    mov  qword ptr [rax+24], 0    /* R12 */
+    mov  qword ptr [rax+32], 0    /* R11 */
+    mov  qword ptr [rax+40], 0    /* R10 */
+    mov  [rax+48], r9             /* R9 */
+    mov  [rax+56], r8             /* R8 */
+
+    /* RBP, RDI, RSI, RDX, RCX, RBX, RAX */
+    sub  rax, 56
+    mov  qword ptr [rax+48], 0    /* RBP */
+    mov  [rax+40], rcx            /* RDI (arg1) */
+    mov  [rax+32], r8             /* RSI (arg2) */
+    mov  [rax+24], r9             /* RDX (arg3) */
+    mov  qword ptr [rax+16], 0    /* RCX */
+    mov  qword ptr [rax+8], 0     /* RBX */
+    mov  qword ptr [rax], 0       /* RAX */
 
     /* RAX = ctx_ptr (bottom of frame = initial fiber.stack_ptr) */
     ret
