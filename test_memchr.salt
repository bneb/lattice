package main

import std.core.ptr.Ptr

extern fn memchr(s: Ptr<u8>, c: i32, n: i64) -> Ptr<u8>;

fn main() -> i32 {
    let request = "Hello, world!\n";
    let buf = request as Ptr<u8>;
    let len: i64 = 14;
    let p = memchr(buf, 119, len); // 119 is 'w'
    if p.is_null() {
        println("Not found");
        return 1;
    }
    let idx = (p.addr() - buf.addr()) as i64;
    println(f"Found at: {idx}");
    return 0;
}
