int32_t ext_get_ipc_fd() {
    int32_t argc = salt_get_argc();
    for (int32_t i = 0; i < argc - 1; i++) {
        const char* arg = salt_get_argv(i);
        if (arg && strcmp(arg, "--ipc-fd") == 0) {
            return atoi(salt_get_argv(i + 1));
