// ipc_ping — IPC ping-pong between two processes
// The parent spawns a child, then they exchange N messages via sys_ipc_send/recv.
// Demonstrates: process spawning, IPC message passing, round-trip latency.

package user.ipc_ping

import user.lib.syscall
import user.std.stdio

const ROUNDS: u64 = 100;

// Parent entry: spawn child, run ping-pong, print results.
fn parent_main() {
    let child_pid = syscall.spawn("/ipc_ping.elf" as u64, 15);
    if child_pid == 0 {
        stdio.print("ipc_ping: spawn failed\n");
        syscall.exit(1);
    }

    stdio.print("ipc_ping: parent ready, child pid=");
    stdio.print_u64(child_pid);
    stdio.print("\n");

    let mut sent: u64 = 0;
    while sent < ROUNDS {
        syscall.ipc_send(child_pid, sent, sent + 1, sent + 2);
        let sender = syscall.ipc_recv();
        if sender == child_pid {
            let msg0 = syscall.ipc_get_msg0();
            if msg0 == sent {
                sent = sent + 1;
            }
        }
    }

    stdio.print("ipc_ping: ");
    stdio.print_u64(ROUNDS);
    stdio.print(" round trips complete\n");

    syscall.wait(child_pid);
    syscall.exit(0);
}

// Child entry: receive message, echo back, repeat.
fn child_main() {
    let mut recv_count: u64 = 0;
    while recv_count < ROUNDS {
        let sender = syscall.ipc_recv();
        if sender != 0 {
            let msg0 = syscall.ipc_get_msg0();
            syscall.ipc_send(sender, msg0, 0, 0);
            recv_count = recv_count + 1;
        }
    }
    syscall.exit(0);
}

// Determine role: if we can spawn a child, we're the parent.
// Otherwise we were spawned and are the child.
pub fn main() {
    // Try to spawn ourselves. If this is the first invocation,
    // spawn succeeds and we're the parent. The child runs child_main.
    let probe = syscall.spawn("/ipc_ping.elf" as u64, 15);
    if probe != 0 {
        // We spawned a child — we're the parent.
        parent_main();
    } else {
        // Spawn returned 0 — we are the child.
        child_main();
    }
}
