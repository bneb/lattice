// =============================================================================
// user/fetch.salt — TCP connect test (handshake only, no data)
// =============================================================================

package user.fetch

import user.lib.syscall
import user.std.stdio

pub fn main() {
    // QEMU gateway IP = 10.0.2.2 = 0x0A000202
    let ip: u32 = 0x0A000202;
    stdio.print("fetch: TCP connect to 10.0.2.2:8080...\n");

    let conn = syscall.tcp_connect(ip);
    if conn == 0xFFFFFFFFFFFFFFFF {
        stdio.print("fetch: connect failed\n");
        syscall.exit(1);
        return;
    }

    stdio.print("fetch: connected! conn_id=");
    stdio.print_u64(conn);
    stdio.print("\n");

    // tcp_send_data and tcp_recv_data need user-buffer access fixes
    // before data transfer works. For now, just prove the handshake.
    syscall.tcp_close(conn);
    stdio.print("fetch: connection closed, test complete\n");
    syscall.exit(0);
}
