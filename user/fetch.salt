// =============================================================================
// user/fetch.salt — HTTP GET Client via sys_http_get
// =============================================================================

package user.fetch

import user.lib.syscall
import user.std.stdio

pub fn main() {
    // QEMU gateway IP = 10.0.2.2 = 0x0A000202
    let ip: u32 = 0x0A000202;
    stdio.print("fetch: GET 10.0.2.2:80\n");
    let result = syscall.http_get(ip);
    if result > 0 {
        stdio.print("fetch: response received (");
        stdio.print_u64(result);
        stdio.print(" bytes)\n");
    } else {
        stdio.print("fetch: request failed or timed out\n");
    }
    syscall.exit(0);
}
