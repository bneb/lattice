// =============================================================================
// user/lettuce/server.salt
// LETTUCE Database Server for KeuOS
// =============================================================================
// This daemon binds to port 6379 and uses the zero-trap user.lib.socket 
// data plane to read and write RESP commands continuously.
// =============================================================================

package main

use std.core.ptr.Ptr
use std.core.str.StringView
use std.collections.string_map.StringMap
use std.collections.string_map.StringMap_new
use std.collections.string_map.StringMap_drop
use user.lib.socket.{Socket, bind, accept, read, write, close}
use user.lettuce.store.{execute, ExecResult}
use user.reactor.scheduler

const PORT: u64 = 6379;
const SESSION_BUF_SIZE: i64 = 1048576;
const SEND_BUF_SIZE: i64 = 1048576;

extern fn puts(s: Ptr<u8>) -> i32;
extern fn memmove(dst: Ptr<u8>, src: Ptr<u8>, n: i64) -> Ptr<u8>;
extern fn malloc(size: i64) -> Ptr<u8>;
extern fn free(ptr: u64);
extern fn r3_sys_yield();

pub struct ClientSession {
    sock: Socket,
    smap: Ptr<StringMap>,
    buf_ptr: Ptr<u8>,
    send_ptr: Ptr<u8>,
    read_cursor: i64,
    parse_cursor: i64,
    state: u32,
}

pub fn client_tick(session: Ptr<ClientSession>) -> bool {
    let mut sess = session.read();
    if sess.state == 0 {
        return false;
    }

    let space_left = SESSION_BUF_SIZE - sess.read_cursor;
    if space_left <= 0 {
        sess.state = 0;
        session.write(sess);
        return false;
    }

    // Zero-syscall read from RX SPSC ring
    let n = read(&sess.sock, (sess.buf_ptr.offset(sess.read_cursor)) as u64, space_left as u64);

    if n == 0 {
        // No data. Yield.
        return true;
    }

    let new_read_cur = sess.read_cursor + (n as i64);
    sess.read_cursor = new_read_cur;
    let mut total_resp: i64 = 0;

    // Zero-allocation RESP parse + execute pipeline
    while sess.parse_cursor < new_read_cur {
        let unparsed_len = new_read_cur - sess.parse_cursor;
        let req_view = StringView::from_raw(sess.buf_ptr.offset(sess.parse_cursor), unparsed_len);
        let resp_ptr = sess.send_ptr.offset(total_resp);
        
        let result = execute(sess.smap, req_view, resp_ptr, SEND_BUF_SIZE - total_resp);

        if result.input_consumed <= 0 {
            break; // Need more data
        }

        total_resp = total_resp + result.resp_len;
        sess.parse_cursor = sess.parse_cursor + result.input_consumed;

        // Flush early if send buffer is nearing capacity
        if total_resp > (SEND_BUF_SIZE - 4096) {
            let mut written: u64 = 0;
            while written < (total_resp as u64) {
                let w = write(&sess.sock, (sess.send_ptr.offset(written as i64)) as u64, (total_resp as u64) - written);
                written = written + w;
            }
            total_resp = 0;
        }
    }

    // Flush remaining responses to TX SPSC ring
    if total_resp > 0 {
        let mut written: u64 = 0;
        while written < (total_resp as u64) {
            let w = write(&sess.sock, (sess.send_ptr.offset(written as i64)) as u64, (total_resp as u64) - written);
            written = written + w;
        }
    }

    // Compact buffer
    let unparsed_len = new_read_cur - sess.parse_cursor;
    if unparsed_len == 0 {
        sess.read_cursor = 0;
        sess.parse_cursor = 0;
    } else if new_read_cur > SESSION_BUF_SIZE - 2048 {
        memmove(sess.buf_ptr, sess.buf_ptr.offset(sess.parse_cursor), unparsed_len);
        sess.read_cursor = unparsed_len;
        sess.parse_cursor = 0;
    } else {
        sess.read_cursor = new_read_cur;
    }

    session.write(sess);
    return true;
}

pub fn main() -> i32 {
    puts("LETTUCE starting on KeuOS... (Port 6379)" as Ptr<u8>);

    // 1. Bind port via Control Plane
    let mut sock = bind(PORT);
    if sock.fd == 0 {
        puts("LETTUCE: Error binding port 6379" as Ptr<u8>);
        return 1;
    }

    puts("LETTUCE: Bound to port 6379. Waiting for connection..." as Ptr<u8>);

    // 2. Accept connection (blocking IPC)
    let ok = accept(&mut sock);
    if !ok {
        puts("LETTUCE: Accept failed" as Ptr<u8>);
        return 1;
    }

    puts("LETTUCE: Client connected! Entering zero-trap reactor loop." as Ptr<u8>);

    // 3. Initialize Client Task State
    let smap = StringMap_new();
    let session_buf = malloc(SESSION_BUF_SIZE);
    let send_buf = malloc(SEND_BUF_SIZE);

    let mut session = ClientSession {
        sock: sock,
        smap: smap,
        buf_ptr: session_buf,
        send_ptr: send_buf,
        read_cursor: 0,
        parse_cursor: 0,
        state: 1,
    };
    
    let session_ptr = (&mut session) as Ptr<ClientSession>;

    // 4. Cooperative Reactor Loop
    while true {
        let active = client_tick(session_ptr);
        if !active {
            break;
        }
        r3_sys_yield();
    }

    close(&mut sock);
    StringMap_drop(smap);
    free(session_buf as u64);
    free(send_buf as u64);
    return 0;
}
