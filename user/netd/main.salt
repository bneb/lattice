// =============================================================================
// user/netd/main.salt — NetD Ring 3 Entry Point
// =============================================================================
// NetD runs exclusively as a Ring 3 process. arg1 (RDI) carries the user VA
// of the shared RX ring, arg2 (RSI) the streams array, arg3 (RDX) the TCB
// array — all mapped by the kernel via sys_shm_grant before spawn.
// =============================================================================

package user.netd.main

import user.netd.encap
import user.netd.daemon

extern fn sys_ipc_recv() -> u64;

const CMD_RX_NOTIFY: u64 = 1;

pub fn netd_main(rx_ring_base: u64, streams: u64, tcbs: u64) {
    daemon.netd_init(rx_ring_base, streams, tcbs);
    encap.execute_fastpath_test();

    loop {
        let cmd = sys_ipc_recv();  // blocks until kernel sends IPC
        if cmd == CMD_RX_NOTIFY {
            daemon.drain_rx_ring();
        }
    }
}
