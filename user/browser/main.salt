@no_mangle
pub fn check_any_layout_dirty() -> i32 {
    let limit = ext_get_dom_node_count() as u32;
    let mut i: u32 = 1;
    while i < limit {
        if dom.FLAG_LAYOUT_DIRTY[i as usize] == 1 { return 1; }
        i = i + 1;
    }
    return 0;
}

pub fn sys_parse_cli_url_ptr(argc: u32, argv: u64) -> u64 {
    let mut i: u32 = 0;
    while i < argc {
        let str_ptr = *((argv + ((i as u64) * 8)) as &u64);
        let mut len: u32 = 0;
        while *((str_ptr + (len as u64)) as &u8) != 0 {
            len = len + 1;
        }
        
        // check for "--url"
        if len == 5 {
            let b0 = *((str_ptr + 0) as &u8);
            let b1 = *((str_ptr + 1) as &u8);
            let b2 = *((str_ptr + 2) as &u8);
            let b3 = *((str_ptr + 3) as &u8);
            let b4 = *((str_ptr + 4) as &u8);
            if b0 == 45 && b1 == 45 && b2 == 117 && b3 == 114 && b4 == 108 { // "--url"
                if (i + 1) < argc {
                    return *((argv + (((i + 1) as u64) * 8)) as &u64);
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

pub fn sys_parse_cli_url_len(argc: u32, argv: u64) -> u32 {
    let ptr = sys_parse_cli_url_ptr(argc, argv);
    if ptr == 0 { return 0; }
    let mut len: u32 = 0;
    while *((ptr + (len as u64)) as &u8) != 0 {
        len = len + 1;
    }
    return len;
}

// Epic 99: Parse --ipc-fd from CLI args and return the fd value
pub fn sys_parse_cli_ipc_fd(argc: u32, argv: u64) -> i32 {
    let mut i: u32 = 0;
    while i < argc {
        let str_ptr = *((argv + ((i as u64) * 8)) as &u64);
        let mut len: u32 = 0;
        while *((str_ptr + (len as u64)) as &u8) != 0 {
            len = len + 1;
        }
        
        // check for "--ipc-fd" (8 chars: 45 45 105 112 99 45 102 100)
        if len == 8 {
            let b0 = *((str_ptr + 0) as &u8);
            let b1 = *((str_ptr + 1) as &u8);
            let b2 = *((str_ptr + 2) as &u8);
            let b3 = *((str_ptr + 3) as &u8);
            let b4 = *((str_ptr + 4) as &u8);
            let b5 = *((str_ptr + 5) as &u8);
            let b6 = *((str_ptr + 6) as &u8);
            let b7 = *((str_ptr + 7) as &u8);
            if b0 == 45 && b1 == 45 && b2 == 105 && b3 == 112 && b4 == 99 && b5 == 45 && b6 == 102 && b7 == 100 {
                if (i + 1) < argc {
                    // Simple atoi: parse the next arg as an integer
                    let val_ptr = *((argv + (((i + 1) as u64) * 8)) as &u64);
                    let mut result: i32 = 0;
                    let mut j: u32 = 0;
                    while *((val_ptr + (j as u64)) as &u8) != 0 {
                        let digit = *((val_ptr + (j as u64)) as &u8);
                        if digit >= 48 && digit <= 57 {
                            result = result * 10 + ((digit - 48) as i32);
                        }
                        j = j + 1;
                    }
                    return result;
                }
            }
        }
        i = i + 1;
    }
    return -1;
}

extern fn ext_cdm_sandbox_init();

@no_mangle
pub fn salt_browser_main(argc: u32, argv: u64) -> u32 {
    let msg: [u8; 40] = [73, 110, 105, 116, 105, 97, 108, 105, 122, 105, 110, 103, 32, 80, 114, 105, 115, 105, 109, 105, 32, 83, 111, 118, 101, 114, 101, 105, 103, 110, 32, 69, 110, 103, 105, 110, 101, 46, 46, 46];
    sys_log_info((&msg) as u64, 40);
    
    // Epic 99: Parse --ipc-fd from CLI to detect multiprocess mode
    let ipc_fd_from_cli = sys_parse_cli_ipc_fd(argc, argv);
    if ipc_fd_from_cli >= 0 {
        // Open shared memory by NAME (bypasses fd inheritance across exec)
        ext_ipc_init_by_name();
        MAX_TEST_FRAMES = 0; // Run forever in multiprocess mode
    }
    
    app_main.sys_boot_engine_matrix();
    
    // Epic 90 requires mimicking exactly this init seq:
    // sys_memory_arena_init(); // handled by airlock/init_arrays
    sys_jsc_init();
    font.init_glyphs();
    load_font_atlas((&font.SDF_ATLAS) as u64, 1024, 1024);
    sys_typography_init();
    sys_hw_audio_init();
    sys_init_vsync();
    ext_cdm_sandbox_init();
    
    let ipc_fd = ext_get_ipc_fd();
    if ipc_fd >= 0 || ipc_fd_from_cli >= 0 {
        sys_gpu_init_iosurface(1920, 1080);
    } else {
        compositor.window_init(1920, 1080);
        MAX_TEST_FRAMES = 0; // Run infinite loop
    }
    
    css.init_css_defaults();
    chrome.init_chrome();
    
    // Parse target URL from CLI arguments
    let url_len = sys_parse_cli_url_len(argc, argv);
    let url_ptr = sys_parse_cli_url_ptr(argc, argv);
    
    if url_ptr == 0 || url_len == 0 {
        let err_msg: [u8; 31] = [70, 65, 84, 65, 76, 58, 32, 78, 111, 32, 112, 97, 121, 108, 111, 97, 100, 32, 85, 82, 76, 32, 112, 114, 111, 118, 105, 100, 101, 100, 46];
        sys_log_error((&err_msg) as u64, 31);
        return 1;
    }
    
    let net_msg: [u8; 50] = [73, 110, 105, 116, 105, 97, 108, 105, 122, 105, 110, 103, 32, 72, 84, 84, 80, 47, 50, 32, 104, 97, 110, 100, 115, 104, 97, 107, 101, 32, 119, 105, 116, 104, 32, 112, 97, 121, 108, 111, 97, 100, 32, 116, 97, 114, 103, 101, 116, 46];
    sys_log_net((&net_msg) as u64, 50);
    
    // Use existing root viewport (node 1) created by sys_boot_engine_matrix.
    // Reconstruct its generational ID for the HTTP lexer.
    let root_gen = dom.DOM_NODE_GENERATION[1] as u64;
    let root: u64 = 1 | (root_gen << 16);
    
    let ipc_fd = ext_get_ipc_fd();
    let is_single_process = ipc_fd < 0 && ipc_fd_from_cli < 0;
    
    if is_single_process {
        // Single-process mode: IPC has no shared memory, so CMD_FETCH_REQUEST
        // goes nowhere. Feed mock HTML directly through the HTTP lexer.
        let mock_ptr = ext_get_mock_http_ptr();
        let mock_len = ext_get_mock_http_len();
        
        let msg_mock: [u8; 30] = [91,78,69,84,93,32,83,105,110,103,108,101,45,112,114,111,99,101,115,115,32,109,111,99,107,32,108,101,110,61]; // "[NET] Single-process mock len="
        sys_log_info((&msg_mock) as u64, 30);
        sys_print_float(mock_len as f64);
        let nl: [u8; 1] = [10];
        sys_log_info((&nl) as u64, 1);
        
        http_set_root_node(root);
        http_process_ingress(mock_ptr, mock_len);
        http_set_eof();
        
        // Mark ALL nodes dirty after batch DOM creation
        invalidate_all_layout();
        ext_mark_all_compositor_dirty();
    } else {
        // Multi-process mode: Send fetch request via IPC to the main process
        let mut nav_bit: u64 = 1;
        nav_bit = nav_bit << 62;
        let multiplexed_id = nav_bit | root;
        sys_ipc_send_r2m_command_with_payload(12 /* CMD_FETCH_REQUEST */, multiplexed_id, url_ptr, url_len);
        ext_mark_all_compositor_dirty();
    }
    
    // Enter the infinite matrix
    app_run_loop();
    
    return 0;
}
