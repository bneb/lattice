// ============================================================================
// Epic 51: Zero-Allocation Async Fetch Queue (SoA)
// ============================================================================
// Provides Salt-native visibility into pending fetch operations.
// State machine: 0=EMPTY, 1=PENDING, 2=DOWNLOADING, 3=DONE, 4=ERROR

extern fn sys_log_net(msg_ptr: u64, msg_len: u32);
extern fn dom_add_scroll_y(delta_y: i32);

pub const FETCH_EMPTY:       u8 = 0;
pub const FETCH_PENDING:     u8 = 1;
pub const FETCH_DOWNLOADING: u8 = 2;
pub const FETCH_DONE:        u8 = 3;
pub const FETCH_ERROR:       u8 = 4;
pub const FETCH_PENDING_SW:  u8 = 5;

// ============================================================================
// Epic 77: HTTP/2 Multiplex Matrix & Advanced TLS
// ============================================================================

pub global H2_INGRESS_RING: [u8; 65536] = [0; 65536];
pub global H2_READ_HEAD: u32 = 0;
pub global H2_WRITE_HEAD: u32 = 0;

pub global FETCH_STREAM_IDS: [u32; 256] = [0; 256];
pub global NEXT_STREAM_ID: u32 = 1; // Client streams must be odd

pub global HAS_ACTIVE_SERVICE_WORKER: u32 = 0;

pub const MAX_FETCH_SLOTS: u32 = 256;

pub global FETCH_QUEUE_STATE:      [u8;  256] = [0; 256];
pub global FETCH_QUEUE_FETCH_ID:   [u64; 256] = [0; 256];
pub global FETCH_QUEUE_BUFFER_PTR: [u64; 256] = [0; 256];
pub global FETCH_QUEUE_BUFFER_LEN: [u32; 256] = [0; 256];
pub global FETCH_QUEUE_URL_PTR:    [u64; 256] = [0; 256];
pub global FETCH_QUEUE_URL_LEN:    [u32; 256] = [0; 256];
pub global FETCH_QUEUE_COUNT:      u32 = 0;

// Allocate a queue slot for a new fetch request.
// Returns slot index on success, -1 if queue is full.
@no_mangle
pub fn ext_net_queue_fetch(fetch_id: u64, url_ptr: u64, url_len: u32) -> i32 {
    let mut i: u32 = 0;
    while i < 256 {
        if FETCH_QUEUE_STATE[i as usize] == FETCH_EMPTY {
            FETCH_QUEUE_FETCH_ID[i as usize] = fetch_id;
            FETCH_QUEUE_STATE[i as usize] = FETCH_PENDING;
            FETCH_QUEUE_BUFFER_PTR[i as usize] = 0;
            FETCH_QUEUE_BUFFER_LEN[i as usize] = 0;
            FETCH_QUEUE_URL_PTR[i as usize] = url_ptr;
            FETCH_QUEUE_URL_LEN[i as usize] = url_len;
            FETCH_QUEUE_COUNT = FETCH_QUEUE_COUNT + 1;
            return i as i32;
        }
        i = i + 1;
    }
    return -1; // Queue full
}

pub fn queue_fetch(fetch_id: u64, url_ptr: u64, url_len: u32) -> i32 {
    return ext_net_queue_fetch(fetch_id, url_ptr, url_len);
}

// Mark a fetch slot as complete with its payload.
// Called by the IPC ingestion path when a response arrives.
@no_mangle
pub fn ext_net_complete_fetch(fetch_id: u64, buf_ptr: u64, buf_len: u32) -> i32 {
    let mut i: u32 = 0;
    while i < 256 {
        if FETCH_QUEUE_STATE[i as usize] != FETCH_EMPTY && FETCH_QUEUE_FETCH_ID[i as usize] == fetch_id {
            FETCH_QUEUE_STATE[i as usize] = FETCH_DONE;
            FETCH_QUEUE_BUFFER_PTR[i as usize] = buf_ptr;
            FETCH_QUEUE_BUFFER_LEN[i as usize] = buf_len;
            return i as i32;
        }
        i = i + 1;
    }
    return -1; // ID not found
}

pub fn complete_fetch(fetch_id: u64, buf_ptr: u64, buf_len: u32) -> i32 {
    return ext_net_complete_fetch(fetch_id, buf_ptr, buf_len);
}

// Reclaim a fetch slot after its promise has been resolved.
@no_mangle
pub fn ext_net_reclaim_slot(slot: u32) {
    if slot >= 256 { return; }
    FETCH_QUEUE_STATE[slot as usize] = FETCH_EMPTY;
    FETCH_QUEUE_FETCH_ID[slot as usize] = 0;
    FETCH_QUEUE_BUFFER_PTR[slot as usize] = 0;
    FETCH_QUEUE_BUFFER_LEN[slot as usize] = 0;
    if FETCH_QUEUE_COUNT > 0 {
        FETCH_QUEUE_COUNT = FETCH_QUEUE_COUNT - 1;
    }
}

// Getters for C-bridge access
@no_mangle
pub fn net_get_fetch_state(slot: u32) -> u8 {
    if slot >= 256 { return 0; }
    return FETCH_QUEUE_STATE[slot as usize];
}

@no_mangle
pub fn net_get_fetch_id(slot: u32) -> u64 {
    if slot >= 256 { return 0; }
    return FETCH_QUEUE_FETCH_ID[slot as usize];
}

@no_mangle
pub fn net_get_fetch_buf_ptr(slot: u32) -> u64 {
    if slot >= 256 { return 0; }
    return FETCH_QUEUE_BUFFER_PTR[slot as usize];
}

@no_mangle
pub fn net_get_fetch_buf_len(slot: u32) -> u32 {
    if slot >= 256 { return 0; }
    return FETCH_QUEUE_BUFFER_LEN[slot as usize];
}

@no_mangle
pub fn net_get_fetch_count() -> u32 {
    return FETCH_QUEUE_COUNT;
}

// ============================================================================
// Epic 58: The Ring Buffer Streamer (WebSockets)
// ============================================================================

pub global WS_STATE: [u8; 16] = [0; 16]; // 0=CLOSED, 1=CONNECTING, 2=OPEN
pub global WS_RING_BUFFER: [u8; 1048576] = [0; 1048576]; // 1MB shared pool (64KB per socket)
pub global WS_HEAD: [u32; 16] = [0; 16];
pub global WS_TAIL: [u32; 16] = [0; 16];

// FFI to allow the OS VirtIO layer to push raw TCP bytes into the buffer
@no_mangle
pub fn sys_net_push_ws_bytes(socket_id: u32, data_ptr: u64, data_len: u32) {
    if socket_id >= 16 { return; }
    let mut i: u32 = 0;
    let offset = socket_id * 65536; // 64KB chunk per socket
    let mut tail = WS_TAIL[socket_id as usize];
    
    while i < data_len {
        let byte = *((data_ptr + (i as u64)) as &mut u8);
        let write_idx = offset + (tail % 65536);
        WS_RING_BUFFER[write_idx as usize] = byte;
        tail = tail + 1;
        i = i + 1;
    }
    WS_TAIL[socket_id as usize] = tail;
}

@no_mangle
pub fn ext_net_open_websocket(url_ptr: u64, url_len: u32) -> u32 {
    let mut i: u32 = 0;
    while i < 16 {
        if WS_STATE[i as usize] == 0 {
            WS_STATE[i as usize] = 2; // Directly to OPEN for testing sync workflow
            WS_HEAD[i as usize] = 0;
            WS_TAIL[i as usize] = 0;
            return i;
        }
        i = i + 1;
    }
    return 999; // Error
}

// C-bridge access to state
@no_mangle
pub fn get_ws_state(socket_id: u32) -> u8 {
    if socket_id >= 16 { return 0; }
    return WS_STATE[socket_id as usize];
}

@no_mangle
pub fn set_ws_state(socket_id: u32, state: u8) {
    if socket_id >= 16 { return; }
    WS_STATE[socket_id as usize] = state;
}

// Epic 76: Network Interceptor Bridge
extern fn sys_ipc_send_r2m_command_with_payload(cmd_type: u32, arg1: u64, payload_ptr: u64, payload_len: u32);
extern fn ext_tls_write_bytes(data_ptr: u64, len: u32);
extern fn ext_hpack_encode_headers(method_ptr: u64, path_ptr: u64, stream_id: u32) -> u32;
extern fn ext_hpack_get_buffer_len() -> u32;
extern fn ext_hpack_get_buffer_ptr() -> u64;
extern fn decode_hpack_block(payload_ptr: u64, payload_len: u32, stream_id: u32);

// ============================================================================
// H2 Framing Layer
// ============================================================================

@no_mangle
pub fn sys_pack_h2_header(header_ptr: u64, len: u32, h2_type: u8, flags: u8, stream_id: u32) {
    let buf = header_ptr as &mut u8;
    // Length (24 bits)
    *((header_ptr + 0) as &mut u8) = ((len >> 16) & 0xFF) as u8;
    *((header_ptr + 1) as &mut u8) = ((len >> 8) & 0xFF) as u8;
    *((header_ptr + 2) as &mut u8) = (len & 0xFF) as u8;
    // Type (8 bits)
    *((header_ptr + 3) as &mut u8) = h2_type;
    // Flags (8 bits)
    *((header_ptr + 4) as &mut u8) = flags;
    // Stream ID (31 bits)
    *((header_ptr + 5) as &mut u8) = ((stream_id >> 24) & 0x7F) as u8;
    *((header_ptr + 6) as &mut u8) = ((stream_id >> 16) & 0xFF) as u8;
    *((header_ptr + 7) as &mut u8) = ((stream_id >> 8) & 0xFF) as u8;
    *((header_ptr + 8) as &mut u8) = (stream_id & 0xFF) as u8;
}

@no_mangle
pub fn sys_net_send_h2_preface() {
    // PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n
    let mut preface: [u8; 24] = [
        80, 82, 73, 32, 42, 32, 72, 84, 84, 80, 47, 50, 46, 48, 13, 10, 13, 10, 83, 77, 13, 10, 13, 10
    ];
    ext_tls_write_bytes((&preface) as u64, 24);
    
    // Send initial SETTINGS frame (Type 0x04, Length 0, Flags 0, Stream 0)
    let mut settings_header: [u8; 9] = [0; 9];
    sys_pack_h2_header((&settings_header) as u64, 0, 0x04, 0x00, 0);
    ext_tls_write_bytes((&settings_header) as u64, 9);
}

@no_mangle
pub fn sys_net_push_h2_request(fetch_id: u32, method_ptr: u64, path_ptr: u64) {
    let stream_id = NEXT_STREAM_ID;
    NEXT_STREAM_ID = NEXT_STREAM_ID + 2;
    FETCH_STREAM_IDS[fetch_id as usize] = stream_id;
    
    // Compress headers using HPACK
    let hpack_len = ext_hpack_encode_headers(method_ptr, path_ptr, stream_id);
    
    // Construct 9-byte HTTP/2 Frame Header
    // 0x01 for HEADERS | 0x05 for END_HEADERS + END_STREAM
    let mut frame_header: [u8; 9] = [0; 9];
    sys_pack_h2_header((&frame_header) as u64, hpack_len, 0x01, 0x05, stream_id);
    
    // Write frame to the secure socket FFI
    ext_tls_write_bytes((&frame_header) as u64, 9);
    ext_tls_write_bytes(ext_hpack_get_buffer_ptr(), hpack_len);
    
    FETCH_QUEUE_STATE[fetch_id as usize] = 2; // DOWNLOADING (Routing H2 to FETCHING)
}

@no_mangle
@no_mangle
pub fn sys_net_push_h2_bytes(data_ptr: u64, data_len: u32) {
    let mut i: u32 = 0;
    while i < data_len {
        let byte = *((data_ptr + (i as u64)) as &u8);
        let write_idx = H2_WRITE_HEAD % 65536;
        H2_INGRESS_RING[write_idx as usize] = byte;
        H2_WRITE_HEAD = H2_WRITE_HEAD + 1;
        i = i + 1;
    }
}

@no_mangle
pub fn pump_net_fetch_queue() {
    let mut i: u32 = 0;
    while i < 256 {
        let state = FETCH_QUEUE_STATE[i as usize];
        if state == FETCH_PENDING {
            let fetch_id = FETCH_QUEUE_FETCH_ID[i as usize];
            let url_ptr = FETCH_QUEUE_URL_PTR[i as usize];
            let url_len = FETCH_QUEUE_URL_LEN[i as usize];
            
            if HAS_ACTIVE_SERVICE_WORKER == 1 {
                FETCH_QUEUE_STATE[i as usize] = FETCH_PENDING_SW;
                sys_ipc_send_r2m_command_with_payload(8, fetch_id, url_ptr, url_len);
            } else {
                // Phase 2: Route via Native Proxy
                FETCH_QUEUE_STATE[i as usize] = 2; // DOWNLOADING
                sys_ipc_send_r2m_command_with_payload(12 /* CMD_FETCH_REQUEST */, fetch_id, url_ptr, url_len);
            }
        }
        i = i + 1;
    }
    
    // H2 Frame Parser Loop
    sys_net_pump_h2_frames();
}

fn sys_net_pump_h2_frames() {
    while (H2_WRITE_HEAD - H2_READ_HEAD) >= 9 {
        // Read 9-byte header
        let mut header: [u8; 9] = [0; 9];
        let mut i: u32 = 0;
        while i < 9 {
            header[i as usize] = H2_INGRESS_RING[((H2_READ_HEAD + i) % 65536) as usize];
            i = i + 1;
        }
        
        let length = ((header[0] as u32) << 16) | ((header[1] as u32) << 8) | (header[2] as u32);
        let h2_type = header[3];
        let flags = header[4];
        let stream_id = ((header[5] as u32 & 0x7F) << 24) | ((header[6] as u32) << 16) | ((header[7] as u32) << 8) | (header[8] as u32);
        
        if (H2_WRITE_HEAD - H2_READ_HEAD) < (9 + length) {
            return; // Wait for full payload
        }
        
        H2_READ_HEAD = H2_READ_HEAD + 9;
        
        // Payload routing
        let payload_ptr = (&H2_INGRESS_RING[0] as u64) + (H2_READ_HEAD % 65536) as u64;
        
        if h2_type == 0x01 { // HEADERS
            decode_hpack_block(payload_ptr, length, stream_id);
        } else if h2_type == 0x00 { // DATA
            sys_net_route_data_to_stream(stream_id, payload_ptr, length, flags);
        }
        
        H2_READ_HEAD = H2_READ_HEAD + length;
    }
}

extern fn js_resolve_fetch_chunk(fetch_id: u32, buf_ptr: u64, buf_len: u32, is_end: u8);

fn sys_net_route_data_to_stream(stream_id: u32, payload_ptr: u64, length: u32, flags: u8) {
    let mut i: u32 = 0;
    while i < 256 {
        if FETCH_STREAM_IDS[i as usize] == stream_id {
            let fetch_id = FETCH_QUEUE_FETCH_ID[i as usize];
            let is_end = (flags & 0x01) == 0x01;
            js_resolve_fetch_chunk(i, payload_ptr, length, is_end as u8);
            return;
        }
        i = i + 1;
    }
}

