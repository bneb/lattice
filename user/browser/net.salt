// Sprint 5: Keyboard Input & Focus FFI
extern fn ext_engine_process_mouse_down(x: f32, y: f32);
extern fn ext_engine_process_key_down(char_code: u8);
extern fn ext_dom_mutate_text(node_id: u32, insert_char: u8, is_backspace: u8);
extern fn dom_get_active_focus() -> u32;

pub fn sys_net_pump_ingress() {
    let mut idx = 0;
    while idx < 10 {
        let cmd_ptr = sys_ipc_read_m2r_command();
        if cmd_ptr == 0 { break; }
        
        let cmd_type = read_ipc_command_type(cmd_ptr);
        let arg1 = read_ipc_command_arg1(cmd_ptr);
        let arg2 = read_ipc_command_arg2(cmd_ptr);
        let payload_ptr = read_ipc_command_payload_ptr(cmd_ptr);
        let payload_len = read_ipc_command_payload_len(cmd_ptr);
        
        if cmd_type == 1 { // EVENT_NAVIGATE
            sys_browser_navigate(payload_ptr, payload_len);
        } else if cmd_type == 3 { // EVENT_GO_BACK
            native_go_back();
        } else if cmd_type == 5 { // EVENT_POST_MESSAGE
            js_bridge_dispatch_message_event(payload_ptr, payload_len);
        } else if cmd_type == 6 { // EVENT_IFRAME_SURFACE
            let iframe_slot = arg1 as u32;
            let surface_id = arg2;
            if iframe_slot < 256 {
                dom.DOM_IFRAME_SURFACE_ID[iframe_slot as usize] = surface_id;
                dom.invalidate_layout(dom.DOM_IFRAME_NODE_ID[iframe_slot as usize]);
            }
        } else if cmd_type == 7 { // CMD_WORKER_REGISTERED
            HAS_ACTIVE_SERVICE_WORKER = 1;
        } else if cmd_type == 13 { // CMD_MOUSEDOWN (Sprint 5)
            // Unpack: x in upper 32 bits, y in lower 32 bits
            let mx = (arg1 >> 32) as i32;
            let my = (arg1 & 0xFFFFFFFF) as i32;
            ext_engine_process_mouse_down(mx as f32, my as f32);
        } else if cmd_type == 14 { // CMD_KEYDOWN (Sprint 5)
            let char_code = arg1 as u8;
            ext_engine_process_key_down(char_code);
        } else if cmd_type == 6 { // CMD_SCROLL
            dom_add_scroll_y(arg1 as i32);
        } else if cmd_type == 10 { // CMD_CDM_REGISTERED
            let cdm_fd = arg1 as i32;
            let m_cdm: [u8; 18] = [91,78,69,84,93,32,67,68,77,32,114,101,103,105,115,116,101,114]; // "[NET] CDM register"
            sys_log_info((&m_cdm) as u64, 18);
        } else if cmd_type == 9 { // CMD_FETCH_RESPONSE
            let ipc_arg1 = read_ipc_command_arg1(cmd_ptr);
            let ipc_arg2 = read_ipc_command_arg2(cmd_ptr);
            let slot_idx = (ipc_arg2 >> 24) as u32;
            let expected_seq = ipc_arg2 & 0xFFFFFF;
            
            let bulk_base = sys_ipc_get_bulk_ingress_ptr();
            let SLOT_SIZE: u32 = 2097152;
            let slot_base = bulk_base + (slot_idx * SLOT_SIZE) as u64;
            
            // Epic 108: Robust Multi-Slot Bulk SHM Synchronization
            // Wait for MainProcess to signal that data is ready in THIS slot
            let slot_status_ptr = slot_base as &mut u32;
            let mut ready_timeout = 10000000;
            while *slot_status_ptr != expected_seq && ready_timeout > 0 {
                ready_timeout = ready_timeout - 1;
            }
            
            let fetch_len = *((slot_base + 4) as &u32);
            let bulk_ptr = slot_base + 8; // Data starts at offset 8
            
            let mut nav_bit: u64 = 1;
            nav_bit = nav_bit << 62;
            let is_nav = (ipc_arg1 & nav_bit) != 0;
            
            let mut img_bit: u64 = 1;
            img_bit = img_bit << 59;
            let is_img_fetch = (ipc_arg1 & img_bit) != 0;
            
            let mut script_bit: u64 = 1;
            script_bit = script_bit << 60;
            let is_script_fetch = (ipc_arg1 & script_bit) != 0;
            
            if is_nav {
                if fetch_len > 0 && bulk_ptr != 0 {
                    let root_id = ipc_arg1 - nav_bit;
                    http_reset_state();
                    ext_salt_reset_lexer();
                    http_set_root_node(root_id);
                    js_lex_html_chunk(root_id, bulk_ptr, fetch_len, 1);
                    http_set_eof();
                    dom.resolve_node(root_id);
                    
                    // Epic 108: Force layout solve and compositor refresh
                    dom.invalidate_all_layout();
                    ext_mark_all_compositor_dirty();
                }
                
                // Mark ALL nodes dirty after batch DOM creation
                dom.invalidate_all_layout();
                paint.paint_mark_compositor_dirty(1);
                sys_js_pump_script_queue();
                sys_jsc_flush_microtasks();
                
                // Epic 108: Acknowledge consumption of this slot
                *slot_status_ptr = 0;
            } else if is_img_fetch && bulk_ptr != 0 {
                let img_fetch_id = arg1 - img_bit;
                let mut f_i: u32 = 0;
                while f_i < 64 {
                    if dom.IMG_FETCH_STATE[f_i as usize] == 1 && dom.IMG_FETCH_ID[f_i as usize] == img_fetch_id {
                        let node_idx = dom.IMG_FETCH_NODE_IDX[f_i as usize];
                        if node_idx != 0xFFFFFFFF && node_idx != 0 {
                            let mut out_w: i32 = 0;
                            let mut out_h: i32 = 0;
                            let tex_id = decode_and_upload_image(bulk_ptr, fetch_len, (&mut out_w) as u64, (&mut out_h) as u64);
                            if tex_id > 0 {
                                dom.DOM_NODE_TEXTURE_ID[node_idx as usize] = tex_id as u32;
                                dom.DOM_CANVAS_WIDTH[node_idx as usize] = out_w as u32;
                                dom.DOM_CANVAS_HEIGHT[node_idx as usize] = out_h as u32;
                                if dom.STYLE_W[node_idx as usize] == -1 { dom.STYLE_W[node_idx as usize] = out_w; }
                                if dom.STYLE_H[node_idx as usize] == -1 { dom.STYLE_H[node_idx as usize] = out_h; }
                                dom.invalidate_layout(node_idx);
                                paint.paint_mark_compositor_dirty(node_idx);
                            }
                        }
                        dom.IMG_FETCH_STATE[f_i as usize] = 0;
                        break;
                    }
                    f_i = f_i + 1;
                }
                *slot_status_ptr = 0;
            } else if is_script_fetch {
                let script_fetch_id = arg1 - script_bit;
                if fetch_len > 0 && bulk_ptr != 0 {
                    let perm_ptr = dom_alloc_text(fetch_len);
                    if perm_ptr != 0 {
                        sys_jsc_flush_microtasks();
                        sys_memcpy(perm_ptr, bulk_ptr, fetch_len);
                        let slot = complete_script_fetch(script_fetch_id, perm_ptr, fetch_len);
                        if slot >= 0 {
                            let src_ptr = dom.SCRIPT_FETCH_SRC_PTR[slot as usize];

                            // Epic 108 Safety: Detect HTML signature
                            let mut is_html_redirect = false;
                            if fetch_len > 10 {
                                let b0 = *((perm_ptr) as &u8);
                                let b1 = *((perm_ptr + 1) as &u8);
                                if b0 == 60 && b1 == 33 { // "<!"
                                    is_html_redirect = true;
                                }
                            }

                            if !is_html_redirect {
                                sys_jsc_evaluate_script(perm_ptr, fetch_len, src_ptr);
                            }

                            dom.SCRIPT_FETCH_STATE[slot as usize] = 0;
                            if dom.PENDING_SCRIPT_COUNT > 0 { dom.PENDING_SCRIPT_COUNT = dom.PENDING_SCRIPT_COUNT - 1; }
                        }
                    }
                } else if fetch_len == 0 {
                    let slot = complete_script_fetch(script_fetch_id, 0, 0);
                    if slot >= 0 {
                        dom.SCRIPT_FETCH_STATE[slot as usize] = 0;
                        if dom.PENDING_SCRIPT_COUNT > 0 { dom.PENDING_SCRIPT_COUNT = dom.PENDING_SCRIPT_COUNT - 1; }
                    }
                }
                *slot_status_ptr = 0;
            } else {
                if bulk_ptr != 0 {
                    complete_fetch(arg1, bulk_ptr, fetch_len);
                }
                *slot_status_ptr = 0;
            }
        }
        idx = idx + 1;
    }
    
    pump_net_fetch_queue();
    
    let mut pumped_bytes = 0;
    let mut active = 1;
    while active == 1 && pumped_bytes < 4096 {
        let mut byte_val: u8 = 0;
        let b_ptr = (&mut byte_val) as u64;
        let res = ipc_ring.ipc_read_byte(b_ptr);
        if res == 0 {
            active = 0;
        } else {
            pumped_bytes = pumped_bytes + 1;
            if NETWORK_INGEST_STATE == 0 {
                let shift = NETWORK_INGEST_CURSOR * 8;
                let v64 = (byte_val as u64) << shift;
                NETWORK_INGEST_NODE_ID = NETWORK_INGEST_NODE_ID | v64;
                NETWORK_INGEST_CURSOR = NETWORK_INGEST_CURSOR + 1;
                if NETWORK_INGEST_CURSOR == 8 {
                    NETWORK_INGEST_STATE = 1;
                    NETWORK_INGEST_CURSOR = 0;
                }
            } else if NETWORK_INGEST_STATE == 1 {
                let shift = NETWORK_INGEST_CURSOR * 8;
                let v32 = (byte_val as u32) << shift;
                NETWORK_INGEST_EXPECTED_LEN = NETWORK_INGEST_EXPECTED_LEN | v32;
                NETWORK_INGEST_CURSOR = NETWORK_INGEST_CURSOR + 1;
                if NETWORK_INGEST_CURSOR == 4 {
                    NETWORK_INGEST_STATE = 2;
                    NETWORK_INGEST_CURSOR = 0;
                }
            } else if NETWORK_INGEST_STATE == 2 {
                if NETWORK_INGEST_CURSOR < 1048576 {
                    NETWORK_INGEST_BUFFER[NETWORK_INGEST_CURSOR as usize] = byte_val;
                }
                NETWORK_INGEST_CURSOR = NETWORK_INGEST_CURSOR + 1;
                if NETWORK_INGEST_CURSOR >= NETWORK_INGEST_EXPECTED_LEN {
                    let mut high_bit: u64 = 1;
                    high_bit = high_bit << 63;
                    let is_fetch = (NETWORK_INGEST_NODE_ID & high_bit) != 0;
                    
                    let mut nav_bit: u64 = 1;
                    nav_bit = nav_bit << 62;
                    let is_nav = (NETWORK_INGEST_NODE_ID & nav_bit) != 0;
                    
                    let mut ws_bit: u64 = 1;
                    ws_bit = ws_bit << 61;
                    let is_ws = (NETWORK_INGEST_NODE_ID & ws_bit) != 0;
                    
                    let mut script_bit: u64 = 1;
                    script_bit = script_bit << 60;
                    let is_script_fetch = (NETWORK_INGEST_NODE_ID & script_bit) != 0;
                    
                    if is_fetch {
                        let fetch_id = NETWORK_INGEST_NODE_ID - high_bit;
                        js_resolve_fetch(fetch_id, (&NETWORK_INGEST_BUFFER) as u64, NETWORK_INGEST_EXPECTED_LEN);
                        sys_jsc_flush_microtasks();
                    } else if is_nav {
                        let root_id = NETWORK_INGEST_NODE_ID - nav_bit;
                        http_set_root_node(root_id);
                        http_process_ingress((&NETWORK_INGEST_BUFFER) as u64, NETWORK_INGEST_EXPECTED_LEN);
                        sys_js_pump_script_queue();
                        sys_jsc_flush_microtasks();
                    } else if is_ws {
                        let ws_id = (NETWORK_INGEST_NODE_ID - ws_bit) as u32;
                        js_bridge_dispatch_websocket_message(ws_id, (&NETWORK_INGEST_BUFFER) as u64, NETWORK_INGEST_EXPECTED_LEN);
                        sys_jsc_flush_microtasks();
                    } else if is_script_fetch {
                        let script_fetch_id = NETWORK_INGEST_NODE_ID - script_bit;
                        let payload_len = NETWORK_INGEST_EXPECTED_LEN;
                        let perm_ptr = dom_alloc_text(payload_len);
                        if perm_ptr != 0 {
                            sys_jsc_flush_microtasks();
                            let mut cp_i: u32 = 0;
                            while cp_i < payload_len {
                                let byte = *((&NETWORK_INGEST_BUFFER as u64 + cp_i as u64) as &u8);
                                *((perm_ptr + cp_i as u64) as &mut u8) = byte;
                                cp_i = cp_i + 1;
                            }
                            let slot = complete_script_fetch(script_fetch_id, perm_ptr, payload_len);
                            if slot >= 0 {
                                let src_ptr = dom.SCRIPT_FETCH_SRC_PTR[slot as usize];
                                let src_len = dom.SCRIPT_FETCH_SRC_LEN[slot as usize];
                                sys_jsc_evaluate_script(perm_ptr, payload_len, src_ptr);
                                dom.SCRIPT_FETCH_STATE[slot as usize] = 0;
                                if dom.PENDING_SCRIPT_COUNT > 0 { dom.PENDING_SCRIPT_COUNT = dom.PENDING_SCRIPT_COUNT - 1; }
                            }
                        }
                    } else {
                        let n_idx = dom.resolve_node(NETWORK_INGEST_NODE_ID);
                        if n_idx != 0xFFFFFFFF && n_idx != 0 {
                            let mut out_w: i32 = 0; let mut out_h: i32 = 0;
                            decode_and_upload_image((&NETWORK_INGEST_BUFFER) as u64, NETWORK_INGEST_EXPECTED_LEN, (&mut out_w) as u64, (&mut out_h) as u64);
                        }
                    }
                    NETWORK_INGEST_STATE = 0;
                    NETWORK_INGEST_CURSOR = 0;
                    NETWORK_INGEST_NODE_ID = 0;
                    NETWORK_INGEST_EXPECTED_LEN = 0;
                }
            }
        }
    }
    
    // Web Worker Drains
    let mut expected_up_len: u32 = 0;
    let up_res = worker_ring.read_up_u32((&mut expected_up_len) as u64);
    if up_res == 1 {
        let mut w_i: u32 = 0;
        while w_i < expected_up_len {
           let mut b: u8 = 0;
           worker_ring.read_up_byte((&mut b) as u64);
           if w_i < 1048576 {
               NETWORK_INGEST_BUFFER[w_i as usize] = b; 
           }
           w_i = w_i + 1;
        }
        js_bridge_dispatch_main_message((&NETWORK_INGEST_BUFFER) as u64, expected_up_len);
        sys_jsc_flush_microtasks();
    }
    
    pump_net_fetch_queue();
    pump_websocket_frames();
    pump_storage_queue();
    
    // Epic 86 Phase 26: TLS Ingress Socket Pump
    // pump_network_ingress();
}

extern fn ext_ring_buffer_poll_chunk(out_buffer: u64, out_len: u64) -> bool;
extern fn salt_lex_html_chunk(root_id: u64, ptr: u64, len: u32, can_execute: u8);

pub global NET_INGRESS_CHUNK: [u8; 8192] = [0; 8192];
pub global NET_CHUNK_LEN: [u64; 1] = [0];

pub fn get_ingress_buf_ptr() -> u64 { return (&NET_INGRESS_CHUNK) as u64; }
pub fn get_chunk_len_ptr() -> u64 { return (&NET_CHUNK_LEN) as u64; }



pub fn pump_network_ingress() {
    // Disabled due to missing FFI bindings in mac_app
}
