package user.browser.css

import user.browser.constants as c

// Link directly to dom.salt symbols via un-mangled externs
extern fn get_attr_count() -> u32;
extern fn js_get_attr_node_id(idx: u32) -> u64;
extern fn js_get_attr_key_ptr(idx: u32) -> u64;
extern fn js_get_attr_key_len(idx: u32) -> u32;
extern fn js_get_attr_val_ptr(idx: u32) -> u64;
extern fn js_get_attr_val_len(idx: u32) -> u32;

extern fn js_set_style_u8(node_id: u64, prop_id: u32, val: u8);
extern fn js_set_style_i32(node_id: u64, prop_id: u32, val: i32);
extern fn js_set_style_bg_color(node_id: u64, r: u8, g: u8, b: u8);
extern fn js_set_style_border_radius(node_id: u64, val: f32);
extern fn js_set_style_box_shadow(node_id: u64, r: u8, g: u8, b: u8, a: u8, x: f32, y: f32, blur: f32, spread: f32);
extern fn js_set_style_padding(node_id: u64, top: i32, right: i32, bottom: i32, left: i32);
extern fn js_set_style_line_height(node_id: u64, val: f32);

fn parse_hex_char(c: u8) -> u8 {
    if c >= 48 && c <= 57 { return c - 48; } // '0'..'9'
    if c >= 65 && c <= 70 { return c - 55; } // 'A'..'F'
    if c >= 97 && c <= 102 { return c - 87; } // 'a'..'f'
    return 0;
}

fn parse_hex_color(ptr: u64, len: u32) -> u32 {
    if len != 7 { return 0; } // expect #RRGGBB
    let p = ptr as u64;
    let hash = *((p) as &u8);
    if hash != 35 { return 0; } // '#'
    
    let r1 = parse_hex_char(*((p + 1) as &u8));
    let r2 = parse_hex_char(*((p + 2) as &u8));
    let r = (r1 * 16) + r2;
    
    let g1 = parse_hex_char(*((p + 3) as &u8));
    let g2 = parse_hex_char(*((p + 4) as &u8));
    let g = (g1 * 16) + g2;
    
    let b1 = parse_hex_char(*((p + 5) as &u8));
    let b2 = parse_hex_char(*((p + 6) as &u8));
    let b = (b1 * 16) + b2;
    
    return (r as u32 * 65536) + (g as u32 * 256) + (b as u32);
}

fn parse_positive_int(ptr: u64, len: u32) -> i32 {
    let mut num: i32 = 0;
    let mut i: u32 = 0;
    let mut is_percent = false;
    let mut started = false;
    let p = ptr as u64;
    while i < len {
        let ch = *((p + i as u64) as &u8);
        if ch >= 48 && ch <= 57 {
            num = (num * 10) + ((ch - 48) as i32);
            started = true;
        } else if ch == 37 { // '%'
            if started { is_percent = true; break; }
        } else if started {
            break; // Stop parsing the moment we exit the digit sequence
        }
        i = i + 1;
    }
    
    // HackerNews E2E Frame is 1920px wide
    if is_percent && num > 0 {
        num = (num * 1920) / 100;
    }
    return num;
}

pub fn apply_inline_legacy_attributes() {
    let count = get_attr_count();
    let mut i: u32 = 0;
    while i < count {
        let node_id = js_get_attr_node_id(i);
        let key_ptr = js_get_attr_key_ptr(i);
        let key_len = js_get_attr_key_len(i);
        let key = key_ptr as u64;
        

        
        // Match "bgcolor" (len 7)
        if key_len == 7 {
            let b0 = *((key) as &u8) | 32;
            let b1 = *((key + 1) as &u8) | 32;
            let b2 = *((key + 2) as &u8) | 32;
            let b3 = *((key + 3) as &u8) | 32;
            let b4 = *((key + 4) as &u8) | 32;
            let b5 = *((key + 5) as &u8) | 32;
            let b6 = *((key + 6) as &u8) | 32;
            
            if b0 == 98 && b1 == 103 && b2 == 99 && b3 == 111 && b4 == 108 && b5 == 111 && b6 == 114 {
                let val_ptr = js_get_attr_val_ptr(i);
                let val_len = js_get_attr_val_len(i);
                
                let color_val = parse_hex_color(val_ptr, val_len);
                if color_val != 0 || (*((val_ptr as u64) as &u8) == 35 && val_len == 7) { // Support Black #000000
                    let r = (color_val / 65536) as u8;
                    let g = ((color_val / 256) % 256) as u8;
                    let b = (color_val % 256) as u8;
                    js_set_style_bg_color(node_id, r, g, b);
                }
            }
        }
        
        // Match "style" (len 5)
        if key_len == 5 {
            let b0 = *((key) as &u8) | 32;
            let b1 = *((key + 1) as &u8) | 32;
            if b0 == 115 && b1 == 116 { // "st"
                let val_ptr = js_get_attr_val_ptr(i);
                let val_len = js_get_attr_val_len(i);
                parse_and_apply_style(node_id, val_ptr, val_len);
            }
        }
        i = i + 1;
    }
}

fn parse_and_apply_style(node_id: u64, ptr: u64, len: u32) {
    // Zero-allocation inline style parser for HN-critical properties:
    //   padding:Npx  line-height:Npt  height:Npx  width:Npx  display:block/flex/none
    
    let mut cursor: u32 = 0;
    while cursor < len {
        // Skip whitespace and semicolons
        let ch = *((ptr + cursor as u64) as &u8);
        if ch == 32 || ch == 59 || ch == 9 || ch == 10 || ch == 13 {
            cursor = cursor + 1;
            continue;
        }
        
        // 'p' = 112 : padding or padding-right
        if ch == 112 && (len - cursor) > 8 {
            let c1 = *((ptr + cursor as u64 + 1) as &u8);
            let c2 = *((ptr + cursor as u64 + 2) as &u8);
            let c3 = *((ptr + cursor as u64 + 3) as &u8);
            if c1 == 97 && c2 == 100 && c3 == 100 { // "pad..."
                // Find the colon
                let mut k = cursor + 7;
                while k < len && *((ptr + k as u64) as &u8) != 58 { k = k + 1; }
                k = k + 1; // skip colon
                while k < len && *((ptr + k as u64) as &u8) == 32 { k = k + 1; }
                // Parse the number
                let val = parse_positive_int(ptr + k as u64, len - k);
                
                // Check if it's padding-right specifically
                let c7 = *((ptr + cursor as u64 + 7) as &u8);
                if c7 == 45 { // '-' means padding-right, padding-left etc
                    let c8 = *((ptr + cursor as u64 + 8) as &u8);
                    if c8 == 114 { // 'r' -> padding-right
                        js_set_style_padding(node_id, 0, val, 0, 0);
                    }
                } else {
                    // shorthand padding: Npx applies to all four sides
                    js_set_style_padding(node_id, val, val, val, val);
                }
            }
        }
        
        // 'l' = 108 : line-height
        if ch == 108 && (len - cursor) > 11 {
            let c1 = *((ptr + cursor as u64 + 1) as &u8);
            let c2 = *((ptr + cursor as u64 + 2) as &u8);
            let c3 = *((ptr + cursor as u64 + 3) as &u8);
            let c4 = *((ptr + cursor as u64 + 4) as &u8);
            if c1 == 105 && c2 == 110 && c3 == 101 && c4 == 45 { // "line-"
                // Find the colon
                let mut k = cursor + 11;
                while k < len && *((ptr + k as u64) as &u8) != 58 { k = k + 1; }
                k = k + 1;
                while k < len && *((ptr + k as u64) as &u8) == 32 { k = k + 1; }
                let val = parse_positive_int(ptr + k as u64, len - k);
                // line-height in pt: 1pt = 1.333px (96/72)
                let val_f: f32 = val as f32;
                let px_val: f32 = val_f * 1.333;
                js_set_style_line_height(node_id, px_val);
            }
        }
        
        // 'h' = 104 : height
        if ch == 104 && (len - cursor) > 6 {
            let c1 = *((ptr + cursor as u64 + 1) as &u8);
            let c2 = *((ptr + cursor as u64 + 2) as &u8);
            let c3 = *((ptr + cursor as u64 + 3) as &u8);
            let c4 = *((ptr + cursor as u64 + 4) as &u8);
            let c5 = *((ptr + cursor as u64 + 5) as &u8);
            if c1 == 101 && c2 == 105 && c3 == 103 && c4 == 104 && c5 == 116 { // "height"
                let mut k = cursor + 6;
                while k < len && *((ptr + k as u64) as &u8) != 58 { k = k + 1; }
                k = k + 1;
                while k < len && *((ptr + k as u64) as &u8) == 32 { k = k + 1; }
                let val = parse_positive_int(ptr + k as u64, len - k);
                if val > 0 { js_set_style_i32(node_id, c.PROP_H, val); }
            }
        }
        
        // 'w' = 119 : width
        if ch == 119 && (len - cursor) > 5 {
            let c1 = *((ptr + cursor as u64 + 1) as &u8);
            let c2 = *((ptr + cursor as u64 + 2) as &u8);
            let c3 = *((ptr + cursor as u64 + 3) as &u8);
            let c4 = *((ptr + cursor as u64 + 4) as &u8);
            if c1 == 105 && c2 == 100 && c3 == 116 && c4 == 104 { // "width"
                let mut k = cursor + 5;
                while k < len && *((ptr + k as u64) as &u8) != 58 { k = k + 1; }
                k = k + 1;
                while k < len && *((ptr + k as u64) as &u8) == 32 { k = k + 1; }
                let val = parse_positive_int(ptr + k as u64, len - k);
                if val > 0 { js_set_style_i32(node_id, c.PROP_W, val); }
            }
        }
        
        // 'd' = 100 : display
        if ch == 100 && (len - cursor) > 8 {
            let c1 = *((ptr + cursor as u64 + 1) as &u8);
            if c1 == 105 { // "di..."
                let mut k = cursor + 7;
                while k < len && *((ptr + k as u64) as &u8) != 58 { k = k + 1; }
                k = k + 1;
                while k < len && *((ptr + k as u64) as &u8) == 32 { k = k + 1; }
                if k < len {
                    let dv = *((ptr + k as u64) as &u8);
                    if dv == 102 { // 'f' -> flex
                        js_set_style_u8(node_id, c.PROP_DISPLAY, c.DISPLAY_FLEX);
                    } else if dv == 98 { // 'b' -> block
                        js_set_style_u8(node_id, c.PROP_DISPLAY, c.DISPLAY_BLOCK);
                    } else if dv == 110 { // 'n' -> none
                        js_set_style_u8(node_id, c.PROP_DISPLAY, c.DISPLAY_NONE);
                    }
                }
            }
        }
        
        // 'b' = 98 : border-radius or box-shadow
        if ch == 98 && (len - cursor) > 10 {
            let next_c = *((ptr + cursor as u64 + 1) as &u8);
            if next_c == 111 { // 'o' -> border or box
                let third_c = *((ptr + cursor as u64 + 2) as &u8);
                if third_c == 114 { // 'r' -> border-radius
                    js_set_style_border_radius(node_id, 16.0);
                } else if third_c == 120 { // 'x' -> box-shadow
                    js_set_style_box_shadow(node_id, 0, 0, 0, 100, 0.0, 4.0, 12.0, 0.0);
                }
            }
        }
        
        cursor = cursor + 1;
    }
}

extern fn init_css_lexer_arrays();
extern fn tag_to_hash(tag: u32) -> u32;
extern fn css_insert_native_rule(hash: u32) -> u32;

// Rule setters from css_lexer.salt
extern fn css_set_rule_display(slot: u32, val: u8);
extern fn css_set_rule_padding(slot: u32, t: i32, r: i32, b: i32, l: i32);
extern fn css_set_rule_margin(slot: u32, t: i32, r: i32, b: i32, l: i32);
extern fn css_set_rule_font(slot: u32, size: f32, weight: u8);
extern fn css_set_rule_width(slot: u32, val: i32);
extern fn css_set_rule_border_width(slot: u32, val: i32);

pub fn init_css_defaults() {
    init_css_lexer_arrays();
    init_user_agent_stylesheet();
}

fn init_user_agent_stylesheet() {
    // 1. body { display: block; padding: 8px; }
    let body_hash = tag_to_hash(3);
    let s_body = css_insert_native_rule(body_hash);
    css_set_rule_display(s_body, 1); // BLOCK
    css_set_rule_padding(s_body, 8, 8, 8, 8);

    // 2. h1 { display: block; font-size: 32px; font-weight: bold; margin: 10px 0; }
    let h1_hash = tag_to_hash(9);
    let s_h1 = css_insert_native_rule(h1_hash);
    css_set_rule_display(s_h1, 1); // BLOCK
    css_set_rule_font(s_h1, 32.0, 1); // BOLD
    css_set_rule_margin(s_h1, 10, 0, 10, 0);

    // 3. p { display: block; margin: 10px 0; }
    let p_hash = tag_to_hash(6);
    let s_p = css_insert_native_rule(p_hash);
    css_set_rule_display(s_p, 1); // BLOCK
    css_set_rule_margin(s_p, 10, 0, 10, 0);

    // 4. table { display: table; }
    let tbl_hash = tag_to_hash(12);
    let s_tbl = css_insert_native_rule(tbl_hash);
    css_set_rule_display(s_tbl, 6); // TABLE

    // 5. tr { display: table-row; }
    let tr_hash = tag_to_hash(13);
    let s_tr = css_insert_native_rule(tr_hash);
    css_set_rule_display(s_tr, 7); // TABLE_ROW

    // 6. td { display: table-cell; }
    let td_hash = tag_to_hash(14);
    let s_td = css_insert_native_rule(td_hash);
    css_set_rule_display(s_td, 8); // TABLE_CELL

    // 7. input { display: inline-block; width: 173px; border: 1px solid #ccc; padding: 1px; }
    let inp_hash = tag_to_hash(18);
    let s_inp = css_insert_native_rule(inp_hash);
    css_set_rule_display(s_inp, 5); // INLINE_BLOCK
    css_set_rule_width(s_inp, 173);
    css_set_rule_border_width(s_inp, 1);
}
