package user.browser.timers

import std.time

// ============================================================================
// Epic 52: The Chronos Matrix (Zero-Allocation Timer Queue)
// ============================================================================

// Macrotasks queue (setTimeout, setInterval)
pub global TIMER_STATE:       [u8;  256] = [0; 256]; // 0 = FREE, 1 = ACTIVE
pub global TIMER_ID:          [u32; 256] = [0; 256];
pub global TIMER_TARGET_MS:   [u64; 256] = [0; 256];
pub global TIMER_INTERVAL_MS: [u32; 256] = [0; 256]; // 0 if setTimeout, >0 if setInterval
pub global TIMER_IS_INTERVAL: [u8;  256] = [0; 256];

// rAF Queue (cleared every frame)
pub global RAF_STATE: [u8; 256] = [0; 256]; // 0 = FREE, 1 = ACTIVE
pub global RAF_ID:    [u32; 256] = [0; 256];

// For testing purposes, we can mock the current time
pub global MOCK_TIME_MS: u64 = 0;
pub global USE_MOCK_TIME: u8 = 0;

pub fn get_current_ms() -> u64 {
    if USE_MOCK_TIME == 1 {
        return MOCK_TIME_MS;
    }
    return std.time.now_nanos() / 1000000;
}

@no_mangle
pub fn ext_timers_register(timer_id: u32, delay_ms: u32, is_interval: u8) -> i32 {
    let current_ms = get_current_ms();
    let mut i: u32 = 0;
    while i < 256 {
        let u_i = i as usize;
        if TIMER_STATE[u_i] == 0 {
            TIMER_ID[u_i] = timer_id;
            TIMER_TARGET_MS[u_i] = current_ms + (delay_ms as u64);
            if is_interval == 1 {
                TIMER_INTERVAL_MS[u_i] = delay_ms;
            } else {
                TIMER_INTERVAL_MS[u_i] = 0;
            }
            TIMER_IS_INTERVAL[u_i] = is_interval;
            TIMER_STATE[u_i] = 1;
            return i as i32;
        }
        i = i + 1;
    }
    return -1; // Queue Full
}

@no_mangle
pub fn ext_timers_clear(timer_id: u32) {
    let mut i: u32 = 0;
    while i < 256 {
        let u_i = i as usize;
        if TIMER_STATE[u_i] == 1 && TIMER_ID[u_i] == timer_id {
            TIMER_STATE[u_i] = 0; // Mark free
        }
        i = i + 1;
    }
}

@no_mangle
pub fn ext_raf_register(raf_id: u32) -> i32 {
    let mut i: u32 = 0;
    while i < 256 {
        let u_i = i as usize;
        if RAF_STATE[u_i] == 0 {
            RAF_ID[u_i] = raf_id;
            RAF_STATE[u_i] = 1;
            return i as i32;
        }
        i = i + 1;
    }
    return -1; // Queue Full
}

@no_mangle
pub fn ext_raf_cancel(raf_id: u32) {
    let mut i: u32 = 0;
    while i < 256 {
        let u_i = i as usize;
        if RAF_STATE[u_i] == 1 && RAF_ID[u_i] == raf_id {
            RAF_STATE[u_i] = 0;
        }
        i = i + 1;
    }
}

// Wrappers for JSC bindings
@no_mangle
pub fn ext_timers_add_timeout(delay_ms: u32, is_interval: u8) -> u32 {
    let mut i: u32 = 0;
    while i < 256 {
        let u_i = i as usize;
        if TIMER_STATE[u_i] == 0 {
            let timer_id = i + 1000;
            ext_timers_register(timer_id, delay_ms, is_interval);
            return timer_id;
        }
        i = i + 1;
    }
    return 0;
}

@no_mangle
pub fn ext_timers_add_raf() -> u32 {
    let mut i: u32 = 0;
    while i < 256 {
        let u_i = i as usize;
        if RAF_STATE[u_i] == 0 {
            let raf_id = i + 2000;
            ext_raf_register(raf_id);
            return raf_id;
        }
        i = i + 1;
    }
    return 0;
}

extern fn sys_js_execute_timer(timer_id: u32, is_interval: u8);
extern fn sys_js_execute_raf(r_id: u32, timestamp: f64);
extern fn sys_jsc_flush_microtasks();
extern fn http_get_eof_reached() -> u8;
extern fn get_pending_script_count() -> u32;
extern fn js_bridge_dispatch_document_event(type_ptr: u64, type_len: u32);
extern fn get_dom_content_loaded_fired() -> u8;
extern fn set_dom_content_loaded_fired(v: u8);

@no_mangle
pub fn js_engine_pump_tasks() {
    let current_ms = get_current_ms();
    let frame_time_float = (current_ms as f64);
    
    let mut t_i: u32 = 0;
    while t_i < 256 {
        let u_i = t_i as usize;
        if TIMER_STATE[u_i] == 1 && current_ms >= TIMER_TARGET_MS[u_i] {
            sys_js_execute_timer(TIMER_ID[u_i], TIMER_IS_INTERVAL[u_i]);
            if TIMER_IS_INTERVAL[u_i] == 1 {
                TIMER_TARGET_MS[u_i] = current_ms + (TIMER_INTERVAL_MS[u_i] as u64);
            } else {
                TIMER_STATE[u_i] = 0; 
            }
        }
        t_i = t_i + 1;
    }
    
    let mut r_i: u32 = 0;
    while r_i < 256 {
        if RAF_STATE[r_i as usize] == 1 {
            RAF_STATE[r_i as usize] = 2;
        }
        r_i = r_i + 1;
    }
    
    r_i = 0;
    while r_i < 256 {
        let u_i = r_i as usize;
        if RAF_STATE[u_i] == 2 {
            let raf_id = RAF_ID[u_i];
            RAF_STATE[u_i] = 0;
            sys_js_execute_raf(raf_id, frame_time_float);
        }
        r_i = r_i + 1;
    }
}

@no_mangle
pub fn js_engine_pump_microtasks() {
    sys_jsc_flush_microtasks();
    
    if http_get_eof_reached() == 1 && get_dom_content_loaded_fired() == 0 && get_pending_script_count() == 0 {
        set_dom_content_loaded_fired(1);
        let dcl_str: [u8; 16] = [68, 79, 77, 67, 111, 110, 116, 101, 110, 116, 76, 111, 97, 100, 101, 100];
        js_bridge_dispatch_document_event((&dcl_str) as u64, 16);
        sys_jsc_flush_microtasks();
    }
}
