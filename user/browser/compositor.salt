// ============================================================================
// Pointer Injection: CMD Array base addresses (injected at boot)
// Cross-module import resolves to wrong addresses; use runtime pointers.
// ============================================================================
global P_CMD_X: u64 = 0;
global P_CMD_Y: u64 = 0;
global P_CMD_W: u64 = 0;
global P_CMD_H: u64 = 0;
global P_CMD_UV_X: u64 = 0;
global P_CMD_UV_Y: u64 = 0;
global P_CMD_UV_W: u64 = 0;
global P_CMD_UV_H: u64 = 0;
global P_CMD_R: u64 = 0;
global P_CMD_G: u64 = 0;
global P_CMD_B: u64 = 0;
global P_CMD_A: u64 = 0;
global P_CMD_TYPE: u64 = 0;
global P_CMD_RAD: u64 = 0;
global P_CMD_SHADOW_R: u64 = 0;
global P_CMD_SHADOW_G: u64 = 0;
global P_CMD_SHADOW_B: u64 = 0;
global P_CMD_SHADOW_A: u64 = 0;
global P_CMD_SHADOW_X: u64 = 0;
global P_CMD_SHADOW_Y: u64 = 0;
global P_CMD_SHADOW_B_L: u64 = 0;
global P_CMD_SHADOW_S: u64 = 0;
global P_CMD_TX: u64 = 0;
global P_CMD_TY: u64 = 0;
global P_CMD_OPACITY: u64 = 0;
global P_CMD_NODE_ID: u64 = 0;

global SCROLL_Y: [f32; 1] = [0.0; 1];
pub global DOCUMENT_HEIGHT: i32 = 0;
pub global VIEWPORT_HEIGHT: i32 = 1080;

pub global KEY_BUF: [u8; 256] = [0; 256];

pub fn get_key_buf_ptr() -> u64 {
    return (&KEY_BUF) as u64;
}

@no_mangle
pub fn drain_keyboard_input() -> u32 {
    return facet_window_drain_keyboard((&KEY_BUF) as u64);
}

@no_mangle
pub fn decode_and_upload_image(bytes_ptr: u64, len: u32, out_w: u64, out_h: u64) -> i32 {
    let pixels = facet_image_decode(bytes_ptr, len as i32, out_w, out_h);
    if pixels == 0 {
        return -1;
    }
    let mut tex_w = *((out_w) as &i32);
    let mut tex_h = *((out_h) as &i32);
    let tex_id = facet_gpu_upload_image(pixels, tex_w, tex_h);
    facet_image_free(pixels);
    return tex_id;
}

pub fn evict_texture(node_idx: u32) {
    let tex_id = dom.DOM_NODE_TEXTURE_ID[node_idx as usize];
    if tex_id != 0xFFFFFFFF && tex_id != 0 {
        facet_gpu_free_texture(tex_id as i32);
        dom.DOM_NODE_FETCH_STATE[node_idx as usize] = 0; // IDLE natives beautifully dependably natives properly smoothly
        dom.DOM_NODE_TEXTURE_ID[node_idx as usize] = 0;
    }
}

pub fn drain_eviction_queue() {
    let mut i: u32 = 0;
    while i < dom.EVICTION_COUNT {
        let node_idx = dom.EVICTION_QUEUE[i as usize];
        evict_texture(node_idx);
        i = i + 1;
    }
    dom.EVICTION_COUNT = 0;
}

@no_mangle
pub fn load_font_atlas(pixels: u64, width: i32, height: i32) {
    facet_gpu_load_font_atlas(pixels, width, height);
}

// Pointer injection stub — called by app_main/main at boot.
// The committed code uses direct paint.CMD_X[i] access so this is a no-op,
// but the symbol must exist for the linker.
@no_mangle
pub fn compositor_inject_paint_pointers() {
    P_CMD_X = paint_ptr_CMD_X();
    P_CMD_Y = paint_ptr_CMD_Y();
    P_CMD_W = paint_ptr_CMD_W();
    P_CMD_H = paint_ptr_CMD_H();
    P_CMD_UV_X = paint_ptr_CMD_UV_X();
    P_CMD_UV_Y = paint_ptr_CMD_UV_Y();
    P_CMD_UV_W = paint_ptr_CMD_UV_W();
    P_CMD_UV_H = paint_ptr_CMD_UV_H();
    P_CMD_R = paint_ptr_CMD_R();
    P_CMD_G = paint_ptr_CMD_G();
    P_CMD_B = paint_ptr_CMD_B();
    P_CMD_A = paint_ptr_CMD_A();
    P_CMD_TYPE = paint_ptr_CMD_TYPE();
    P_CMD_RAD = paint_ptr_CMD_RAD();
    P_CMD_SHADOW_R = paint_ptr_CMD_SHADOW_R();
    P_CMD_SHADOW_G = paint_ptr_CMD_SHADOW_G();
    P_CMD_SHADOW_B = paint_ptr_CMD_SHADOW_B();
    P_CMD_SHADOW_A = paint_ptr_CMD_SHADOW_A();
    P_CMD_SHADOW_X = paint_ptr_CMD_SHADOW_X();
    P_CMD_SHADOW_Y = paint_ptr_CMD_SHADOW_Y();
    P_CMD_SHADOW_B_L = paint_ptr_CMD_SHADOW_B_L();
    P_CMD_SHADOW_S = paint_ptr_CMD_SHADOW_S();
    P_CMD_TX = paint_ptr_CMD_TX();
    P_CMD_TY = paint_ptr_CMD_TY();
    P_CMD_OPACITY = paint_ptr_CMD_OPACITY();
    P_CMD_NODE_ID = paint_ptr_CMD_NODE_ID();
}

pub fn window_init(width: i32, height: i32) {
    facet_window_init(width, height);
}

pub fn window_next_drawable() -> u64 {
    return facet_window_next_drawable();
}

pub fn window_pump_events() {
    facet_window_pump_events();
}

@no_mangle
pub fn drain_scroll_input() -> i32 {
    let delta = facet_window_get_scroll_delta();
    if delta != 0.0 {
        SCROLL_Y[0] = SCROLL_Y[0] - (delta * 20.0);
        if SCROLL_Y[0] < 0.0 {
            SCROLL_Y[0] = 0.0;
        }
        let max_scroll = (DOCUMENT_HEIGHT - VIEWPORT_HEIGHT) as f32;
        if max_scroll > 0.0 && SCROLL_Y[0] > max_scroll {
            SCROLL_Y[0] = max_scroll;
        }
        if max_scroll <= 0.0 {
            SCROLL_Y[0] = 0.0;
        }
    }
    return SCROLL_Y[0] as i32;
}

pub fn get_scroll_y() -> i32 {
    return SCROLL_Y[0] as i32;
}



@no_mangle
pub fn get_gpu_buffer_ptr() -> u64 {
    return paint_ptr_GPU_RECT_BUF();
}

pub fn trigger_hardware_compositor(canvas_ptr: u64, width: i32, height: i32) {
    let mut count = paint.get_z_sort_count();
    // [SEC-21] Clamp to GPU buffer capacity to prevent overflow
    if count > GPU_RECT_BUF_MAX_ENTRIES { count = GPU_RECT_BUF_MAX_ENTRIES; }
    
    let mut i: u32 = 0;
    while i < count {
        // Iterate primitives linearly, not by node ID, because paint.salt deposits them sequentially into CMD_X arrays
        let mut x = *((P_CMD_X + (i as u64) * 4) as &i32);
        let mut y = *((P_CMD_Y + (i as u64) * 4) as &i32);
        let mut w = *((P_CMD_W + (i as u64) * 4) as &i32);
        let mut h = *((P_CMD_H + (i as u64) * 4) as &i32);
        let mut uv_x = *((P_CMD_UV_X + (i as u64) * 4) as &f32);
        let mut uv_y = *((P_CMD_UV_Y + (i as u64) * 4) as &f32);
        let mut uv_w = *((P_CMD_UV_W + (i as u64) * 4) as &f32);
        let mut uv_h = *((P_CMD_UV_H + (i as u64) * 4) as &f32);
        let type_flag = *((P_CMD_TYPE + (i as u64)) as &u8); // 0 = Rect, 1 = Glyph, 2 = Image
        
        let r = *((P_CMD_R + (i as u64)) as &u8);
        let g = *((P_CMD_G + (i as u64)) as &u8);
        let b = *((P_CMD_B + (i as u64)) as &u8);
        let a = *((P_CMD_A + (i as u64)) as &u8);
        
        let br = *((P_CMD_RAD + (i as u64) * 4) as &f32);
        let sr = *((P_CMD_SHADOW_R + (i as u64)) as &u8);
        let sg = *((P_CMD_SHADOW_G + (i as u64)) as &u8);
        let sb = *((P_CMD_SHADOW_B + (i as u64)) as &u8);
        let sa = *((P_CMD_SHADOW_A + (i as u64)) as &u8);
        let s_x = *((P_CMD_SHADOW_X + (i as u64) * 4) as &f32);
        let s_y = *((P_CMD_SHADOW_Y + (i as u64) * 4) as &f32);
        let s_b = *((P_CMD_SHADOW_B_L + (i as u64) * 4) as &f32);
        let s_s = *((P_CMD_SHADOW_S + (i as u64) * 4) as &f32);
        
        let color_u32 = ((r as u32) << 24) | ((g as u32) << 16) | ((b as u32) << 8) | (a as u32);
        let shadow_color_u32 = ((sr as u32) << 24) | ((sg as u32) << 16) | ((sb as u32) << 8) | (sa as u32);
        
        let offset = i * GPU_RECT_BUF_STRIDE;
        // [SEC-21] Bounds check: ensure write does not exceed GPU_RECT_BUF
        if (offset + GPU_RECT_BUF_STRIDE) as u32 > GPU_RECT_BUF_SIZE { break; }
        let buf_ptr = paint_ptr_GPU_RECT_BUF();
        
        *((buf_ptr + (offset as u64)) as &mut f32) = (x as f32);
        *((buf_ptr + (offset as u64) + 4) as &mut f32) = (y as f32);
        *((buf_ptr + (offset as u64) + 8) as &mut f32) = (w as f32);
        *((buf_ptr + (offset as u64) + 12) as &mut f32) = (h as f32);
        *((buf_ptr + (offset as u64) + 16) as &mut f32) = uv_x;
        *((buf_ptr + (offset as u64) + 20) as &mut f32) = uv_y;
        *((buf_ptr + (offset as u64) + 24) as &mut f32) = uv_w;
        *((buf_ptr + (offset as u64) + 28) as &mut f32) = uv_h;
        *((buf_ptr + (offset as u64) + 32) as &mut u32) = color_u32;
        *((buf_ptr + (offset as u64) + 36) as &mut u32) = (type_flag as u32);
        *((buf_ptr + (offset as u64) + 40) as &mut f32) = br;
        *((buf_ptr + (offset as u64) + 44) as &mut u32) = shadow_color_u32;
        *((buf_ptr + (offset as u64) + 48) as &mut f32) = s_x;
        *((buf_ptr + (offset as u64) + 52) as &mut f32) = s_y;
        *((buf_ptr + (offset as u64) + 56) as &mut f32) = s_b;
        *((buf_ptr + (offset as u64) + 60) as &mut f32) = s_s;
        let node_id = *((P_CMD_NODE_ID + (i as u64) * 4) as &u32);
        let anim_tx = animations.COMPOSITOR_TRANSFORM_X[node_id as usize];
        let anim_op = animations.COMPOSITOR_OPACITY[node_id as usize];

        *((buf_ptr + (offset as u64) + 64) as &mut f32) = *((P_CMD_TX + (i as u64) * 4) as &f32) + anim_tx;
        *((buf_ptr + (offset as u64) + 68) as &mut f32) = *((P_CMD_TY + (i as u64) * 4) as &f32);
        *((buf_ptr + (offset as u64) + 72) as &mut f32) = *((P_CMD_OPACITY + (i as u64) * 4) as &f32) * anim_op;
        *((buf_ptr + (offset as u64) + 76) as &mut f32) = 0.0; // pad
        
        i = i + 1;
    }
    
    let rects_ptr = paint_ptr_GPU_RECT_BUF();
    facet_gpu_rasterize_primitives(canvas_ptr, rects_ptr, width, height, count as i32, SCROLL_Y[0]);
}

@no_mangle
pub fn trigger_e2e_compositor(out_buffer_ptr: u64, width: i32, height: i32) {
    let mut count = paint.get_cmd_count();
    // [SEC-21] Clamp to GPU buffer capacity to prevent overflow
    if count > GPU_RECT_BUF_MAX_ENTRIES { count = GPU_RECT_BUF_MAX_ENTRIES; }
    let mut i: u32 = 0;
    while i < count {
        let mut x = *((P_CMD_X + (i as u64) * 4) as &i32);
        let mut y = *((P_CMD_Y + (i as u64) * 4) as &i32);
        let mut w = *((P_CMD_W + (i as u64) * 4) as &i32);
        let mut h = *((P_CMD_H + (i as u64) * 4) as &i32);
        let mut uv_x = *((P_CMD_UV_X + (i as u64) * 4) as &f32);
        let mut uv_y = *((P_CMD_UV_Y + (i as u64) * 4) as &f32);
        let mut uv_w = *((P_CMD_UV_W + (i as u64) * 4) as &f32);
        let mut uv_h = *((P_CMD_UV_H + (i as u64) * 4) as &f32);
        let type_flag = *((P_CMD_TYPE + (i as u64)) as &u8);
        
        let r = *((P_CMD_R + (i as u64)) as &u8);
        let g = *((P_CMD_G + (i as u64)) as &u8);
        let b = *((P_CMD_B + (i as u64)) as &u8);
        let a = *((P_CMD_A + (i as u64)) as &u8);
        
        let color_u32 = ((r as u32) << 24) | ((g as u32) << 16) | ((b as u32) << 8) | (a as u32);
        
        let offset = i * GPU_RECT_BUF_STRIDE;
        // [SEC-21] Bounds check: ensure write does not exceed GPU_RECT_BUF
        if (offset + GPU_RECT_BUF_STRIDE) as u32 > GPU_RECT_BUF_SIZE { break; }
        let buf_ptr = paint_ptr_GPU_RECT_BUF();
        
        *((buf_ptr + (offset as u64)) as &mut f32) = (x as f32);
        *((buf_ptr + (offset as u64) + 4) as &mut f32) = (y as f32);
        *((buf_ptr + (offset as u64) + 8) as &mut f32) = (w as f32);
        *((buf_ptr + (offset as u64) + 12) as &mut f32) = (h as f32);
        *((buf_ptr + (offset as u64) + 16) as &mut f32) = uv_x;
        *((buf_ptr + (offset as u64) + 20) as &mut f32) = uv_y;
        *((buf_ptr + (offset as u64) + 24) as &mut f32) = uv_w;
        *((buf_ptr + (offset as u64) + 28) as &mut f32) = uv_h;
        *((buf_ptr + (offset as u64) + 32) as &mut u32) = color_u32;
        *((buf_ptr + (offset as u64) + 36) as &mut u32) = (type_flag as u32);
        *((buf_ptr + (offset as u64) + 64) as &mut f32) = *((P_CMD_TX + (i as u64) * 4) as &f32);
        *((buf_ptr + (offset as u64) + 68) as &mut f32) = *((P_CMD_TY + (i as u64) * 4) as &f32);
        *((buf_ptr + (offset as u64) + 72) as &mut f32) = *((P_CMD_OPACITY + (i as u64) * 4) as &f32);
        
        i = i + 1;
    }
    
    let rects_ptr = paint_ptr_GPU_RECT_BUF();
    facet_gpu_render_to_buffer(out_buffer_ptr, rects_ptr, width, height, count as i32, 0.0);
}

@no_mangle
pub fn flush_frame(width: i32, height: i32) {
    let mut count = paint.get_cmd_count();
    // [SEC-21] Clamp to GPU buffer capacity to prevent overflow
    if count > GPU_RECT_BUF_MAX_ENTRIES { count = GPU_RECT_BUF_MAX_ENTRIES; }
    
    if count == 0 { return; }
    // Pack SoA paint commands into packed GPU rect buffer
    let mut i: u32 = 0;
    while i < count {
        let cx = *((P_CMD_X + (i as u64) * 4) as &i32);
        let cy = *((P_CMD_Y + (i as u64) * 4) as &i32);
        let cw = *((P_CMD_W + (i as u64) * 4) as &i32);
        let ch = *((P_CMD_H + (i as u64) * 4) as &i32);
        
        let r = *((P_CMD_R + (i as u64)) as &u8);
        let g = *((P_CMD_G + (i as u64)) as &u8);
        let b = *((P_CMD_B + (i as u64)) as &u8);
        let a = *((P_CMD_A + (i as u64)) as &u8);
        
        let br = *((P_CMD_RAD + (i as u64) * 4) as &f32);
        let sr = *((P_CMD_SHADOW_R + (i as u64)) as &u8);
        let sg = *((P_CMD_SHADOW_G + (i as u64)) as &u8);
        let sb = *((P_CMD_SHADOW_B + (i as u64)) as &u8);
        let sa = *((P_CMD_SHADOW_A + (i as u64)) as &u8);
        let s_x = *((P_CMD_SHADOW_X + (i as u64) * 4) as &f32);
        let s_y = *((P_CMD_SHADOW_Y + (i as u64) * 4) as &f32);
        let s_b = *((P_CMD_SHADOW_B_L + (i as u64) * 4) as &f32);
        let s_s = *((P_CMD_SHADOW_S + (i as u64) * 4) as &f32);
        
        let color_u32 = ((r as u32) << 24) | ((g as u32) << 16) | ((b as u32) << 8) | (a as u32);
        let shadow_color_u32 = ((sr as u32) << 24) | ((sg as u32) << 16) | ((sb as u32) << 8) | (sa as u32);
        
        let offset = i * GPU_RECT_BUF_STRIDE;
        // [SEC-21] Bounds check: ensure write does not exceed GPU_RECT_BUF
        if (offset + GPU_RECT_BUF_STRIDE) as u32 > GPU_RECT_BUF_SIZE { break; }
        let bptr = paint_ptr_GPU_RECT_BUF();
        
        *((bptr + (offset as u64)) as &mut f32) = cx as f32;
        *((bptr + (offset as u64) + 4) as &mut f32) = cy as f32;
        *((bptr + (offset as u64) + 8) as &mut f32) = cw as f32;
        *((bptr + (offset as u64) + 12) as &mut f32) = ch as f32;
        *((bptr + (offset as u64) + 16) as &mut f32) = *((P_CMD_UV_X + (i as u64) * 4) as &f32);
        *((bptr + (offset as u64) + 20) as &mut f32) = *((P_CMD_UV_Y + (i as u64) * 4) as &f32);
        *((bptr + (offset as u64) + 24) as &mut f32) = *((P_CMD_UV_W + (i as u64) * 4) as &f32);
        *((bptr + (offset as u64) + 28) as &mut f32) = *((P_CMD_UV_H + (i as u64) * 4) as &f32);
        
        *((bptr + (offset as u64) + 32) as &mut u32) = color_u32;
        
        let ctype = *((P_CMD_TYPE + (i as u64)) as &u8);
        *((bptr + (offset as u64) + 36) as &mut u32) = ctype as u32;
        
        *((bptr + (offset as u64) + 40) as &mut f32) = br;
        *((bptr + (offset as u64) + 44) as &mut u32) = shadow_color_u32;
        
        *((bptr + (offset as u64) + 48) as &mut f32) = s_x;
        *((bptr + (offset as u64) + 52) as &mut f32) = s_y;
        *((bptr + (offset as u64) + 56) as &mut f32) = s_b;
        *((bptr + (offset as u64) + 60) as &mut f32) = s_s;
        *((bptr + (offset as u64) + 64) as &mut f32) = *((P_CMD_TX + (i as u64) * 4) as &f32);
        *((bptr + (offset as u64) + 68) as &mut f32) = *((P_CMD_TY + (i as u64) * 4) as &f32);
        *((bptr + (offset as u64) + 72) as &mut f32) = *((P_CMD_OPACITY + (i as u64) * 4) as &f32);
        *((bptr + (offset as u64) + 76) as &mut f32) = 0.0; // pad
        
        i = i + 1;
    }
    
    let rects_ptr = paint_ptr_GPU_RECT_BUF();
    
    let ios_mode = sys_gpu_is_iosurface_mode();
    if ios_mode == 1 {
        // Multi-Process: Render to IOSurface, signal Main Process
        sys_gpu_rasterize_iosurface(rects_ptr, width, height, count as i32, SCROLL_Y[0]);
        sys_gpu_commit_iosurface();
    } else {
        // Single-Process: Render directly to window drawable
        let drawable = facet_window_next_drawable();
        if drawable != 0 {
            facet_gpu_rasterize_primitives(drawable, rects_ptr, width, height, count as i32, SCROLL_Y[0]);
        }
    }
}
