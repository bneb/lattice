package user.browser.compositor

import user.browser.paint
import user.browser.dom
import user.browser.animations

extern fn facet_gpu_rasterize_primitives(native_drawable: u64, rects: u64, width: i32, height: i32, rect_count: i32, scroll_y: f32);
extern fn facet_gpu_render_to_buffer(out_buffer: u64, rects: u64, width: i32, height: i32, rect_count: i32, scroll_y: f32);
extern fn facet_gpu_load_font_atlas(pixels: u64, width: i32, height: i32);
extern fn facet_gpu_free_texture(tex_idx: i32);
extern fn facet_gpu_upload_image(rgba: u64, width: i32, height: i32) -> i32;
extern fn facet_image_decode(bytes: u64, len: i32, out_w: u64, out_h: u64) -> u64;
extern fn facet_image_free(pixels: u64);

extern fn facet_window_init(width: i32, height: i32);
extern fn facet_window_next_drawable() -> u64;
extern fn facet_window_pump_events();
extern fn facet_window_get_scroll_delta() -> f32;
extern fn facet_window_drain_keyboard(target: u64) -> u32;

// Epic 68: IOSurface Multi-Process Mode
pub global COMPOSITOR_SCROLL_Y: [f32; 1] = [0.0; 1];

@no_mangle
pub fn compositor_get_rect_buf_ptr() -> u64 {
    return (&GPU_RECT_BUF) as u64;
}

@no_mangle
pub fn compositor_get_rect_count() -> i32 {
    return paint.get_z_sort_count() as i32;
}

@no_mangle
pub fn compositor_get_scroll_y() -> f32 {
    return COMPOSITOR_SCROLL_Y[0];
}

@no_mangle
pub fn sys_flag_gpu_redraw() {
    // Signals that the compositor should wake up (handled by CVDisplayLink naturally)
}
extern fn sys_gpu_is_iosurface_mode() -> i32;
extern fn sys_gpu_rasterize_iosurface(rects: u64, width: i32, height: i32, rect_count: i32, scroll_y: f32);
extern fn sys_gpu_commit_iosurface();

global SCROLL_Y: [f32; 1] = [0.0; 1];
pub global DOCUMENT_HEIGHT: i32 = 0;
pub global VIEWPORT_HEIGHT: i32 = 1080;

pub global KEY_BUF: [u8; 256] = [0; 256];

pub fn get_key_buf_ptr() -> u64 {
    return (&KEY_BUF) as u64;
}

pub fn drain_keyboard_input() -> u32 {
    return facet_window_drain_keyboard((&KEY_BUF) as u64);
}

pub fn decode_and_upload_image(bytes_ptr: u64, len: u32, out_w: u64, out_h: u64) -> i32 {
    let pixels = facet_image_decode(bytes_ptr, len as i32, out_w, out_h);
    if pixels == 0 {
        return -1;
    }
    let mut tex_w = *((out_w) as &i32);
    let mut tex_h = *((out_h) as &i32);
    let tex_id = facet_gpu_upload_image(pixels, tex_w, tex_h);
    facet_image_free(pixels);
    return tex_id;
}

pub fn evict_texture(node_idx: u32) {
    let tex_id = dom.DOM_NODE_TEXTURE_ID[node_idx as usize];
    if tex_id != 0xFFFFFFFF && tex_id != 0 {
        facet_gpu_free_texture(tex_id as i32);
        dom.DOM_NODE_FETCH_STATE[node_idx as usize] = 0; // IDLE natively beautifully dependably natively properly smoothly
        dom.DOM_NODE_TEXTURE_ID[node_idx as usize] = 0;
    }
}

pub fn drain_eviction_queue() {
    let mut i: u32 = 0;
    while i < dom.EVICTION_COUNT {
        let node_idx = dom.EVICTION_QUEUE[i as usize];
        evict_texture(node_idx);
        i = i + 1;
    }
    dom.EVICTION_COUNT = 0;
}

pub fn load_font_atlas(pixels: u64, width: i32, height: i32) {
    facet_gpu_load_font_atlas(pixels, width, height);
}

pub fn window_init(width: i32, height: i32) {
    facet_window_init(width, height);
}

pub fn window_next_drawable() -> u64 {
    return facet_window_next_drawable();
}

pub fn window_pump_events() {
    facet_window_pump_events();
}

@no_mangle
pub fn drain_scroll_input() -> i32 {
    let delta = facet_window_get_scroll_delta();
    if delta != 0.0 {
        SCROLL_Y[0] = SCROLL_Y[0] - (delta * 20.0);
        if SCROLL_Y[0] < 0.0 {
            SCROLL_Y[0] = 0.0;
        }
        let max_scroll = (DOCUMENT_HEIGHT - VIEWPORT_HEIGHT) as f32;
        if max_scroll > 0.0 && SCROLL_Y[0] > max_scroll {
            SCROLL_Y[0] = max_scroll;
        }
        if max_scroll <= 0.0 {
            SCROLL_Y[0] = 0.0;
        }
    }
    return SCROLL_Y[0] as i32;
}

pub fn get_scroll_y() -> i32 {
    return SCROLL_Y[0] as i32;
}

pub global GPU_RECT_BUF: [u8; 655360] = [0; 655360]; // 8192 * 80 bytes

@no_mangle
pub fn get_gpu_buffer_ptr() -> u64 {
    return (&GPU_RECT_BUF) as u64;
}

pub fn trigger_hardware_compositor(canvas_ptr: u64, width: i32, height: i32) {
    let count = paint.get_z_sort_count();
    
    let mut i: u32 = 0;
    while i < count {
        // Iterate primitives linearly, not by node ID, because paint.salt deposits them sequentially into CMD_X arrays
        let mut x = paint.CMD_X[i as usize];
        let mut y = paint.CMD_Y[i as usize];
        let mut w = paint.CMD_W[i as usize];
        let mut h = paint.CMD_H[i as usize];
        let mut uv_x = paint.CMD_UV_X[i as usize];
        let mut uv_y = paint.CMD_UV_Y[i as usize];
        let mut uv_w = paint.CMD_UV_W[i as usize];
        let mut uv_h = paint.CMD_UV_H[i as usize];
        let type_flag = paint.CMD_TYPE[i as usize]; // 0 = Rect, 1 = Glyph, 2 = Image
        
        let r = paint.CMD_R[i as usize];
        let g = paint.CMD_G[i as usize];
        let b = paint.CMD_B[i as usize];
        let a = paint.CMD_A[i as usize];
        
        let br = paint.CMD_RAD[i as usize];
        let sr = paint.CMD_SHADOW_R[i as usize];
        let sg = paint.CMD_SHADOW_G[i as usize];
        let sb = paint.CMD_SHADOW_B[i as usize];
        let sa = paint.CMD_SHADOW_A[i as usize];
        let s_x = paint.CMD_SHADOW_X[i as usize];
        let s_y = paint.CMD_SHADOW_Y[i as usize];
        let s_b = paint.CMD_SHADOW_B_L[i as usize];
        let s_s = paint.CMD_SHADOW_S[i as usize];
        
        let color_u32 = ((r as u32) << 24) | ((g as u32) << 16) | ((b as u32) << 8) | (a as u32);
        let shadow_color_u32 = ((sr as u32) << 24) | ((sg as u32) << 16) | ((sb as u32) << 8) | (sa as u32);
        
        let offset = i * 80;
        let buf_ptr = (&GPU_RECT_BUF) as u64;
        
        *((buf_ptr + (offset as u64)) as &mut f32) = (x as f32);
        *((buf_ptr + (offset as u64) + 4) as &mut f32) = (y as f32);
        *((buf_ptr + (offset as u64) + 8) as &mut f32) = (w as f32);
        *((buf_ptr + (offset as u64) + 12) as &mut f32) = (h as f32);
        *((buf_ptr + (offset as u64) + 16) as &mut f32) = uv_x;
        *((buf_ptr + (offset as u64) + 20) as &mut f32) = uv_y;
        *((buf_ptr + (offset as u64) + 24) as &mut f32) = uv_w;
        *((buf_ptr + (offset as u64) + 28) as &mut f32) = uv_h;
        *((buf_ptr + (offset as u64) + 32) as &mut u32) = color_u32;
        *((buf_ptr + (offset as u64) + 36) as &mut u32) = (type_flag as u32);
        *((buf_ptr + (offset as u64) + 40) as &mut f32) = br;
        *((buf_ptr + (offset as u64) + 44) as &mut u32) = shadow_color_u32;
        *((buf_ptr + (offset as u64) + 48) as &mut f32) = s_x;
        *((buf_ptr + (offset as u64) + 52) as &mut f32) = s_y;
        *((buf_ptr + (offset as u64) + 56) as &mut f32) = s_b;
        *((buf_ptr + (offset as u64) + 60) as &mut f32) = s_s;
        let node_id = paint.CMD_NODE_ID[i as usize];
        let anim_tx = animations.COMPOSITOR_TRANSFORM_X[node_id as usize];
        let anim_op = animations.COMPOSITOR_OPACITY[node_id as usize];

        *((buf_ptr + (offset as u64) + 64) as &mut f32) = paint.CMD_TX[i as usize] + anim_tx;
        *((buf_ptr + (offset as u64) + 68) as &mut f32) = paint.CMD_TY[i as usize];
        *((buf_ptr + (offset as u64) + 72) as &mut f32) = paint.CMD_OPACITY[i as usize] * anim_op;
        *((buf_ptr + (offset as u64) + 76) as &mut f32) = 0.0; // pad
        
        i = i + 1;
    }
    
    let rects_ptr = (&GPU_RECT_BUF) as u64;
    facet_gpu_rasterize_primitives(canvas_ptr, rects_ptr, width, height, count as i32, SCROLL_Y[0]);
}

@no_mangle
pub fn trigger_e2e_compositor(out_buffer_ptr: u64, width: i32, height: i32) {
    let count = paint.get_cmd_count();
    
    let mut i: u32 = 0;
    while i < count {
        let mut x = paint.CMD_X[i as usize];
        let mut y = paint.CMD_Y[i as usize];
        let mut w = paint.CMD_W[i as usize];
        let mut h = paint.CMD_H[i as usize];
        let mut uv_x = paint.CMD_UV_X[i as usize];
        let mut uv_y = paint.CMD_UV_Y[i as usize];
        let mut uv_w = paint.CMD_UV_W[i as usize];
        let mut uv_h = paint.CMD_UV_H[i as usize];
        let type_flag = paint.CMD_TYPE[i as usize];
        
        let r = paint.CMD_R[i as usize];
        let g = paint.CMD_G[i as usize];
        let b = paint.CMD_B[i as usize];
        let a = paint.CMD_A[i as usize];
        
        let color_u32 = ((r as u32) << 24) | ((g as u32) << 16) | ((b as u32) << 8) | (a as u32);
        
        let offset = i * 80;
        let buf_ptr = (&GPU_RECT_BUF) as u64;
        
        *((buf_ptr + (offset as u64)) as &mut f32) = (x as f32);
        *((buf_ptr + (offset as u64) + 4) as &mut f32) = (y as f32);
        *((buf_ptr + (offset as u64) + 8) as &mut f32) = (w as f32);
        *((buf_ptr + (offset as u64) + 12) as &mut f32) = (h as f32);
        *((buf_ptr + (offset as u64) + 16) as &mut f32) = uv_x;
        *((buf_ptr + (offset as u64) + 20) as &mut f32) = uv_y;
        *((buf_ptr + (offset as u64) + 24) as &mut f32) = uv_w;
        *((buf_ptr + (offset as u64) + 28) as &mut f32) = uv_h;
        *((buf_ptr + (offset as u64) + 32) as &mut u32) = color_u32;
        *((buf_ptr + (offset as u64) + 36) as &mut u32) = (type_flag as u32);
        *((buf_ptr + (offset as u64) + 64) as &mut f32) = paint.CMD_TX[i as usize];
        *((buf_ptr + (offset as u64) + 68) as &mut f32) = paint.CMD_TY[i as usize];
        *((buf_ptr + (offset as u64) + 72) as &mut f32) = paint.CMD_OPACITY[i as usize];
        
        i = i + 1;
    }
    
    let rects_ptr = (&GPU_RECT_BUF) as u64;
    facet_gpu_render_to_buffer(out_buffer_ptr, rects_ptr, width, height, count as i32, 0.0);
}

// ═══════════════════════════════════════════════════════════
// Epic 68: Unified Frame Flush
// Packs all paint commands → dispatches to IOSurface or Window
// ═══════════════════════════════════════════════════════════

@no_mangle
pub fn flush_frame(width: i32, height: i32) {
    let count = paint.get_cmd_count();
    if count == 0 { return; }
    
    // Pack SoA paint commands into packed GPU rect buffer
    let mut i: u32 = 0;
    while i < count {
        let r = paint.CMD_R[i as usize];
        let g = paint.CMD_G[i as usize];
        let b = paint.CMD_B[i as usize];
        let a = paint.CMD_A[i as usize];
        
        let br = paint.CMD_RAD[i as usize];
        let sr = paint.CMD_SHADOW_R[i as usize];
        let sg = paint.CMD_SHADOW_G[i as usize];
        let sb = paint.CMD_SHADOW_B[i as usize];
        let sa = paint.CMD_SHADOW_A[i as usize];
        let s_x = paint.CMD_SHADOW_X[i as usize];
        let s_y = paint.CMD_SHADOW_Y[i as usize];
        let s_b = paint.CMD_SHADOW_B_L[i as usize];
        let s_s = paint.CMD_SHADOW_S[i as usize];
        
        let color_u32 = ((r as u32) << 24) | ((g as u32) << 16) | ((b as u32) << 8) | (a as u32);
        let shadow_color_u32 = ((sr as u32) << 24) | ((sg as u32) << 16) | ((sb as u32) << 8) | (sa as u32);
        
        let offset = i * 80;
        let buf_ptr = (&GPU_RECT_BUF) as u64;
        
        *((buf_ptr + (offset as u64)) as &mut f32) = (paint.CMD_X[i as usize] as f32);
        *((buf_ptr + (offset as u64) + 4) as &mut f32) = (paint.CMD_Y[i as usize] as f32);
        *((buf_ptr + (offset as u64) + 8) as &mut f32) = (paint.CMD_W[i as usize] as f32);
        *((buf_ptr + (offset as u64) + 12) as &mut f32) = (paint.CMD_H[i as usize] as f32);
        *((buf_ptr + (offset as u64) + 16) as &mut f32) = paint.CMD_UV_X[i as usize];
        *((buf_ptr + (offset as u64) + 20) as &mut f32) = paint.CMD_UV_Y[i as usize];
        *((buf_ptr + (offset as u64) + 24) as &mut f32) = paint.CMD_UV_W[i as usize];
        *((buf_ptr + (offset as u64) + 28) as &mut f32) = paint.CMD_UV_H[i as usize];
        *((buf_ptr + (offset as u64) + 32) as &mut u32) = color_u32;
        *((buf_ptr + (offset as u64) + 36) as &mut u32) = (paint.CMD_TYPE[i as usize] as u32);
        *((buf_ptr + (offset as u64) + 40) as &mut f32) = br;
        *((buf_ptr + (offset as u64) + 44) as &mut u32) = shadow_color_u32;
        *((buf_ptr + (offset as u64) + 48) as &mut f32) = s_x;
        *((buf_ptr + (offset as u64) + 52) as &mut f32) = s_y;
        *((buf_ptr + (offset as u64) + 56) as &mut f32) = s_b;
        *((buf_ptr + (offset as u64) + 60) as &mut f32) = s_s;
        *((buf_ptr + (offset as u64) + 64) as &mut f32) = paint.CMD_TX[i as usize];
        *((buf_ptr + (offset as u64) + 68) as &mut f32) = paint.CMD_TY[i as usize];
        *((buf_ptr + (offset as u64) + 72) as &mut f32) = paint.CMD_OPACITY[i as usize];
        *((buf_ptr + (offset as u64) + 76) as &mut f32) = 0.0; // pad
        
        i = i + 1;
    }
    
    let rects_ptr = (&GPU_RECT_BUF) as u64;
    
    if sys_gpu_is_iosurface_mode() == 1 {
        // Multi-Process: Render to IOSurface, signal Main Process
        sys_gpu_rasterize_iosurface(rects_ptr, width, height, count as i32, SCROLL_Y[0]);
        sys_gpu_commit_iosurface();
    } else {
        // Single-Process: Render directly to window drawable
        let drawable = facet_window_next_drawable();
        if drawable != 0 {
            facet_gpu_rasterize_primitives(drawable, rects_ptr, width, height, count as i32, SCROLL_Y[0]);
        }
    }
}
