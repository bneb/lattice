// ============================================================================
// Pointer Injection Matrix — Canonical Array Address Exports
// These @no_mangle functions return the base pointer of each canonical SoA
// array. Consumer modules (layout.salt, paint.salt) call these ONCE at boot
// to store local pointer globals, bypassing Salt's module global duplication.
// ============================================================================

// Layout outputs (i32, stride 4)
@no_mangle pub fn dom_ptr_LAYOUT_X() -> u64 { return (&LAYOUT_X) as u64; }
@no_mangle pub fn dom_ptr_LAYOUT_Y() -> u64 { return (&LAYOUT_Y) as u64; }
@no_mangle pub fn dom_ptr_LAYOUT_W() -> u64 { return (&LAYOUT_W) as u64; }
@no_mangle pub fn dom_ptr_LAYOUT_H() -> u64 { return (&LAYOUT_H) as u64; }

