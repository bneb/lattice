// Struct-of-Arrays (SoA) Layout
pub global DOM_NODE_TAG:           [u32; 65536] = [0; 65536];
pub global DOM_NODE_PARENT:        [u64; 65536] = [0; 65536];
pub global DOM_NODE_FIRST_CHILD:   [u64; 65536] = [0; 65536];
pub global DOM_SHADOW_ROOT:        [u64; 65536] = [0; 65536];
pub global DOM_NODE_NEXT_SIBLING:  [u64; 65536] = [0; 65536];
// Epic 54: The Reconciliation FFI (Doubly-Linked)
pub global DOM_NODE_PREV_SIBLING:  [u64; 65536] = [0; 65536];
pub global DOM_LAST_CHILD:         [u32; 65536] = [0; 65536];

pub global DOM_TEXT_PTR:           [u64; 65536] = [0; 65536];
pub global DOM_TEXT_LEN:           [u32; 65536] = [0; 65536];

// Epic 37: The Contiguous Monolith (10MB String Memory Arena)
pub global DOM_TEXT_ARENA:         [u8; 10485760] = [0; 10485760];
pub global DOM_TEXT_CURSOR:        u32 = 0;
pub global ACTIVE_CURSOR_INDEX:    u32 = 0;

@no_mangle
pub fn dom_alloc_text(len: u32) -> u64 {
    let current = DOM_TEXT_CURSOR;
    if current + len > 10485760 {
        return 0; // Arena exhausted
    }
    DOM_TEXT_CURSOR = DOM_TEXT_CURSOR + len;
    return (&DOM_TEXT_ARENA) as u64 + (current as u64);
}

