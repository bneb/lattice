// Styling Matrix (SoA)
pub global DIRTY_LAYOUT: [u8; 65536] = [1; 65536]; 
pub global DIRTY_PAINT: [u8; 65536] = [1; 65536]; 
pub global DIRTY_STYLE: [u8; 65536] = [0; 65536]; 
pub global COMPOSITOR_DIRTY: [u8; 65536] = [0; 65536];

@no_mangle
pub fn dom_clear_dirty_flags() {
    let mut i: u32 = 0;
    while i < 65536 {
        DIRTY_LAYOUT[i as usize] = 0;
        DIRTY_PAINT[i as usize] = 0;
        i = i + 1;
    }
}

// Epic 48: Upward Propagation — bubbles DIRTY_LAYOUT from mutated node to root.

@no_mangle
pub fn invalidate_layout(mut node_id: u32) {
    while node_id != 999999 {
        let parent = STYLE_PARENT[node_id as usize];
        
        if DIRTY_LAYOUT[node_id as usize] == 1 { return; } 
        DIRTY_LAYOUT[node_id as usize] = 1;
        DIRTY_PAINT[node_id as usize] = 1; 
        COMPOSITOR_DIRTY[node_id as usize] = 1;
        
        if parent == node_id { break; }
        node_id = parent;
    }
}

// Mark ALL nodes dirty — used after batch DOM creation (HTML lexer)
@no_mangle
pub fn invalidate_all_layout() {
    let limit = get_dom_node_count();
    let mut i: u64 = 1;
    while i < limit {
        DIRTY_LAYOUT[i as usize] = 1;
        DIRTY_PAINT[i as usize] = 1;
        COMPOSITOR_DIRTY[i as usize] = 1;
        i = i + 1;
    }
}

@no_mangle
pub fn invalidate_paint(node_id: u32) {
    if node_id != 0 {
        DIRTY_PAINT[node_id as usize] = 1;
    }
}

