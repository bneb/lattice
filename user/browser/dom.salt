// ============================================================================
// Epic 53: The Dynamic Cascade
// ============================================================================
extern fn apply_rules_to_node(idx: u32);

@no_mangle
pub fn recompute_style(node_id: u32) {
    let u_i = node_id as usize;
    if DIRTY_STYLE[u_i] == 0 { return; }
    
    // 1. Snapshot previous geometric boundaries
    let old_display = STYLE_DISPLAY[u_i];
    let old_width = STYLE_W[u_i];
    let old_height = STYLE_H[u_i];
    let old_flex_dir = STYLE_FLEX_DIR[u_i];
    let old_flex_grow = STYLE_FLEX_GROW[u_i];
    let old_position = STYLE_POSITION[u_i];
    let old_top = STYLE_TOP[u_i];
    let old_right = STYLE_RIGHT[u_i];
    let old_bottom = STYLE_BOTTOM[u_i];
    let old_left = STYLE_LEFT[u_i];
    
    // 2. Clear current non-inline styles and re-evaluate global CSS rules
    STYLE_SPEC_DISPLAY[u_i] = 0;
    STYLE_SPEC_WIDTH[u_i] = 0;
    STYLE_SPEC_HEIGHT[u_i] = 0;
    STYLE_SPEC_FLEX_DIR[u_i] = 0;
    STYLE_SPEC_FLEX_GROW[u_i] = 0;
    STYLE_SPEC_BG[u_i] = 0;
    STYLE_SPEC_COLOR[u_i] = 0;
    STYLE_SPEC_POSITION[u_i] = 0;
    STYLE_SPEC_TOP[u_i] = 0;
    STYLE_SPEC_RIGHT[u_i] = 0;
    STYLE_SPEC_BOTTOM[u_i] = 0;
    STYLE_SPEC_LEFT[u_i] = 0;
    STYLE_SPEC_Z_INDEX[u_i] = 0;
    
    // Reset defaults before re-cascade
    STYLE_DISPLAY[u_i] = 1;
    STYLE_W[u_i] = -1;
    STYLE_H[u_i] = -1;
    STYLE_FLEX_DIR[u_i] = 0;
    STYLE_FLEX_GROW[u_i] = 0;
    STYLE_POSITION[u_i] = 0; // static
    STYLE_TOP[u_i] = -1;
    STYLE_RIGHT[u_i] = -1;
    STYLE_BOTTOM[u_i] = -1;
    STYLE_LEFT[u_i] = -1;
    STYLE_Z_INDEX[u_i] = 0;
    
    apply_rules_to_node(node_id);
    
    // 3. Diff the geometry
    let mut geometry_changed = 0;
    if STYLE_DISPLAY[u_i] != old_display { geometry_changed = 1; }
    if STYLE_W[u_i] != old_width { geometry_changed = 1; }
    if STYLE_H[u_i] != old_height { geometry_changed = 1; }
    if STYLE_FLEX_DIR[u_i] != old_flex_dir { geometry_changed = 1; }
    if STYLE_FLEX_GROW[u_i] != old_flex_grow { geometry_changed = 1; }
    if STYLE_POSITION[u_i] != old_position { geometry_changed = 1; }
    if STYLE_TOP[u_i] != old_top { geometry_changed = 1; }
    if STYLE_RIGHT[u_i] != old_right { geometry_changed = 1; }
    if STYLE_BOTTOM[u_i] != old_bottom { geometry_changed = 1; }
    if STYLE_LEFT[u_i] != old_left { geometry_changed = 1; }
    
    if geometry_changed == 1 {
        invalidate_layout(node_id); 
    } else {
        invalidate_paint(node_id);
    }
    
    DIRTY_STYLE[u_i] = 0;
}

// ============================================================================
// Epic 50: Focus Matrix
// ============================================================================
pub global ACTIVE_FOCUS_NODE: u32 = 0;

@no_mangle
pub fn dom_get_active_focus() -> u32 {
    return ACTIVE_FOCUS_NODE;
}

@no_mangle
pub fn dom_get_active_cursor() -> u32 {
    return ACTIVE_CURSOR_INDEX;
}

@no_mangle
pub fn dom_handle_click_focus(node_idx: u32) {
    if node_idx == 0 || node_idx >= 65536 {
        ACTIVE_FOCUS_NODE = 0;
        return;
    }
    
    let tag = DOM_NODE_TAG[node_idx as usize];
    
    // Interactive elements that can receive focus
    if tag == TAG_INPUT || tag == TAG_TEXTAREA || tag == TAG_BUTTON {
        ACTIVE_FOCUS_NODE = node_idx;
        ACTIVE_CURSOR_INDEX = DOM_TEXT_LEN[node_idx as usize]; // Set cursor to end
    } else {
        ACTIVE_FOCUS_NODE = 0; // Blur
        ACTIVE_CURSOR_INDEX = 0;
    }
}

// ============================================================================
// Epic 57: The Typography & Input Matrix (Buffer Mutator)
// ============================================================================

@no_mangle
pub fn ext_dom_mutate_text(node_id: u32, insert_char: u8, is_backspace: u8) {
    if node_id == 0 || node_id != ACTIVE_FOCUS_NODE { return; }
    
    let u_idx = node_id as usize;
    let old_ptr = DOM_TEXT_PTR[u_idx];
    let old_len = DOM_TEXT_LEN[u_idx];
    
    // 1. Handle Backspace
    if is_backspace == 1 {
        if ACTIVE_CURSOR_INDEX > 0 {
            // Allocate new string length (old_len - 1)
            let new_ptr = dom_alloc_text(old_len - 1);
            if new_ptr == 0 { return; } // Arena exhausted
            
            // Loop 1: Copy before cursor
            let mut i: u32 = 0;
            while i < ACTIVE_CURSOR_INDEX - 1 {
                let b = *((old_ptr + (i as u64)) as &u8);
                *((new_ptr + (i as u64)) as &mut u8) = b;
                i = i + 1;
            }
            
            // Loop 2: Copy after cursor
            let mut j: u32 = ACTIVE_CURSOR_INDEX;
            let mut w: u32 = ACTIVE_CURSOR_INDEX - 1;
            while j < old_len {
                let b = *((old_ptr + (j as u64)) as &u8);
                *((new_ptr + (w as u64)) as &mut u8) = b;
                j = j + 1;
                w = w + 1;
            }
            
            DOM_TEXT_PTR[u_idx] = new_ptr;
            DOM_TEXT_LEN[u_idx] = old_len - 1;
            ACTIVE_CURSOR_INDEX = ACTIVE_CURSOR_INDEX - 1;
            
            invalidate_layout(node_id);
        }
        return;
    }
    
    // 2. Handle Insertion
    if insert_char != 0 {
        let new_ptr = dom_alloc_text(old_len + 1);
        if new_ptr == 0 { return; } // Arena exhausted
        
        // Loop 1: Copy before cursor
        let mut i: u32 = 0;
        while i < ACTIVE_CURSOR_INDEX {
            let b = *((old_ptr + (i as u64)) as &u8);
            *((new_ptr + (i as u64)) as &mut u8) = b;
            i = i + 1;
        }
        
        // Write the new char
        *((new_ptr + (ACTIVE_CURSOR_INDEX as u64)) as &mut u8) = insert_char;
        
        // Loop 2: Copy after cursor
        let mut j: u32 = ACTIVE_CURSOR_INDEX;
        let mut w: u32 = ACTIVE_CURSOR_INDEX + 1;
        while j < old_len {
            let b = *((old_ptr + (j as u64)) as &u8);
            *((new_ptr + (w as u64)) as &mut u8) = b;
            j = j + 1;
            w = w + 1;
        }
        
        DOM_TEXT_PTR[u_idx] = new_ptr;
        DOM_TEXT_LEN[u_idx] = old_len + 1;
        ACTIVE_CURSOR_INDEX = ACTIVE_CURSOR_INDEX + 1;
        
        invalidate_layout(node_id);
    }
}

// ============================================================================
// Epic 56: Overflow & Scrolling Bridges
// ============================================================================
@no_mangle
pub fn dom_set_style_overflow(idx: u32, val: u8) {
    if idx != 0xFFFFFFFF {
        STYLE_OVERFLOW[idx as usize] = val;
        invalidate_paint(idx); // Just clipping change, no geometry reflow
    }
}

pub fn propagate_scroll_dirty(node_idx: u32) {
    // Only dirties layout coordinates of descendants, bypassing W/H solver
    let mut child = (DOM_NODE_FIRST_CHILD[node_idx as usize] & 0xFFFF) as u32;
    while child != 0 && child != 999999 {
        // Here we just invalidate layout of children physically if we desired,
        // but wait! If we just call invalidate_layout, it crawls UP to root.
        // We only want to trigger child coordinate recalculation downstream.
        // For Prisimi's bypass, since children check DIRTY_LAYOUT, 
        // we must mark children DIRTY_LAYOUT. Actually, marking parent DIRTY layout 
        // fulfills the immediate translation. To satisfy the prompt strictly:
        DIRTY_LAYOUT[child as usize] = 1;
        DIRTY_PAINT[child as usize] = 1;
        propagate_scroll_dirty(child);
        child = (DOM_NODE_NEXT_SIBLING[child as usize] & 0xFFFF) as u32;
    }
}

@no_mangle
pub fn dom_set_layout_scroll_y(node_id: u32, val: f32) {
    if node_id != 0xFFFFFFFF {
        LAYOUT_SCROLL_Y[node_id as usize] = val;
        propagate_scroll_dirty(node_id);
        invalidate_layout(node_id);
    }
}
extern fn sys_canvas_create_backing_store(node_id: u32, width: u32, height: u32) -> u32;

@no_mangle
pub fn dom_init_canvas(node_id: u32, width: u32, height: u32) {
    let surface_id = sys_canvas_create_backing_store(node_id, width, height);
    CANVAS_SURFACE_IDS[node_id as usize] = surface_id;
    DOM_CANVAS_WIDTH[node_id as usize] = width;
    DOM_CANVAS_HEIGHT[node_id as usize] = height;
}
