@no_mangle
pub fn hash_attribute_val(ptr: u64, len: u32) -> u64 {
    let mut hash: u64 = 5381;
    let mut i: u32 = 0;
    while i < len {
        let ch = *((ptr + (i as u64)) as &u8);
        hash = ((hash << 5) + hash) + (ch as u64); // hash * 33 + c
        i = i + 1;
    }
    return hash;
}

@no_mangle
pub fn get_element_by_id_hash(target_hash: u64) -> u32 {
    let mut i: u32 = 1;
    let limit = DOM_NODE_COUNT as u32;
    while i < limit {
        let u_i = i as usize;
        let id_len = DOM_ID_LEN[u_i];
        if id_len > 0 {
            let id_ptr = DOM_ID_PTR[u_i];
            if id_ptr != 0 {
                let current_hash = hash_attribute_val(id_ptr, id_len);
                if current_hash == target_hash {
                    return i;
                }
            }
        }
        i = i + 1;
    }
    return 0; // Not found
}

@no_mangle
@unmangled
pub fn resolve_node_by_id(id_ptr: u64, id_len: u32) -> u64 {
    let mut i: u32 = 1;
    let limit = DOM_NODE_COUNT as u32;
    while i < limit {
        let u_i = i as usize;
        if DOM_ID_LEN[u_i] == id_len && DOM_ID_PTR[u_i] != 0 {
            // Byte-compare the id strings
            let mut j: u32 = 0;
            let mut match_ok: u32 = 1;
            while j < id_len {
                let a = *((DOM_ID_PTR[u_i] + (j as u64)) as &u8);
                let b = *((id_ptr + (j as u64)) as &u8);
                if a != b { match_ok = 0; j = id_len; }
                j = j + 1;
            }
            if match_ok == 1 { 
                let gen = DOM_NODE_GENERATION[u_i] as u64;
                return (i as u64) | (gen << 16); 
            }
        }
        i = i + 1;
    }
    return 0;
}

