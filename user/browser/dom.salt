@no_mangle pub fn dom_ptr_DOM_SELECTION_START() -> u64 { return (&DOM_SELECTION_START) as u64; }
@no_mangle pub fn dom_ptr_DOM_SELECTION_END() -> u64 { return (&DOM_SELECTION_END) as u64; }
@no_mangle pub fn dom_ptr_EVICTION_QUEUE() -> u64 { return (&EVICTION_QUEUE) as u64; }
@no_mangle pub fn dom_ptr_CANVAS_SURFACE_IDS() -> u64 { return (&CANVAS_SURFACE_IDS) as u64; }
@no_mangle pub fn dom_ptr_EVICTION_COUNT() -> u64 { return (&EVICTION_COUNT) as u64; }
@no_mangle pub fn dom_ptr_DOM_NODE_COUNT() -> u64 { return (&DOM_NODE_COUNT) as u64; }

@no_mangle
pub fn invalidate_style_subtree(node_id: u32) {
    if node_id == 0 { return; }
    DIRTY_STYLE[node_id as usize] = 1;
    
    let mut child = DOM_NODE_FIRST_CHILD[node_id as usize];
    while child != 0 {
        invalidate_style_subtree(child as u32);
        child = DOM_NODE_NEXT_SIBLING[child as usize];
    }
}

@no_mangle
pub fn ext_dom_set_class_name(node_id: u32, str_ptr: u64, str_len: u32) {
    if node_id >= 65536 { return; }
    
    DOM_CLASS_PTR[node_id as usize] = str_ptr;
    DOM_CLASS_LEN[node_id as usize] = str_len;
    
    // Mark this node and its entire subtree as dirty for style recalculation
    invalidate_style_subtree(node_id);
}

@no_mangle
pub fn js_set_grid_template_columns(node_id: u64, str_ptr: u64, str_len: u32) {
    let u_idx = resolve_node(node_id);
    if u_idx == 0xFFFFFFFF { return; }
    
    let u_id = u_idx;
    let mut i: u32 = 0;
    let mut col_idx: u32 = 0;
    
    while i < str_len && col_idx < 16 {
        while i < str_len {
            let ch = *((str_ptr + i as u64) as &u8);
            if ch != 32 { break; }
            i = i + 1;
        }
        if i >= str_len { break; }
        
        let mut is_fr = false;
        let mut is_px = false;
        let mut is_auto = false;
        
        // Very basic string scan for tests
        let head_char = *((str_ptr + i as u64) as &u8);
        if head_char == 97 { // 'a' (auto)
            is_auto = true;
            while i < str_len {
                let ch = *((str_ptr + i as u64) as &u8);
                if ch == 32 { break; }
                i = i + 1;
            }
        } else {
            let mut num = 0;
            while i < str_len {
                let ch = *((str_ptr + i as u64) as &u8);
                if ch >= 48 && ch <= 57 {
                    num = num * 10 + (ch - 48) as u32;
                    i = i + 1;
                } else {
                    break;
                }
            }
            
            while i < str_len {
                let ch = *((str_ptr + i as u64) as &u8);
                if ch == 32 { break; } // Next space
                if ch == 112 { is_px = true; } // 'p'
                if ch == 102 { is_fr = true; } // 'f'
                i = i + 1;
            }
            
            let offset = u_id * 16 + col_idx;
            if is_px {
                STYLE_GRID_COL_TYPE[offset as usize] = 0;
                STYLE_GRID_COL_VAL[offset as usize] = num as f32;
                col_idx = col_idx + 1;
            } else if is_fr {
                STYLE_GRID_COL_TYPE[offset as usize] = 1;
                STYLE_GRID_COL_VAL[offset as usize] = num as f32;
                col_idx = col_idx + 1;
            }
        }
    }
    STYLE_GRID_COL_COUNT[u_id as usize] = col_idx as u8;
    invalidate_layout(u_id);
}

@no_mangle
pub fn js_set_grid_column_start(node_id: u64, start: u32) {
    let u_id = resolve_node(node_id);
    if u_id == 0xFFFFFFFF { return; }
    STYLE_GRID_COL_START[u_id as usize] = start as u8;
    
    let p = STYLE_PARENT[u_id as usize];
    if p != 0 && p != 999999 {
        invalidate_layout(p);
    }
}

// Script Execution Queue
pub global SCRIPT_QUEUE_PTR: [u64; 1024] = [0; 1024];
pub global SCRIPT_QUEUE_LEN: [u32; 1024] = [0; 1024];
pub global SCRIPT_QUEUE_TAIL: u32 = 0;
pub global SCRIPT_QUEUE_HEAD: u32 = 0;

@no_mangle
pub fn js_queue_script(ptr: u64, len: u32) {
    let next_head = (SCRIPT_QUEUE_HEAD + 1) % 1024;
    if next_head != SCRIPT_QUEUE_TAIL {
        SCRIPT_QUEUE_PTR[SCRIPT_QUEUE_HEAD as usize] = ptr;
        SCRIPT_QUEUE_LEN[SCRIPT_QUEUE_HEAD as usize] = len;
        SCRIPT_QUEUE_HEAD = next_head;
    }
}

@no_mangle
pub fn js_dequeue_script_ptr() -> u64 {
    if SCRIPT_QUEUE_HEAD == SCRIPT_QUEUE_TAIL { return 0; }
    return SCRIPT_QUEUE_PTR[SCRIPT_QUEUE_TAIL as usize];
}

@no_mangle
pub fn js_dequeue_script_len() -> u32 {
    if SCRIPT_QUEUE_HEAD == SCRIPT_QUEUE_TAIL { return 0; }
    let len = SCRIPT_QUEUE_LEN[SCRIPT_QUEUE_TAIL as usize];
    SCRIPT_QUEUE_TAIL = (SCRIPT_QUEUE_TAIL + 1) % 1024;
    return len;
}

// Epic 61: Script src setters/getters
@no_mangle
pub fn dom_set_script_src(node_idx: u32, src_ptr: u64, src_len: u32) {
    if node_idx >= 65536 { return; }
    SCRIPT_SRC_PTR[node_idx as usize] = src_ptr;
    SCRIPT_SRC_LEN[node_idx as usize] = src_len;
}

