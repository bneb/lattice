@no_mangle
pub fn js_set_style_u8(node_id: u64, prop_id: u32, val: u8) {
    let idx = resolve_node(node_id);
    if idx == 0xFFFFFFFF { return; }
    let u_idx = idx as usize;
    if prop_id == 0 { STYLE_DISPLAY[u_idx] = val; }
    else if prop_id == 1 { STYLE_FLEX_DIR[u_idx] = val; }
    else if prop_id == 2 { STYLE_JUSTIFY_CONTENT[u_idx] = val; }
    else if prop_id == 3 { STYLE_ALIGN_ITEMS[u_idx] = val; }
    else if prop_id == 4 { STYLE_W_UNIT[u_idx] = val; }
    else if prop_id == 5 { STYLE_H_UNIT[u_idx] = val; }
    invalidate_layout(u_idx);
}

