    else if prop_id == 1 { STYLE_H[u_idx] = val; }
    else if prop_id == 2 { STYLE_FLEX_GROW[u_idx] = val; }
    else if prop_id == 3 { STYLE_FLEX_BASIS[u_idx] = val; }
    else if prop_id == 4 { STYLE_Z_INDEX[u_idx] = val; }
    invalidate_layout(u_idx);
}

