pub fn dom_get_first_child_idx(idx: u32) -> u32 {
    let child_id = DOM_NODE_FIRST_CHILD[idx as usize];
    if child_id == 0 { return 999999; }
    let c = resolve_node(child_id);
    if c == 0xFFFFFFFF { return 999999; }
    return c;
}

// Epic 64: Shadow DOM Matrix
pub fn dom_get_render_first_child_idx(idx: u32) -> u32 {
    let shadow_id = DOM_SHADOW_ROOT[idx as usize];
    let mut target_id = DOM_NODE_FIRST_CHILD[idx as usize];
    
    if shadow_id != 0 {
        let s_idx = resolve_node(shadow_id);
        if s_idx != 0xFFFFFFFF {
            target_id = DOM_NODE_FIRST_CHILD[s_idx as usize];
        }
    }
    
    if target_id == 0 { return 999999; }
    let c = resolve_node(target_id);
    if c == 0xFFFFFFFF { return 999999; }
    return c;
}

pub fn dom_get_next_sibling_idx(idx: u32) -> u32 {
    let sib_id = DOM_NODE_NEXT_SIBLING[idx as usize];
    if sib_id == 0 { return 999999; }
    let c = resolve_node(sib_id);
    if c == 0xFFFFFFFF { return 999999; }
    return c;
}

