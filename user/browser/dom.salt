@no_mangle
pub fn dom_get_scope_idx(mut idx: u32) -> u32 {
    while idx != 0 && idx != 999999 {
        if DOM_NODE_TAG[idx as usize] == TAG_SHADOW_ROOT {
            return idx;
        }
        let p_id = DOM_NODE_PARENT[idx as usize];
        if p_id == 0 { break; }
        
        let p_idx = resolve_node(p_id);
        if p_idx == 0xFFFFFFFF { break; }
        idx = p_idx;
    }
    return 0;
}

