// Epic 71: Geometric Tree Order
// Returns -1 if node1 is before node2, 1 if node1 is after node2, 0 if equal.
pub fn compare_document_position(node1: u32, node2: u32) -> i32 {
    if node1 == node2 { return 0; }
    if node1 == 0 || node2 == 0 { return 0; }

    // 1. Compute depths and paths to root
    let mut d1: u32 = 0;
    let mut curr1 = node1;
    while curr1 != 0 && curr1 != 1 && d1 < 1000 {
        curr1 = STYLE_PARENT[curr1 as usize];
        d1 = d1 + 1;
    }

    let mut d2: u32 = 0;
    let mut curr2 = node2;
    while curr2 != 0 && curr2 != 1 && d2 < 1000 {
        curr2 = STYLE_PARENT[curr2 as usize];
        d2 = d2 + 1;
    }

    // 2. Align depths
    let mut n1 = node1;
    let mut n2 = node2;
    if d1 > d2 {
        let diff = d1 - d2;
        let mut i: u32 = 0;
        while i < diff {
            n1 = STYLE_PARENT[n1 as usize];
            i = i + 1;
        }
        if n1 == n2 { return 1; } // node2 is ancestor of node1
    } else if d2 > d1 {
        let diff = d2 - d1;
        let mut i: u32 = 0;
        while i < diff {
            n2 = STYLE_PARENT[n2 as usize];
            i = i + 1;
        }
        if n1 == n2 { return -1; } // node1 is ancestor of node2
    }

    // 3. Walk up in sync to find common parent
    while n1 != 0 && n2 != 0 {
        let p1 = STYLE_PARENT[n1 as usize];
        let p2 = STYLE_PARENT[n2 as usize];
        if p1 == p2 {
            // Compare siblings under shared parent
            let mut child = DOM_NODE_FIRST_CHILD[p1 as usize];
            while child != 0 {
                let c_idx = (child & 0xFFFF) as u32;
                if c_idx == n1 { return -1; }
                if c_idx == n2 { return 1; }
                child = DOM_NODE_NEXT_SIBLING[c_idx as usize];
            }
            return 0; // Should not reach
        }
        n1 = p1;
        n2 = p2;
    }

    return 0;
}

