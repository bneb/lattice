// Event Handling Matrix
pub global EVENT_NODE: [u32; 1024] = [0; 1024];
pub global EVENT_SIP:  [u32; 1024] = [0; 1024];
pub global EVENT_PC:   [u32; 1024] = [0; 1024];
pub global EVENT_COUNT: u32 = 0;

@no_mangle
pub fn bind_event_listener(node_idx: u32, sip_idx: u32, target_pc: u32) -> i32 {
    let count = EVENT_COUNT;
    if count >= 1024 { return -1; }
    EVENT_NODE[count as usize] = node_idx;
    EVENT_SIP[count as usize] = sip_idx;
    EVENT_PC[count as usize] = target_pc;
    EVENT_COUNT = count + 1;
    return 0;
}

