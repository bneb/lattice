@no_mangle
pub fn js_clear_children(node_id: u64) {
    let idx = resolve_node(node_id);
    if idx == 0xFFFFFFFF { return; }
    let u_idx = idx as usize;
    // Walk children and push to freelist
    let mut child_id = DOM_NODE_FIRST_CHILD[u_idx];
    while child_id != 0 {
        let c_idx = resolve_node(child_id);
        if c_idx == 0xFFFFFFFF { child_id = 0; }
        else {
            let next = DOM_NODE_NEXT_SIBLING[c_idx as usize];
            // Push to freelist
            if DOM_FREE_LIST_COUNT < 65536 {
                DOM_FREE_LIST[DOM_FREE_LIST_COUNT as usize] = c_idx as u64;
                DOM_FREE_LIST_COUNT = DOM_FREE_LIST_COUNT + 1;
            }
            child_id = next;
        }
    }
    DOM_NODE_FIRST_CHILD[u_idx] = 0;
    DOM_LAST_CHILD[u_idx] = 0;
    invalidate_layout(u_idx);
}

