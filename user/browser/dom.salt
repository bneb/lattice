@no_mangle
pub fn js_set_style_box_shadow(node_id: u64, r: u8, g: u8, b: u8, a: u8, x: f32, y: f32, blur: f32, spread: f32) {
    let idx = resolve_node(node_id);
    if idx != 0xFFFFFFFF {
        let u_idx = idx as usize;
        STYLE_BOX_SHADOW_R[u_idx] = r;
        STYLE_BOX_SHADOW_G[u_idx] = g;
        STYLE_BOX_SHADOW_B[u_idx] = b;
        STYLE_BOX_SHADOW_A[u_idx] = a;
        STYLE_BOX_SHADOW_OFFSET_X[u_idx] = x;
        STYLE_BOX_SHADOW_OFFSET_Y[u_idx] = y;
        STYLE_BOX_SHADOW_BLUR[u_idx] = blur;
        STYLE_BOX_SHADOW_SPREAD[u_idx] = spread;
