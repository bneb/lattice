// Epic 69: OOPIF Iframe SoA Management
// Registers a DOM node as an iframe, returns slot index (or 0xFFFFFFFF if full)
@no_mangle
pub fn dom_register_iframe(node_idx: u32) -> u32 {
    let count = IFRAME_COUNT;
    if count >= 256 { return 0xFFFFFFFF; }
    DOM_IFRAME_NODE_ID[count as usize] = node_idx;
    DOM_IFRAME_SRC_PTR[count as usize] = 0;
    DOM_IFRAME_SRC_LEN[count as usize] = 0;
    DOM_IFRAME_SURFACE_ID[count as usize] = 0;
    DOM_IFRAME_PID[count as usize] = 0;
    IFRAME_COUNT = count + 1;
    return count;
}

@no_mangle
pub fn dom_set_iframe_src(iframe_slot: u32, src_ptr: u64, src_len: u32) {
    if iframe_slot >= 256 { return; }
    DOM_IFRAME_SRC_PTR[iframe_slot as usize] = src_ptr;
    DOM_IFRAME_SRC_LEN[iframe_slot as usize] = src_len;
}

@no_mangle
pub fn dom_get_iframe_src_ptr(iframe_slot: u32) -> u64 {
    if iframe_slot >= 256 { return 0; }
    return DOM_IFRAME_SRC_PTR[iframe_slot as usize];
}

@no_mangle
pub fn dom_get_iframe_src_len(iframe_slot: u32) -> u32 {
    if iframe_slot >= 256 { return 0; }
    return DOM_IFRAME_SRC_LEN[iframe_slot as usize];
}

// Lookup iframe slot by DOM node index
@no_mangle
pub fn dom_find_iframe_slot(node_idx: u32) -> u32 {
    let mut i: u32 = 0;
    while i < IFRAME_COUNT {
        if DOM_IFRAME_NODE_ID[i as usize] == node_idx {
            return i;
        }
        i = i + 1;
    }
    return 0xFFFFFFFF;
}

// Epic 61: Queue a network fetch for an external <script src="...">
// Registers in the SoA queue and returns the fetch_id for the caller to dispatch.
// Returns 0 if queue is full.
@no_mangle
pub fn queue_script_fetch(src_ptr: u64, src_len: u32) -> u64 {
    let mut i: u32 = 0;
    while i < 64 {
        if SCRIPT_FETCH_STATE[i as usize] == 0 {
            let fetch_id = NEXT_SCRIPT_FETCH_ID;
            NEXT_SCRIPT_FETCH_ID = NEXT_SCRIPT_FETCH_ID + 1;
            
            SCRIPT_FETCH_STATE[i as usize] = 1; // PENDING
            SCRIPT_FETCH_ID[i as usize] = fetch_id;
            SCRIPT_FETCH_SRC_PTR[i as usize] = src_ptr;
            SCRIPT_FETCH_SRC_LEN[i as usize] = src_len;
            SCRIPT_FETCH_BUF_PTR[i as usize] = 0;
            SCRIPT_FETCH_BUF_LEN[i as usize] = 0;
            PENDING_SCRIPT_COUNT = PENDING_SCRIPT_COUNT + 1;
            
            return fetch_id;
        }
        i = i + 1;
    }
    return 0; // Queue full
}

// Epic 61: Called when a script fetch response arrives
@no_mangle
pub fn complete_script_fetch(fetch_id: u64, buf_ptr: u64, buf_len: u32) -> i32 {
    let mut i: u32 = 0;
    while i < 64 {
        if SCRIPT_FETCH_STATE[i as usize] == 1 && SCRIPT_FETCH_ID[i as usize] == fetch_id {
            SCRIPT_FETCH_STATE[i as usize] = 2; // DONE
            SCRIPT_FETCH_BUF_PTR[i as usize] = buf_ptr;
            SCRIPT_FETCH_BUF_LEN[i as usize] = buf_len;
            return i as i32;
        }
        i = i + 1;
    }
    return -1;
}

// Epic 61: Get the count of scripts still waiting for download
@no_mangle
pub fn get_pending_script_count() -> u32 {
    return PENDING_SCRIPT_COUNT;
}

@no_mangle
pub fn init_arrays() {
    DOM_NODE_COUNT = 1;
    DOM_FREE_LIST_COUNT = 0;
    ATTR_COUNT = 0;
    EVICTION_COUNT = 0;
    EVENT_COUNT = 0;
    PENDING_SCRIPT_COUNT = 0;
    NEXT_SCRIPT_FETCH_ID = 1;
    IFRAME_COUNT = 0;
    
    // Reset iframe tracking
    let mut ifr: u32 = 0;
    while ifr < 256 {
        DOM_IFRAME_SRC_PTR[ifr as usize] = 0;
        DOM_IFRAME_SRC_LEN[ifr as usize] = 0;
        DOM_IFRAME_SURFACE_ID[ifr as usize] = 0;
        DOM_IFRAME_PID[ifr as usize] = 0;
        DOM_IFRAME_NODE_ID[ifr as usize] = 0;
        ifr = ifr + 1;
    }
    
    // Reset script fetch queue
    let mut sf: u32 = 0;
    while sf < 64 {
        SCRIPT_FETCH_STATE[sf as usize] = 0;
        SCRIPT_FETCH_ID[sf as usize] = 0;
        SCRIPT_FETCH_SRC_PTR[sf as usize] = 0;
        SCRIPT_FETCH_SRC_LEN[sf as usize] = 0;
        SCRIPT_FETCH_BUF_PTR[sf as usize] = 0;
        SCRIPT_FETCH_BUF_LEN[sf as usize] = 0;
        sf = sf + 1;
    }
    
    let mut i: u32 = 0;
    while i < 65536 {
        let u_i = i as usize;
        DOM_CUSTOM_TAG_HASH[u_i] = 0;
        DOM_CUSTOM_TAG_PTR[u_i] = 0;
        DOM_CUSTOM_TAG_LEN[u_i] = 0;
        DOM_NODE_UPGRADED[u_i] = 0;
        STYLE_W[u_i] = -1;
        STYLE_H[u_i] = -1;
        STYLE_FLEX_BASIS[u_i] = -1;
        STYLE_GRID_COL_COUNT[u_i] = 0;
        STYLE_GRID_ROW_COUNT[u_i] = 0;
        STYLE_GRID_COL_START[u_i] = 0;
        STYLE_GRID_ROW_START[u_i] = 0;
        STYLE_FIRST_CHILD[u_i] = 999999;
        STYLE_NEXT_SIBLING[u_i] = 999999;
        STYLE_PARENT[u_i] = 999999;
        invalidate_layout(u_i);
        COMPOSITOR_DIRTY[u_i] = 0;
        STYLE_BG_A[u_i] = 0;
        STYLE_COLOR_R[u_i] = 0;
        STYLE_COLOR_G[u_i] = 0;
        STYLE_COLOR_B[u_i] = 0;
        STYLE_COLOR_A[u_i] = 255;
        STYLE_FONT_SIZE[u_i] = 16.0;
        STYLE_BORDER_RADIUS[u_i] = 0.0;
        STYLE_BOX_SHADOW_R[u_i] = 0;
        STYLE_BOX_SHADOW_G[u_i] = 0;
        STYLE_BOX_SHADOW_B[u_i] = 0;
        STYLE_BOX_SHADOW_A[u_i] = 0;
        STYLE_BOX_SHADOW_OFFSET_X[u_i] = 0.0;
        STYLE_BOX_SHADOW_OFFSET_Y[u_i] = 0.0;
        STYLE_BOX_SHADOW_BLUR[u_i] = 0.0;
        STYLE_BOX_SHADOW_SPREAD[u_i] = 0.0;
        STYLE_TRANSFORM_X[u_i] = 0.0;
        STYLE_TRANSFORM_Y[u_i] = 0.0;
        STYLE_OPACITY[u_i] = 1.0;
        DOM_CANVAS_WIDTH[u_i] = 0;
        DOM_CANVAS_HEIGHT[u_i] = 0;
        i = i + 1;
    }
}

@no_mangle
pub fn resolve_node(id: u64) -> u32 {
    if id == 0 { return 0; }
    let idx = (id & 0xFFFF) as u32;
    if idx >= 65536 { return 0xFFFFFFFF; }
    let expected_gen = (id >> 16) as u32;
    if DOM_NODE_GENERATION[idx as usize] != expected_gen { return 0xFFFFFFFF; }
    return idx;
}

// ============================================================================
// Epic 49: Data Sanitization — zeroes ALL style/layout/DOM data for a slot
// ============================================================================
pub fn sanitize_node_slot(u_idx: usize) {
    // DOM Tree Linkage
    DOM_NODE_TAG[u_idx] = 0;
    DOM_NODE_PARENT[u_idx] = 0;
    DOM_NODE_FIRST_CHILD[u_idx] = 0;
    DOM_SHADOW_ROOT[u_idx] = 0;
    DOM_NODE_NEXT_SIBLING[u_idx] = 0;
    DOM_LAST_CHILD[u_idx] = 0;
    DOM_TEXT_PTR[u_idx] = 0;
    DOM_TEXT_LEN[u_idx] = 0;
    DOM_NODE_CAN_EXECUTE[u_idx] = 1;
    
    // Style Tree Linkage
    STYLE_PARENT[u_idx] = 999999;
    STYLE_FIRST_CHILD[u_idx] = 999999;
    STYLE_NEXT_SIBLING[u_idx] = 999999;
    
    // Display & Flex
    STYLE_DISPLAY[u_idx] = 1;
    STYLE_FLEX_DIR[u_idx] = 0;
    STYLE_JUSTIFY_CONTENT[u_idx] = 0;
    STYLE_ALIGN_ITEMS[u_idx] = 0;
    STYLE_FLEX_GROW[u_idx] = 0;
    STYLE_FLEX_BASIS[u_idx] = -1;
    STYLE_GRID_COL_COUNT[u_idx] = 0;
    STYLE_GRID_ROW_COUNT[u_idx] = 0;
    STYLE_GRID_COL_START[u_idx] = 0;
    STYLE_GRID_ROW_START[u_idx] = 0;
    
    // Box Model
    STYLE_W[u_idx] = -1;
    STYLE_H[u_idx] = -1;
    STYLE_W_UNIT[u_idx] = 0;
    STYLE_H_UNIT[u_idx] = 0;
    STYLE_PADDING_TOP[u_idx] = 0;
    STYLE_PADDING_RIGHT[u_idx] = 0;
    STYLE_PADDING_BOTTOM[u_idx] = 0;
    STYLE_PADDING_LEFT[u_idx] = 0;
    
    // Background & Color
    STYLE_BG_R[u_idx] = 255;
    STYLE_BG_G[u_idx] = 255;
    STYLE_BG_B[u_idx] = 255;
    STYLE_BG_A[u_idx] = 0;
    STYLE_COLOR_R[u_idx] = 0;
    STYLE_COLOR_G[u_idx] = 0;
    STYLE_COLOR_B[u_idx] = 0;
    STYLE_COLOR_A[u_idx] = 255;
    
    // Typography
    STYLE_FONT_SIZE[u_idx] = 16.0;
    STYLE_LINE_HEIGHT[u_idx] = -1.0;
    STYLE_TEXT_ALIGN[u_idx] = 0;
    STYLE_SPECIFICITY_TEXT_ALIGN[u_idx] = 0;
    
    // Visual Effects
    STYLE_BORDER_RADIUS[u_idx] = 0.0;
    STYLE_BOX_SHADOW_R[u_idx] = 0;
    STYLE_BOX_SHADOW_G[u_idx] = 0;
    STYLE_BOX_SHADOW_B[u_idx] = 0;
    STYLE_BOX_SHADOW_A[u_idx] = 0;
    STYLE_BOX_SHADOW_OFFSET_X[u_idx] = 0.0;
    STYLE_BOX_SHADOW_OFFSET_Y[u_idx] = 0.0;
    STYLE_BOX_SHADOW_BLUR[u_idx] = 0.0;
    STYLE_BOX_SHADOW_SPREAD[u_idx] = 0.0;
    STYLE_TRANSFORM_X[u_idx] = 0.0;
    STYLE_TRANSFORM_Y[u_idx] = 0.0;
    STYLE_OPACITY[u_idx] = 1.0;
    STYLE_Z_INDEX[u_idx] = 0;
    STYLE_POSITION[u_idx] = 0;
    STYLE_TOP[u_idx] = -1;
    STYLE_RIGHT[u_idx] = -1;
    STYLE_BOTTOM[u_idx] = -1;
    STYLE_LEFT[u_idx] = -1;
    
    // Specificity
    STYLE_SPEC_DISPLAY[u_idx] = 0;
    STYLE_SPEC_FLEX_DIR[u_idx] = 0;
    STYLE_SPEC_FLEX_GROW[u_idx] = 0;
    STYLE_SPEC_WIDTH[u_idx] = 0;
    STYLE_SPEC_HEIGHT[u_idx] = 0;
    STYLE_SPEC_BG[u_idx] = 0;
    STYLE_SPEC_COLOR[u_idx] = 0;
    STYLE_SPEC_POSITION[u_idx] = 0;
    STYLE_SPEC_TOP[u_idx] = 0;
    STYLE_SPEC_RIGHT[u_idx] = 0;
    STYLE_SPEC_BOTTOM[u_idx] = 0;
    STYLE_SPEC_LEFT[u_idx] = 0;
    STYLE_SPEC_Z_INDEX[u_idx] = 0;
    
    // Layout Outputs
    LAYOUT_X[u_idx] = 0;
    LAYOUT_Y[u_idx] = 0;
    LAYOUT_W[u_idx] = 0;
    LAYOUT_H[u_idx] = 0;
    
    // Dirty Bits
    DIRTY_LAYOUT[u_idx] = 1;
    DIRTY_PAINT[u_idx] = 1;
    COMPOSITOR_DIRTY[u_idx] = 0;
    
    // Fetch / Canvas
    DOM_NODE_FETCH_STATE[u_idx] = 0;
    DOM_NODE_TEXTURE_ID[u_idx] = 0;
    DOM_CANVAS_WIDTH[u_idx] = 0;
    DOM_CANVAS_HEIGHT[u_idx] = 0;
    
    // Selection
    DOM_SELECTION_START[u_idx] = 0;
    DOM_SELECTION_END[u_idx] = 0;
    
    // String Attributes
    DOM_ID_PTR[u_idx] = 0;
    DOM_ID_LEN[u_idx] = 0;
    DOM_CLASS_PTR[u_idx] = 0;
    DOM_CLASS_LEN[u_idx] = 0;
    SCRIPT_SRC_PTR[u_idx] = 0;
    SCRIPT_SRC_LEN[u_idx] = 0;
    
    DOM_CUSTOM_TAG_HASH[u_idx] = 0;
    DOM_CUSTOM_TAG_PTR[u_idx] = 0;
    DOM_CUSTOM_TAG_LEN[u_idx] = 0;
    DOM_NODE_UPGRADED[u_idx] = 0;
}

@no_mangle
pub fn create_node(tag: u32) -> u64 {
    let mut idx: u64 = 0;
    if DOM_FREE_LIST_COUNT > 0 {
        DOM_FREE_LIST_COUNT = DOM_FREE_LIST_COUNT - 1;
        idx = DOM_FREE_LIST[DOM_FREE_LIST_COUNT as usize];
        // CRITICAL: Sanitize all legacy data from previous occupant
        sanitize_node_slot(idx as usize);
    } else {
        idx = DOM_NODE_COUNT;
        if idx >= 65535 { return 0; } // OOM Guard
        DOM_NODE_COUNT = DOM_NODE_COUNT + 1;
    }
    
    let u_idx = idx as usize;
    DOM_NODE_TAG[u_idx] = tag;
    DOM_NODE_PARENT[u_idx] = 0;
    DOM_NODE_FIRST_CHILD[u_idx] = 0;
    DOM_SHADOW_ROOT[u_idx] = 0;
    DOM_NODE_NEXT_SIBLING[u_idx] = 0;
    DOM_LAST_CHILD[u_idx] = 0;
    DOM_NODE_GENERATION[u_idx] = DOM_NODE_GENERATION[u_idx] + 1;
    DOM_NODE_CAN_EXECUTE[u_idx] = 1;
    
    if tag == 0 {
        STYLE_DISPLAY[u_idx] = 3; // INLINE (TEXT)
    } else if tag == 5 || tag == 7 || tag == 15 || tag == 16 || tag == 17 {
        // SPAN=5, A=7, B=15, I=16, FONT=17 → INLINE
        STYLE_DISPLAY[u_idx] = 3;
    } else if tag == 11 {
        STYLE_DISPLAY[u_idx] = 2; // FLEX (CENTER)
        STYLE_JUSTIFY_CONTENT[u_idx] = 1; // CENTER
        STYLE_FLEX_DIR[u_idx] = 0; // ROW
    } else if tag == 13 {
        STYLE_DISPLAY[u_idx] = 2; // FLEX
        STYLE_FLEX_DIR[u_idx] = 0; // ROW for TR
    } else if tag == 14 {
        STYLE_DISPLAY[u_idx] = 1; // BLOCK
        STYLE_FLEX_GROW[u_idx] = 1; // TD flex stretches to fill TR
    } else if tag == 26 {
        // TAG_IFRAME: BLOCK with default 300x150 per W3C
        STYLE_DISPLAY[u_idx] = 1; // BLOCK
        STYLE_W[u_idx] = 300;
        STYLE_H[u_idx] = 150;
    } else if tag == 27 {
        // TAG_CANVAS: BLOCK with default 300x150 per W3C
        STYLE_DISPLAY[u_idx] = 1; // BLOCK
        STYLE_W[u_idx] = 300;
        STYLE_H[u_idx] = 150;
        DOM_CANVAS_WIDTH[u_idx] = 300;
        DOM_CANVAS_HEIGHT[u_idx] = 150;
    } else {
        STYLE_DISPLAY[u_idx] = 1; // BLOCK
    }
    
    invalidate_layout(u_idx);
    
    if observers.sys_is_node_observed_for(idx as u32, 1 /* Mutation */) {
        observers.sys_queue_mutation_record(idx as u32, 1 /* addition */);
    }
    
    return idx | ((DOM_NODE_GENERATION[u_idx] as u64) << 16);
}

@no_mangle
pub fn create_text_node(text_ptr: u64, len: u32) -> u64 {
    let id = create_node(TAG_TEXT);
    let idx = resolve_node(id);
    if idx != 0xFFFFFFFF {
        DOM_TEXT_PTR[idx as usize] = text_ptr;
        DOM_TEXT_LEN[idx as usize] = len;
    }
    return id;
}

@no_mangle
pub fn append_child(parent_id: u64, child_id: u64) {
    let p_idx = resolve_node(parent_id);
    let c_idx = resolve_node(child_id);
    if p_idx == 0xFFFFFFFF || c_idx == 0xFFFFFFFF { return; }
    
    DOM_NODE_PARENT[c_idx as usize] = parent_id;
    STYLE_PARENT[c_idx as usize] = p_idx;
    DOM_NODE_NEXT_SIBLING[c_idx as usize] = 0;
    
    let first = DOM_NODE_FIRST_CHILD[p_idx as usize];
    if first == 0 {
        DOM_NODE_FIRST_CHILD[p_idx as usize] = child_id;
        DOM_NODE_PREV_SIBLING[c_idx as usize] = 0;
    } else {
        // O(1) tail insertion via DOM_LAST_CHILD
        let tail_idx = DOM_LAST_CHILD[p_idx as usize];
        if tail_idx != 0 {
            DOM_NODE_NEXT_SIBLING[tail_idx as usize] = child_id;
            let tail_gen = DOM_NODE_GENERATION[tail_idx as usize] as u64;
            DOM_NODE_PREV_SIBLING[c_idx as usize] = (tail_idx as u64) | (tail_gen << 16);
        } else {
            DOM_NODE_PREV_SIBLING[c_idx as usize] = 0;
        }
    }
    DOM_LAST_CHILD[p_idx as usize] = c_idx;
    invalidate_layout(p_idx as usize);
}

// ============================================================================
// O(1) DOM Mutation API — The React Foundation (Epic 31)
// ============================================================================

@no_mangle
pub fn ext_dom_set_shadow_root(host_idx: u32, shadow_idx: u32) {
    if host_idx >= 65536 || shadow_idx >= 65536 { return; }
    
    let host_gen = DOM_NODE_GENERATION[host_idx as usize] as u64;
    let shadow_gen = DOM_NODE_GENERATION[shadow_idx as usize] as u64;
    
    let shadow_id = (shadow_idx as u64) | (shadow_gen << 16);
    let host_id = (host_idx as u64) | (host_gen << 16);
    
    DOM_SHADOW_ROOT[host_idx as usize] = shadow_id;
    DOM_NODE_PARENT[shadow_idx as usize] = host_id;
    STYLE_PARENT[shadow_idx as usize] = host_idx;
    
    // Trigger layout propagation
    invalidate_layout(host_idx);
}

// O(1) appendChild using raw u32 indices (called from QuickJS C bridge)
@no_mangle
pub fn js_dom_append_child(parent_idx: u32, child_idx: u32) {
    if parent_idx >= 65536 || child_idx >= 65536 { return; }
    let p = parent_idx as usize;
    let c = child_idx as usize;
    
    // Set parent linkage
    let parent_gen = DOM_NODE_GENERATION[p] as u64;
    DOM_NODE_PARENT[c] = (parent_idx as u64) | (parent_gen << 16);
    STYLE_PARENT[c] = parent_idx;
    DOM_NODE_NEXT_SIBLING[c] = 0;
    
    let child_gen = DOM_NODE_GENERATION[c] as u64;
    let child_node_id = (child_idx as u64) | (child_gen << 16);
    
    let first = DOM_NODE_FIRST_CHILD[p];
    if first == 0 {
        DOM_NODE_FIRST_CHILD[p] = child_node_id;
        DOM_NODE_PREV_SIBLING[c] = 0;
    } else {
        // O(1) tail insertion
        let tail = DOM_LAST_CHILD[p] as usize;
        DOM_NODE_NEXT_SIBLING[tail] = child_node_id;
        let tail_gen = DOM_NODE_GENERATION[tail] as u64;
        DOM_NODE_PREV_SIBLING[c] = (tail as u64) | (tail_gen << 16);
    }
    DOM_LAST_CHILD[p] = child_idx;
    invalidate_layout(p);
    
    if observers.sys_is_node_observed_for(parent_idx, 1 /* Mutation */) {
        observers.sys_queue_mutation_record(child_idx, 1 /* addition */);
    }
    
    // Epic 80B: Component Matrix - trigger lifecycle hooks
    ext_jsc_trigger_connected_callback(child_node_id);
}

@no_mangle
pub fn remove_child(parent_id: u64, child_id: u64) {
    let p_idx = resolve_node(parent_id);
    let c_idx = resolve_node(child_id);
    if p_idx == 0xFFFFFFFF || c_idx == 0xFFFFFFFF { return; }
    ext_dom_remove_child(p_idx, c_idx);
}

@no_mangle
pub fn ext_dom_remove_child(parent_idx: u32, child_idx: u32) {
    if parent_idx == 0 || child_idx == 0 || parent_idx >= 65536 || child_idx >= 65536 { return; }
    if STYLE_PARENT[child_idx as usize] != parent_idx { return; }

    let prev = DOM_NODE_PREV_SIBLING[child_idx as usize];
    let next = DOM_NODE_NEXT_SIBLING[child_idx as usize];

    if prev != 0 {
        let prev_idx = (prev & 0xFFFF) as usize;
        DOM_NODE_NEXT_SIBLING[prev_idx] = next;
    } else {
        DOM_NODE_FIRST_CHILD[parent_idx as usize] = next;
    }

    if next != 0 {
        let next_idx = (next & 0xFFFF) as usize;
        DOM_NODE_PREV_SIBLING[next_idx] = prev;
    } else {
        // Child was the last child
        if prev != 0 {
            DOM_LAST_CHILD[parent_idx as usize] = (prev & 0xFFFF) as u32;
        } else {
            DOM_LAST_CHILD[parent_idx as usize] = 0;
        }
    }

    // Isolate the detached node (No GC here)
    DOM_NODE_PREV_SIBLING[child_idx as usize] = 0;
    DOM_NODE_NEXT_SIBLING[child_idx as usize] = 0;
    STYLE_PARENT[child_idx as usize] = 0;
    DOM_NODE_PARENT[child_idx as usize] = 0;

    invalidate_layout(parent_idx as usize);

    if observers.sys_is_node_observed_for(parent_idx, 1 /* Mutation */) {
        observers.sys_queue_mutation_record(child_idx, 2 /* removal */);
    }
    
    let child_gen = DOM_NODE_GENERATION[child_idx as usize] as u64;
    let child_node_id = (child_idx as u64) | (child_gen << 16);
    ext_jsc_trigger_disconnected_callback(child_node_id);
}

@no_mangle
pub fn ext_dom_insert_before(parent_idx: u32, new_idx: u32, ref_idx: u32) {
    if parent_idx == 0 || new_idx == 0 || parent_idx >= 65536 || new_idx >= 65536 { return; }
    if parent_idx == new_idx { return; } 

    let p = STYLE_PARENT[new_idx as usize];
    if p != 0 && p != 999999 {
        ext_dom_remove_child(p, new_idx);
    }

    if ref_idx == 0 {
        js_dom_append_child(parent_idx, new_idx);
    } else {
        if ref_idx >= 65536 { return; }
        STYLE_PARENT[new_idx as usize] = parent_idx;
        let parent_gen = DOM_NODE_GENERATION[parent_idx as usize] as u64;
        DOM_NODE_PARENT[new_idx as usize] = (parent_idx as u64) | (parent_gen << 16);
        
        let new_gen = DOM_NODE_GENERATION[new_idx as usize] as u64;
        let new_packed = (new_idx as u64) | (new_gen << 16);
        
        let prev_sibling = DOM_NODE_PREV_SIBLING[ref_idx as usize];
        
        DOM_NODE_NEXT_SIBLING[new_idx as usize] = (ref_idx as u64) | ((DOM_NODE_GENERATION[ref_idx as usize] as u64) << 16);
        DOM_NODE_PREV_SIBLING[new_idx as usize] = prev_sibling;
        DOM_NODE_PREV_SIBLING[ref_idx as usize] = new_packed;

        if prev_sibling != 0 {
            let prev_idx = (prev_sibling & 0xFFFF) as usize;
            DOM_NODE_NEXT_SIBLING[prev_idx] = new_packed;
        } else {
            DOM_NODE_FIRST_CHILD[parent_idx as usize] = new_packed;
        }
        invalidate_layout(parent_idx as usize);
        
        // Epic 80B: Component Matrix - trigger lifecycle hooks
        ext_jsc_trigger_connected_callback(new_packed);
    }
}

// Epic 54 Text Content Mutation
@no_mangle
pub fn dom_set_text(node_id: u64, str_ptr: u64, str_len: u32) -> i32 {
    let u_idx = resolve_node(node_id);
    if u_idx == 0xFFFFFFFF { return -1; }
    ext_dom_set_text_content(u_idx, str_ptr, str_len);
    return 0;
}
pub fn sys_node_set_width(node_idx: u32, width: i32) {
    STYLE_W[node_idx as usize] = width;
    invalidate_layout(node_idx as usize);
}

@no_mangle
pub fn ext_dom_set_text_content(node_idx: u32, str_ptr: u64, str_len: u32) {
    if node_idx >= 65536 { return; }
    
    // Push to the monotonic text bump arena
    let safe_ptr = dom_alloc_text(str_len);
    if safe_ptr == 0 { return; } // OOM
    
    // memcpy to safe bounds (assuming sys memory is accessible)
    let mut i: u32 = 0;
    while i < str_len {
        let b = *((str_ptr + i as u64) as &u8);
        *((safe_ptr + i as u64) as &mut u8) = b;
        i = i + 1;
    }
    
    DOM_TEXT_PTR[node_idx as usize] = safe_ptr;
    DOM_TEXT_LEN[node_idx as usize] = str_len;
    
    let pid = STYLE_PARENT[node_idx as usize];
    if pid != 0 && pid != 999999 {
        invalidate_layout(pid as usize);
    }

    if observers.sys_is_node_observed_for(node_idx, 1 /* Mutation */) {
        observers.sys_queue_mutation_record(node_idx, 3 /* text */);
    }
}

// Topological Deletion — removes child from parent's linked list,
// then recursively pushes the child subtree onto the free list.
@no_mangle
pub fn js_dom_remove_child(parent_idx: u32, child_idx: u32) {
    ext_dom_remove_child(parent_idx, child_idx);
    
    // Recursively reclaim the subtree onto the free list
    reclaim_subtree(child_idx);
}

// Push a node and all its descendants onto the free list
fn reclaim_subtree(idx: u32) {
    if idx == 0 || idx >= 65536 { return; }
    
    // Recurse into children first
    let mut child_id = DOM_NODE_FIRST_CHILD[idx as usize];
    while child_id != 0 {
        let c_idx = (child_id & 0xFFFF) as u32;
        if c_idx >= 65536 { child_id = 0; }
        else {
            let next = DOM_NODE_NEXT_SIBLING[c_idx as usize];
            reclaim_subtree(c_idx);
            child_id = next;
        }
    }
    
    // Free callbacks registered to this node
    ext_events_free_node_callbacks(idx);

    // Sanitize all data so ghost properties don't bleed on reuse
    sanitize_node_slot(idx as usize);
    
    // Push onto free list
    if DOM_FREE_LIST_COUNT < 65536 {
        DOM_FREE_LIST[DOM_FREE_LIST_COUNT as usize] = idx as u64;
        DOM_FREE_LIST_COUNT = DOM_FREE_LIST_COUNT + 1;
    }
}

// ============================================================================
// Epic 49: ext_dom_free_node — QuickJS Finalizer Entry Point
// ============================================================================
// Epic 72: The DOM Range Mutator — Surgical Text Splitting
@no_mangle
pub fn ext_dom_wrap_text_range(text_node_id: u32, start_idx: u32, end_idx: u32, wrapper_tag: u8) -> i32 {
    if text_node_id >= 65536 { return -1; }
    let original_len = DOM_TEXT_LEN[text_node_id as usize];
    let original_ptr = DOM_TEXT_PTR[text_node_id as usize];
    
    // Boundary Validation
    if start_idx > end_idx || end_idx > original_len { return -1; }
    
    // 1. Allocate from Free-List
    let wrapper_id = create_node(wrapper_tag as u32);
    if wrapper_id == 0 { return -1; }
    
    let target_text_id = create_node(TAG_TEXT);
    if target_text_id == 0 {
        ext_dom_free_node((wrapper_id & 0xFFFF) as u32);
        return -1;
    }
    
    let suffix_id = create_node(TAG_TEXT);
    if suffix_id == 0 {
        ext_dom_free_node((wrapper_id & 0xFFFF) as u32);
        ext_dom_free_node((target_text_id & 0xFFFF) as u32);
        return -1;
    }
    
    let wrapper_idx = (wrapper_id & 0xFFFF) as u32;
    let target_text_idx = (target_text_id & 0xFFFF) as u32;
    let suffix_idx = (suffix_id & 0xFFFF) as u32;
    
    // 2. Configure Wrapper Element
    // create_node already set tag and initial styles.
    DOM_NODE_PARENT[wrapper_idx as usize] = DOM_NODE_PARENT[text_node_id as usize];
    STYLE_PARENT[wrapper_idx as usize] = STYLE_PARENT[text_node_id as usize];
    
    // 3. Configure Target Text Node (The highlighted text)
    DOM_NODE_PARENT[target_text_idx as usize] = wrapper_id;
    STYLE_PARENT[target_text_idx as usize] = wrapper_idx;
    DOM_TEXT_PTR[target_text_idx as usize] = original_ptr + (start_idx as u64);
    DOM_TEXT_LEN[target_text_idx as usize] = end_idx - start_idx;
    
    // 4. Configure Suffix Text Node
    DOM_NODE_PARENT[suffix_idx as usize] = DOM_NODE_PARENT[text_node_id as usize];
    STYLE_PARENT[suffix_idx as usize] = STYLE_PARENT[text_node_id as usize];
    DOM_TEXT_PTR[suffix_idx as usize] = original_ptr + (end_idx as u64);
    DOM_TEXT_LEN[suffix_idx as usize] = original_len - end_idx;
    
    // 5. Mutate Original Node into Prefix
    DOM_TEXT_LEN[text_node_id as usize] = start_idx; 
    
    // 6. Execute Sibling Stitcher
    dom_stitch_siblings_after_split(text_node_id, wrapper_id, target_text_id, suffix_id);
    
    // 7. Flag Layout Recalculation
    let parent_idx = STYLE_PARENT[text_node_id as usize];
    if parent_idx != 999999 {
        invalidate_layout(parent_idx);
    }
    
    return wrapper_idx as i32;
}

fn dom_stitch_siblings_after_split(prefix_idx: u32, wrapper_id: u64, target_id: u64, suffix_id: u64) {
    let wrapper_idx = (wrapper_id & 0xFFFF) as u32;
    let target_idx = (target_id & 0xFFFF) as u32;
    let suffix_idx = (suffix_id & 0xFFFF) as u32;
    
    let original_next = DOM_NODE_NEXT_SIBLING[prefix_idx as usize];
    let parent_id = DOM_NODE_PARENT[prefix_idx as usize];
    let parent_idx = STYLE_PARENT[prefix_idx as usize];
    
    // Nest the target inside the wrapper
    DOM_NODE_FIRST_CHILD[wrapper_idx as usize] = target_id;
    DOM_LAST_CHILD[wrapper_idx as usize] = target_idx;
    // target info already set in ext_dom_wrap_text_range
    
    // Link Prefix -> Wrapper
    DOM_NODE_NEXT_SIBLING[prefix_idx as usize] = wrapper_id;
    let prefix_gen = DOM_NODE_GENERATION[prefix_idx as usize] as u64;
    DOM_NODE_PREV_SIBLING[wrapper_idx as usize] = (prefix_idx as u64) | (prefix_gen << 16);
    
    // Link Wrapper -> Suffix
    DOM_NODE_NEXT_SIBLING[wrapper_idx as usize] = suffix_id;
    DOM_NODE_PREV_SIBLING[suffix_idx as usize] = wrapper_id;
    
    // Link Suffix -> Original Next Sibling
    DOM_NODE_NEXT_SIBLING[suffix_idx as usize] = original_next;
    if original_next != 0 {
        let next_idx = (original_next & 0xFFFF) as u32;
        DOM_NODE_PREV_SIBLING[next_idx as usize] = suffix_id;
    } else {
        // We were the last child, now suffix is the last child
        if parent_idx != 999999 {
            DOM_LAST_CHILD[parent_idx as usize] = suffix_idx;
        }
    }
}

// Called by the C-bridge when QuickJS GC collects a PrisimiNode JSValue.
// Performs: tree detach → recursive child reclaim → sanitize → push to free-list.
@no_mangle
pub fn ext_dom_free_node(node_idx: u32) {
    if node_idx == 0 || node_idx >= 65536 { return; }
    let c = node_idx as usize;
    
    // Epic 51: JS wrapper GC should NOT destroy native nodes that are still attached to the DOM
    if DOM_NODE_PARENT[c] != 0 || node_idx == 1 { return; }
    
    // 1. Tree Healing: detach from parent's sibling chain
    let parent = STYLE_PARENT[c];
    if parent != 999999 && parent < 65536 {
        let p = parent as usize;
        let first = DOM_NODE_FIRST_CHILD[p];
        if first != 0 {
            let first_idx = (first & 0xFFFF) as u32;
            if first_idx == node_idx {
                // Removing the first child — advance parent's first-child pointer
                DOM_NODE_FIRST_CHILD[p] = DOM_NODE_NEXT_SIBLING[c];
                if DOM_LAST_CHILD[p] == node_idx {
                    DOM_LAST_CHILD[p] = 0;
                }
            } else {
                // Walk to find the previous sibling
                let mut prev_id = first;
                let mut found: u32 = 0;
                while prev_id != 0 && found == 0 {
                    let prev_idx = (prev_id & 0xFFFF) as u32;
                    if prev_idx >= 65536 { prev_id = 0; }
                    else {
                        let next = DOM_NODE_NEXT_SIBLING[prev_idx as usize];
                        let next_idx = (next & 0xFFFF) as u32;
                        if next_idx == node_idx {
                            // Patch: prev.next = child.next
                            DOM_NODE_NEXT_SIBLING[prev_idx as usize] = DOM_NODE_NEXT_SIBLING[c];
                            if DOM_LAST_CHILD[p] == node_idx {
                                DOM_LAST_CHILD[p] = prev_idx;
                            }
                            found = 1;
                        } else {
                            prev_id = next;
                        }
                    }
                }
            }
        }
        invalidate_layout(p);
        
        if observers.sys_is_node_observed_for(parent, 1 /* Mutation */) {
            observers.sys_queue_mutation_record(node_idx, 2 /* removal */);
        }
    }
    
    // 2. Clear our own parent/sibling linkage before recursing
    DOM_NODE_PARENT[c] = 0;
    DOM_NODE_NEXT_SIBLING[c] = 0;
    STYLE_PARENT[c] = 999999;
    
    // 3. Recursively reclaim the entire subtree (children first, then self)
    reclaim_subtree(node_idx);
}

@no_mangle
pub fn bind_attribute(node_id: u64, key_ptr: u64, key_len: u32, val_ptr: u64, val_len: u32) -> u32 {
    let idx = ATTR_COUNT;
    if idx >= 262144 { return 0; }
    let u_idx = idx as usize;
    ATTR_NODE_ID[u_idx] = node_id;
    ATTR_KEY_PTR[u_idx] = key_ptr;
    ATTR_KEY_LEN[u_idx] = key_len;
    ATTR_VAL_PTR[u_idx] = val_ptr;
    ATTR_VAL_LEN[u_idx] = val_len;
    ATTR_COUNT = ATTR_COUNT + 1;
    return idx;
}

