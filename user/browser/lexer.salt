// ============================================================================
// Tag Name Matcher
// ============================================================================
// Compares bytes at html_ptr[start..start+len] against known tag strings.
// Returns the TAG_ID constant matching dom.salt values.

fn match_tag(html_ptr: u64, start: u32, len: u32) -> i32 {
    if len == 0 { return 4; } // TAG_DIV default
    let p = html_ptr + (start as u64);
    
    // Convert first byte to lowercase (ASCII OR 0x20)
    let b0 = *((p) as &u8) | 32;
    
    if len == 1 {
        if b0 == 112 { return 6; }  // 'p' -> TAG_P
        if b0 == 97 { return 7; }   // 'a' -> TAG_A
        if b0 == 98 { return 15; }  // 'b' -> TAG_B
        if b0 == 105 { return 16; } // 'i' -> TAG_I
        if b0 == 117 { return 96; } // 'u' hasn't been implemented specifically, but return 96 so we keep the tag
        return 96;
    }
    if len == 2 {
        let b1 = *((p + 1) as &u8) | 32;
        if b0 == 104 && b1 == 49 { return 9; } // 'h1' -> TAG_H1
        if b0 == 116 && b1 == 114 { return 13; } // 'tr' -> TAG_TR
        if b0 == 116 && b1 == 100 { return 14; } // 'td' -> TAG_TD
        return 96;
    }
    if len == 3 {
        let b1 = *((p + 1) as &u8) | 32;
        let b2 = *((p + 2) as &u8) | 32;
        if b0 == 100 && b1 == 105 && b2 == 118 { return 4; } // 'div' -> TAG_DIV
        if b0 == 105 && b1 == 109 && b2 == 103 { return 8; } // 'img' -> TAG_IMG
        return 96;
    }
    if len == 4 {
        let b1 = *((p + 1) as &u8) | 32;
        let b2 = *((p + 2) as &u8) | 32;
        let b3 = *((p + 3) as &u8) | 32;
        if b0 == 115 && b1 == 112 && b2 == 97 && b3 == 110 { return 5; }  // 'span' -> TAG_SPAN
        if b0 == 104 && b1 == 116 && b2 == 109 && b3 == 108 { return 1; } // 'html' -> TAG_HTML
        if b0 == 104 && b1 == 101 && b2 == 97 && b3 == 100 { return 2; }  // 'head' -> TAG_HEAD
        if b0 == 98 && b1 == 111 && b2 == 100 && b3 == 121 { return 3; }  // 'body' -> TAG_BODY
        if b0 == 102 && b1 == 111 && b2 == 110 && b3 == 116 { return 17; } // 'font' -> TAG_FONT
        return 96;
    }
    if len == 5 {
        let b1 = *((p + 1) as &u8) | 32;
        let b2 = *((p + 2) as &u8) | 32;
        let b3 = *((p + 3) as &u8) | 32;
        let b4 = *((p + 4) as &u8) | 32;
        if b0 == 116 && b1 == 97 && b2 == 98 && b3 == 108 && b4 == 101 { return 12; } // 'table' -> TAG_TABLE
        // 'style' -> 98
        if b0 == 115 && b1 == 116 && b2 == 121 && b3 == 108 && b4 == 101 { return 98; }
        if b0 == 118 && b1 == 105 && b2 == 100 && b3 == 101 && b4 == 111 { return 25; } // 'video' -> TAG_VIDEO
        if b0 == 105 && b1 == 110 && b2 == 112 && b3 == 117 && b4 == 116 { return 18; } // 'input' -> TAG_INPUT
        return 96;
    }
    if len == 6 {
        let b1 = *((p + 1) as &u8) | 32;
        let b2 = *((p + 2) as &u8) | 32;
        let b3 = *((p + 3) as &u8) | 32;
        let b4 = *((p + 4) as &u8) | 32;
        let b5 = *((p + 5) as &u8) | 32;
        // 'script' -> 99
        if b0 == 115 && b1 == 99 && b2 == 114 && b3 == 105 && b4 == 112 && b5 == 116 { return 99; }
        // 'center' -> 11
        if b0 == 99 && b1 == 101 && b2 == 110 && b3 == 116 && b4 == 101 && b5 == 114 { return 11; }
        // Epic 69: 'iframe' -> TAG_IFRAME=26
        if b0 == 105 && b1 == 102 && b2 == 114 && b3 == 97 && b4 == 109 && b5 == 101 { return 26; }
        // 'canvas' -> TAG_CANVAS=27
        if b0 == 99 && b1 == 97 && b2 == 110 && b3 == 118 && b4 == 97 && b5 == 115 { return 27; }
        // 'button' -> TAG_BUTTON=20
        if b0 == 98 && b1 == 117 && b2 == 116 && b3 == 116 && b4 == 111 && b5 == 110 { return 20; }
        // 'strong' -> TAG_STRONG=17 (reuse font slot since font isn't needed anymore)
        if b0 == 115 && b1 == 116 && b2 == 114 && b3 == 111 && b4 == 110 && b5 == 103 { return 17; }
        return 96;
    }
    return 96; // TAG_CUSTOM_ELEMENT default instead of 4
}

fn fnv1a_hash_bytes(html_ptr: u64, start: u32, len: u32) -> u32 {
    let mut hash: u32 = 2166136261;
    let mut i: u32 = 0;
    while i < len {
        let mut b = *((html_ptr + (start + i) as u64) as &u8);
        if b >= 65 && b <= 90 {
            b = b + 32; // Lowercase for consistent JS custom element hashing
        }
        hash = hash ^ (b as u32);
        hash = hash * 16777619;
        i = i + 1;
    }
    return hash;
}

// W3C Void Elements — do NOT push onto parent stack
fn is_void_element(tag: i32) -> bool {
    // meta(4/generic), link(4/generic), img=8, br(4/generic), input(4/generic), hr(4/generic)
    // We check tag IDs: IMG=8. For others not in our tag table, they map to TAG_DIV=4.
    // Specific void tag name check needed. We use the raw tag_len + first bytes instead.
    // This function is called with the matched tag ID.
    if tag == 8 { return true; } // IMG
    return false;
}

// Check if tag name bytes represent a void element not in our tag table
fn is_void_tag_name(html_ptr: u64, start: u32, len: u32) -> bool {
    let p = html_ptr + (start as u64);
    let b0 = *((p) as &u8) | 32;
    
    if len == 2 {
        let b1 = *((p + 1) as &u8) | 32;
        if b0 == 98 && b1 == 114 { return true; } // 'br'
        if b0 == 104 && b1 == 114 { return true; } // 'hr'
        return false;
    }
    if len == 3 {
        let b1 = *((p + 1) as &u8) | 32;
        let b2 = *((p + 2) as &u8) | 32;
        if b0 == 105 && b1 == 109 && b2 == 103 { return true; } // 'img'
        if b0 == 99 && b1 == 111 && b2 == 108 { return true; } // 'col'
        return false;
    }
    if len == 4 {
        let b1 = *((p + 1) as &u8) | 32;
        let b2 = *((p + 2) as &u8) | 32;
        let b3 = *((p + 3) as &u8) | 32;
        if b0 == 109 && b1 == 101 && b2 == 116 && b3 == 97 { return true; } // 'meta'
        if b0 == 108 && b1 == 105 && b2 == 110 && b3 == 107 { return true; } // 'link'
        return false;
    }
    if len == 5 {
        let b1 = *((p + 1) as &u8) | 32;
        let b2 = *((p + 2) as &u8) | 32;
        let b3 = *((p + 3) as &u8) | 32;
        let b4 = *((p + 4) as &u8) | 32;
        if b0 == 105 && b1 == 110 && b2 == 112 && b3 == 117 && b4 == 116 { return true; } // 'input'
        return false;
    }
    return false;
}

// ============================================================================
// Matches an attribute key at html_ptr[start..start+len] against "id"
// ============================================================================
fn is_attr_id(html_ptr: u64, start: u32, len: u32) -> bool {
    if len != 2 { return false; }
    let p = html_ptr + (start as u64);
    let b0 = *((p) as &u8) | 32;
    let b1 = *((p + 1) as &u8) | 32;
    return b0 == 105 && b1 == 100; // 'id'
}

fn is_attr_class(html_ptr: u64, start: u32, len: u32) -> bool {
    if len != 5 { return false; }
    let p = html_ptr + (start as u64);
    let b0 = *((p) as &u8) | 32;
    let b1 = *((p + 1) as &u8) | 32;
    let b2 = *((p + 2) as &u8) | 32;
    let b3 = *((p + 3) as &u8) | 32;
    let b4 = *((p + 4) as &u8) | 32;
    return b0 == 99 && b1 == 108 && b2 == 97 && b3 == 115 && b4 == 115; // 'class'
}

fn is_attr_src(html_ptr: u64, start: u32, len: u32) -> bool {
    if len != 3 { return false; }
    let p = html_ptr + (start as u64);
    let b0 = *((p) as &u8) | 32;
    let b1 = *((p + 1) as &u8) | 32;
    let b2 = *((p + 2) as &u8) | 32;
    return b0 == 115 && b1 == 114 && b2 == 99; // 'src'
}

fn is_match_bgcolor(html_ptr: u64, start: u32, len: u32) -> bool {
    if len != 7 { return false; }
    let p = html_ptr + (start as u64);
    let b0 = *((p) as &u8) | 32;
    let b1 = *((p + 1) as &u8) | 32;
    let b2 = *((p + 2) as &u8) | 32;
    let b3 = *((p + 3) as &u8) | 32;
    let b4 = *((p + 4) as &u8) | 32;
    let b5 = *((p + 5) as &u8) | 32;
    let b6 = *((p + 6) as &u8) | 32;
    return b0 == 98 && b1 == 103 && b2 == 99 && b3 == 111 && b4 == 108 && b5 == 111 && b6 == 114; // 'bgcolor'
}

fn is_match_color(html_ptr: u64, start: u32, len: u32) -> bool {
    if len != 5 { return false; }
    let p = html_ptr + (start as u64);
    let b0 = *((p) as &u8) | 32;
    let b1 = *((p + 1) as &u8) | 32;
    let b2 = *((p + 2) as &u8) | 32;
    let b3 = *((p + 3) as &u8) | 32;
    let b4 = *((p + 4) as &u8) | 32;
    return b0 == 99 && b1 == 111 && b2 == 108 && b3 == 111 && b4 == 114; // 'color'
}

fn is_match_align(html_ptr: u64, start: u32, len: u32) -> bool {
    if len != 5 { return false; }
    let p = html_ptr + (start as u64);
    let b0 = *((p) as &u8) | 32;
    let b1 = *((p + 1) as &u8) | 32;
    let b2 = *((p + 2) as &u8) | 32;
    let b3 = *((p + 3) as &u8) | 32;
    let b4 = *((p + 4) as &u8) | 32;
    return b0 == 97 && b1 == 108 && b2 == 105 && b3 == 103 && b4 == 110; // 'align'
}

fn is_match_right(html_ptr: u64, start: u32, len: u32) -> bool {
    if len != 5 { return false; }
    let p = html_ptr + (start as u64);
    let b0 = *((p) as &u8) | 32;
    let b1 = *((p + 1) as &u8) | 32;
    let b2 = *((p + 2) as &u8) | 32;
    let b3 = *((p + 3) as &u8) | 32;
    let b4 = *((p + 4) as &u8) | 32;
    return b0 == 114 && b1 == 105 && b2 == 103 && b3 == 104 && b4 == 116; // 'right'
}

fn is_match_width(html_ptr: u64, start: u32, len: u32) -> bool {
    if len != 5 { return false; }
    let p = html_ptr + (start as u64);
    let b0 = *((p) as &u8) | 32;
    let b1 = *((p + 1) as &u8) | 32;
    let b2 = *((p + 2) as &u8) | 32;
    let b3 = *((p + 3) as &u8) | 32;
    let b4 = *((p + 4) as &u8) | 32;
    return b0 == 119 && b1 == 105 && b2 == 100 && b3 == 116 && b4 == 104; // 'width'
}

fn is_match_height(html_ptr: u64, start: u32, len: u32) -> bool {
    if len != 6 { return false; }
    let p = html_ptr + (start as u64);
    let b0 = *((p) as &u8) | 32;
    let b1 = *((p + 1) as &u8) | 32;
    let b2 = *((p + 2) as &u8) | 32;
    let b3 = *((p + 3) as &u8) | 32;
    let b4 = *((p + 4) as &u8) | 32;
    let b5 = *((p + 5) as &u8) | 32;
    return b0 == 104 && b1 == 101 && b2 == 105 && b3 == 103 && b4 == 104 && b5 == 116; // 'height'
}

fn parse_positive_int(ptr: u64, len: u32) -> i32 {
    let mut val: u32 = 0;
    let mut i: u32 = 0;
    let mut found = false;
    while i < len {
        let b = *((ptr + i as u64) as &u8);
        if b >= 48 && b <= 57 { // '0' to '9'
            val = (val * 10) + ((b - 48) as u32);
            found = true;
        } else {
            break;
        }
        i = i + 1;
    }
    if found { return val as i32; }
    return -1;
}

// ============================================================================
// HTML Lexer — Full state machine with tag matching, attributes, and nesting
// ============================================================================
// States:
//   0 = DATA       — reading text/whitespace between tags
//   1 = TAG_OPEN   — just saw '<', deciding open vs close
//   2 = TAG_NAME   — accumulating tag name bytes
//   3 = ATTR_SPACE — in whitespace between attributes
//   4 = ATTR_NAME  — accumulating attribute key bytes
//   5 = ATTR_EQ    — just saw '=', expecting quote
//   6 = ATTR_VAL   — inside quoted attribute value
//   7 = CLOSE_TAG  — inside </tag>, reading tag name to skip
//   8 = CLOSE_SKIP — skipping until '>' in close tag

@no_mangle
pub fn lex_html(html_ptr: u64, max_len: u32, root_id: u64, can_execute: u8) {
    let mut i: u32 = 0;
    let mut state: u32 = 0;
    
    let mut tag_start: u32 = 0;
    let mut tag_len: u32 = 0;
    let mut text_start: u32 = 0;
    let mut text_len: u32 = 0;
    
    let mut attr_key_start: u32 = 0;
    let mut attr_key_len: u32 = 0;
    let mut attr_val_start: u32 = 0;
    let mut attr_val_len: u32 = 0;
    
    let mut current_parent = root_id;
    let mut current_node: u64 = 0;
    let mut current_tag: i32 = 0;
    let mut is_self_closing = false;
    let mut quote_char: u8 = 0; // Track which quote opened the attr value
    
    while i < max_len {
        let b = *((html_ptr + i as u64) as &u8);
        
        if state == 0 { // DATA
            if b == 60 { // '<'
                let mut is_closing_raw = false;
                if current_tag == 99 || current_tag == 98 {
                    // Epic 76: RAW_TEXT mode! If inside <script> or <style>, 
                    // ONLY allow '<' to open a tag if it's followed by '/'
                    if i + 1 < max_len {
                        let next_b = *((html_ptr + (i + 1) as u64) as &u8);
                        if next_b == 47 { // '/'
                            is_closing_raw = true;
                        }
                    }
                } else {
                    is_closing_raw = true; // Not raw text, allow child tags
                }
                
                if is_closing_raw {
                    if text_len > 0 {
                        let txt = create_text_node(html_ptr + text_start as u64, text_len);
                        js_set_node_executable(txt, can_execute);
                        append_child(current_parent, txt);
                        text_len = 0;
                    }
                    state = 1;
                } else {
                    // Inside script/style, treat '<' as raw DATA byte
                    if text_len == 0 { text_start = i; }
                    text_len = text_len + 1;
                }
            } else {
                if text_len == 0 { text_start = i; }
                text_len = text_len + 1;
            }
        } else if state == 1 { // TAG_OPEN
            if b == 47 { // '/' (closing tag)
                state = 7; // CLOSE_TAG
                tag_start = i + 1;
                tag_len = 0;
            } else if b == 33 { // '!' — DOCTYPE or comment → skip to '>'
                // Consume everything until we see '>'
                i = i + 1;
                while i < max_len {
                    if *((html_ptr + i as u64) as &u8) == 62 { // '>'
                        break;
                    }
                    i = i + 1;
                }
                state = 0; // Return to DATA — no node created, no parent pushed
            } else {
                tag_start = i;
                tag_len = 1;
                state = 2; // TAG_NAME
            }
        } else if state == 2 { // TAG_NAME
            if b == 62 || b == 32 || b == 47 { // '>' or space or '/'
                let tag = match_tag(html_ptr, tag_start, tag_len);
                current_tag = tag;
                let is_void = is_void_tag_name(html_ptr, tag_start, tag_len);
                is_self_closing = (b == 47);
                current_node = create_node(tag);
                if tag == 96 {
                    let hash = fnv1a_hash_bytes(html_ptr, tag_start, tag_len);
                    let node_idx = resolve_node(current_node);
                    if node_idx != 0xFFFFFFFF {
                        dom_set_custom_tag(node_idx, hash, html_ptr + tag_start as u64, tag_len);
                    }
                }
                js_set_node_executable(current_node, can_execute);
                append_child(current_parent, current_node);
                
                if b == 62 {
                    // Only push as parent if NOT a void element
                    if !is_void && !is_self_closing {
                        current_parent = current_node;
                    }
                    state = 0;
                } else if b == 47 {
                    // Self-closing tag start, wait for '>'
                    is_self_closing = true;
                    state = 3; // go to ATTR_SPACE to find the '>'
                } else {
                    state = 3; // ATTR_SPACE
                }
            } else {
                tag_len = tag_len + 1;
            }
        } else if state == 3 { // ATTR_SPACE — whitespace between attributes
            if b == 62 { // '>'
                let is_void = is_void_tag_name(html_ptr, tag_start, tag_len);
                if !is_void && !is_self_closing {
                    current_parent = current_node;
                }
                is_self_closing = false;
                state = 0;
            } else if b == 47 { // '/' — self-closing like <br/> or <tr .../>
                is_self_closing = true;
            } else if b != 32 && b != 9 && b != 10 && b != 13 { // not whitespace
                attr_key_start = i;
                attr_key_len = 1;
                state = 4; // ATTR_NAME
            }
        } else if state == 4 { // ATTR_NAME
            if b == 61 { // '='
                state = 5; // ATTR_EQ
            } else if b == 32 || b == 62 || b == 47 { // space or '>' or '/'
                // Boolean attribute (no value)
                bind_attribute(
                    current_node,
                    html_ptr + attr_key_start as u64, attr_key_len,
                    0, 0
                );
                if b == 62 {
                    let is_void = is_void_tag_name(html_ptr, tag_start, tag_len);
                    if !is_void && !is_self_closing {
                        current_parent = current_node;
                    }
                    is_self_closing = false;
                    state = 0;
                } else if b == 47 {
                    is_self_closing = true;
                    state = 3;
                } else {
                    state = 3;
                }
            } else {
                attr_key_len = attr_key_len + 1;
            }
        } else if state == 5 { // ATTR_EQ — expecting opening quote or unquoted value
            if b == 34 || b == 39 { // '"' or '\''
                quote_char = b; // Remember which quote opened
                attr_val_start = i + 1;
                attr_val_len = 0;
                state = 6; // ATTR_VAL
            } else if b == 62 { // '>' before any value — malformed, bailout
                let is_void = is_void_tag_name(html_ptr, tag_start, tag_len);
                if !is_void && !is_self_closing {
                    current_parent = current_node;
                }
                is_self_closing = false;
                state = 0;
            } else if b != 32 && b != 9 && b != 10 && b != 13 { // Unquoted attr value
                attr_val_start = i;
                attr_val_len = 1;
                quote_char = 0; // No quote — terminate on space or >
                state = 6;
            }
        } else if state == 6 { // ATTR_VAL — inside (quoted or unquoted) value
            let is_close = if quote_char != 0 { b == quote_char } else { b == 32 || b == 62 || b == 9 || b == 10 || b == 13 };
            if is_close {
                // Emit attribute
                bind_attribute(
                    current_node,
                    html_ptr + attr_key_start as u64, attr_key_len,
                    html_ptr + attr_val_start as u64, attr_val_len
                );
                // Special handling: if key is "id", also call js_set_id
                if is_attr_id(html_ptr, attr_key_start, attr_key_len) {
                    js_set_id(current_node, html_ptr + attr_val_start as u64, attr_val_len);
                }
                // Special handling: if key is "class", also call js_set_class
                if is_attr_class(html_ptr, attr_key_start, attr_key_len) {
                    js_set_class(current_node, html_ptr + attr_val_start as u64, attr_val_len);
                }
                // Epic 61: If key is "src" on a <script>, track the external URL
                if is_attr_src(html_ptr, attr_key_start, attr_key_len) {
                    if current_tag == 99 { // TAG_SCRIPT
                        let src_node_idx = resolve_node(current_node);
                        if src_node_idx != 0xFFFFFFFF {
                            // Store src pointer into the DOM SoA arrays
                            dom_set_script_src(src_node_idx, html_ptr + attr_val_start as u64, attr_val_len);
                        }
                    }
                    // Epic 69: If key is "src" on an <iframe>, track the URL in iframe SoA
                    if current_tag == 26 { // TAG_IFRAME
                        let ifr_node_idx = resolve_node(current_node);
                        if ifr_node_idx != 0xFFFFFFFF {
                            let ifr_slot = dom_register_iframe(ifr_node_idx);
                            if ifr_slot != 0xFFFFFFFF {
                                dom_set_iframe_src(ifr_slot, html_ptr + attr_val_start as u64, attr_val_len);
                            }
                        }
                    }
                }
                
                // Legacy HTML Attributes mapping at Specificity 0
                if is_match_bgcolor(html_ptr, attr_key_start, attr_key_len) {
                    let mut hex_start = html_ptr + attr_val_start as u64;
                    if *((hex_start) as &u8) == 35 { hex_start = hex_start + 1; } // Skip '#'
                    let mut r: u8 = 0; let mut g: u8 = 0; let mut b: u8 = 0;
                    parse_hex_to_rgb(hex_start, &mut r, &mut g, &mut b);
                    let bg_idx = resolve_node(current_node);
                    dom_set_style_bg(bg_idx, r, g, b);
                    dom_set_spec_bg(bg_idx, 0); // Tier 0
                } else if is_match_color(html_ptr, attr_key_start, attr_key_len) {
                    let mut hex_start = html_ptr + attr_val_start as u64;
                    if *((hex_start) as &u8) == 35 { hex_start = hex_start + 1; } // Skip '#'
                    let mut r: u8 = 0; let mut g: u8 = 0; let mut b: u8 = 0;
                    parse_hex_to_rgb(hex_start, &mut r, &mut g, &mut b);
                    let color_idx = resolve_node(current_node);
                    dom_set_style_color(color_idx, r, g, b);
                    dom_set_spec_color(color_idx, 0); // Tier 0
                } else if is_match_align(html_ptr, attr_key_start, attr_key_len) {
                    if is_match_right(html_ptr, attr_val_start, attr_val_len) {
                        let align_idx = resolve_node(current_node);
                        dom_set_style_text_align(align_idx, 1);
                        dom_set_spec_text_align(align_idx, 0);
                    }
                } else if is_match_width(html_ptr, attr_key_start, attr_key_len) {
                    let mut unit: u8 = 0; // UNIT_PX
                    let mut parse_len = attr_val_len;
                    if attr_val_len > 0 {
                        let last_byte_ptr = html_ptr + (attr_val_start + attr_val_len - 1) as u64;
                        if *((last_byte_ptr) as &u8) == 37 {
                            unit = 1; // UNIT_PERCENT
                            parse_len = parse_len - 1;
                        }
                    }
                    let parsed_val = parse_positive_int(html_ptr + attr_val_start as u64, parse_len);
                    if parsed_val > 0 {
                        let w_idx = resolve_node(current_node);
                        dom_set_style_width(w_idx, parsed_val);
                        dom_set_style_w_unit(w_idx, unit);
                        dom_set_spec_width(w_idx, 0);
                    }
                } else if is_match_height(html_ptr, attr_key_start, attr_key_len) {
                    let mut unit: u8 = 0; // UNIT_PX
                    let mut parse_len = attr_val_len;
                    if attr_val_len > 0 {
                        let last_byte_ptr = html_ptr + (attr_val_start + attr_val_len - 1) as u64;
                        if *((last_byte_ptr) as &u8) == 37 {
                            unit = 1; // UNIT_PERCENT
                            parse_len = parse_len - 1;
                        }
                    }
                    let parsed_val = parse_positive_int(html_ptr + attr_val_start as u64, parse_len);
                    if parsed_val > 0 {
                        let h_idx = resolve_node(current_node);
                        dom_set_style_height(h_idx, parsed_val);
                        dom_set_style_h_unit(h_idx, unit);
                        dom_set_spec_height(h_idx, 0);
                    }
                }
                

                // If unquoted value closed by '>', also close the tag
                if quote_char == 0 && b == 62 {
                    let is_void = is_void_tag_name(html_ptr, tag_start, tag_len);
                    if !is_void && !is_self_closing {
                        current_parent = current_node;
                    }
                    is_self_closing = false;
                    state = 0;
                } else {
                    state = 3; // back to ATTR_SPACE
                }
            } else {
                attr_val_len = attr_val_len + 1;
            }
        } else if state == 7 { // CLOSE_TAG — accumulating close tag name
            if b == 62 { // '>'
                let tag = match_tag(html_ptr, tag_start, tag_len);
                if tag == 99 && can_execute == 1 { // SCRIPT
                    let script_node_idx = resolve_node(current_parent);
                    let ext_src_ptr = dom_get_script_src_ptr(script_node_idx);
                    let ext_src_len = dom_get_script_src_len(script_node_idx);
                    
                    if ext_src_ptr != 0 && ext_src_len > 0 {
                        // Epic 61: External <script src="..."> — queue and dispatch
                        let fetch_id = queue_script_fetch(ext_src_ptr, ext_src_len);
                        if fetch_id != 0 {
                            // Multiplex: set bit 60 to mark this as a script fetch
                            let mut script_bit: u64 = 1;
                            script_bit = script_bit << 60;
                            let multiplexed_id = script_bit | fetch_id;
                            sys_ipc_send_r2m_command_with_payload(12 /* CMD_FETCH_REQUEST */, multiplexed_id, ext_src_ptr, ext_src_len);
                        }
                    } else {
                        // Inline <script> — existing path
                        let c_id = dom_get_first_child(resolve_node(current_parent));
                        if c_id != 0 {
                            let c_idx = resolve_node(c_id);
                            if c_idx != 0xFFFFFFFF {
                                let text_ptr = dom_get_text_ptr(c_idx);
                                let ptr_len = dom_get_text_len(c_idx);
                                if ptr_len > 0 {
                                    js_queue_script(text_ptr, ptr_len);
                                }
                            }
                        }
                    }
                }
                if tag == 98 { // STYLE
                    let s_id = dom_get_first_child(resolve_node(current_parent));
                    if s_id != 0 {
                        let s_idx = resolve_node(s_id);
                        if s_idx != 0xFFFFFFFF {
                            let text_ptr = dom_get_text_ptr(s_idx);
                            let ptr_len = dom_get_text_len(s_idx);
                            if ptr_len > 0 {
                                let scope_id = dom_get_scope_idx(s_idx);
                                css_lex_stylesheet(text_ptr, ptr_len, scope_id);
                            }
                        }
                    }
                }
                // Epic 69: On </iframe>, emit CMD_SPAWN_IFRAME to Main Process
                if tag == 26 { // TAG_IFRAME
                    let ifr_node_idx = resolve_node(current_parent);
                    if ifr_node_idx != 0xFFFFFFFF {
                        // Find the iframe slot for this node
                        let mut ifr_slot: u32 = 0xFFFFFFFF;
                        let mut ifr_s: u32 = 0;
                        while ifr_s < 256 {
                            // Linear scan — 256 slots is trivial
                            ifr_s = ifr_s + 1;
                        }
                        // Use node_idx as arg1 so Main Process can route the surface back
                        // Payload = iframe src URL bytes
                        // We need to find which slot has this node — walk DOM_IFRAME_NODE_ID
                        ifr_s = 0;
                        while ifr_s < 256 {
                            // Extern arrays not accessible here, use dom_get_iframe_src approach
                            ifr_s = ifr_s + 1;
                        }
                        // Simplified: emit CMD_SPAWN_IFRAME=4 with node_idx
                        // The src URL was already stored by dom_set_iframe_src, main process reads it
                        sys_ipc_send_r2m_command_with_payload(4, ifr_node_idx as u64, 0, 0);
                    }
                }
                
                // Pop parent: go back up the tree
                current_parent = js_dom_get_parent(current_parent);
                if current_parent == 0 { current_parent = root_id; }
                // CRITICAL: Reset current_tag to exit RAW_TEXT mode.
                // Without this, closing </script> leaves current_tag=99,
                // causing all subsequent '<' chars to be treated as raw text.
                current_tag = 0;
                state = 0;
            } else {
                tag_len = tag_len + 1;
            }
        }
        
        i = i + 1;
    }
    
    // Flush any trailing text
    if text_len > 0 {
        let txt = create_text_node(html_ptr + text_start as u64, text_len);
        js_set_node_executable(txt, can_execute);
        append_child(current_parent, txt);
    }
}

@no_mangle
pub fn js_lex_html_chunk(root_id: u64, ptr: u64, len: u32, can_execute: u8) {
    lex_html(ptr, len, root_id, can_execute);
}
