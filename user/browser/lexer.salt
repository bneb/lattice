package user.browser.lexer


pub global LEX_STATE: u32 = 0;
pub global LEX_TAG_BUF: [u8; 128] = [0; 128];
pub global LEX_TAG_LEN: u32 = 0;
pub global LEX_ATTR_KEY_BUF: [u8; 128] = [0; 128];
pub global LEX_ATTR_KEY_LEN: u32 = 0;
pub global LEX_ATTR_VAL_BUF: [u8; 4096] = [0; 4096];
pub global LEX_ATTR_VAL_LEN: u32 = 0;
pub global LEX_TEXT_BUF: [u8; 16384] = [0; 16384];
pub global LEX_TEXT_LEN: u32 = 0;

pub global LEX_CURRENT_PARENT: u64 = 0;
pub global LEX_CURRENT_NODE: u64 = 0;
pub global LEX_CURRENT_TAG: i32 = 0;
pub global LEX_IS_SELF_CLOSING: u8 = 0;
pub global LEX_QUOTE_CHAR: u8 = 0;

pub global LEX_INITIALIZED: u8 = 0;

// W3C HTML5 Script Data State Machine (§8.2.4.6)
// 0 = SCRIPT_DATA           — normal script content, </script> closes
// 1 = SCRIPT_DATA_ESCAPED   — after <!--, </script> does NOT close
// 2 = SCRIPT_DATA_DOUBLE_ESCAPED — after <script inside escaped
pub global LEX_SCRIPT_STATE: u8 = 0;

// Consecutive dash counter for --> detection in escaped state
pub global LEX_DASH_COUNT: u8 = 0;


