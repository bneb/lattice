// ============================================================================
// Tag Name Matcher
// ============================================================================
// Compares bytes at html_ptr[start..start+len] against known tag strings.
// Returns the TAG_ID constant matching dom.salt values.



fn get_tag_buf_ptr() -> u64 { return (&LEX_TAG_BUF) as u64; }
fn get_akey_buf_ptr() -> u64 { return (&LEX_ATTR_KEY_BUF) as u64; }
fn get_aval_buf_ptr() -> u64 { return (&LEX_ATTR_VAL_BUF) as u64; }
fn get_txt_buf_ptr() -> u64 { return (&LEX_TEXT_BUF) as u64; }

fn get_tag_byte(idx: u32) -> u8 {
    let ptr = get_tag_buf_ptr();
    return *((ptr + (idx as u64)) as &u8);
}
fn get_attr_key_byte(idx: u32) -> u8 {
    let ptr = get_akey_buf_ptr();
    return *((ptr + (idx as u64)) as &u8);
}
fn get_attr_val_byte(idx: u32) -> u8 {
    let ptr = get_aval_buf_ptr();
    return *((ptr + (idx as u64)) as &u8);
}

fn match_tag(len: u32) -> i32 {
    if len == 0 { return 4; } // TAG_DIV default
    let b0 = get_tag_byte(0) | 32;
    
    if len == 1 {
        if b0 == 112 { return 6; }  // 'p' -> TAG_P
        if b0 == 97 { return 7; }   // 'a' -> TAG_A
        if b0 == 98 { return 15; }  // 'b' -> TAG_B
        if b0 == 105 { return 16; } // 'i' -> TAG_I
        if b0 == 117 { return 96; } // 'u' hasn't been implemented specifically, but return 96 so we keep the tag
        return 255;
    }
    if len == 2 {
        let b1 = get_tag_byte((1) as u32) | 32;
        if b0 == 104 && b1 == 49 { return 9; } // 'h1' -> TAG_H1
        if b0 == 116 && b1 == 114 { return 13; } // 'tr' -> TAG_TR
        if b0 == 116 && b1 == 100 { return 14; } // 'td' -> TAG_TD
        return 255;
    }
    if len == 3 {
        let b1 = get_tag_byte((1) as u32) | 32;
        let b2 = get_tag_byte((2) as u32) | 32;
        if b0 == 100 && b1 == 105 && b2 == 118 { return 4; } // 'div' -> TAG_DIV
        if b0 == 105 && b1 == 109 && b2 == 103 { return 8; } // 'img' -> TAG_IMG
        return 255;
    }
    if len == 4 {
        let b1 = get_tag_byte((1) as u32) | 32;
        let b2 = get_tag_byte((2) as u32) | 32;
        let b3 = get_tag_byte((3) as u32) | 32;
        if b0 == 115 && b1 == 112 && b2 == 97 && b3 == 110 { return 5; }  // 'span' -> TAG_SPAN
        if b0 == 104 && b1 == 116 && b2 == 109 && b3 == 108 { return 1; } // 'html' -> TAG_HTML
        if b0 == 104 && b1 == 101 && b2 == 97 && b3 == 100 { return 2; }  // 'head' -> TAG_HEAD
        if b0 == 98 && b1 == 111 && b2 == 100 && b3 == 121 { return 3; }  // 'body' -> TAG_BODY
        if b0 == 102 && b1 == 111 && b2 == 110 && b3 == 116 { return 17; } // 'font' -> TAG_FONT
        return 255;
    }
    if len == 5 {
        let b1 = get_tag_byte((1) as u32) | 32;
        let b2 = get_tag_byte((2) as u32) | 32;
        let b3 = get_tag_byte((3) as u32) | 32;
        let b4 = get_tag_byte((4) as u32) | 32;
        if b0 == 116 && b1 == 97 && b2 == 98 && b3 == 108 && b4 == 101 { return 12; } // 'table' -> TAG_TABLE
        // 'style' -> 98
        if b0 == 115 && b1 == 116 && b2 == 121 && b3 == 108 && b4 == 101 { return 98; }
        if b0 == 118 && b1 == 105 && b2 == 100 && b3 == 101 && b4 == 111 { return 25; } // 'video' -> TAG_VIDEO
        if b0 == 105 && b1 == 110 && b2 == 112 && b3 == 117 && b4 == 116 { return 18; } // 'input' -> TAG_INPUT
        return 255;
    }
    if len == 6 {
        let b1 = get_tag_byte((1) as u32) | 32;
        let b2 = get_tag_byte((2) as u32) | 32;
        let b3 = get_tag_byte((3) as u32) | 32;
        let b4 = get_tag_byte((4) as u32) | 32;
        let b5 = get_tag_byte((5) as u32) | 32;
        // 'script' -> 99
        if b0 == 115 && b1 == 99 && b2 == 114 && b3 == 105 && b4 == 112 && b5 == 116 { return 99; }
        // 'shadow' -> 21
        if b0 == 115 && b1 == 104 && b2 == 97 && b3 == 100 && b4 == 111 && b5 == 119 { return 21; }
        // 'iframe' -> TAG_IFRAME=26
        if b0 == 105 && b1 == 102 && b2 == 114 && b3 == 97 && b4 == 109 && b5 == 101 { return 26; }
        // 'canvas' -> TAG_CANVAS=27
        if b0 == 99 && b1 == 97 && b2 == 110 && b3 == 118 && b4 == 97 && b5 == 115 { return 27; }
        return 255;
    }
    return 255;
}

fn fnv1a_hash_bytes(len: u32) -> u32 {
    return hash_string(get_tag_buf_ptr(), len);
}

fn fnv1a_hash_attr_val(len: u32) -> u32 {
    return hash_string(get_aval_buf_ptr(), len);
}

// W3C Void Elements — do NOT push onto parent stack
fn is_void_element(tag: i32) -> bool {
    // meta(4/generic), link(4/generic), img=8, br(4/generic), input(4/generic), hr(4/generic)
    // We check tag IDs: IMG=8. For others not in our tag table, they map to TAG_DIV=4.
    // Specific void tag name check needed. We use the raw tag_len + first bytes instead.
    // This function is called with the matched tag ID.
    if tag == 8 { return true; } // IMG
    return false;
}

// Check if tag name bytes represent a void element not in our tag table
fn is_void_tag_name(len: u32) -> bool {
    let b0 = get_tag_byte(0) | 32;
    
    if len == 2 {
        let b1 = get_tag_byte((1) as u32) | 32;
        if b0 == 98 && b1 == 114 { return true; } // 'br'
        if b0 == 104 && b1 == 114 { return true; } // 'hr'
        return false;
    }
    if len == 3 {
        let b1 = get_tag_byte((1) as u32) | 32;
        let b2 = get_tag_byte((2) as u32) | 32;
        if b0 == 105 && b1 == 109 && b2 == 103 { return true; } // 'img'
        if b0 == 99 && b1 == 111 && b2 == 108 { return true; } // 'col'
        return false;
    }
    if len == 4 {
        let b1 = get_tag_byte((1) as u32) | 32;
        let b2 = get_tag_byte((2) as u32) | 32;
        let b3 = get_tag_byte((3) as u32) | 32;
        if b0 == 109 && b1 == 101 && b2 == 116 && b3 == 97 { return true; } // 'meta'
        if b0 == 108 && b1 == 105 && b2 == 110 && b3 == 107 { return true; } // 'link'
        return false;
    }
    if len == 5 {
        let b1 = get_tag_byte((1) as u32) | 32;
        let b2 = get_tag_byte((2) as u32) | 32;
        let b3 = get_tag_byte((3) as u32) | 32;
        let b4 = get_tag_byte((4) as u32) | 32;
        if b0 == 105 && b1 == 110 && b2 == 112 && b3 == 117 && b4 == 116 { return true; } // 'input'
        return false;
    }
    return false;
}

// ============================================================================
// Matches an attribute key at html_ptr[start..start+len] against "id"
// ============================================================================
fn is_attr_id(len: u32) -> bool {
    if len != 2 { return false; }
    let b0 = get_attr_key_byte(0) | 32;
    let b1 = get_attr_key_byte(1) | 32;
    return b0 == 105 && b1 == 100; // 'id'
}

fn is_attr_class(len: u32) -> bool {
    if len != 5 { return false; }
    let b0 = get_attr_key_byte(0) | 32;
    let b1 = get_attr_key_byte(1) | 32;
    let b2 = get_attr_key_byte(2) | 32;
    let b3 = get_attr_key_byte(3) | 32;
    let b4 = get_attr_key_byte(4) | 32;
    return b0 == 99 && b1 == 108 && b2 == 97 && b3 == 115 && b4 == 115; // 'class'
}

fn is_attr_style(len: u32) -> bool {
    if len != 5 { return false; }
    let b0 = get_attr_key_byte(0) | 32;
    let b1 = get_attr_key_byte(1) | 32;
    let b2 = get_attr_key_byte(2) | 32;
    let b3 = get_attr_key_byte(3) | 32;
    let b4 = get_attr_key_byte(4) | 32;
    // s(115), t(116), y(121), l(108), e(101)
    return b0 == 115 && b1 == 116 && b2 == 121 && b3 == 108 && b4 == 101;
}

fn is_attr_src(len: u32) -> bool {
    if len != 3 { return false; }
    let b0 = get_attr_key_byte(0) | 32;
    let b1 = get_attr_key_byte(1) | 32;
    let b2 = get_attr_key_byte(2) | 32;
    return b0 == 115 && b1 == 114 && b2 == 99; // 'src'
}

fn is_match_bgcolor(len: u32) -> bool {
    if len == 0 { return false; }
    let b0 = get_attr_key_byte(0) | 32;
    let b1 = get_tag_byte((1) as u32) | 32;
    let b2 = get_tag_byte((2) as u32) | 32;
    let b3 = get_tag_byte((3) as u32) | 32;
    let b4 = get_tag_byte((4) as u32) | 32;
    let b5 = get_tag_byte((5) as u32) | 32;
    let b6 = get_tag_byte((6) as u32) | 32;
    return b0 == 98 && b1 == 103 && b2 == 99 && b3 == 111 && b4 == 108 && b5 == 111 && b6 == 114; // 'bgcolor'
}

fn is_match_color(len: u32) -> bool {
    if len == 0 { return false; }
    let b0 = get_attr_key_byte(0) | 32;
    let b1 = get_tag_byte((1) as u32) | 32;
    let b2 = get_tag_byte((2) as u32) | 32;
    let b3 = get_tag_byte((3) as u32) | 32;
    let b4 = get_tag_byte((4) as u32) | 32;
    return b0 == 99 && b1 == 111 && b2 == 108 && b3 == 111 && b4 == 114; // 'color'
}

fn is_match_align(len: u32) -> bool {
    if len == 0 { return false; }
    let b0 = get_attr_key_byte(0) | 32;
    let b1 = get_tag_byte((1) as u32) | 32;
    let b2 = get_tag_byte((2) as u32) | 32;
    let b3 = get_tag_byte((3) as u32) | 32;
    let b4 = get_tag_byte((4) as u32) | 32;
    return b0 == 97 && b1 == 108 && b2 == 105 && b3 == 103 && b4 == 110; // 'align'
}

fn is_match_right(len: u32) -> bool {
    if len == 0 { return false; }
    let b0 = get_attr_val_byte(0) | 32;
    let b1 = get_tag_byte((1) as u32) | 32;
    let b2 = get_tag_byte((2) as u32) | 32;
    let b3 = get_tag_byte((3) as u32) | 32;
    let b4 = get_tag_byte((4) as u32) | 32;
    return b0 == 114 && b1 == 105 && b2 == 103 && b3 == 104 && b4 == 116; // 'right'
}

fn is_match_width(len: u32) -> bool {
    if len == 0 { return false; }
    let b0 = get_attr_key_byte(0) | 32;
    let b1 = get_tag_byte((1) as u32) | 32;
    let b2 = get_tag_byte((2) as u32) | 32;
    let b3 = get_tag_byte((3) as u32) | 32;
    let b4 = get_tag_byte((4) as u32) | 32;
    return b0 == 119 && b1 == 105 && b2 == 100 && b3 == 116 && b4 == 104; // 'width'
}

fn is_match_height(len: u32) -> bool {
    if len != 6 { return false; }
    if get_attr_key_byte(0)|32 != 104 { return false; } if get_attr_key_byte(1)|32 != 101 { return false; }
    if get_attr_key_byte(2)|32 != 105 { return false; } if get_attr_key_byte(3)|32 != 103 { return false; }
    if get_attr_key_byte(4)|32 != 104 { return false; } if get_attr_key_byte(5)|32 != 116 { return false; }
    return true;
}

fn is_match_style(len: u32) -> bool {
    if len != 5 { return false; }
    if get_attr_key_byte(0)|32 != 115 { return false; } if get_attr_key_byte(1)|32 != 116 { return false; }
    if get_attr_key_byte(2)|32 != 121 { return false; } if get_attr_key_byte(3)|32 != 108 { return false; }
    if get_attr_key_byte(4)|32 != 101 { return false; }
    return true;
}

fn parse_positive_int(len: u32) -> i32 {
    let mut val: u32 = 0;
    let mut i: u32 = 0;
    let mut found = false;
    while i < len {
        let b = get_attr_val_byte(((i as u64)) as u32);
        if b >= 48 && b <= 57 { // '0' to '9'
            val = (val * 10) + ((b - 48) as u32);
            found = true;
        } else {
            break;
        }
        i = i + 1;
    }
    if found { return val as i32; }
    return -1;
}

// ============================================================================
// HTML Lexer — Full state machine with tag matching, attributes, and nesting
// ============================================================================
// States:
//   0 = DATA       — reading text/whitespace between tags
//   1 = TAG_OPEN   — just saw '<', deciding open vs close
//   2 = TAG_NAME   — accumulating tag name bytes
//   3 = ATTR_SPACE — in whitespace between attributes
//   4 = ATTR_NAME  — accumulating attribute key bytes
//   5 = ATTR_EQ    — just saw '=', expecting quote
//   6 = ATTR_VAL   — inside quoted attribute value
//   7 = CLOSE_TAG  — inside </tag>, reading tag name to skip
//   8 = CLOSE_SKIP — skipping until '>' in close tag


pub fn lex_html(html_ptr: u64, chunk_len: u32, root_id: u64, can_execute: u8) {
    
    let p_tag = get_tag_buf_ptr();
    let p_akey = get_akey_buf_ptr();
    let p_aval = get_aval_buf_ptr();
    let p_txt = get_txt_buf_ptr();

    if LEX_INITIALIZED == 0 {
        LEX_CURRENT_PARENT = root_id;
        LEX_INITIALIZED = 1;
    }
    
    let mut i: u32 = 0;
    while i < chunk_len {
        let b = *((html_ptr + i as u64) as &u8);
        
        if LEX_STATE == 0 { // DATA
            if b == 60 { // '<'
                let mut is_closing_raw = false;
                if LEX_CURRENT_TAG == 99 { // Inside <script>
                    // W3C HTML5 Script Data FSM (§8.2.4.6-§8.2.4.29)
                    // Only close when in base SCRIPT_DATA state (0) AND
                    // lookahead confirms case-insensitive </script> match.
                    if LEX_SCRIPT_STATE == 0 {
                        // State 0: SCRIPT_DATA — check for </script> to close
                        let remaining = chunk_len - i;
                        if remaining >= 9 {
                            let c1 = *((html_ptr + (i + 1) as u64) as &u8);
                            let c2 = *((html_ptr + (i + 2) as u64) as &u8) | 32;
                            let c3 = *((html_ptr + (i + 3) as u64) as &u8) | 32;
                            let c4 = *((html_ptr + (i + 4) as u64) as &u8) | 32;
                            let c5 = *((html_ptr + (i + 5) as u64) as &u8) | 32;
                            let c6 = *((html_ptr + (i + 6) as u64) as &u8) | 32;
                            let c7 = *((html_ptr + (i + 7) as u64) as &u8) | 32;
                            let c8 = *((html_ptr + (i + 8) as u64) as &u8);
                            if c1 == 47 && c2 == 115 && c3 == 99 && c4 == 114 && c5 == 105 && c6 == 112 && c7 == 116 {
                                if c8 == 62 || c8 == 32 || c8 == 9 || c8 == 10 || c8 == 13 {
                                    is_closing_raw = true;
                                }
                            }
                        }
                        // Also check for <!-- to enter escaped state
                        if !is_closing_raw {
                            if remaining >= 4 {
                                let la1 = *((html_ptr + (i + 1) as u64) as &u8);
                                let la2 = *((html_ptr + (i + 2) as u64) as &u8);
                                let la3 = *((html_ptr + (i + 3) as u64) as &u8);
                                if la1 == 33 && la2 == 45 && la3 == 45 {
                                    LEX_SCRIPT_STATE = 1;
                                }
                            }
                        }
                    } else if LEX_SCRIPT_STATE == 1 {
                        // State 1: SCRIPT_DATA_ESCAPED — inside <!--
                        // Check for <script to enter double-escaped
                        let remaining = chunk_len - i;
                        if remaining >= 8 {
                            let la1 = *((html_ptr + (i + 1) as u64) as &u8) | 32;
                            let la2 = *((html_ptr + (i + 2) as u64) as &u8) | 32;
                            let la3 = *((html_ptr + (i + 3) as u64) as &u8) | 32;
                            let la4 = *((html_ptr + (i + 4) as u64) as &u8) | 32;
                            let la5 = *((html_ptr + (i + 5) as u64) as &u8) | 32;
                            let la6 = *((html_ptr + (i + 6) as u64) as &u8) | 32;
                            let la7 = *((html_ptr + (i + 7) as u64) as &u8);
                            if la1 == 115 && la2 == 99 && la3 == 114 && la4 == 105 && la5 == 112 && la6 == 116 {
                                if la7 == 62 || la7 == 32 || la7 == 9 || la7 == 10 || la7 == 13 {
                                    LEX_SCRIPT_STATE = 2;
                                }
                            }
                        }
                        // Check for </script> to leave escaped back to base
                        if remaining >= 9 {
                            let la1 = *((html_ptr + (i + 1) as u64) as &u8);
                            let la2 = *((html_ptr + (i + 2) as u64) as &u8) | 32;
                            let la3 = *((html_ptr + (i + 3) as u64) as &u8) | 32;
                            let la4 = *((html_ptr + (i + 4) as u64) as &u8) | 32;
                            let la5 = *((html_ptr + (i + 5) as u64) as &u8) | 32;
                            let la6 = *((html_ptr + (i + 6) as u64) as &u8) | 32;
                            let la7 = *((html_ptr + (i + 7) as u64) as &u8) | 32;
                            let la8 = *((html_ptr + (i + 8) as u64) as &u8);
                            if la1 == 47 && la2 == 115 && la3 == 99 && la4 == 114 && la5 == 105 && la6 == 112 && la7 == 116 {
                                if la8 == 62 || la8 == 32 || la8 == 9 || la8 == 10 || la8 == 13 {
                                    LEX_SCRIPT_STATE = 0;
                                }
                            }
                        }
                    } else if LEX_SCRIPT_STATE == 2 {
                        // State 2: SCRIPT_DATA_DOUBLE_ESCAPED — inside <script inside <!--
                        // Check for </script> to return to escaped
                        let remaining = chunk_len - i;
                        if remaining >= 9 {
                            let la1 = *((html_ptr + (i + 1) as u64) as &u8);
                            let la2 = *((html_ptr + (i + 2) as u64) as &u8) | 32;
                            let la3 = *((html_ptr + (i + 3) as u64) as &u8) | 32;
                            let la4 = *((html_ptr + (i + 4) as u64) as &u8) | 32;
                            let la5 = *((html_ptr + (i + 5) as u64) as &u8) | 32;
                            let la6 = *((html_ptr + (i + 6) as u64) as &u8) | 32;
                            let la7 = *((html_ptr + (i + 7) as u64) as &u8) | 32;
                            let la8 = *((html_ptr + (i + 8) as u64) as &u8);
                            if la1 == 47 && la2 == 115 && la3 == 99 && la4 == 114 && la5 == 105 && la6 == 112 && la7 == 116 {
                                if la8 == 62 || la8 == 32 || la8 == 9 || la8 == 10 || la8 == 13 {
                                    LEX_SCRIPT_STATE = 1;
                                }
                            }
                        }
                    }
                } else if LEX_CURRENT_TAG == 98 { // Inside <style>
                    if i + 1 < chunk_len {
                        let next_b = *((html_ptr + (i + 1) as u64) as &u8);
                        if next_b == 47 { is_closing_raw = true; }
                    }
                } else {
                    is_closing_raw = true;
                }
                
                if is_closing_raw {
                    if LEX_TEXT_LEN > 0 {
                        if LEX_CURRENT_TAG == 98 {
                            let style_idx = ext_salt_resolve_node(LEX_CURRENT_NODE);
                            let scope = dom_get_scope_idx(style_idx);
                            css_lex_stylesheet(p_txt, LEX_TEXT_LEN, scope);
                        } else {
                            let txt = ext_salt_create_text_node(p_txt, LEX_TEXT_LEN);
                            js_set_node_executable(txt, can_execute);
                            ext_salt_append_child(LEX_CURRENT_PARENT, txt);
                        }
                        LEX_TEXT_LEN = 0;
                    }
                    LEX_SCRIPT_STATE = 0;
                    LEX_DASH_COUNT = 0;
                    LEX_STATE = 1;
                } else {
                    if LEX_TEXT_LEN < 16384 {
                        *((p_txt + (LEX_TEXT_LEN as u64)) as &mut u8) = b;
                        LEX_TEXT_LEN = LEX_TEXT_LEN + 1;
                    }
                }
            } else {
                // Track --> for leaving escaped state (W3C §8.2.4.22)
                if LEX_CURRENT_TAG == 99 && LEX_SCRIPT_STATE == 1 {
                    if b == 45 {
                        LEX_DASH_COUNT = LEX_DASH_COUNT + 1;
                    } else if b == 62 && LEX_DASH_COUNT >= 2 {
                        LEX_SCRIPT_STATE = 0;
                        LEX_DASH_COUNT = 0;
                    } else {
                        LEX_DASH_COUNT = 0;
                    }
                }
                if LEX_TEXT_LEN < 16384 {
                    *((p_txt + (LEX_TEXT_LEN as u64)) as &mut u8) = b;
                    LEX_TEXT_LEN = LEX_TEXT_LEN + 1;
                }
            }
        } else if LEX_STATE == 1 { // TAG_OPEN
            if b == 47 { // '/'
                LEX_STATE = 7; // CLOSE_TAG
                LEX_TAG_LEN = 0;
            } else if b == 33 { // '!' comment skip
                LEX_STATE = 8; // COMMENT_SKIP
            } else {
                LEX_TAG_LEN = 0;
                *((p_tag) as &mut u8) = b;
                LEX_TAG_LEN = 1;
                LEX_STATE = 2; // TAG_NAME
            }
        } else if LEX_STATE == 8 { // COMMENT_SKIP
            if b == 62 { LEX_STATE = 0; } // '>'
        } else if LEX_STATE == 2 { // TAG_NAME
            if b == 62 || b == 32 || b == 47 {
                let tag = match_tag(LEX_TAG_LEN);
                LEX_CURRENT_TAG = tag;
                let is_void = is_void_tag_name(LEX_TAG_LEN);
                LEX_IS_SELF_CLOSING = if b == 47 { 1 } else { 0 };
                LEX_CURRENT_NODE = ext_salt_create_node(tag);
                
                if tag == 96 {
                    let hash = fnv1a_hash_bytes(LEX_TAG_LEN);
                    let node_idx = ext_salt_resolve_node(LEX_CURRENT_NODE);
                    if node_idx != 0xFFFFFFFF {
                        dom_set_custom_tag(node_idx, hash, p_tag, LEX_TAG_LEN);
                    }
                }
                js_set_node_executable(LEX_CURRENT_NODE, can_execute);
                ext_salt_append_child(LEX_CURRENT_PARENT, LEX_CURRENT_NODE);
                
                if b == 62 {
                    if !is_void && LEX_IS_SELF_CLOSING == 0 {
                        LEX_CURRENT_PARENT = LEX_CURRENT_NODE;
                    }
                    LEX_STATE = 0;
                } else if b == 47 {
                    LEX_IS_SELF_CLOSING = 1;
                    LEX_STATE = 3;
                } else {
                    LEX_STATE = 3;
                }
            } else {
                if LEX_TAG_LEN < 128 {
                    *((p_tag + (LEX_TAG_LEN as u64)) as &mut u8) = b;
                    LEX_TAG_LEN = LEX_TAG_LEN + 1;
                }
            }
        } else if LEX_STATE == 3 { // ATTR_SPACE
            if b == 62 {
                let is_void = is_void_tag_name(LEX_TAG_LEN);
                if !is_void && LEX_IS_SELF_CLOSING == 0 {
                    LEX_CURRENT_PARENT = LEX_CURRENT_NODE;
                }
                LEX_IS_SELF_CLOSING = 0;
                LEX_STATE = 0;
            } else if b == 47 {
                LEX_IS_SELF_CLOSING = 1;
            } else if b != 32 && b != 9 && b != 10 && b != 13 {
                LEX_ATTR_KEY_LEN = 0;
                *((p_akey) as &mut u8) = b;
                LEX_ATTR_KEY_LEN = 1;
                LEX_STATE = 4;
            }
        } else if LEX_STATE == 4 { // ATTR_NAME
            if b == 61 { // '='
                LEX_STATE = 5; // ATTR_EQ
            } else if b == 32 || b == 62 || b == 47 {
                bind_attribute(LEX_CURRENT_NODE, p_akey, LEX_ATTR_KEY_LEN, 0, 0);
                if b == 62 {
                    let is_void = is_void_tag_name(LEX_TAG_LEN);
                    if !is_void && LEX_IS_SELF_CLOSING == 0 {
                        LEX_CURRENT_PARENT = LEX_CURRENT_NODE;
                    }
                    LEX_IS_SELF_CLOSING = 0;
                    LEX_STATE = 0;
                } else if b == 47 {
                    LEX_IS_SELF_CLOSING = 1;
                    LEX_STATE = 3;
                } else {
                    LEX_STATE = 3;
                }
            } else {
                if LEX_ATTR_KEY_LEN < 128 {
                    *((p_akey + (LEX_ATTR_KEY_LEN as u64)) as &mut u8) = b;
                    LEX_ATTR_KEY_LEN = LEX_ATTR_KEY_LEN + 1;
                }
            }
        } else if LEX_STATE == 5 { // ATTR_EQ
            if b == 34 || b == 39 {
                LEX_QUOTE_CHAR = b;
                LEX_ATTR_VAL_LEN = 0;
                LEX_STATE = 6;
            } else if b == 62 {
                let is_void = is_void_tag_name(LEX_TAG_LEN);
                if !is_void && LEX_IS_SELF_CLOSING == 0 {
                    LEX_CURRENT_PARENT = LEX_CURRENT_NODE;
                }
                LEX_IS_SELF_CLOSING = 0;
                LEX_STATE = 0;
            } else if b != 32 && b != 9 && b != 10 && b != 13 {
                LEX_ATTR_VAL_LEN = 0;
                *((p_aval) as &mut u8) = b;
                LEX_ATTR_VAL_LEN = 1;
                LEX_QUOTE_CHAR = 0;
                LEX_STATE = 6;
            }
        } else if LEX_STATE == 6 { // ATTR_VAL
            let mut is_close = false;
            if LEX_QUOTE_CHAR != 0 {
                if b == LEX_QUOTE_CHAR { is_close = true; }
            } else {
                if b == 32 || b == 62 || b == 9 || b == 10 || b == 13 { is_close = true; }
            }
            
            if is_close {
                bind_attribute(LEX_CURRENT_NODE, p_akey, LEX_ATTR_KEY_LEN, p_aval, LEX_ATTR_VAL_LEN);
                if is_attr_id(LEX_ATTR_KEY_LEN) {
                    js_set_id(LEX_CURRENT_NODE, p_aval, LEX_ATTR_VAL_LEN);
                }
                if is_attr_class(LEX_ATTR_KEY_LEN) {
                    let class_idx = ext_salt_resolve_node(LEX_CURRENT_NODE);
                    if class_idx != 0xFFFFFFFF {
                        js_set_class(LEX_CURRENT_NODE, p_aval, LEX_ATTR_VAL_LEN);
                        let hash = fnv1a_hash_attr_val(LEX_ATTR_VAL_LEN);
                        ext_salt_set_node_class_hash(class_idx, hash);
                    }
                }
                if is_attr_style(LEX_ATTR_KEY_LEN) {
                    let style_idx = ext_salt_resolve_node(LEX_CURRENT_NODE);
                    if style_idx != 0xFFFFFFFF {
                        ext_salt_set_inline_style(style_idx, p_aval, LEX_ATTR_VAL_LEN);
                    }
                }
                if is_attr_src(LEX_ATTR_KEY_LEN) {
                    if LEX_CURRENT_TAG == 99 {
                        let src_node_idx = ext_salt_resolve_node(LEX_CURRENT_NODE);
                        if src_node_idx != 0xFFFFFFFF { dom_set_script_src(src_node_idx, p_aval, LEX_ATTR_VAL_LEN); }
                    }
                    if LEX_CURRENT_TAG == 26 {
                        let ifr_node_idx = ext_salt_resolve_node(LEX_CURRENT_NODE);
                        if ifr_node_idx != 0xFFFFFFFF {
                            let ifr_slot = dom_register_iframe(ifr_node_idx);
                            if ifr_slot != 0xFFFFFFFF { dom_set_iframe_src(ifr_slot, p_aval, LEX_ATTR_VAL_LEN); }
                        }
                    }
                    if LEX_CURRENT_TAG == 8 {
                        let img_node_idx = ext_salt_resolve_node(LEX_CURRENT_NODE);
                        if img_node_idx != 0xFFFFFFFF {
                            let img_fetch_id = queue_image_fetch(img_node_idx);
                            if img_fetch_id != 0 {
                                let mut img_bit: u64 = 1; img_bit = img_bit << 59;
                                sys_ipc_send_r2m_command_with_payload(12, img_bit | img_fetch_id, p_aval, LEX_ATTR_VAL_LEN);
                            }
                        }
                    }
                }
                
                if is_match_bgcolor(LEX_ATTR_KEY_LEN) {
                    let mut hex_start = p_aval;
                    if get_attr_val_byte(0) == 35 { hex_start = hex_start + 1; }
                    let mut r: u8 = 0; let mut g: u8 = 0; let mut b_c: u8 = 0;
                    parse_hex_to_rgb(hex_start, &mut r, &mut g, &mut b_c);
                    let bg_idx = ext_salt_resolve_node(LEX_CURRENT_NODE);
                    dom_set_style_bg(bg_idx, r, g, b_c); dom_set_spec_bg(bg_idx, 0);
                } else if is_match_color(LEX_ATTR_KEY_LEN) {
                    let mut hex_start = p_aval;
                    if get_attr_val_byte(0) == 35 { hex_start = hex_start + 1; }
                    let mut r: u8 = 0; let mut g: u8 = 0; let mut b_c: u8 = 0;
                    parse_hex_to_rgb(hex_start, &mut r, &mut g, &mut b_c);
                    let color_idx = ext_salt_resolve_node(LEX_CURRENT_NODE);
                    dom_set_style_color(color_idx, r, g, b_c); dom_set_spec_color(color_idx, 0);
                } else if is_match_align(LEX_ATTR_KEY_LEN) {
                    if is_match_right(LEX_ATTR_VAL_LEN) {
                        let align_idx = ext_salt_resolve_node(LEX_CURRENT_NODE);
                        dom_set_style_text_align(align_idx, 1); dom_set_spec_text_align(align_idx, 0);
                    }
                } else if is_match_width(LEX_ATTR_KEY_LEN) {
                    let mut unit: u8 = 0; let mut parse_len = LEX_ATTR_VAL_LEN;
                    if LEX_ATTR_VAL_LEN > 0 {
                        if *( (p_aval + ((LEX_ATTR_VAL_LEN - 1) as u64)) as &u8 ) == 37 { unit = 1; parse_len = parse_len - 1; }
                    }
                    let parsed_val = parse_positive_int(parse_len);
                    if parsed_val > 0 {
                        let w_idx = ext_salt_resolve_node(LEX_CURRENT_NODE);
                        dom_set_style_width(w_idx, parsed_val); dom_set_style_w_unit(w_idx, unit); dom_set_spec_width(w_idx, 0);
                    }
                } else if is_match_height(LEX_ATTR_KEY_LEN) {
                    let mut unit: u8 = 0; let mut parse_len = LEX_ATTR_VAL_LEN;
                    if LEX_ATTR_VAL_LEN > 0 {
                        if *( (p_aval + ((LEX_ATTR_VAL_LEN - 1) as u64)) as &u8 ) == 37 { unit = 1; parse_len = parse_len - 1; }
                    }
                    let parsed_val = parse_positive_int(parse_len);
                    if parsed_val > 0 {
                        let h_idx = ext_salt_resolve_node(LEX_CURRENT_NODE);
                        dom_set_style_height(h_idx, parsed_val); dom_set_style_h_unit(h_idx, unit); dom_set_spec_height(h_idx, 0);
                    }
                } else if is_match_style(LEX_ATTR_KEY_LEN) {
                    let style_idx = ext_salt_resolve_node(LEX_CURRENT_NODE);
                    if style_idx != 0xFFFFFFFF && LEX_ATTR_VAL_LEN > 0 {
                        css_lex_inline_style(style_idx, p_aval, LEX_ATTR_VAL_LEN);
                    }
                }
                
                if LEX_QUOTE_CHAR == 0 && b == 62 {
                    let is_void = is_void_tag_name(LEX_TAG_LEN);
                    if !is_void && LEX_IS_SELF_CLOSING == 0 { LEX_CURRENT_PARENT = LEX_CURRENT_NODE; }
                    LEX_IS_SELF_CLOSING = 0; LEX_STATE = 0;
                } else {
                    LEX_STATE = 3;
                }
            } else {
                if LEX_ATTR_VAL_LEN < 4096 {
                    *((p_aval + (LEX_ATTR_VAL_LEN as u64)) as &mut u8) = b;
                    LEX_ATTR_VAL_LEN = LEX_ATTR_VAL_LEN + 1;
                }
            }
        } else if LEX_STATE == 7 { // CLOSE_TAG
            if b == 62 {
                let tag = match_tag(LEX_TAG_LEN);
                if tag == 99 && can_execute == 1 {
                    let script_node_idx = ext_salt_resolve_node(LEX_CURRENT_PARENT);
                    let ext_src_ptr = dom_get_script_src_ptr(script_node_idx);
                    let ext_src_len = dom_get_script_src_len(script_node_idx);
                    if ext_src_ptr != 0 && ext_src_len > 0 {
                        let fetch_id = queue_script_fetch(ext_src_ptr, ext_src_len);
                        if fetch_id != 0 {
                            let mut script_bit: u64 = 1; script_bit = script_bit << 60;
                            sys_ipc_send_r2m_command_with_payload(12, script_bit | fetch_id, ext_src_ptr, ext_src_len);
                        }
                    } else {
                        let c_id = dom_get_first_child(ext_salt_resolve_node(LEX_CURRENT_PARENT));
                        if c_id != 0 {
                            let c_idx = ext_salt_resolve_node(c_id);
                            if c_idx != 0xFFFFFFFF {
                                let text_ptr = dom_get_text_ptr(c_idx);
                                let ptr_len = dom_get_text_len(c_idx);
                                if ptr_len > 0 { js_queue_script(text_ptr, ptr_len); }
                            }
                        }
                    }
                }
                if tag == 98 {
                    let s_id = dom_get_first_child(ext_salt_resolve_node(LEX_CURRENT_PARENT));
                    if s_id != 0 {
                        let s_idx = ext_salt_resolve_node(s_id);
                        if s_idx != 0xFFFFFFFF {
                            let text_ptr = dom_get_text_ptr(s_idx);
                            let ptr_len = dom_get_text_len(s_idx);
                            if ptr_len > 0 {
                                let scope_id = dom_get_scope_idx(s_idx);
                                css_lex_stylesheet(text_ptr, ptr_len, scope_id);
                            }
                        }
                    }
                }
                if tag == 26 {
                    let ifr_node_idx = ext_salt_resolve_node(LEX_CURRENT_PARENT);
                    if ifr_node_idx != 0xFFFFFFFF {
                        sys_ipc_send_r2m_command_with_payload(4, ifr_node_idx as u64, 0, 0);
                    }
                }
                
                let mut target_parent = LEX_CURRENT_PARENT;
                let mut found = false;
                while target_parent != 0 && target_parent != root_id {
                    let tp_idx = ext_salt_resolve_node(target_parent);
                    if tp_idx == 0xFFFFFFFF { break; }
                    let tp_tag = dom_get_tag(tp_idx);
                    if tp_tag == (tag as u32) { found = true; break; }
                    target_parent = js_dom_get_parent(target_parent);
                }
                if found {
                    LEX_CURRENT_PARENT = js_dom_get_parent(target_parent);
                    if LEX_CURRENT_PARENT == 0 { LEX_CURRENT_PARENT = root_id; }
                }
                
                LEX_CURRENT_TAG = 0;
                LEX_STATE = 0;
            } else {
                if LEX_TAG_LEN < 128 {
                    *((p_tag + (LEX_TAG_LEN as u64)) as &mut u8) = b;
                    LEX_TAG_LEN = LEX_TAG_LEN + 1;
                }
            }
        }
        
        i = i + 1;
    }
}
@no_mangle
pub fn js_lex_html_chunk(root_id: u64, ptr: u64, len: u32, can_execute: u8) {
    lex_html(ptr, len, root_id, can_execute);
}

@no_mangle
pub fn salt_lex_html_chunk(root_id: u64, ptr: u64, len: u32, can_execute: u8) {
    lex_html(ptr, len, root_id, can_execute);
}
