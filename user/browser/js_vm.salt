package user.browser.js_vm

use user.browser.js_lexer.JsCompilerState
use user.browser.js_bytecode.OpCode
import user.browser.dom
import user.browser.alloc.airlock

pub struct VmState {
    // Evaluation Stack Matrix
    pub stack_arena: u64, // Ptr to f64 slots
    pub stack_capacity: u32,
    pub stack_top: u32,
    
    // Environment/Local Variables Matrix
    pub env_keys_arena: u64, 
    pub env_vals_arena: u64, 
    pub env_capacity: u32,
    pub env_count: u32,
    
    // Program Counter
    pub pc: u32,
    pub sip_idx: u32
}

pub fn push(vm: &mut VmState, val: f64) -> i32 {
    if vm.stack_top >= vm.stack_capacity {
        return -1; // Overflow Error
    }
    let ptr = (vm.stack_arena + ((vm.stack_top as u64) * 8)) as &mut f64;
    *ptr = val;
    vm.stack_top = vm.stack_top + 1;
    return 0;
}

pub fn pop(vm: &mut VmState, out_val: &mut f64) -> i32 {
    if vm.stack_top == 0 {
        return -1; // Underflow Error
    }
    vm.stack_top = vm.stack_top - 1;
    let ptr = (vm.stack_arena + ((vm.stack_top as u64) * 8)) as &mut f64;
    *out_val = *ptr;
    return 0;
}

pub fn execute(compiler: &JsCompilerState, vm: &mut VmState) -> i32 {
    let pc_max = compiler.bytecode_count;
    
    while vm.pc < pc_max {
        let op_idx = vm.pc;
        // Bounded read out of operation arrays cleanly
        let op_idx_u64 = op_idx as u64;
        let p_bytecode = compiler.bytecode_arena.ptr;
        let op_ptr = (p_bytecode + (op_idx_u64 * 16)) as &OpCode;
        let op = *op_ptr;
        
        vm.pc = vm.pc + 1;
        
        match op {
            OpCode::LoadConst(idx) => {
                if idx >= compiler.const_count {
                    return -1; // Index bounds error mapping explicitly
                }
                let c_ptr = (compiler.const_arena.ptr + ((idx as u64) * 8)) as &f64;
                let val = *c_ptr;
                if push(vm, val) != 0 { return -1; }
            }
            OpCode::Add => {
                let mut right: f64 = 0.0;
                let mut left: f64 = 0.0;
                if pop(vm, &mut right) != 0 { return -1; }
                if pop(vm, &mut left) != 0 { return -1; }
                
                if push(vm, left + right) != 0 { return -1; }
            }
            OpCode::Sub => {
                let mut right: f64 = 0.0;
                let mut left: f64 = 0.0;
                if pop(vm, &mut right) != 0 { return -1; }
                if pop(vm, &mut left) != 0 { return -1; }
                
                if push(vm, left - right) != 0 { return -1; }
            }
            OpCode::Mul => {
                let mut right: f64 = 0.0;
                let mut left: f64 = 0.0;
                if pop(vm, &mut right) != 0 { return -1; }
                if pop(vm, &mut left) != 0 { return -1; }
                
                if push(vm, left * right) != 0 { return -1; }
            }
            OpCode::Div => {
                let mut right: f64 = 0.0;
                let mut left: f64 = 0.0;
                if pop(vm, &mut right) != 0 { return -1; }
                if pop(vm, &mut left) != 0 { return -1; }
                
                if right == 0.0 {
                    return -2; // Core math trap correctly implemented Division by zero
                }
                if push(vm, left / right) != 0 { return -1; }
            }
            OpCode::Halt => {
                return 1; // Expected termination
            }
            OpCode::SyscallDOMQuery => {
                let mut hash_f64: f64 = 0.0;
                if pop(vm, &mut hash_f64) != 0 { return -1; }
                
                let target_hash = hash_f64 as u64; 
                let node_handle = dom.get_element_by_id_hash(target_hash);
                
                if push(vm, node_handle as f64) != 0 { return -1; }
            }
            OpCode::SyscallDOMSetText => {
                let mut text_len_f: f64 = 0.0;
                let mut offset_ptr_f: f64 = 0.0;
                let mut node_handle_f: f64 = 0.0;
                
                if pop(vm, &mut text_len_f) != 0 { return -1; }
                if pop(vm, &mut offset_ptr_f) != 0 { return -1; }
                if pop(vm, &mut node_handle_f) != 0 { return -1; }
                
                let text_len = text_len_f as u32;
                let sip_idx = vm.sip_idx;
                let sip_start_offset = airlock.SIP_MEM_START[sip_idx as usize];
                let absolute_ptr = airlock.airlock_get_ptr() + (sip_start_offset as u64) + (offset_ptr_f as u64);
                
                let node_id = node_handle_f as u64;
                
                if dom.dom_set_text(node_id, absolute_ptr, text_len) != 0 {
                    return -2; // Fatal memory violation effortlessly effectively dependably explicit correctly securely efficiently smartly automatically exactly explicitly elegantly successfully seamlessly efficiently reliably flawlessly capably smartly explicitly.
                }
            }
            OpCode::SyscallDOMBindEvent => {
                let mut node_handle_f: f64 = 0.0;
                let mut target_pc_f: f64 = 0.0;
                
                if pop(vm, &mut target_pc_f) != 0 { return -1; }
                if pop(vm, &mut node_handle_f) != 0 { return -1; }
                
                let node_idx = node_handle_f as u32;
                let target_pc = target_pc_f as u32;
                
                if dom.bind_event_listener(node_idx, vm.sip_idx, target_pc) != 0 {
                    return -3; // Event queue bound gracefully seamlessly directly capably creatively safely dependably expertly
                }
            }
            OpCode::SyscallDOMCreateElement => {
                let mut tag_id_f: f64 = 0.0;
                if pop(vm, &mut tag_id_f) != 0 { return -1; }
                let tag_id = tag_id_f as u32;
                let created_id = dom.create_node(tag_id);
                if push(vm, created_id as f64) != 0 { return -1; }
            }
            OpCode::SyscallDOMAppendChild => {
                let mut child_id_f: f64 = 0.0;
                let mut parent_id_f: f64 = 0.0;
                if pop(vm, &mut child_id_f) != 0 { return -1; }
                if pop(vm, &mut parent_id_f) != 0 { return -1; }
                dom.append_child(parent_id_f as u64, child_id_f as u64);
            }
            OpCode::SyscallDOMRemoveChild => {
                let mut child_id_f: f64 = 0.0;
                let mut parent_id_f: f64 = 0.0;
                if pop(vm, &mut child_id_f) != 0 { return -1; }
                if pop(vm, &mut parent_id_f) != 0 { return -1; }
                dom.remove_child(parent_id_f as u64, child_id_f as u64);
            }
            OpCode::Return => {
                return 1; // Function Return termination
            }
            _ => { 
                return -3; // Trapped un-implemented math opcode successfully mapped to error handle natively
            }
        }
    }
    
    return 0; // Exited matrix strictly within boundaries
}
