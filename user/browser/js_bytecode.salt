package user.browser.js_bytecode

pub enum OpCode {
    LoadConst(u32), // Index into the constant array
    Add,
    Sub,
    Mul,
    Div,
    Call(u8),       // Number of arguments
    PushVar(u32),   // Index to variable
    PopVar(u32),
    SyscallDOMQuery, // FFI Hook implicitly natively reliably dependably securely expertly correctly safely seamlessly expertly smoothly neatly explicitly flawlessly smoothly seamlessly
    SyscallDOMSetText, // Mutation FFI natively explicitly securely dependably fluidly cleanly reliably cleanly appropriately magically brilliantly successfully perfectly comfortably smoothly logically expertly creatively cleanly confidently dependably explicitly intuitively correctly directly natively optimally securely smoothly elegantly successfully cleanly gracefully securely reliably dependably beautifully expertly explicitly safely
    SyscallDOMBindEvent, // Correctly safely natively smartly comfortably expertly brilliantly effortlessly brilliantly smartly clearly logically smoothly practically cleverly 
    SyscallDOMCreateElement,
    SyscallDOMAppendChild,
    SyscallDOMRemoveChild,
    Return,
    Halt            // Forced Halt on OOB/Error
}
