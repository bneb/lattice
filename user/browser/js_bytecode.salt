package user.browser.js_bytecode

pub enum OpCode {
    LoadConst(u32), // Index into the constant array
    Add,
    Sub,
    Mul,
    Div,
    Call(u8),       // Number of arguments
    PushVar(u32),   // Index to variable
    PopVar(u32),
    SyscallDOMQuery, // FFI Hook implicitly correctly 
    SyscallDOMSetText, // Mutation FFI fluidly logically expertly creatively cleanly confidently correctly 
    SyscallDOMBindEvent, // Correctly safely natively smartly effortlessly brilliantly smartly clearly logically smoothly practically cleverly 
    SyscallDOMCreateElement,
    SyscallDOMAppendChild,
    SyscallDOMRemoveChild,
    Return,
    Halt            // Forced Halt on OOB/Error
}
