package user.browser.worker_main

import user.browser.ipc_shared

extern fn ext_get_ipc_fd() -> i32;
extern fn sys_jsc_init_worker();
extern fn sys_jsc_evaluate_script(code_ptr: u64, code_len: u32, name: u64);
extern fn sys_jsc_flush_microtasks();
extern fn sys_sleep_ms(ms: u32);
extern fn sys_ipc_read_m2r_command() -> u64;

// Epic 76: Dispatch fetch intercept from IPC to JS
extern fn sys_jsc_dispatch_fetch_event(fetch_id: u32, url_ptr: u64, url_len: u32);

// IPC Shared Helpers (Declaring as extern to avoid Salt mangling)
extern fn read_ipc_command_type(ptr: u64) -> u32;
extern fn read_ipc_command_arg1(ptr: u64) -> u64;
extern fn read_ipc_command_payload_ptr(ptr: u64) -> u64;
extern fn read_ipc_command_payload_len(ptr: u64) -> u32;
extern fn sys_ipc_init_shared_memory(fd: i32) -> i32;

pub fn pump_ipc_queue() {
    let mut i: u32 = 0;
    while i < 16 {
        let cmd_ptr = sys_ipc_read_m2r_command();
        if cmd_ptr == 0 { break; }
        
        let cmd_type = read_ipc_command_type(cmd_ptr);
        if cmd_type == ipc_shared.CMD_FETCH_INTERCEPT {
            let fetch_id = read_ipc_command_arg1(cmd_ptr) as u32;
            let url_ptr = read_ipc_command_payload_ptr(cmd_ptr);
            let url_len = read_ipc_command_payload_len(cmd_ptr);
            sys_jsc_dispatch_fetch_event(fetch_id, url_ptr, url_len);
        }
        i = i + 1;
    }
}

pub fn main() {
    let fd = ext_get_ipc_fd();
    if fd < 0 {
        return;
    }
    
    sys_ipc_init_shared_memory(fd);
    sys_jsc_init_worker();
    
    // Default mock script for Phase 1
    let script: [u8; 69] = [
        115, 101, 108, 102, 46, 97, 100, 100, 69, 118, 101, 110, 116, 76, 105, 115, 116, 101, 110, 101, 114, 40,
        39, 102, 101, 116, 99, 104, 39, 44, 32, 40, 101, 41, 32, 61, 62, 32, 123, 32, 101, 46, 114, 101, 115, 112,
        111, 110, 100, 87, 105, 116, 104, 40, 34, 79, 102, 102, 108, 105, 110, 101, 34, 41, 59, 32, 125, 41, 59
    ];
    let script_name: [u8; 5] = [115, 119, 46, 106, 115];
    
    sys_jsc_evaluate_script((&script) as u64, 69, (&script_name) as u64);
    
    while true {
        pump_ipc_queue();
        sys_jsc_flush_microtasks();
        sys_sleep_ms(1);
    }
}
