package user.browser.js_lexer

import user.browser.js_tokens.JsToken
import user.browser.js_tokens.PunctToken
import user.browser.js_tokens.KeywordToken
import user.browser.js_tokens.TokenSpan

pub struct ByteSpan {
    pub ptr: u64,
    pub len: u32
}

pub struct JsCompilerState {
    pub source_ptr: u64,
    pub source_len: u32,
    pub cursor: u32,
    pub bytecode_count: u32,
    pub bytecode_arena: ByteSpan,
    pub const_count: u32,
    pub const_arena: ByteSpan,
    pub var_count: u32,
    pub var_arena: ByteSpan
}

// Global state for testing bypass
pub global LEX_SOURCE_PTR: u64 = 0;
pub global LEX_SOURCE_LEN: u32 = 0;
pub global LEX_CURSOR: u32 = 0;

@no_mangle
pub fn set_lex_state(ptr: u64, len: u32) {
    LEX_SOURCE_PTR = ptr;
    LEX_SOURCE_LEN = len;
    LEX_CURSOR = 0;
}

pub fn is_whitespace(c: u8) -> bool {
    if c == 0x20 { return true; }
    if c == 0x09 { return true; }
    if c == 0x0A { return true; }
    if c == 0x0D { return true; }
    return false;
}

pub fn is_digit(c: u8) -> bool {
    if c >= 0x30 {
        if c <= 0x39 {
            return true;
        }
    }
    return false;
}

pub fn is_alpha(c: u8) -> bool {
    if c >= 0x41 {
        if c <= 0x5A { return true; }
    }
    if c >= 0x61 {
        if c <= 0x7A { return true; }
    }
    if c == 0x5F { return true; }
    return false;
}

extern fn sys_log_info(ptr: u64, len: u32);
extern fn sys_print_u32(u: u32);

pub fn next_token_global() -> JsToken {
    let source_ptr = LEX_SOURCE_PTR;
    let source_len = LEX_SOURCE_LEN;

    // Skip whitespace
    let mut tmp_ws = LEX_CURSOR;
    while tmp_ws < source_len {
        let c = *((source_ptr + (tmp_ws as u64)) as &u8);
        if is_whitespace(c) == false {
            break;
        }
        tmp_ws = tmp_ws + 1;
    }
    LEX_CURSOR = tmp_ws;
    
    if LEX_CURSOR >= source_len {
        return JsToken::EndOfFile;
    }
    
    let c = *((source_ptr + (LEX_CURSOR as u64)) as &u8);
    let start_cursor = LEX_CURSOR;
    
    if is_digit(c) {
        let mut val: f64 = 0.0;
        let mut tmp_dig = LEX_CURSOR;
        while tmp_dig < source_len {
            let ch = *((source_ptr + (tmp_dig as u64)) as &u8);
            if is_digit(ch) == false {
                break;
            }
            tmp_dig = tmp_dig + 1;
        }
        LEX_CURSOR = tmp_dig;
        return JsToken::Number(0.0);
    }
    
    if is_alpha(c) {
        let mut tmp_al = LEX_CURSOR;
        while tmp_al < source_len {
            let ch = *((source_ptr + (tmp_al as u64)) as &u8);
            let mut is_alphanum = false;
            if is_alpha(ch) { is_alphanum = true; }
            if is_digit(ch) { is_alphanum = true; }
            if is_alphanum == false {
                break;
            }
            tmp_al = tmp_al + 1;
        }
        LEX_CURSOR = tmp_al;
        let len = LEX_CURSOR - start_cursor;
        
        if len == 3 {
            let c0 = *((source_ptr + (start_cursor as u64)) as &u8);
            let c1 = *((source_ptr + ((start_cursor + 1) as u64)) as &u8);
            let c2 = *((source_ptr + ((start_cursor + 2) as u64)) as &u8);
            if c0 == 0x6C {
                if c1 == 0x65 {
                    if c2 == 0x74 {
                        return JsToken::Keyword(KeywordToken::Let);
                    }
                }
            }
        }
        
        let span = TokenSpan { start: start_cursor, len: len };
        return JsToken::Identifier(span);
    }
    
    LEX_CURSOR = LEX_CURSOR + 1;
    if c == 0x2B { return JsToken::Punctuation(PunctToken::Plus); }
    if c == 0x2D { return JsToken::Punctuation(PunctToken::Minus); }
    if c == 0x2A { return JsToken::Punctuation(PunctToken::Asterisk); }
    if c == 0x2F { return JsToken::Punctuation(PunctToken::Slash); }
    if c == 0x3D { return JsToken::Punctuation(PunctToken::Assign); }
    if c == 0x28 { return JsToken::Punctuation(PunctToken::OpenParen); }
    if c == 0x29 { return JsToken::Punctuation(PunctToken::CloseParen); }
    if c == 0x3B { return JsToken::Punctuation(PunctToken::SemiColon); }
    
    return JsToken::Unknown(start_cursor);
}

// Legacy struct-based API for compatibility
pub fn next_token(state: &mut JsCompilerState) -> JsToken {
    return next_token_global();
}
