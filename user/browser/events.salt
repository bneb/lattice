package user.browser.events

import user.browser.dom
import user.browser.paint
import user.browser.chrome
import user.browser.net
import user.browser.compositor

extern fn drain_keyboard_input() -> u32;
extern fn ext_mark_all_compositor_dirty();
extern fn js_bridge_dispatch_event(node_id: u64, type_ptr: u64, type_len: u32);
extern fn drain_scroll_input() -> i32;
extern fn ext_salt_create_node(tag: u32) -> u64;
extern fn sys_ipc_send_r2m_command_with_payload(cmd: u32, arg1: u64, ptr: u64, len: u32);

// [EPIC 110]: The High-Performance Event Registry
// Stores (node_id, type_hash, callback_ptr, is_capture) in a flat SoA matrix.
pub global REG_NODE:    [u32; 1024] = [0; 1024];
pub global REG_HASH:    [u32; 1024] = [0; 1024];
pub global REG_CB_PTR:  [u64; 1024] = [0; 1024];
pub global REG_CAPTURE: [u8;  1024] = [0; 1024];
pub global REG_COUNT:   u32 = 0;

@no_mangle
pub fn ext_events_register(node_id: u32, type_hash: u32, cb_ptr: u64, capture: u8) {
    let count = REG_COUNT;
    if count < 1024 {
        REG_NODE[count as usize] = node_id;
        REG_HASH[count as usize] = type_hash;
        REG_CB_PTR[count as usize] = cb_ptr;
        REG_CAPTURE[count as usize] = capture;
        REG_COUNT = count + 1;
    }
}

@no_mangle
pub fn ext_events_remove(node_id: u32, type_hash: u32, cb_ptr: u64, capture: u8) {
    let mut i: u32 = 0;
    while i < REG_COUNT {
        if REG_NODE[i as usize] == node_id && REG_HASH[i as usize] == type_hash && REG_CB_PTR[i as usize] == cb_ptr {
            REG_NODE[i as usize] = 0; // Soft delete
        }
        i = i + 1;
    }
}

extern fn ext_jsc_call_event_callback(cb_ptr: u64, js_event_ptr: u64);

@no_mangle
pub fn ext_events_invoke(node_id: u32, type_hash: u32, js_event_ptr: u64, is_capture: u8) {
    let mut i: u32 = 0;
    while i < REG_COUNT {
        if REG_NODE[i as usize] == node_id && REG_HASH[i as usize] == type_hash && REG_CAPTURE[i as usize] == is_capture {
            let cb = REG_CB_PTR[i as usize];
            if cb != 0 {
                ext_jsc_call_event_callback(cb, js_event_ptr);
            }
        }
        i = i + 1;
    }
}

@no_mangle
pub fn ext_events_free_node_callbacks(node_id: u32) {
    let mut i: u32 = 0;
    while i < REG_COUNT {
        if REG_NODE[i as usize] == node_id {
            REG_NODE[i as usize] = 0;
        }
        i = i + 1;
    }
}

@no_mangle
pub fn get_active_focus_node() -> u64 {
    return dom.dom_get_focused_node() as u64;
}

pub global MOUSE_CLICK_X: [i32; 16] = [0; 16];
pub global MOUSE_CLICK_Y: [i32; 16] = [0; 16];
pub global MOUSE_CLICK_COUNT: u32 = 0;

pub fn get_mouse_click_count() -> u32 { return MOUSE_CLICK_COUNT; }
pub fn get_mouse_click_x(i: u32) -> i32 { return MOUSE_CLICK_X[i as usize]; }
pub fn get_mouse_click_y(i: u32) -> i32 { return MOUSE_CLICK_Y[i as usize]; }
pub fn clear_mouse_clicks() { MOUSE_CLICK_COUNT = 0; }

@no_mangle
pub fn enqueue_click(x: i32, y: i32) {
    process_mouse_click(x, y);
}

pub fn process_mouse_click(x: i32, y: i32) {
    if MOUSE_CLICK_COUNT < 16 {
        MOUSE_CLICK_X[MOUSE_CLICK_COUNT as usize] = x;
        MOUSE_CLICK_Y[MOUSE_CLICK_COUNT as usize] = y;
        MOUSE_CLICK_COUNT = MOUSE_CLICK_COUNT + 1;
    }
}

@no_mangle
pub fn ext_engine_process_key_down(char_code: u8) {
    process_key_event(char_code);
    chrome.mark_chrome_dirty();
}

fn handle_backspace(focused: u32, tag: u32) {
    if tag == 18 || tag == 19 {
        dom.delete_text_at_node(focused as u64);
        dom.invalidate_layout(focused);
    } else if focused == 0 {
        if chrome.OMNIBOX_LEN > 0 {
            chrome.OMNIBOX_LEN = chrome.OMNIBOX_LEN - 1;
        }
    }
}

fn handle_printable(focused: u32, tag: u32, ch: u8) {
    if tag == 18 || tag == 19 {
        dom.append_text_to_node(focused as u64, ch);
        let m_input: [u8; 5] = [105, 110, 112, 117, 116];
        js_bridge_dispatch_event(focused as u64, (&m_input) as u64, 5);
        dom.invalidate_layout(focused);
    } else if focused == 0 {
        if chrome.OMNIBOX_LEN < 1023 {
            chrome.OMNIBOX_URL[chrome.OMNIBOX_LEN as usize] = ch;
            chrome.OMNIBOX_LEN = chrome.OMNIBOX_LEN + 1;
        }
    }
}

fn handle_enter(focused: u32, tag: u32) {
    if tag == 18 || tag == 19 {
        let form = dom.find_form_ancestor(focused);
        if form != 0 {
            dom.dom_handle_form_submit(form);
        }
    } else {
        let new_root = dom.create_node(1);
        let mut nav_bit: u64 = 1; nav_bit = nav_bit << 62;
        sys_ipc_send_r2m_command_with_payload(12, nav_bit | new_root, (&chrome.OMNIBOX_URL) as u64, chrome.OMNIBOX_LEN);
    }
}

@no_mangle
pub fn process_key_event(ch: u8) {
    let focused = dom.ACTIVE_FOCUS_NODE_IDX;
    let mut tag: u32 = 0;
    if focused != 0 {
        tag = dom.DOM_NODE_TAG[focused as usize];
    }
    
    if ch == 13 || ch == 10 {
        handle_enter(focused, tag);
    } else if ch == 127 || ch == 8 {
        handle_backspace(focused, tag);
    } else if ch >= 32 && ch < 127 {
        handle_printable(focused, tag, ch);
    }
}

@no_mangle
pub fn sys_events_pump_os_queue() {
    compositor.window_pump_events();
    
    let current_scroll_y = drain_scroll_input();
    let keyboard_count = drain_keyboard_input();

    if keyboard_count > 0 {
        let key_ptr: u64 = compositor.get_key_buf_ptr();
        let mut ki: u32 = 0;
        while ki < keyboard_count {
            let ch: u8 = *((key_ptr + (ki as u64)) as &u8);
            process_key_event(ch);
            ki = ki + 1;
        }
        chrome.mark_chrome_dirty();
    }
    
    let m_count = get_mouse_click_count();
    let mut i: u32 = 0;
    while i < m_count {
        let m_x = get_mouse_click_x(i);
        let m_y = get_mouse_click_y(i);
        let adjusted_y = m_y + current_scroll_y;
        process_mouse_click(m_x, adjusted_y);
        i = i + 1;
    }
    clear_mouse_clicks();
}

pub struct EventDispatchContext {
    pub status: i32,
    pub sip_idx: u32,
    pub target_pc: u32
}

extern fn sys_hit_test(x: f32, y: f32, root_node: u32) -> u32;

@no_mangle
pub fn dispatch_click(x: i32, y: i32, flags: u32) -> EventDispatchContext {
    let target = sys_hit_test(x as f32, y as f32, 1);
    
    let mut i: u32 = 0;
    while i < dom.get_event_count() {
        if dom.EVENT_NODE[i as usize] == target {
            return EventDispatchContext {
                status: 0,
                sip_idx: dom.EVENT_SIP[i as usize],
                target_pc: dom.EVENT_PC[i as usize]
            };
        }
        i = i + 1;
    }
    
    return EventDispatchContext { status: -2, sip_idx: 0, target_pc: 0 };
}
