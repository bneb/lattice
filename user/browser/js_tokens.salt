package user.browser.js_tokens

pub struct TokenSpan {
    pub start: u32,
    pub len: u32
}

pub enum PunctToken {
    Plus,
    Minus,
    Asterisk,
    Slash,
    Assign,
    OpenParen,
    CloseParen,
    SemiColon
}

pub enum KeywordToken {
    Let,
    Function,
    Return
}

pub enum JsToken {
    EndOfFile,
    Identifier(TokenSpan),
    Number(f64),
    String(TokenSpan),
    Punctuation(PunctToken),
    Keyword(KeywordToken),
    Unknown(u32)
}
