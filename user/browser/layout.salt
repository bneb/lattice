// ============================================================================
// Pointer Injection Matrix — Canonical DOM Array Pointers
// These are initialized at boot by layout_inject_dom_pointers().
// All dom.ARRAY[idx] accesses below use these pointers directly.
// ============================================================================

// i32 arrays (stride 4)
global P_LAYOUT_X: u64 = 0;
global P_LAYOUT_Y: u64 = 0;
global P_LAYOUT_W: u64 = 0;
global P_LAYOUT_H: u64 = 0;
global P_STYLE_W: u64 = 0;
global P_STYLE_H: u64 = 0;
global P_STYLE_FLEX_GROW: u64 = 0;
global P_STYLE_FLEX_BASIS: u64 = 0;
global P_STYLE_PADDING_TOP: u64 = 0;
global P_STYLE_PADDING_RIGHT: u64 = 0;
global P_STYLE_PADDING_BOTTOM: u64 = 0;
global P_STYLE_PADDING_LEFT: u64 = 0;
global P_STYLE_TOP: u64 = 0;
global P_STYLE_LEFT: u64 = 0;
global P_STYLE_Z_INDEX: u64 = 0;

// u32 arrays (stride 4)
global P_DOM_NODE_TAG: u64 = 0;
global P_DOM_TEXT_LEN: u64 = 0;
global P_STYLE_PARENT: u64 = 0;

// u8 arrays (stride 1)
global P_DIRTY_LAYOUT: u64 = 0;
global P_DIRTY_STYLE: u64 = 0;
global P_STYLE_DISPLAY: u64 = 0;
global P_STYLE_FLEX_DIR: u64 = 0;
global P_STYLE_JUSTIFY_CONTENT: u64 = 0;
global P_STYLE_ALIGN_ITEMS: u64 = 0;
global P_STYLE_W_UNIT: u64 = 0;
global P_STYLE_POSITION: u64 = 0;
global P_STYLE_OVERFLOW: u64 = 0;
global P_STYLE_GRID_COL_COUNT: u64 = 0;
global P_STYLE_GRID_COL_START: u64 = 0;
global P_STYLE_GRID_ROW_START: u64 = 0;
global P_STYLE_TEXT_ALIGN: u64 = 0;
global P_STYLE_GRID_COL_TYPE: u64 = 0;

// u64 arrays (stride 8)
global P_DOM_NODE_NEXT_SIBLING: u64 = 0;
global P_DOM_TEXT_PTR: u64 = 0;

// f32 arrays (stride 4)
global P_STYLE_FONT_SIZE: u64 = 0;
global P_LAYOUT_SCROLL_X: u64 = 0;
global P_LAYOUT_SCROLL_Y: u64 = 0;
global P_STYLE_GRID_COL_VAL: u64 = 0;

// Extern: pointer export functions from dom.salt
extern fn dom_ptr_LAYOUT_X() -> u64;
extern fn dom_ptr_LAYOUT_Y() -> u64;
extern fn dom_ptr_LAYOUT_W() -> u64;
extern fn dom_ptr_LAYOUT_H() -> u64;
extern fn dom_ptr_STYLE_W() -> u64;
extern fn dom_ptr_STYLE_H() -> u64;
extern fn dom_ptr_STYLE_FLEX_GROW() -> u64;
extern fn dom_ptr_STYLE_FLEX_BASIS() -> u64;
extern fn dom_ptr_STYLE_PADDING_TOP() -> u64;
extern fn dom_ptr_STYLE_PADDING_RIGHT() -> u64;
extern fn dom_ptr_STYLE_PADDING_BOTTOM() -> u64;
extern fn dom_ptr_STYLE_PADDING_LEFT() -> u64;
extern fn dom_ptr_STYLE_TOP() -> u64;
extern fn dom_ptr_STYLE_LEFT() -> u64;
extern fn dom_ptr_STYLE_Z_INDEX() -> u64;
extern fn dom_ptr_DOM_NODE_TAG() -> u64;
extern fn dom_ptr_DOM_TEXT_LEN() -> u64;
extern fn dom_ptr_STYLE_PARENT() -> u64;
extern fn dom_ptr_DIRTY_LAYOUT() -> u64;
extern fn dom_ptr_DIRTY_STYLE() -> u64;
extern fn dom_ptr_STYLE_DISPLAY() -> u64;
extern fn dom_ptr_STYLE_FLEX_DIR() -> u64;
extern fn dom_ptr_STYLE_JUSTIFY_CONTENT() -> u64;
extern fn dom_ptr_STYLE_ALIGN_ITEMS() -> u64;
extern fn dom_ptr_STYLE_W_UNIT() -> u64;
extern fn dom_ptr_STYLE_POSITION() -> u64;
extern fn dom_ptr_STYLE_OVERFLOW() -> u64;
extern fn dom_ptr_STYLE_GRID_COL_COUNT() -> u64;
extern fn dom_ptr_STYLE_GRID_COL_START() -> u64;
extern fn dom_ptr_STYLE_GRID_ROW_START() -> u64;
extern fn dom_ptr_STYLE_TEXT_ALIGN() -> u64;
extern fn dom_ptr_STYLE_GRID_COL_TYPE() -> u64;
extern fn dom_ptr_DOM_NODE_NEXT_SIBLING() -> u64;
extern fn dom_ptr_DOM_TEXT_PTR() -> u64;
extern fn dom_ptr_STYLE_FONT_SIZE() -> u64;
extern fn dom_ptr_LAYOUT_SCROLL_X() -> u64;
extern fn dom_ptr_LAYOUT_SCROLL_Y() -> u64;
