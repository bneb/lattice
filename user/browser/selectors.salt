// Phase 3: The Zero-Allocation Query Engine

import user.browser.dom
import std.core.str

@no_mangle
pub fn sys_dom_query_selector(root_node_idx: u32, selector_str_ptr: u64, selector_len: u32) -> u64 {
    let sel_type = parse_selector_type(selector_str_ptr); // 1 = ID, 2 = Class, 3 = Tag
    
    let mut target_hash: u32 = 0;
    if sel_type == 3 {
        target_hash = hash_string_to_upper_if_needed(selector_str_ptr, selector_len);
    } else {
        target_hash = hash_string(selector_str_ptr + 1, selector_len - 1);
    }
    
    let mut stack: [u64; 128] = [0; 128];
    let mut stack_ptr: i32 = 0;
    
    let first_child_id = dom.DOM_NODE_FIRST_CHILD[root_node_idx as usize];
    if first_child_id == 0 { return 0; }
    
    stack[stack_ptr as usize] = first_child_id;
    
    while stack_ptr >= 0 {
        let current_id = stack[stack_ptr as usize];
        if current_id == 0 {
            stack_ptr = stack_ptr - 1;
            continue;
        }
        
        let current_idx = (current_id & 0xFFFF) as u32;
        
        let next_sibling_id = dom.DOM_NODE_NEXT_SIBLING[current_idx as usize];
        if next_sibling_id != 0 {
            stack[stack_ptr as usize] = next_sibling_id;
        } else {
            stack_ptr = stack_ptr - 1;
        }
        
        if node_matches_target(current_idx, sel_type, target_hash) {
            return current_id;
        }
        
        let child_id = dom.DOM_NODE_FIRST_CHILD[current_idx as usize];
        if child_id != 0 {
            stack_ptr = stack_ptr + 1;
            if stack_ptr < 128 {
                stack[stack_ptr as usize] = child_id;
            } else {
                stack_ptr = stack_ptr - 1;
            }
        }
    }
    
    return 0; // No match found
}

pub fn node_matches_target(current_idx: u32, sel_type: u32, target_hash: u32) -> bool {
    if sel_type == 1 { // ID
        let id_ptr = dom.DOM_ID_PTR[current_idx as usize];
        let id_len = dom.DOM_ID_LEN[current_idx as usize];
        if id_ptr != 0 && id_len > 0 {
            if hash_string(id_ptr, id_len) == target_hash { return true; }
        }
    } else if sel_type == 3 { // Tag
        let tag = dom.DOM_NODE_TAG[current_idx as usize];
        if tag == target_hash { return true; }
    }
    return false;
}

pub fn hash_string_to_upper_if_needed(ptr: u64, len: u32) -> u32 {
    let mut hash: u32 = 2166136261;
    let mut i: u32 = 0;
    while i < len {
        let mut ch = *((ptr + (i as u64)) as &u8) as u32;
        if ch >= 97 && ch <= 122 { ch = ch - 32; } // Convert to uppercase for tag parsing consistency?
        // Wait, custom elements use lowercase string hash! 
        // We will just use hash_string for now since we lowercased test-widget.
        hash = hash ^ ch;
        hash = hash * 16777619;
        i = i + 1;
    }
    return hash;
}

pub fn parse_selector_type(selector_str_ptr: u64) -> u32 {
    let first_char = *((selector_str_ptr) as &u8);
    if first_char == 35 { return 1; }
    if first_char == 46 { return 2; }
    return 3;
}

pub fn hash_string(ptr: u64, len: u32) -> u32 {
    let mut hash: u32 = 2166136261;
    let mut i: u32 = 0;
    while i < len {
        let ch = *((ptr + (i as u64)) as &u8) as u32;
        hash = hash ^ ch;
        hash = hash * 16777619;
        i = i + 1;
    }
    return hash;
}

pub fn node_has_class(current: u32, target_hash: u32) -> bool {
    // Phase 2 placeholder
    return false;
}
