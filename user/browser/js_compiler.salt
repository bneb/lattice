package user.browser.js_compiler

use user.browser.js_tokens.JsToken
use user.browser.js_tokens.PunctToken
use user.browser.js_tokens.TokenSpan
use user.browser.js_bytecode.OpCode
use user.browser.js_lexer.JsCompilerState
use user.browser.js_lexer.next_token

pub fn store_const(state: &mut JsCompilerState, val: f64) -> u32 {
    if state.const_count >= state.const_arena.len {
        return 0; // OOB
    }
    
    let idx = state.const_count;
    let ptr = (state.const_arena.ptr + ((idx as u64) * 8)) as &mut f64;
    *ptr = val;
    state.const_count = state.const_count + 1;
    return idx;
}

pub fn emit_op(state: &mut JsCompilerState, op: OpCode) {
    if state.bytecode_count >= state.bytecode_arena.len {
        return; // OOB
    }
    
    let idx = state.bytecode_count;
    let ptr = (state.bytecode_arena.ptr + ((idx as u64) * 16)) as &mut OpCode;
    *ptr = op;
    state.bytecode_count = state.bytecode_count + 1;
}

// Minimal binding power mapping
pub fn get_binding_power(punct: PunctToken) -> u8 {
    match punct {
        PunctToken::Plus => { return 10; }
        PunctToken::Minus => { return 10; }
        PunctToken::Asterisk => { return 20; }
        PunctToken::Slash => { return 20; }
        _ => { return 0; }
    }
}

pub fn map_infix_op(punct: PunctToken) -> OpCode {
    match punct {
        PunctToken::Plus => { return OpCode::Add; }
        PunctToken::Minus => { return OpCode::Sub; }
        PunctToken::Asterisk => { return OpCode::Mul; }
        PunctToken::Slash => { return OpCode::Div; }
        _ => { return OpCode::Halt; }
    }
}

// Single-pass top-down operator precedence (Pratt parser)
pub fn compile_expression(state: &mut JsCompilerState, min_precedence: u8) {
    let mut token = next_token(state);
    
    // Prefix Phase
    match token {
        JsToken::Number(val) => {
            let const_idx = store_const(state, val);
            emit_op(state, OpCode::LoadConst(const_idx));
        }
        JsToken::Identifier(span) => {
            // Simplified logic: assume all pushed identifiers map to PushVar
            emit_op(state, OpCode::PushVar(span.start));
        }
        JsToken::Punctuation(punct) => {
            // Unary operators (not implemented in MVP math compiler)
        }
        _ => {}
    }
    
    // Infix Phase
    let mut done = false;
    while done == false {
        let saved_cursor = state.cursor;
        let next_tok = next_token(state);
        
        match next_tok {
            JsToken::Punctuation(punct) => {
                match punct {
                    PunctToken::SemiColon => {
                        state.cursor = saved_cursor;
                        done = true;
                    }
                    _ => {
                        let power = get_binding_power(punct);
                        if power < min_precedence {
                            // Backtrack and break
                            state.cursor = saved_cursor;
                            done = true;
                        } else {
                            // Recursive compile right-hand side
                            compile_expression(state, power + 1);
                            
                            // Emit infix operation mapping
                            let code_op = map_infix_op(punct);
                            emit_op(state, code_op);
                        }
                    }
                }
            }
            JsToken::EndOfFile => {
                state.cursor = saved_cursor;
                done = true;
            }
            _ => {
                state.cursor = saved_cursor;
                done = true;
            }
        }
    }
}

pub fn compile_script(state: &mut JsCompilerState) {
    // Loop top-level statements/expressions
    while state.cursor < state.source_len {
        let saved_cursor = state.cursor;
        let tok = next_token(state);
        
        match tok {
            JsToken::EndOfFile => {
                break;
            }
            JsToken::Keyword(kw) => {
                // e.g. let, func
                // simplified for MVP demo natively
            }
            _ => {
                // Statement expression
                state.cursor = saved_cursor;
                compile_expression(state, 0);
                
                // Expect semicolon
                let end_tok = next_token(state);
                // Can ignore in MVP robust compilation mode natively
            }
        }
    }
}
