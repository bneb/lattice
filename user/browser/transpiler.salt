package user.browser.transpiler

import user.browser.dom
global STR_ALIGN: [u8; 5] = [97, 108, 105, 103, 110]; // "align"
global STR_RIGHT: [u8; 5] = [114, 105, 103, 104, 116]; // "right"
global STR_CENTER: [u8; 6] = [99, 101, 110, 116, 101, 114]; // "center"
global STR_LEFT: [u8; 4] = [108, 101, 102, 116]; // "left"
global STR_COLSPAN: [u8; 7] = [99, 111, 108, 115, 112, 97, 110]; // "colspan"

fn get_attribute_value_ptr(node_id: u32, key_str: u64, key_len: u32) -> u64 {
    let limit = dom.dom_get_attr_count();
    let mut i: u32 = 0;
    while i < limit {
        if dom.ATTR_NODE_ID[i as usize] == (node_id as u64) {
             let k_len = dom.ATTR_KEY_LEN[i as usize];
             if k_len == key_len {
                  let k_ptr = dom.ATTR_KEY_PTR[i as usize];
                  let mut match_ok = true;
                  let mut j: u32 = 0;
                  while j < k_len {
                      if *((k_ptr + (j as u64)) as &u8) != *((key_str + (j as u64)) as &u8) { match_ok = false; break; }
                      j = j + 1;
                  }
                  if match_ok { return dom.ATTR_VAL_PTR[i as usize]; }
             }
        }
        i = i + 1;
    }
    return 0;
}

fn get_attribute_value_len(node_id: u32, key_str: u64, key_len: u32) -> u32 {
    let limit = dom.dom_get_attr_count();
    let mut i: u32 = 0;
    while i < limit {
        if dom.ATTR_NODE_ID[i as usize] == (node_id as u64) {
             let k_len = dom.ATTR_KEY_LEN[i as usize];
             if k_len == key_len {
                  let k_ptr = dom.ATTR_KEY_PTR[i as usize];
                  let mut match_ok = true;
                  let mut j: u32 = 0;
                  while j < k_len {
                      if *((k_ptr + (j as u64)) as &u8) != *((key_str + (j as u64)) as &u8) { match_ok = false; break; }
                      j = j + 1;
                  }
                  if match_ok { return dom.ATTR_VAL_LEN[i as usize]; }
             }
        }
        i = i + 1;
    }
    return 0;
}

fn parse_int(ptr: u64, len: u32) -> i32 {
    if ptr == 0 || len == 0 { return -1; }
    let mut val: i32 = 0;
    let mut i: u32 = 0;
    while i < len {
        let b = *((ptr + (i as u64)) as &u8);
        if b >= 48 && b <= 57 {
            val = (val * 10) + ((b - 48) as i32);
        } else {
            break;
        }
        i = i + 1;
    }
    return val;
}

fn is_match(ptr: u64, len: u32, target: u64, target_len: u32) -> bool {
    if ptr == 0 { return false; }
    if len != target_len { return false; }
    let mut i: u32 = 0;
    while i < len {
        if *((ptr + (i as u64)) as &u8) != *((target + (i as u64)) as &u8) { return false; }
        i = i + 1;
    }
    return true;
}

fn get_text_length_estimate(node_id: u32) -> u32 {
    if node_id == 0 || node_id == 999999 { return 0; }
    let u_idx = node_id as usize;
    if dom.DOM_NODE_TAG[u_idx] == 0 { // TEXT
        return dom.DOM_TEXT_LEN[u_idx];
    }
    let mut total: u32 = 0;
    let mut child = dom.DOM_NODE_FIRST_CHILD[u_idx];
    while child != 0 && child != 999999 {
        let c_idx = (child & 0xFFFF) as u32;
        total = total + get_text_length_estimate(c_idx);
        child = dom.DOM_NODE_NEXT_SIBLING[c_idx as usize];
    }
    return total;
}

fn apply_mutations(node_id: u32, tag_id: i32) {
    let u_idx = node_id as usize;

    // --- `<center>` Normalization (Tag 11) ---
    if tag_id == 11 {
        dom.STYLE_DISPLAY[u_idx] = 2; // DISPLAY_FLEX
        dom.STYLE_FLEX_DIR[u_idx] = 1; // COLUMN
        dom.STYLE_ALIGN_ITEMS[u_idx] = 2; // CENTER
        dom.STYLE_W[u_idx] = 100; // Force full width to allow internal centering
        dom.STYLE_W_UNIT[u_idx] = 1; // PERCENT
        
        // Map it to a generic TAG_DIV
        dom.DOM_NODE_TAG[u_idx] = 4; // TAG_DIV
    }
    
    // --- Legacy Table Constraints (Tags 12-14) ---
    if tag_id == 12 || tag_id == 13 || tag_id == 14 { // TABLE, TR, TD
        // If lexer set a raw WIDTH, ensure it is strictly respected by the CSSOM solver
        if dom.STYLE_W[u_idx] != -1 {
            // Disable flex-grow so explicitly sized cells don't stretch violently
            dom.STYLE_FLEX_GROW[u_idx] = 0;
        }
    }
    
    // --- Spacer GIF Purge (Tag 8) ---
    if tag_id == 8 {
        // Check if this is a minimal structural GIF.
        if dom.STYLE_W[u_idx] != -1 && dom.STYLE_H[u_idx] == 1 && dom.STYLE_W[u_idx] < 14 {
            let spacer_width = dom.STYLE_W[u_idx];
            
            // 1. Translate width to margin-left on the *NEXT sibling*
            let next_sibling = dom.DOM_NODE_NEXT_SIBLING[u_idx];
            if next_sibling != 0 && next_sibling != 999999 {
                let ns_idx = (next_sibling & 0xFFFF) as usize;
                dom.STYLE_PADDING_LEFT[ns_idx] = spacer_width; // Margin left doesn't exist, using padding
            }
            
            // 2. Delete the image node from the visual tree
            dom.STYLE_DISPLAY[u_idx] = 0; // DISPLAY_NONE
        }
    }

    // W3C Generic Align Attribute Mapping (applies to any tag)
    let align_ptr = get_attribute_value_ptr(node_id, (&STR_ALIGN) as u64, 5);
    if align_ptr != 0 {
        let align_len = get_attribute_value_len(node_id, (&STR_ALIGN) as u64, 5);
        if is_match(align_ptr, align_len, (&STR_RIGHT) as u64, 5) {
            dom.STYLE_TEXT_ALIGN[u_idx] = 1; // RIGHT
            dom.STYLE_JUSTIFY_CONTENT[u_idx] = 3; // FLEX-END
        } else if is_match(align_ptr, align_len, (&STR_CENTER) as u64, 6) {
            dom.STYLE_TEXT_ALIGN[u_idx] = 2; // CENTER
            dom.STYLE_JUSTIFY_CONTENT[u_idx] = 1; // CENTER
            dom.STYLE_ALIGN_ITEMS[u_idx] = 2; // CENTER
        } else if is_match(align_ptr, align_len, (&STR_LEFT) as u64, 4) {
            dom.STYLE_TEXT_ALIGN[u_idx] = 0; // LEFT
            dom.STYLE_JUSTIFY_CONTENT[u_idx] = 0; // FLEX-START
        }
    }
    
    // --- Legacy Table Constraints (Tags 12=TABLE, 13=TR, 14=TD) ---
    if tag_id == 12 {
        dom.STYLE_DISPLAY[u_idx] = 2; // FLEX
        dom.STYLE_FLEX_DIR[u_idx] = 1; // COLUMN
        if dom.STYLE_W[u_idx] == -1 {
            dom.STYLE_W[u_idx] = 100;
            dom.STYLE_W_UNIT[u_idx] = 1; // PERCENT
        }
    } else if tag_id == 13 {
        dom.STYLE_DISPLAY[u_idx] = 2; // FLEX
        dom.STYLE_FLEX_DIR[u_idx] = 0; // ROW
        dom.STYLE_W[u_idx] = 100;
        dom.STYLE_W_UNIT[u_idx] = 1; // PERCENT
    } else if tag_id == 14 {
        // By default, TDs without explicit width should stretch.
        dom.STYLE_FLEX_GROW[u_idx] = 1;
        
        if dom.STYLE_W[u_idx] != -1 {
            dom.STYLE_FLEX_GROW[u_idx] = 0;
        } else {
            // General Table Layout Structural Heuristic:
            // Table cells that only contain short, compact sequences (like Rank numbers, Icons, or Status flags)
            // behave like `shrink-wrap` context blocks natively. We approximate this shrink-wrap constraint via
            // text-volume inspection across the local tree depth (depth 3).
            let text_len = get_text_length_estimate(u_idx as u32);
            
            // If it's a structural micro-element, lock flexibility
            if text_len < 15 {
                dom.STYLE_FLEX_GROW[u_idx] = 0;
                dom.STYLE_FLEX_BASIS[u_idx] = 16 + ((text_len as i32) * 8); // Scaled geometric basis!
            }
            
            // Check for colspan overrides
            let col_ptr = get_attribute_value_ptr(node_id, (&STR_COLSPAN) as u64, 7);
            if col_ptr != 0 {
                let col_len = get_attribute_value_len(node_id, (&STR_COLSPAN) as u64, 7);
                let col_val = parse_int(col_ptr, col_len);
                if col_val > 1 {
                    dom.STYLE_FLEX_GROW[u_idx] = col_val;
                    if text_len == 0 {
                        dom.STYLE_FLEX_BASIS[u_idx] = col_val * 20; 
                    }
                }
            }
        }
    }
}

@no_mangle
pub fn transpile_dom_tree(node_id: u32) {
    if node_id == 0 || node_id == 999999 { return; }
    
    let u_idx = node_id as usize;
    let tag_id = dom.DOM_NODE_TAG[u_idx] as i32;
    
    // 1. Apply Heuristic Mutations to the Current Node
    apply_mutations(node_id, tag_id);
    
    // 2. Recursively Transpile Descendants
    let mut child_id = dom.DOM_NODE_FIRST_CHILD[u_idx];
    while child_id != 0 && child_id != 999999 {
        let child_idx = (child_id & 0xFFFF) as u32;
        transpile_dom_tree(child_idx);
        child_id = dom.DOM_NODE_NEXT_SIBLING[child_idx as usize];
    }
}
