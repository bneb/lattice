package user.browser.js_jsc

extern fn sys_jsc_init();
@no_mangle extern fn sys_jsc_evaluate_script(code_ptr: u64, len: u32, filename: u64);
@no_mangle extern fn sys_jsc_flush_microtasks();
@no_mangle extern fn sys_jsc_teardown();

@no_mangle extern fn js_resolve_fetch_impl(fetch_id: u64, ptr: u64, len: u32);

@no_mangle
pub fn js_resolve_fetch(fetch_id: u64, ptr: u64, len: u32) {
    js_resolve_fetch_impl(fetch_id, ptr, len);
}

@no_mangle
pub fn js_engine_init() {
    sys_jsc_init();
}

@no_mangle
pub fn js_engine_eval_string(code_ptr: u64, len: u32) {
    sys_jsc_evaluate_script(code_ptr, len, 0);
}

@no_mangle
pub fn js_engine_teardown() {
    sys_jsc_teardown();
}

@no_mangle
pub fn pump_microtasks() {
    sys_jsc_flush_microtasks();
}
