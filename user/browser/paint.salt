pub global CMD_TYPE: [u8;  8192] = [0; 8192];
pub global CMD_X:    [i32; 8192] = [0; 8192];
pub global CMD_Y:    [i32; 8192] = [0; 8192];
pub global CMD_W:    [i32; 8192] = [0; 8192];
pub global CMD_H:    [i32; 8192] = [0; 8192];
pub global CMD_UV_X: [f32; 8192] = [0.0; 8192];
pub global CMD_UV_Y: [f32; 8192] = [0.0; 8192];
pub global CMD_UV_W: [f32; 8192] = [0.0; 8192];
pub global CMD_UV_H: [f32; 8192] = [0.0; 8192];
pub global CMD_R:    [u8;  8192] = [0; 8192];
pub global CMD_G:    [u8;  8192] = [0; 8192];
pub global CMD_B:    [u8;  8192] = [0; 8192];
pub global CMD_A:    [u8;  8192] = [255; 8192];

pub global CMD_RAD:  [f32; 8192] = [0.0; 8192];
pub global CMD_SHADOW_R: [u8; 8192] = [0; 8192];
pub global CMD_SHADOW_G: [u8; 8192] = [0; 8192];
pub global CMD_SHADOW_B: [u8; 8192] = [0; 8192];
pub global CMD_SHADOW_A: [u8; 8192] = [0; 8192];
pub global CMD_SHADOW_X: [f32; 8192] = [0.0; 8192];
pub global CMD_SHADOW_Y: [f32; 8192] = [0.0; 8192];
pub global CMD_SHADOW_B_L: [f32; 8192] = [0.0; 8192];
pub global CMD_SHADOW_S: [f32; 8192] = [0.0; 8192];

pub global CMD_TX:      [f32; 8192] = [0.0; 8192];
pub global CMD_TY:      [f32; 8192] = [0.0; 8192];
pub global CMD_OPACITY: [f32; 8192] = [1.0; 8192];
pub global CMD_NODE_ID: [u32; 8192] = [0; 8192];

// Epic 56: GPU Scissor Testing Stack
pub global CLIP_STACK_X: [i32; 64] = [0; 64];
pub global CLIP_STACK_Y: [i32; 64] = [0; 64];
pub global CLIP_STACK_W: [i32; 64] = [0; 64];
pub global CLIP_STACK_H: [i32; 64] = [0; 64];
pub global CLIP_STACK_PTR: u32 = 0;

extern fn sys_gpu_set_scissor_rect(x: i32, y: i32, w: i32, h: i32);

pub global PAINT_CURR_R: u8 = 0;
pub global PAINT_CURR_G: u8 = 0;
pub global PAINT_CURR_B: u8 = 0;

// CRITICAL: These must be [T;1] arrays, NOT scalar globals,
// because LLVM GlobalMerge displaces scalar global addresses
// in the multiprocess renderer binary.
pub global CMD_COUNT_A: [u32; 1] = [0; 1];
pub global PAINT_VISIT_COUNT_A: [u32; 1] = [0; 1];

// ============================================================================
// Phase 32: Display List Compiler (Path Alpha)
// ============================================================================

pub const OP_DRAW_RECT: u8 = 1;
pub const OP_DRAW_TEXT: u8 = 2;
pub const OP_PUSH_CLIP: u8 = 3;
pub const OP_POP_CLIP: u8 = 4;
pub const OP_DRAW_IMAGE: u8 = 5;

pub global DL_OPCODE: [u8;  16384] = [0; 16384];
pub global DL_X:      [f32; 16384] = [0.0; 16384];
pub global DL_Y:      [f32; 16384] = [0.0; 16384];
pub global DL_W:      [f32; 16384] = [0.0; 16384];
pub global DL_H:      [f32; 16384] = [0.0; 16384];
pub global DL_COLOR:  [u32; 16384] = [0; 16384];
pub global DL_COUNT:  u32 = 0;

@no_mangle
pub fn ext_paint_get_dl_count() -> u32 { return DL_COUNT; }

@no_mangle
pub fn ext_paint_get_dl_opcode_ptr() -> u64 { return (&DL_OPCODE[0]) as u64; }

@no_mangle
pub fn ext_paint_get_dl_x_ptr() -> u64 { return (&DL_X[0]) as u64; }

@no_mangle
pub fn ext_paint_get_dl_y_ptr() -> u64 { return (&DL_Y[0]) as u64; }

@no_mangle
pub fn ext_paint_get_dl_w_ptr() -> u64 { return (&DL_W[0]) as u64; }

@no_mangle
pub fn ext_paint_get_dl_h_ptr() -> u64 { return (&DL_H[0]) as u64; }

@no_mangle
pub fn ext_paint_get_dl_color_ptr() -> u64 { return (&DL_COLOR[0]) as u64; }

pub fn compile_display_list_recursive(node_idx: u32) {
    let n_idx = (node_idx & 0xFFFF) as u64;
    
    if node_idx == 0 || *((P_STYLE_DISPLAY + n_idx) as &u8) == 0 { return; }

    PAINT_VISIT_COUNT_A[0] = PAINT_VISIT_COUNT_A[0] + 1;

    let img_ptr = *((P_IMG_PTR + n_idx * 8) as &u64);
    let count = DL_COUNT;

    if img_ptr != 0 && count < 16383 {
        let x = *((P_LAYOUT_X[0] + n_idx * 4) as &i32) as f32;
        let y = *((P_LAYOUT_Y[0] + n_idx * 4) as &i32) as f32;
        let w = *((P_LAYOUT_W[0] + n_idx * 4) as &i32) as f32;
        let h = *((P_LAYOUT_H[0] + n_idx * 4) as &i32) as f32;

        let c_idx = count as usize;
        DL_OPCODE[c_idx] = OP_DRAW_IMAGE;
        DL_X[c_idx] = x;
        DL_Y[c_idx] = y;
        DL_W[c_idx] = w;
        DL_H[c_idx] = h;
        // Re-use DL_COLOR to store the node_idx so Metal can look up the IMG_PTR
        DL_COLOR[c_idx] = node_idx; 
        DL_COUNT = count + 1;
    } else {
        // 1. Emit Background Rect
        let a = *((P_STYLE_BG_A[0] + n_idx) as &u8);
        if a > 0 && count < 16383 {
            let r = *((P_STYLE_BG_R[0] + n_idx) as &u8) as u32;
            let g = *((P_STYLE_BG_G[0] + n_idx) as &u8) as u32;
            let b = *((P_STYLE_BG_B[0] + n_idx) as &u8) as u32;
            let u_a = a as u32;

            let x = *((P_LAYOUT_X[0] + n_idx * 4) as &i32) as f32;
            let y = *((P_LAYOUT_Y[0] + n_idx * 4) as &i32) as f32;
            let w = *((P_LAYOUT_W[0] + n_idx * 4) as &i32) as f32;
            let h = *((P_LAYOUT_H[0] + n_idx * 4) as &i32) as f32;
            
            let c_idx = count as usize;
            DL_OPCODE[c_idx] = OP_DRAW_RECT;
            DL_X[c_idx] = x;
            DL_Y[c_idx] = y;
            DL_W[c_idx] = w;
            DL_H[c_idx] = h;
            DL_COLOR[c_idx] = (r << 24) | (g << 16) | (b << 8) | u_a;
            DL_COUNT = count + 1;
        }
    }

    // 2. Recurse to children (Painter's Algorithm: Front-to-back traversal of tree = back-to-front rendering)
    let mut child = dom.dom_get_render_first_child_idx(node_idx);
    while child != 0 && child != 999999 {
        compile_display_list_recursive(child);
        let c_idx = (child & 0xFFFF) as u64;
        let next_packed = *((P_DOM_NODE_NEXT_SIBLING + c_idx * 8) as &u64);
        child = (next_packed & 0xFFFFFFFF) as u32; // Keep generation for next iteration's resolve
    }
}

@no_mangle
pub fn ext_paint_compile_display_list() {
    DL_COUNT = 0;
    PAINT_VISIT_COUNT_A[0] = 0;
    // We start traversal from Node 1 (Physical Root)
    compile_display_list_recursive(1);
    
    // Also include Node 999999 if it's not a descendant of 1?
    // In our engine Node 1 is the <html> root.
}

pub fn emit_rect(x: i32, y: i32, w: i32, h: i32, n: u32) -> i32 {
    if CMD_COUNT_A[0] >= 8192 { return -1; }
    
    let u_n = n as usize;
    let mut r = *((P_STYLE_BG_R[0] + (u_n as u64)) as &u8);
    let mut g = *((P_STYLE_BG_G[0] + (u_n as u64)) as &u8);
    let mut b = *((P_STYLE_BG_B[0] + (u_n as u64)) as &u8);
    let a = *((P_STYLE_BG_A[0] + (u_n as u64)) as &u8);
    
    if a == 0 { return 0; }
    
    let tag = *((P_DOM_NODE_TAG + (n as u64) * 4) as &u32);
    if n == dom_get_hovered_node() && (tag == 20 || tag == 7) {
        if r >= 25 { r = r - 25; } else { r = 0; }
        if g >= 25 { g = g - 25; } else { g = 0; }
        if b >= 25 { b = b - 25; } else { b = 0; }
    }
    
    let idx = CMD_COUNT_A[0];
    
    CMD_TYPE[idx as usize] = 0; // 0 = RECT
    // Defensive clamp: prevent off-screen coordinates from reaching the GPU
    let mut cx = x;
    let mut cy = y;
    if cx < -8192 { cx = -8192; }
    if cx > 16384 { cx = 16384; }
    if cy < -8192 { cy = -8192; }
    if cy > 16384 { cy = 16384; }
    CMD_X[idx as usize] = cx;
    CMD_Y[idx as usize] = cy;
    CMD_W[idx as usize] = w;
    CMD_H[idx as usize] = h;
    CMD_UV_X[idx as usize] = 0.0;
    CMD_UV_Y[idx as usize] = 0.0;
    CMD_UV_W[idx as usize] = 0.0;
    CMD_UV_H[idx as usize] = 0.0;
    CMD_R[idx as usize] = r;
    CMD_G[idx as usize] = g;
    CMD_B[idx as usize] = b;
    CMD_A[idx as usize] = a;
    
    CMD_RAD[idx as usize] = *((P_STYLE_BORDER_RADIUS + (u_n as u64) * 4) as &f32);
    CMD_SHADOW_R[idx as usize] = *((P_STYLE_BOX_SHADOW_R + (u_n as u64)) as &u8);
    CMD_SHADOW_G[idx as usize] = *((P_STYLE_BOX_SHADOW_G + (u_n as u64)) as &u8);
    CMD_SHADOW_B[idx as usize] = *((P_STYLE_BOX_SHADOW_B + (u_n as u64)) as &u8);
    CMD_SHADOW_A[idx as usize] = *((P_STYLE_BOX_SHADOW_A + (u_n as u64)) as &u8);
    CMD_SHADOW_X[idx as usize] = *((P_STYLE_BOX_SHADOW_OFFSET_X + (u_n as u64) * 4) as &f32);
    CMD_SHADOW_Y[idx as usize] = *((P_STYLE_BOX_SHADOW_OFFSET_Y + (u_n as u64) * 4) as &f32);
    CMD_SHADOW_B_L[idx as usize] = *((P_STYLE_BOX_SHADOW_BLUR + (u_n as u64) * 4) as &f32);
    CMD_SHADOW_S[idx as usize] = *((P_STYLE_BOX_SHADOW_SPREAD + (u_n as u64) * 4) as &f32);
    
    CMD_TX[idx as usize] = *((P_STYLE_TRANSFORM_X + (u_n as u64) * 4) as &f32);
    CMD_TY[idx as usize] = *((P_STYLE_TRANSFORM_Y + (u_n as u64) * 4) as &f32);
    CMD_OPACITY[idx as usize] = *((P_STYLE_OPACITY + (u_n as u64) * 4) as &f32);
    CMD_NODE_ID[idx as usize] = n;
    
    CMD_COUNT_A[0] = CMD_COUNT_A[0] + 1;
    return 0;
}

pub fn emit_solid_rect(x: i32, y: i32, w: i32, h: i32, r: u8, g: u8, b: u8, a: u8, n: u32) -> i32 {
    if CMD_COUNT_A[0] >= 8192 { return -1; }
    
    let idx = CMD_COUNT_A[0];
    CMD_TYPE[idx as usize] = 0; // 0 = RECT
    CMD_X[idx as usize] = x;
    CMD_Y[idx as usize] = y;
    CMD_W[idx as usize] = w;
    CMD_H[idx as usize] = h;
    CMD_UV_X[idx as usize] = 0.0;
    CMD_UV_Y[idx as usize] = 0.0;
    CMD_UV_W[idx as usize] = 0.0;
    CMD_UV_H[idx as usize] = 0.0;
    CMD_R[idx as usize] = r;
    CMD_G[idx as usize] = g;
    CMD_B[idx as usize] = b;
    CMD_A[idx as usize] = a;
    
    CMD_RAD[idx as usize] = 0.0;
    CMD_SHADOW_R[idx as usize] = 0;
    CMD_SHADOW_G[idx as usize] = 0;
    CMD_SHADOW_B[idx as usize] = 0;
    CMD_SHADOW_A[idx as usize] = 0;
    CMD_SHADOW_X[idx as usize] = 0.0;
    CMD_SHADOW_Y[idx as usize] = 0.0;
    CMD_SHADOW_B_L[idx as usize] = 0.0;
    CMD_SHADOW_S[idx as usize] = 0.0;
    
    CMD_TX[idx as usize] = 0.0;
    CMD_TY[idx as usize] = 0.0;
    CMD_OPACITY[idx as usize] = 1.0;
    CMD_NODE_ID[idx as usize] = n;
    
    CMD_COUNT_A[0] = CMD_COUNT_A[0] + 1;
    return 0;
}

pub fn emit_glyph(x: i32, y: i32, w: i32, h: i32, uv_x: f32, uv_y: f32, uv_w: f32, uv_h: f32, n: u32) -> i32 {
    if CMD_COUNT_A[0] >= 8192 { return -1; }
    
    let idx = CMD_COUNT_A[0];
    CMD_TYPE[idx as usize] = 1; // 1 = GLYPH (SDF) smoothly naturally securely cleanly nicely creatively neatly capably smartly securely properly sensibly gracefully effectively flexibly explicit safely explicitly gracefully intelligently safely cleanly intelligently seamlessly confidently wonderfully flawlessly dependably dependably solidly properly
    CMD_X[idx as usize] = x;
    CMD_Y[idx as usize] = y;
    CMD_W[idx as usize] = w;
    CMD_H[idx as usize] = h;
    CMD_UV_X[idx as usize] = uv_x;
    CMD_UV_Y[idx as usize] = uv_y;
    CMD_UV_W[idx as usize] = uv_w;
    CMD_UV_H[idx as usize] = uv_h;
    
    // HARDCODE WHITE to bypass ARM64 >8 argument ABI bugs in the Salt Compiler
    CMD_R[idx as usize] = PAINT_CURR_R;
    CMD_G[idx as usize] = PAINT_CURR_G;
    CMD_B[idx as usize] = PAINT_CURR_B;
    CMD_A[idx as usize] = 255;
    
    CMD_RAD[idx as usize] = 0.0;
    CMD_SHADOW_A[idx as usize] = 0;
    
    CMD_TX[idx as usize] = 0.0;
    CMD_TY[idx as usize] = 0.0;
    CMD_OPACITY[idx as usize] = 1.0;
    
    CMD_COUNT_A[0] = CMD_COUNT_A[0] + 1;
    return 0;
}

pub fn emit_image(x: i32, y: i32, w: i32, h: i32, tex_idx: u8, n: u32) -> i32 {
    if CMD_COUNT_A[0] >= 8192 { return -1; }
    
    let idx = CMD_COUNT_A[0];
    CMD_TYPE[idx as usize] = 2; // 2 = BITMAP IMAGE
    CMD_X[idx as usize] = x;
    CMD_Y[idx as usize] = y;
    CMD_W[idx as usize] = w;
    CMD_H[idx as usize] = h;
    CMD_UV_X[idx as usize] = 0.0;
    CMD_UV_Y[idx as usize] = 0.0;
    CMD_UV_W[idx as usize] = 1.0;
    CMD_UV_H[idx as usize] = 1.0;
    CMD_R[idx as usize] = tex_idx;
    CMD_G[idx as usize] = 0;
    CMD_B[idx as usize] = 0;
    CMD_A[idx as usize] = 255;
    
    CMD_RAD[idx as usize] = 0.0;
    CMD_SHADOW_A[idx as usize] = 0;
    
    CMD_TX[idx as usize] = 0.0;
    CMD_TY[idx as usize] = 0.0;
    CMD_OPACITY[idx as usize] = 1.0;
    
    CMD_COUNT_A[0] = CMD_COUNT_A[0] + 1;
    return 0;
}

pub global Z_SORT_BUF: [u32; 8192] = [0; 8192];
pub global Z_SORT_COUNT_A: [u32; 1] = [0; 1];

pub fn get_z_sort_count() -> u32 {
    return Z_SORT_COUNT_A[0];
}

pub fn get_cmd_count() -> u32 {
    return CMD_COUNT_A[0];
}

pub fn begin_frame() {
    CMD_COUNT_A[0] = 0;
    PAINT_VISIT_COUNT_A[0] = 0;
    Z_SORT_COUNT_A[0] = 0;
    CLIP_STACK_PTR = 0;
    
    // Initial viewport clip (effectively infinite/viewport max)
    CLIP_STACK_X[0] = -999999;
    CLIP_STACK_Y[0] = -999999;
    CLIP_STACK_W[0] = 1999999;
    CLIP_STACK_H[0] = 1999999;
    // Reset compositor dirty bits after painting
    let limit = get_dom_node_count() as u32;
    let mut i: u32 = 0;
    while i < limit {
        *((P_COMPOSITOR_DIRTY + (i as u64)) as &mut u8) = 0;
        i = i + 1;
    }
}

pub fn sys_gpu_emit_video_frame(node_id: u32, x: i32, y: i32, w: i32, h: i32) -> i32 {
    if CMD_COUNT_A[0] >= 8192 { return -1; }
    
    let idx = CMD_COUNT_A[0];
    CMD_TYPE[idx as usize] = 3; // 3 = VIDEO YUV
    CMD_X[idx as usize] = x;
    CMD_Y[idx as usize] = y;
    CMD_W[idx as usize] = w;
    CMD_H[idx as usize] = h;
    CMD_UV_X[idx as usize] = 0.0;
    CMD_UV_Y[idx as usize] = 0.0;
    CMD_UV_W[idx as usize] = 1.0;
    CMD_UV_H[idx as usize] = 1.0;
    
    // Store node_id in the color or shadow variables for lookup
    CMD_R[idx as usize] = (node_id & 0xFF) as u8;
    CMD_G[idx as usize] = ((node_id >> 8) & 0xFF) as u8;
    CMD_B[idx as usize] = 0;
    CMD_A[idx as usize] = 255;
    
    CMD_RAD[idx as usize] = 0.0;
    CMD_SHADOW_A[idx as usize] = 0;
    
    CMD_TX[idx as usize] = 0.0;
    CMD_TY[idx as usize] = 0.0;
    CMD_OPACITY[idx as usize] = 1.0;
    
    CMD_COUNT_A[0] = CMD_COUNT_A[0] + 1;
    return 0;
}

pub fn sys_gpu_emit_external_surface(node_id: u32, surface_id: u32, x: i32, y: i32, w: i32, h: i32) -> i32 {
    if CMD_COUNT_A[0] >= 8192 { return -1; }
    
    let idx = CMD_COUNT_A[0];
    CMD_TYPE[idx as usize] = 4; // 4 = EXTERNAL IOSURFACE
    CMD_X[idx as usize] = x;
    CMD_Y[idx as usize] = y;
    CMD_W[idx as usize] = w;
    CMD_H[idx as usize] = h;
    CMD_UV_X[idx as usize] = 0.0;
    CMD_UV_Y[idx as usize] = 0.0;
    CMD_UV_W[idx as usize] = 1.0;
    CMD_UV_H[idx as usize] = 1.0;
    
    // Store surface_id in the color fields (Big Endian packing for compositor.salt)
    CMD_R[idx as usize] = ((surface_id >> 24) & 0xFF) as u8;
    CMD_G[idx as usize] = ((surface_id >> 16) & 0xFF) as u8;
    CMD_B[idx as usize] = ((surface_id >> 8) & 0xFF) as u8;
    CMD_A[idx as usize] = (surface_id & 0xFF) as u8;
    
    CMD_RAD[idx as usize] = 0.0;
    CMD_SHADOW_A[idx as usize] = 0;
    
    CMD_TX[idx as usize] = 0.0;
    CMD_TY[idx as usize] = 0.0;
    CMD_OPACITY[idx as usize] = 1.0;
    
    CMD_COUNT_A[0] = CMD_COUNT_A[0] + 1;
    return 0;
}

// Epic 71: Selection Geometric Solver
pub fn is_node_between_selection(n: u32) -> u8 {
    let anchor = dom.dom_get_selection_anchor_node();
    let focus = dom.dom_get_selection_focus_node();
    if anchor == 0 || focus == 0 { return 0; }
    if n == anchor || n == focus { return 0; }

    let order = dom.compare_document_position(anchor, focus);
    if order == 0 { return 0; }

    let start = if order == -1 { anchor } else { focus };
    let end = if order == -1 { focus } else { anchor };

    // Check if n is after start and before end
    if dom.compare_document_position(start, n) == -1 && dom.compare_document_position(n, end) == -1 {
        return 1;
    }
    return 0;
}

pub fn paint_node(n: u32, focus_node: u64, frame_count: u64, scroll_y: i32, viewport_height: i32) {
    let x = *((P_LAYOUT_X[0] + (n as u64) * 4) as &i32);
    let y = *((P_LAYOUT_Y[0] + (n as u64) * 4) as &i32);
    let w = *((P_LAYOUT_W[0] + (n as u64) * 4) as &i32);
    let h = *((P_LAYOUT_H[0] + (n as u64) * 4) as &i32);
    
    if w <= 0 || h <= 0 { return; }
    let dirty_paint = *((P_DIRTY_PAINT + (n as u64)) as &u8);
    if dirty_paint == 0 { return; }
    
    // Epic 79: Intersection Observer Calculation
    if observers.sys_is_node_observed_for(n, 3 /* Intersection */) {
        let vx1 = 0;
        let vy1 = scroll_y;
        let vx2 = 1920;
        let vy2 = scroll_y + viewport_height;
        
        let ix1 = if x > vx1 { x } else { vx1 };
        let iy1 = if y > vy1 { y } else { vy1 };
        let ix2 = if (x + w) < vx2 { x + w } else { vx2 };
        let iy2 = if (y + h) < vy2 { y + h } else { vy2 };
        
        let mut iw = ix2 - ix1;
        let mut ih = iy2 - iy1;
        if iw < 0 { iw = 0; }
        if ih < 0 { ih = 0; }
        
        let area_i = (iw as f32) * (ih as f32);
        let area_n = (w as f32) * (h as f32);
        let ratio = area_i / area_n;
        
        observers.sys_queue_intersection_record(n, ratio);
    }
    
    let fetch_st = *((P_DOM_NODE_FETCH_STATE + (n as u64)) as &u8);
    if fetch_st == 2 {
        let sy = scroll_y as i32;
        let lower_b = sy - 2048;
        let upper_b = sy + viewport_height + 2048;
        if (y + h) < lower_b || y > upper_b {
            if (*((P_EVICTION_COUNT) as &mut u32)) < 1024 {
                *((P_EVICTION_QUEUE + ((*((P_EVICTION_COUNT) as &mut u32)) as u64) * 4) as &mut u32) = n;
                (*((P_EVICTION_COUNT) as &mut u32)) = (*((P_EVICTION_COUNT) as &mut u32)) + 1;
            }
            return;
        }
    }
    
    let r = *((P_STYLE_BG_R[0] + (n as u64)) as &u8);
    let g = *((P_STYLE_BG_G[0] + (n as u64)) as &u8);
    let b = *((P_STYLE_BG_B[0] + (n as u64)) as &u8);
    
    if *((P_DOM_NODE_TAG + (n as u64) * 4) as &u32) == 25 { // TAG_VIDEO
        sys_gpu_emit_video_frame(n, x, y, w, h);
    } else if *((P_DOM_NODE_TAG + (n as u64) * 4) as &u32) == 26 { // TAG_IFRAME
        let ifr_slot = dom_find_iframe_slot(n);
        if ifr_slot != 0xFFFFFFFF {
            let surface_id = *((P_DOM_IFRAME_SURFACE_ID + (ifr_slot as u64) * 4) as &u32);
            if surface_id != 0 {
                sys_gpu_emit_external_surface(n, surface_id, x, y, w, h);
                return;
            }
        }
        emit_rect(x, y, w, h, n); // Fallback to placeholder rect if no surface
    } else if *((P_DOM_NODE_TAG + (n as u64) * 4) as &u32) == 27 { // TAG_CANVAS
        let surface_id = *((P_CANVAS_SURFACE_IDS + (n as u64) * 4) as &u32);
        if surface_id != 0 {
            sys_gpu_emit_external_surface(n, surface_id, x, y, w, h);
            return;
        }
        emit_rect(x, y, w, h, n); // Fallback to placeholder rect if no surface
    } else if *((P_DOM_NODE_TAG + (n as u64) * 4) as &u32) == 8 { // TAG_IMG
        let tex_id = *((P_DOM_NODE_TEXTURE_ID + (n as u64) * 4) as &u32);
        if tex_id != 0 {
            emit_image(x, y, w, h, tex_id as u8, n);
        } else {
            emit_rect(x, y, w, h, n); // Draw placeholder background if not loaded
        }
    } else if fetch_st == 2 || fetch_st == 3 {
        let tex_id = *((P_DOM_NODE_TEXTURE_ID + (n as u64) * 4) as &u32);
        emit_image(x, y, w, h, tex_id as u8, n);
    } else {
        emit_rect(x, y, w, h, n);
    }
    
    if *((P_DOM_NODE_TAG + (n as u64) * 4) as &u32) == dom.TAG_TEXT || *((P_DOM_NODE_TAG + (n as u64) * 4) as &u32) == 18 || *((P_DOM_NODE_TAG + (n as u64) * 4) as &u32) == 19 {
        let mut clen = *((P_DOM_TEXT_LEN + (n as u64) * 4) as &u32);
        let mut txt_ptr = *((P_DOM_TEXT_PTR + (n as u64) * 8) as &u64);
        let mut is_placeholder = 0;
        
        if clen == 0 && (*((P_DOM_NODE_TAG + (n as u64) * 4) as &u32) == 18 || *((P_DOM_NODE_TAG + (n as u64) * 4) as &u32) == 19) {
            clen = *((P_PLACEHOLDER_LEN + (n as u64) * 4) as &u32);
            txt_ptr = *((P_PLACEHOLDER_PTR + (n as u64) * 8) as &u64);
            is_placeholder = 1;
        }

        if clen > 0 {
            let sel_start = *((P_DOM_SELECTION_START + (n as u64) * 4) as &u32);
            let sel_end =   *((P_DOM_SELECTION_END + (n as u64) * 4) as &u32);
            
            let mut is_focused = 0;
            if focus_node != 0 {
                let resolved_f = dom.resolve_node(focus_node);
                if resolved_f != 0xFFFFFFFF && n == (resolved_f as u32) {
                    is_focused = 1;
                }
            }
            
            // Inherited Color & Font Configuration
            let mut text_parent = *((P_STYLE_PARENT + (n as u64) * 4) as &u32);
            if text_parent == 999999 || text_parent == 0 { text_parent = n; }
            PAINT_CURR_R = *((P_STYLE_COLOR_R + (text_parent as u64)) as &u8);
            PAINT_CURR_G = *((P_STYLE_COLOR_G + (text_parent as u64)) as &u8);
            PAINT_CURR_B = *((P_STYLE_COLOR_B + (text_parent as u64)) as &u8);
            
            if is_placeholder == 1 {
                PAINT_CURR_R = 128;
                PAINT_CURR_G = 128;
                PAINT_CURR_B = 128;
            }
            
            let font_size_f: f32 = *((P_STYLE_FONT_SIZE + (text_parent as u64) * 4) as &f32);
            let font_size_i: i32 = font_size_f as i32;
            let scale_factor: f32 = font_size_f / 64.0;
            let ascent = font.GLYPH_METRICS[0].ascent * scale_factor;
            let descent = font.GLYPH_METRICS[0].descent * scale_factor;
            let line_gap = font.GLYPH_METRICS[0].line_gap * scale_factor;
            let temp_lh: f32 = ascent - descent + line_gap;
            let line_height: i32 = temp_lh as i32;
            let mut x_cursor: f32 = x as f32;
            let mut y_cursor: i32 = y;
            let text_parent_idx = *((P_STYLE_PARENT + (n as u64) * 4) as &u32);
            let max_width = *((P_LAYOUT_W[0] + (text_parent_idx as u64) * 4) as &i32);
            let mut was_space = false;
            let mut prev_char: u32 = 0;
            
            let mut i: u32 = 0;
            
            // Epic 71: Selection Layer Synthesis
            let global_anchor = dom.dom_get_selection_anchor_node();
            let global_focus = dom.dom_get_selection_focus_node();
            let is_between = is_node_between_selection(n);
            
            let mut node_sel_start: u32 = 0xFFFFFFFF;
            let mut node_sel_end: u32 = 0xFFFFFFFF;

            if is_between == 1 {
                node_sel_start = 0;
                node_sel_end = clen;
            } else if n == global_anchor && n == global_focus {
                let s = dom.dom_get_selection_anchor_offset();
                let e = dom.dom_get_selection_focus_offset();
                node_sel_start = if s < e { s } else { e };
                node_sel_end = if s < e { e } else { s };
            } else if n == global_anchor {
                let order = dom.compare_document_position(global_anchor, global_focus);
                if order == -1 { // anchor is before focus
                    node_sel_start = dom.dom_get_selection_anchor_offset();
                    node_sel_end = clen;
                } else { // anchor is after focus
                    node_sel_start = 0;
                    node_sel_end = dom.dom_get_selection_anchor_offset();
                }
            } else if n == global_focus {
                let order = dom.compare_document_position(global_anchor, global_focus);
                if order == -1 { // anchor is before focus
                    node_sel_start = 0;
                    node_sel_end = dom.dom_get_selection_focus_offset();
                } else { // anchor is after focus
                    node_sel_start = dom.dom_get_selection_focus_offset();
                    node_sel_end = clen;
                }
            }

            while i <= clen {
                if is_focused == 1 && i == dom_get_active_cursor() {
                    let mut ms = sys_clock_get_ms();
                    if CURRENT_FRAME_COUNT > 0 {
                        ms = CURRENT_FRAME_COUNT * 16;
                    }
                    if (ms % 1000) < 500 {
                        let final_xc: i32 = x_cursor as i32;
                        emit_solid_rect(final_xc, y_cursor, 2, line_height, 0, 0, 0, 255, n); // Black Caret
                    }
                }
                
                if i == clen { break; }

                let char_val = *((txt_ptr + (i as u64)) as &u8);
                
                let mut is_space = false;
                let mut char_idx: u32 = char_val as u32;
                
                if char_val == 32 || char_val == 9 || char_val == 10 || char_val == 13 {
                    is_space = true;
                    char_idx = 32;
                }
                
                if is_space && was_space {
                    i = i + 1;
                    continue;
                }
                
                was_space = is_space;
                
                if char_idx < 256 {
                    let advance = font.GLYPH_METRICS[char_idx as usize].advance * scale_factor;
                    let mut actual_advance = advance;
                    if prev_char != 0 {
                        let kern_offset = font.get_kerning_offset(prev_char, char_idx) * scale_factor;
                        x_cursor = x_cursor + kern_offset;
                    }
                    
                    if was_space || i == 0 {
                        let mut word_idx = i;
                        let mut word_width: f32 = 0.0;
                        let mut word_prev = prev_char;
                        while word_idx < clen {
                            let b2 = *((txt_ptr + word_idx as u64) as &u8);
                            if b2 == 32 || b2 == 9 || b2 == 10 || b2 == 13 { break; }
                            let c2 = b2 as u32;
                            if c2 < 256 {
                                let adv2 = font.GLYPH_METRICS[c2 as usize].advance * scale_factor;
                                if word_prev != 0 {
                                    let k2 = font.get_kerning_offset(word_prev, c2) * scale_factor;
                                    word_width = word_width + k2;
                                }
                                word_width = word_width + adv2;
                                word_prev = c2;
                            }
                            word_idx = word_idx + 1;
                        }
                        
                        if x_cursor > (x as f32) && (x_cursor + word_width) > ((x + max_width) as f32) {
                            x_cursor = x as f32;
                            y_cursor = y_cursor + line_height;
                            prev_char = 0;
                        }
                    }
                    
                    if (x_cursor + actual_advance) > ((x + max_width) as f32) && is_space {
                        x_cursor = x_cursor;
                    } else if (x_cursor + actual_advance) > ((x + max_width) as f32) && x_cursor == (x as f32) {
                        x_cursor = x_cursor;
                    }
                    
                    // Render macOS Selection Highlight (#B4D5FE)
                    if i >= node_sel_start && i < node_sel_end {
                        let xc_i: i32 = x_cursor as i32;
                        // Use a slightly larger width for spaces to avoid gaps
                        let sel_w_f: f32 = advance + 0.5;
                        emit_solid_rect(xc_i, y_cursor, sel_w_f as i32, line_height, 180, 213, 254, 255, n);
                    }

                    if !is_space {
                        let uv_x = font.GLYPH_METRICS[char_idx as usize].atlas_x;
                        let uv_y = font.GLYPH_METRICS[char_idx as usize].atlas_y;
                        let uv_w = font.GLYPH_METRICS[char_idx as usize].width;
                        let uv_h = font.GLYPH_METRICS[char_idx as usize].height;
                        
                        let bearing_x = font.GLYPH_METRICS[char_idx as usize].bearing_x * scale_factor;
                        let bearing_y = font.GLYPH_METRICS[char_idx as usize].bearing_y * scale_factor;
                        
                        let f_glyph_w = uv_w * 1024.0 * scale_factor;
                        let glyph_w = f_glyph_w as i32;
                        let f_glyph_h = uv_h * 1024.0 * scale_factor;
                        let glyph_h = f_glyph_h as i32;
                        
                        // W3C Baseline Calculation: Y-origin + Ascent
                        let baseline_y: f32 = (y_cursor as f32) + ascent;
                        
                        // Add sub-pixel rounding (+0.5) to maintain crisp edges
                        let temp_y: f32 = baseline_y + bearing_y + 0.5;
                        let gy: i32 = temp_y as i32;
                        
                        let temp_x: f32 = x_cursor + bearing_x + 0.5;
                        let gx: i32 = temp_x as i32;
                        
                        emit_glyph(gx, gy, glyph_w, glyph_h, uv_x, uv_y, uv_w, uv_h, n);
                    }
                    
                    x_cursor = x_cursor + advance;
                    prev_char = char_idx;
                }
                
                i = i + 1;
            }
            
            // Legacy caret blink block removed
        }
    }
    
    // Border Painting
    let bw_t = *((P_STYLE_BORDER_WIDTH_TOP + (n as u64) * 4) as &i32);
    let bw_r = *((P_STYLE_BORDER_WIDTH_RIGHT + (n as u64) * 4) as &i32);
    let bw_b = *((P_STYLE_BORDER_WIDTH_BOTTOM + (n as u64) * 4) as &i32);
    let bw_l = *((P_STYLE_BORDER_WIDTH_LEFT + (n as u64) * 4) as &i32);
    
    if bw_t > 0 || bw_r > 0 || bw_b > 0 || bw_l > 0 {
        let bc_r = *((P_STYLE_BORDER_COLOR_R + (n as u64)) as &u8);
        let bc_g = *((P_STYLE_BORDER_COLOR_G + (n as u64)) as &u8);
        let bc_b = *((P_STYLE_BORDER_COLOR_B + (n as u64)) as &u8);
        
        if bw_t > 0 { emit_solid_rect(x, y, w, bw_t, bc_r, bc_g, bc_b, 255, n); }
        if bw_b > 0 { emit_solid_rect(x, y + h - bw_b, w, bw_b, bc_r, bc_g, bc_b, 255, n); }
        if bw_l > 0 { emit_solid_rect(x, y, bw_l, h, bc_r, bc_g, bc_b, 255, n); }
        if bw_r > 0 { emit_solid_rect(x + w - bw_r, y, bw_r, h, bc_r, bc_g, bc_b, 255, n); }
    }
    
    // Focus Ring
    if n == dom_get_focused_node() {
        let fx = x - 2;
        let fy = y - 2;
        let fw = w + 4;
        let fh = h + 4;
        
        emit_solid_rect(fx, fy, fw, 2, 56, 189, 248, 255, n); // top
        emit_solid_rect(fx, fy + fh - 2, fw, 2, 56, 189, 248, 255, n); // bottom
        emit_solid_rect(fx, fy, 2, fh, 56, 189, 248, 255, n); // left
        emit_solid_rect(fx + fw - 2, fy, 2, fh, 56, 189, 248, 255, n); // right
    }
}

fn intersect_clip(cur_x: i32, cur_y: i32, cur_w: i32, cur_h: i32, new_x: i32, new_y: i32, new_w: i32, new_h: i32, out_x: &i32, out_y: &i32, out_w: &i32, out_h: &i32) {
    let mut cx1 = cur_x;
    let mut cy1 = cur_y;
    let mut cx2 = cur_x + cur_w;
    let mut cy2 = cur_y + cur_h;
    
    let mut nx1 = new_x;
    let mut ny1 = new_y;
    let mut nx2 = new_x + new_w;
    let mut ny2 = new_y + new_h;
    
    let mut ix1 = if cx1 > nx1 { cx1 } else { nx1 };
    let mut iy1 = if cy1 > ny1 { cy1 } else { ny1 };
    let mut ix2 = if cx2 < nx2 { cx2 } else { nx2 };
    let mut iy2 = if cy2 < ny2 { cy2 } else { ny2 };
    
    let mut iw = ix2 - ix1;
    let mut ih = iy2 - iy1;
    if iw < 0 { iw = 0; }
    if ih < 0 { ih = 0; }
    
    *out_x = ix1;
    *out_y = iy1;
    *out_w = iw;
    *out_h = ih;
}

@no_mangle
pub fn paint_layer(node_id: u32, pass_type: i32, focus: u64, scroll: i32, vh: i32) {
    PAINT_VISIT_COUNT_A[0] = PAINT_VISIT_COUNT_A[0] + 1;
    if node_id == 0 || *((P_STYLE_DISPLAY + (node_id as u64)) as &u8) == 0 { return; }
    
    let overflow = *((P_STYLE_OVERFLOW + (node_id as u64)) as &u8);
    let mut pushed_clip = 0;
    
    if overflow == 1 || overflow == 2 || overflow == 3 {
        let node_x = *((P_LAYOUT_X[0] + (node_id as u64) * 4) as &i32);
        let node_y = *((P_LAYOUT_Y[0] + (node_id as u64) * 4) as &i32);
        let node_w = *((P_LAYOUT_W[0] + (node_id as u64) * 4) as &i32);
        let node_h = *((P_LAYOUT_H[0] + (node_id as u64) * 4) as &i32);
        
        // Calculate intersection with current active clip
        let p = CLIP_STACK_PTR as usize;
        let cur_x = CLIP_STACK_X[p];
        let cur_y = CLIP_STACK_Y[p];
        let cur_w = CLIP_STACK_W[p];
        let cur_h = CLIP_STACK_H[p];
        
        let mut new_x = 0;
        let mut new_y = 0;
        let mut new_w = 0;
        let mut new_h = 0;
        intersect_clip(cur_x, cur_y, cur_w, cur_h, node_x, node_y, node_w, node_h, &new_x, &new_y, &new_w, &new_h);
        
        // Push to stack
        if CLIP_STACK_PTR < 63 {
            CLIP_STACK_PTR = CLIP_STACK_PTR + 1;
            let np = CLIP_STACK_PTR as usize;
            CLIP_STACK_X[np] = new_x;
            CLIP_STACK_Y[np] = new_y;
            CLIP_STACK_W[np] = new_w;
            CLIP_STACK_H[np] = new_h;
            
            sys_gpu_set_scissor_rect(new_x, new_y, new_w, new_h);
            pushed_clip = 1;
        }
    }
    
    let z = *((P_STYLE_Z_INDEX + (node_id as u64) * 4) as &i32);
    let pos = *((P_STYLE_POSITION + (node_id as u64)) as &u8);
    
    let mut should_paint_self = 0;
    
    if pass_type == 0 && pos == 0 { should_paint_self = 1; }
    else if pass_type == -1 && z < 0 { should_paint_self = 1; }
    else if pass_type == 1 && pos != 0 && z == 0 { should_paint_self = 1; }
    else if pass_type == 2 && z > 0 { should_paint_self = 1; }
    
    if should_paint_self == 1 {
        paint_node(node_id, focus, 0, scroll, vh);
    }
    
    // Recurse to children natively
    let mut child = dom.dom_get_render_first_child_idx(node_id);
    while child != 0 && child != 999999 {
        paint_layer(child, pass_type, focus, scroll, vh);
        let next_packed = *((P_DOM_NODE_NEXT_SIBLING + (child as u64) * 8) as &u64);
        child = (next_packed & 0xFFFF) as u32;
    }
    
    if pushed_clip == 1 {
        if CLIP_STACK_PTR > 0 {
            CLIP_STACK_PTR = CLIP_STACK_PTR - 1;
            let p = CLIP_STACK_PTR as usize;
            sys_gpu_set_scissor_rect(
                CLIP_STACK_X[p], 
                CLIP_STACK_Y[p], 
                CLIP_STACK_W[p], 
                CLIP_STACK_H[p]
            );
        }
    }
}

pub fn generate_display_list(root_node: u32, focus_node: u64, frame_count: u64, scroll_y: i32, viewport_height: i32) -> i32 {
    // Zero-allocation Multi-pass Stacking Context implementation
    CURRENT_FRAME_COUNT = frame_count;
    
    paint_layer(root_node, 0, focus_node, scroll_y, viewport_height);  // Normal flow
    paint_layer(root_node, -1, focus_node, scroll_y, viewport_height); // Negative Z
    paint_layer(root_node, 1, focus_node, scroll_y, viewport_height);  // Auto Z, Relative/Absolute
    paint_layer(root_node, 2, focus_node, scroll_y, viewport_height);  // Positive Z
    
    return get_cmd_count() as i32;
}
extern fn get_active_focus_node() -> u64;
extern fn drain_scroll_input() -> i32;


pub fn paint_tree() {
    let focus = get_active_focus_node();
    let scroll = drain_scroll_input();
    
    // Epic 109: Dynamically locate the TAG_HTML root (usually Node 1 or 2)
    let mut root_idx: u32 = 1;
    let limit = get_dom_node_count() as u32;
    while root_idx < limit {
        if dom.dom_get_tag(root_idx) == 1 { // TAG_HTML
            break;
        }
        root_idx = root_idx + 1;
    }
    if root_idx >= limit { root_idx = 1; } // Fallback

    // Use current viewport dimensions
    let vw = dom.get_viewport_w();
    let vh = dom.get_viewport_h();
    generate_display_list(root_idx, focus, 0, scroll, vh as i32);
}

extern fn is_chrome_dirty() -> u8;

@no_mangle
pub fn sys_gpu_check_dirty_flag() -> i32 {
    if is_chrome_dirty() == 1 { return 1; }
    
    let limit = get_dom_node_count() as u32;
    let mut i: u32 = 1;
    while i < limit {
        if *((P_COMPOSITOR_DIRTY + (i as u64)) as &u8) == 1 { 
            return 1; 
        }
        i = i + 1;
    }
    return 0;
}

pub fn paint_mark_compositor_dirty(node_idx: u32) {
    if P_COMPOSITOR_DIRTY != 0 {
        *((P_COMPOSITOR_DIRTY + (node_idx as u64)) as &mut u8) = 1;
    }
}

@no_mangle
pub fn ext_mark_all_compositor_dirty() {
    if P_COMPOSITOR_DIRTY == 0 { return; }
    let limit = get_dom_node_count() as u32;
    let mut i: u32 = 1;
    while i < limit {
        *((P_COMPOSITOR_DIRTY + (i as u64)) as &mut u8) = 1;
        *((P_DIRTY_PAINT + (i as u64)) as &mut u8) = 1;
        i = i + 1;
    }
}

extern fn sys_gpu_commit();
extern fn flush_frame(width: i32, height: i32);
extern fn draw_trusted_ui();

extern fn sys_print_float(f: f64);
extern fn sys_log_info(msg_ptr: u64, msg_len: u32);

@no_mangle
pub fn sys_metal_render_frame() {
    begin_frame();
    
    paint_tree();
    draw_trusted_ui();
    
    flush_frame(1920, 1080);
}

