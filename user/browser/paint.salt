    P_STYLE_OPACITY = dom_ptr_STYLE_OPACITY();
    P_COMPOSITOR_DIRTY = dom_ptr_COMPOSITOR_DIRTY();
    P_LAYOUT_X = dom_ptr_LAYOUT_X();
    P_LAYOUT_Y = dom_ptr_LAYOUT_Y();
    P_LAYOUT_W = dom_ptr_LAYOUT_W();
    P_LAYOUT_H = dom_ptr_LAYOUT_H();
    P_DOM_NODE_FETCH_STATE = dom_ptr_DOM_NODE_FETCH_STATE();
    P_DOM_NODE_TEXTURE_ID = dom_ptr_DOM_NODE_TEXTURE_ID();
    P_DOM_IFRAME_SURFACE_ID = dom_ptr_DOM_IFRAME_SURFACE_ID();
