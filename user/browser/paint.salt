    P_STYLE_BORDER_COLOR_B = dom_ptr_STYLE_BORDER_COLOR_B();
    P_STYLE_BORDER_WIDTH_TOP = dom_ptr_STYLE_BORDER_WIDTH_TOP();
    P_STYLE_BORDER_WIDTH_RIGHT = dom_ptr_STYLE_BORDER_WIDTH_RIGHT();
    P_STYLE_BORDER_WIDTH_BOTTOM = dom_ptr_STYLE_BORDER_WIDTH_BOTTOM();
