@no_mangle
pub fn ext_paint_begin_frame() {
    begin_frame();
}

@no_mangle
pub fn ext_paint_tree() {
    paint_tree();
}

@no_mangle
pub fn ext_paint_get_cmd_count() -> u32 {
    return get_cmd_count();
}

// ═══════════════════════════════════════════════════════════════
// Pointer Injection Matrix — Paint Command Array Exports
// Consumer modules (compositor.salt, hit_test.salt) call these ONCE
// at boot to store local pointer globals, avoiding the
// EMIT_INDEX_FALLBACK_RVALUE compiler bug with cross-module array indexing.
// ═══════════════════════════════════════════════════════════════

