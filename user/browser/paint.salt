    P_STYLE_BOX_SHADOW_OFFSET_X = dom_ptr_STYLE_BOX_SHADOW_OFFSET_X();
    P_STYLE_BOX_SHADOW_OFFSET_Y = dom_ptr_STYLE_BOX_SHADOW_OFFSET_Y();
    P_STYLE_BOX_SHADOW_BLUR = dom_ptr_STYLE_BOX_SHADOW_BLUR();
    P_STYLE_BOX_SHADOW_SPREAD = dom_ptr_STYLE_BOX_SHADOW_SPREAD();
