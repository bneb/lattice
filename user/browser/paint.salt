    P_DOM_IFRAME_SURFACE_ID = dom_ptr_DOM_IFRAME_SURFACE_ID();
    P_CANVAS_SURFACE_IDS = dom_ptr_CANVAS_SURFACE_IDS();
    P_DOM_NODE_TAG = dom_ptr_DOM_NODE_TAG();
    P_DOM_TEXT_LEN = dom_ptr_DOM_TEXT_LEN();
