package user.browser.css_lexer

import user.browser.css

// ============================================================================
// Epic 32: The CSSOM Matrix Lexer (The HackerNews Standard)
// ============================================================================
// A zero-allocation CSS tokenizer that parses raw stylesheet text into a
// fixed-size SoA hash table keyed by FNV1a selector hashes.
// Collisions: hybrid linear probing (same-selector overwrites, different probes).
// ============================================================================

// FNV-1a Hash Function (native Salt, no FFI needed)
@no_mangle
pub fn css_fnv1a(ptr: u64, len: u32) -> u32 {
    let mut hash: u32 = 2166136261;
    let mut i: u32 = 0;
    while i < len {
        let byte = *((ptr + i as u64) as &u8);
        hash = hash ^ (byte as u32);
        hash = hash * 16777619;
        i = i + 1;
    }
    return hash;
}

// ============================================================================
// Rule Store — SoA Hash Table (4096 slots, linear probing)
// ============================================================================

pub const MAX_RULES: u32 = 4096;

pub global RULE_HASH:          [u32; 4096] = [0; 4096];
pub global RULE_SPECIFICITY:   [u16; 4096] = [0; 4096];
pub global RULE_SELECTOR_TYPE: [u8; 4096]  = [0; 4096]; // 0=unused, 1=tag, 2=class, 3=id
pub global RULE_SCOPE:         [u32; 4096] = [0; 4096]; // 0 = global, otherwise index of nearest ShadowRoot

// Per-rule style properties (255 / -1 = unset sentinel)
pub global RULE_DISPLAY:       [u8; 4096]  = [255; 4096];
pub global RULE_FLEX_DIR:      [u8; 4096]  = [255; 4096];
pub global RULE_FLEX_GROW:     [i32; 4096] = [-1; 4096];
pub global RULE_WIDTH:         [i32; 4096] = [-1; 4096];
pub global RULE_HEIGHT:        [i32; 4096] = [-1; 4096];
pub global RULE_BG_R:          [u8; 4096]  = [0; 4096];
pub global RULE_BG_G:          [u8; 4096]  = [0; 4096];
pub global RULE_BG_B:          [u8; 4096]  = [0; 4096];
pub global RULE_BG_SET:        [u8; 4096]  = [0; 4096];

// Epic 54: Positional Matrices
pub global RULE_POSITION:      [u8;  4096] = [255; 4096]; // 255 = unset
pub global RULE_TOP:           [i32; 4096] = [-1; 4096];
pub global RULE_RIGHT:         [i32; 4096] = [-1; 4096];
pub global RULE_BOTTOM:        [i32; 4096] = [-1; 4096];
pub global RULE_LEFT:          [i32; 4096] = [-1; 4096];
pub global RULE_Z_INDEX:       [i32; 4096] = [0;  4096]; // 0 is default, wait, -1 isn't great because z-index can be negative. But let's use -2147483648 for unset.
pub global RULE_Z_INDEX_SET:   [u8;  4096] = [0;  4096]; // bool since z-index can be any value

// Box Model
pub global RULE_MARGIN_TOP:    [i32; 4096] = [-1; 4096];
pub global RULE_MARGIN_RIGHT:  [i32; 4096] = [-1; 4096];
pub global RULE_MARGIN_BOTTOM: [i32; 4096] = [-1; 4096];
pub global RULE_MARGIN_LEFT:   [i32; 4096] = [-1; 4096];
pub global RULE_MARGIN_SET:    [u8;  4096] = [0;  4096];

pub global RULE_PAD_TOP:       [i32; 4096] = [-1; 4096];
pub global RULE_PAD_RIGHT:     [i32; 4096] = [-1; 4096];
pub global RULE_PAD_BOTTOM:    [i32; 4096] = [-1; 4096];
pub global RULE_PAD_LEFT:      [i32; 4096] = [-1; 4096];
pub global RULE_PAD_SET:       [u8;  4096] = [0;  4096];

pub global RULE_COUNT: u32 = 0;

// ============================================================================
// Hash Table Operations
// ============================================================================

@no_mangle
pub fn init_css_lexer_arrays() {
    let mut i: u32 = 0;
    while i < 4096 {
        RULE_DISPLAY[i as usize] = 255;
        RULE_FLEX_DIR[i as usize] = 255;
        RULE_FLEX_GROW[i as usize] = -1;
        RULE_WIDTH[i as usize] = -1;
        RULE_HEIGHT[i as usize] = -1;
        RULE_BG_SET[i as usize] = 0;
        
        RULE_POSITION[i as usize] = 255;
        RULE_TOP[i as usize] = -1;
        RULE_RIGHT[i as usize] = -1;
        RULE_BOTTOM[i as usize] = -1;
        RULE_LEFT[i as usize] = -1;
        RULE_Z_INDEX_SET[i as usize] = 0;
        
        i = i + 1;
    }
}

// Find existing slot or insert new one (hybrid linear probing)
extern fn css_arena_set_hash(idx: u32, val: u32);
extern fn css_arena_inc_count();
extern fn css_arena_set_display(idx: u32, val: u8);
extern fn css_arena_set_width(idx: u32, val: i32);
extern fn css_arena_set_height(idx: u32, val: i32);
extern fn css_arena_set_color(idx: u32, val: u32);
extern fn css_arena_set_margin_top(idx: u32, val: i32);
extern fn css_arena_set_padding(idx: u32, pt: i32, pr: i32, pb: i32, pl: i32);

fn find_or_insert_slot(hash: u32, scope_node_id: u32) -> u32 {
    let mut slot = hash % 4096;
    let mut probes: u32 = 0;
    while probes < 4096 {
        let s = slot as usize;
        if RULE_HASH[s] == 0 {
            // Empty slot — claim it
            RULE_HASH[s] = hash;
            RULE_SCOPE[s] = scope_node_id;
            RULE_COUNT = RULE_COUNT + 1;
            css_arena_set_hash(slot, hash);
            css_arena_inc_count();
            return slot;
        }
        if RULE_HASH[s] == hash && RULE_SCOPE[s] == scope_node_id {
            // Same selector — overwrite (CSS last-rule-wins)
            return slot;
        }
        // Different selector collision — linear probe
        slot = (slot + 1) % 4096;
        probes = probes + 1;
    }
    return 0; // Table full
}

// Look up an existing slot by hash (for cascade matching)
@no_mangle
pub fn css_find_slot(hash: u32, scope_id: u32) -> u32 {
    let mut slot = hash % 4096;
    let mut probes: u32 = 0;
    while probes < 4096 {
        let s = slot as usize;
        if RULE_HASH[s] == 0 { return 0xFFFFFFFF; } // Empty = miss
        if RULE_HASH[s] == hash && RULE_SCOPE[s] == scope_id { return slot; }
        slot = (slot + 1) % 4096;
        probes = probes + 1;
    }
    return 0xFFFFFFFF;
}

// ============================================================================
// Getters (for test harness cross-module access)
// ============================================================================

@no_mangle
pub fn css_get_rule_hash(slot: u32) -> u32 {
    if slot >= 4096 { return 0; }
    return RULE_HASH[slot as usize];
}

@no_mangle
pub fn css_get_rule_display(slot: u32) -> u8 {
    if slot >= 4096 { return 255; }
    return RULE_DISPLAY[slot as usize];
}

@no_mangle
pub fn css_get_rule_flex_grow(slot: u32) -> i32 {
    if slot >= 4096 { return -1; }
    return RULE_FLEX_GROW[slot as usize];
}

