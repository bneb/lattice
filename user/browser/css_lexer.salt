}

// ============================================================================
// CSS Tokenizer State Machine
// ============================================================================
// States:
//   0 = IDLE       — scanning for selector start
//   1 = SELECTOR   — accumulating selector bytes
//   2 = BLOCK_WAIT — after selector, waiting for '{'
//   3 = PROP_NAME  — accumulating property name
//   4 = PROP_COLON — saw ':', scanning for value start
//   5 = PROP_VALUE — accumulating property value
//   6 = COMMENT_S  — saw '/', waiting for '*'
//   7 = COMMENT    — inside /* ... */
//   8 = COMMENT_E  — inside comment, saw '*', waiting for '/'

@no_mangle
pub fn css_lex_stylesheet(ptr: u64, len: u32, scope_node_id: u32) {
    let mut i: u32 = 0;
    let mut state: u32 = 0;

    // Selector tracking
    let mut sel_start: u32 = 0;
    let mut sel_len: u32 = 0;

    // Current rule slot
    let mut current_slot: u32 = 0;
    let mut current_specificity: u16 = 0;

    // Property name tracking
    let mut prop_start: u32 = 0;
    let mut prop_len: u32 = 0;

    // Property value tracking
    let mut val_start: u32 = 0;
    let mut val_len: u32 = 0;

    while i < len {
        let b = *((ptr + i as u64) as &u8);

        if state == 0 { // IDLE
            if b == 47 { // '/' — possible comment
                state = 6;
            } else if b != 32 && b != 10 && b != 13 && b != 9 { // non-whitespace
                sel_start = i;
                sel_len = 1;
                state = 1;
            }
        } else if state == 1 { // SELECTOR
            if b == 123 { // '{'
                // Trim trailing whitespace from selector
                while sel_len > 0 {
                    let tail = *((ptr + (sel_start + sel_len - 1) as u64) as &u8);
                    if tail == 32 || tail == 10 || tail == 13 || tail == 9 {
                        sel_len = sel_len - 1;
                    } else {
                        break;
                    }
                }
                // Process selector
                if sel_len > 0 {
                    let first = *((ptr + sel_start as u64) as &u8);
                    if first == 46 { // '.' class selector
                        let hash = css_fnv1a(ptr + (sel_start + 1) as u64, sel_len - 1);
                        current_slot = find_or_insert_slot(hash, scope_node_id);
                        current_specificity = 10;
                        RULE_SELECTOR_TYPE[current_slot as usize] = 2;
                    } else if first == 35 { // '#' id selector
                        let hash = css_fnv1a(ptr + (sel_start + 1) as u64, sel_len - 1);
                        current_slot = find_or_insert_slot(hash, scope_node_id);
                        current_specificity = 100;
                        RULE_SELECTOR_TYPE[current_slot as usize] = 3;
                    } else { // tag selector
                        let hash = css_fnv1a(ptr + sel_start as u64, sel_len);
                        current_slot = find_or_insert_slot(hash, scope_node_id);
                        current_specificity = 1;
                        RULE_SELECTOR_TYPE[current_slot as usize] = 1;
                    }
                    RULE_SPECIFICITY[current_slot as usize] = current_specificity;
                    RULE_SCOPE[current_slot as usize] = scope_node_id;
                }
                state = 3; // Jump to PROP_NAME
                prop_len = 0;
            } else {
                sel_len = sel_len + 1;
            }
        } else if state == 3 { // PROP_NAME
            if b == 125 { // '}' — end of rule block
                state = 0;
            } else if b == 58 { // ':' — transition to value
                // Trim prop name
                while prop_len > 0 {
                    let tail = *((ptr + (prop_start + prop_len - 1) as u64) as &u8);
                    if tail == 32 || tail == 9 { prop_len = prop_len - 1; }
                    else { break; }
                }
                state = 4;
                val_len = 0;
            } else if b != 32 && b != 10 && b != 13 && b != 9 && b != 59 {
                if prop_len == 0 { prop_start = i; }
                prop_len = prop_len + 1;
            } else if b == 59 {
                // Semicolon without colon — skip
                prop_len = 0;
            }
        } else if state == 4 { // PROP_COLON — skip leading whitespace before value
            if b != 32 && b != 9 && b != 10 && b != 13 {
                val_start = i;
                val_len = 1;
                state = 5;
            }
        } else if state == 5 { // PROP_VALUE
            if b == 59 || b == 125 { // ';' or '}'
                // Trim trailing whitespace from value
                while val_len > 0 {
                    let tail = *((ptr + (val_start + val_len - 1) as u64) as &u8);
                    if tail == 32 || tail == 9 || tail == 13 || tail == 10 {
                        val_len = val_len - 1;
                    } else {
                        break;
                    }
                }
                // Apply property:value to RULE_*[current_slot]
                if prop_len > 0 && val_len > 0 {
                    apply_rule_property(current_slot, ptr, prop_start, prop_len, val_start, val_len);
                }
                prop_len = 0;
                val_len = 0;
                if b == 125 { // '}'
                    state = 0;
                } else {
                    state = 3;
                }
            } else {
                val_len = val_len + 1;
            }
        } else if state == 6 { // COMMENT_S — saw '/'
            if b == 42 { // '*'
                state = 7;
            } else {
                state = 0; // Not a comment, go back
            }
        } else if state == 7 { // COMMENT
            if b == 42 { // '*' — possible end
                state = 8;
            }
        } else if state == 8 { // COMMENT_E — saw '*' in comment
            if b == 47 { // '/' — end comment
                state = 0;
            } else if b != 42 {
                state = 7; // Back to comment body
            }
        }

        i = i + 1;
    }
}

// ============================================================================
// Property:Value Parser — Maps property name + value to RULE_* arrays
// ============================================================================

fn apply_rule_property(slot: u32, ptr: u64, prop_start: u32, prop_len: u32, val_start: u32, val_len: u32) {
    let s = slot as usize;
    let pp = ptr + prop_start as u64;
    let vp = ptr + val_start as u64;

    // Match property name by first byte + length
    let p0 = *((pp) as &u8) | 32; // lowercase

    // "display" (7 chars, starts with 'd')
    if p0 == 100 && prop_len == 7 {
        let v0 = *((vp) as &u8) | 32;
        if v0 == 102 && val_len == 4 { // "flex"
            RULE_DISPLAY[s] = 2;
        } else if v0 == 98 && val_len == 5 { // "block"
            RULE_DISPLAY[s] = 1;
        } else if v0 == 110 && val_len == 4 { // "none"
            RULE_DISPLAY[s] = 0;
        } else if v0 == 105 && val_len == 6 { // "inline"
            RULE_DISPLAY[s] = 3;
        }
        return;
    }

    // "flex-grow" (9 chars, starts with 'f')
    if p0 == 102 && prop_len == 9 {
        let p5 = *((pp + 5) as &u8) | 32;
        if p5 == 103 { // 'g' in "flex-grow"
            RULE_FLEX_GROW[s] = parse_int(vp, val_len);
        }
        return;
    }

    // "flex-direction" (14 chars, starts with 'f')
    if p0 == 102 && prop_len == 14 {
        let v0 = *((vp) as &u8) | 32;
        if v0 == 114 { // 'r' = "row"
            RULE_FLEX_DIR[s] = 0;
        } else if v0 == 99 { // 'c' = "column"
            RULE_FLEX_DIR[s] = 1;
        }
        return;
    }

    // "width" (5 chars, starts with 'w')
    if p0 == 119 && prop_len == 5 {
        RULE_WIDTH[s] = parse_int(vp, val_len);
        return;
    }

    // "height" (6 chars, starts with 'h')
    if p0 == 104 && prop_len == 6 {
        RULE_HEIGHT[s] = parse_int(vp, val_len);
        return;
    }
    
    // Epic 54: Positional Geometry parsing
    
    // "position" (8 chars, starts with 'p')
    if p0 == 112 && prop_len == 8 {
        let v0 = *((vp) as &u8) | 32;
        if v0 == 115 && val_len == 6 { // 's' + 6 chars: "static" or "sticky"
            let v4 = *((vp + 4) as &u8) | 32;
            if v4 == 105 { // 'i' -> "static"
                RULE_POSITION[s] = 0;
            } else if v4 == 107 { // 'k' -> "sticky"
                RULE_POSITION[s] = 4;
            }
        } else if v0 == 114 && val_len == 8 { // "relative"
            RULE_POSITION[s] = 1;
        } else if v0 == 97 && val_len == 8 { // "absolute"
            RULE_POSITION[s] = 2;
        } else if v0 == 102 && val_len == 5 { // "fixed"
            RULE_POSITION[s] = 3;
        }
        return;
    }
    
    // "top" (3 chars, starts with 't')
    if p0 == 109 && prop_len == 6 {
        let mut i: u32 = 0;
        let mut space_idx: u32 = 0xFFFFFFFF;
        while i < val_len {
            if *((vp + i as u64) as &u8) == 32 { // space
                space_idx = i;
                break;
            }
            i = i + 1;
        }

        if space_idx != 0xFFFFFFFF {
            let vp1 = vp;
            let val1_len = space_idx;
            let mut j = space_idx + 1;
            while j < val_len {
                if *((vp + j as u64) as &u8) != 32 { break; }
                j = j + 1;
            }
            let vp2 = vp + j as u64;
            let val2_len = val_len - j;

            let mut v1 = parse_int(vp1, val1_len);
            if (*((vp1) as &u8) | 32) == 97 { v1 = -2; } // 'a'uto
            let mut v2 = parse_int(vp2, val2_len);
            if (*((vp2) as &u8) | 32) == 97 { v2 = -2; } // 'a'uto

            RULE_MARGIN_TOP[s] = v1;
            RULE_MARGIN_BOTTOM[s] = v1;
            RULE_MARGIN_RIGHT[s] = v2;
            RULE_MARGIN_LEFT[s] = v2;
        } else {
            let mut v = parse_int(vp, val_len);
            if (*((vp) as &u8) | 32) == 97 { v = -2; } // 'a'uto
            RULE_MARGIN_TOP[s] = v;
            RULE_MARGIN_RIGHT[s] = v;
            RULE_MARGIN_BOTTOM[s] = v;
            RULE_MARGIN_LEFT[s] = v;
        }
        RULE_MARGIN_SET[s] = 1;
        return;
    }
    // "padding" (7 chars, starts with 'p')
    if p0 == 112 && prop_len == 7 {
        let v = parse_int(vp, val_len);
        RULE_PAD_TOP[s] = v;
        RULE_PAD_RIGHT[s] = v;
        RULE_PAD_BOTTOM[s] = v;
        RULE_PAD_LEFT[s] = v;
        RULE_PAD_SET[s] = 1;
        return;
    }
    // "margin-top" (10 chars)
    if p0 == 109 && prop_len == 10 {
        let p7 = *((pp + 7) as &u8) | 32;
        if p7 == 116 { // 't' -> margin-top
            RULE_MARGIN_TOP[s] = parse_int(vp, val_len);
            RULE_MARGIN_SET[s] = 1;
        }
        return;
    }
    if p0 == 116 && prop_len == 3 {
        RULE_MARGIN_TOP[s] = parse_int(vp, val_len); // Wait, "top" is handled differently up there. Oh, this is top as margin? No, "top" was caught before this. Removing this legacy snippet.
        return;
    }
    // "right" (5 chars, starts with 'r')
    if p0 == 114 && prop_len == 5 {
        RULE_RIGHT[s] = parse_int(vp, val_len);
        return;
    }
    // "bottom" (6 chars, starts with 'b' - distinguish from background)
    if p0 == 98 && prop_len == 6 {
        RULE_BOTTOM[s] = parse_int(vp, val_len);
        return;
    }
    // "left" (4 chars, starts with 'l')
    if p0 == 108 && prop_len == 4 {
        RULE_LEFT[s] = parse_int(vp, val_len);
        return;
    }
    // "z-index" (7 chars, starts with 'z')
    if p0 == 122 && prop_len == 7 {
        RULE_Z_INDEX[s] = parse_int(vp, val_len);
        RULE_Z_INDEX_SET[s] = 1;
        return;
    }


    // "background-color" or "background" (starts with 'b')
    if p0 == 98 && prop_len >= 10 {
        // Parse #RRGGBB hex color
        if val_len >= 7 {
            let hash_char = *((vp) as &u8);
            if hash_char == 35 { // '#'
                let r = parse_hex_byte(vp + 1);
                let g = parse_hex_byte(vp + 3);
                let b = parse_hex_byte(vp + 5);
                RULE_BG_R[s] = r;
                RULE_BG_G[s] = g;
                RULE_BG_B[s] = b;
                RULE_BG_SET[s] = 1;
            }
        }
        return;
    }
}

// Parse a simple unsigned integer from bytes (stops at non-digit or 'p' for px)
fn parse_int(ptr: u64, len: u32) -> i32 {
    let mut result: i32 = 0;
    let mut i: u32 = 0;
    let mut neg: i32 = 1;
    if len > 0 {
        let first = *((ptr) as &u8);
        if first == 45 { // '-'
            neg = -1;
            i = 1;
        }
    }
    while i < len {
        let c = *((ptr + i as u64) as &u8);
        if c >= 48 && c <= 57 { // '0'-'9'
            result = result * 10 + (c - 48) as i32;
        } else {
            break; // Stop at 'px', '%', etc.
        }
        i = i + 1;
    }
    return result * neg;
}

// Parse a 2-character hex byte (e.g., "FF" -> 255)
fn parse_hex_byte(ptr: u64) -> u8 {
    let hi = hex_digit(*((ptr) as &u8));
    let lo = hex_digit(*((ptr + 1) as &u8));
    return ((hi << 4) | lo) as u8;
}

fn hex_digit(c: u8) -> u8 {
    if c >= 48 && c <= 57 { return c - 48; }        // '0'-'9'
    if c >= 65 && c <= 70 { return c - 65 + 10; }   // 'A'-'F'
    if c >= 97 && c <= 102 { return c - 97 + 10; }  // 'a'-'f'
    return 0;
}

// ============================================================================
// Cascade Matcher — The 3-Probe Strike
// ============================================================================
// For each DOM node, execute exactly three O(1) probes against RULE_HASH[]:
//   1. fnv1a(TAG_NAME)   — specificity 1
//   2. fnv1a(CLASS_NAME) — specificity 10
//   3. fnv1a(ID_NAME)    — specificity 100
// Properties overwrite only when incoming specificity >= current.
// ============================================================================

extern fn dom_get_node_count() -> u64;
extern fn dom_get_tag(idx: u32) -> u32;
