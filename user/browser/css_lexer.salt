// Tag name to hash mapping (precomputed FNV1a for known tags)
@no_mangle
pub fn tag_to_hash(tag: u32) -> u32 {
    // Compute FNV1a of the lowercase tag name string
    if tag == 4 { // "div"
        return css_fnv1a_literal(100, 105, 118, 0, 0, 0, 3);
    }
    if tag == 5 { // "span"
        return css_fnv1a_literal(115, 112, 97, 110, 0, 0, 4);
    }
    if tag == 6 { // "p"
        return css_fnv1a_literal(112, 0, 0, 0, 0, 0, 1);
    }
    if tag == 7 { // "a"
        return css_fnv1a_literal(97, 0, 0, 0, 0, 0, 1);
    }
    if tag == 9 { // "h1"
        return css_fnv1a_literal(104, 49, 0, 0, 0, 0, 2);
    }
    if tag == 3 { // "body"
        return css_fnv1a_literal(98, 111, 100, 121, 0, 0, 4);
    }
    if tag == 12 { // "table"
        return css_fnv1a_literal(116, 97, 98, 108, 101, 0, 5);
    }
    if tag == 13 { // "tr"
        return css_fnv1a_literal(116, 114, 0, 0, 0, 0, 2);
    }
    if tag == 14 { // "td"
        return css_fnv1a_literal(116, 100, 0, 0, 0, 0, 2);
    }
    if tag == 18 { // "input"
        return css_fnv1a_literal(105, 110, 112, 117, 116, 0, 5);
    }
    if tag == 20 { // "button"
        return css_fnv1a_literal(98, 117, 116, 116, 111, 110, 6);
    }
    if tag == 21 { // "form"
        return css_fnv1a_literal(102, 111, 114, 109, 0, 0, 4);
    }
    return 0;
}

// Inline FNV1a for up to 6 literal bytes
fn css_fnv1a_literal(b0: u8, b1: u8, b2: u8, b3: u8, b4: u8, b5: u8, len: u32) -> u32 {
    let mut hash: u32 = 2166136261;
    let bytes: [u8; 6] = [b0, b1, b2, b3, b4, b5];
    let mut i: u32 = 0;
    while i < len {
        hash = hash ^ (bytes[i as usize] as u32);
        hash = hash * 16777619;
        i = i + 1;
    }
    return hash;
}

@no_mangle
pub fn css_insert_native_rule(tag_hash: u32) -> u32 {
    // Inserts a global rule (scope 999999) for a tag.
    // Specificity is 1 (Probe 1).
    return css_insert_rule(tag_hash, 999999);
}

// Walk the entire DOM tree and apply CSS rules
@no_mangle
pub fn apply_cascade_to_tree() {
    // TIER 0: Inline HTML Attributes (e.g., bgcolor) 
    css.apply_inline_legacy_attributes();
    
    let count = dom_get_node_count();
    let mut i: u32 = 1; // Skip sentinel node 0
    while (i as u64) < count {
        let tag = dom_get_tag(i);
        if tag == 2 {
            dom_set_style_display(i, 0); // HEAD = display:none
        }
        apply_rules_to_node(i);
        i = i + 1;
    }
}

extern fn dom_get_scope_idx(idx: u32) -> u32;

// The 3-Probe Strike for a single node
@no_mangle
pub fn apply_rules_to_node(idx: u32) {
    let tag = dom_get_tag(idx);
    if tag == 0 { return; } // TEXT node — no CSS

    let scope_id = dom_get_scope_idx(idx);

    // Probe 1: Tag selector (specificity 1)
    let tag_hash = tag_to_hash(tag);
    if tag_hash != 0 {
        let slot = css_find_slot(tag_hash, scope_id);
        if slot != 0xFFFFFFFF {
            apply_matching_rule(idx, slot, 1);
        }
    }

    // Probe 2: Class selector (specificity 10)
    let class_ptr = dom_get_class_ptr(idx);
    let class_len = dom_get_class_len(idx);
    if class_len > 0 {
        let mut i: u32 = 0;
        let mut start: u32 = 0;
        while i <= class_len {
            let mut is_delimiter = false;
            if i == class_len {
                is_delimiter = true;
            } else {
                let b = *((class_ptr + i as u64) as &u8);
                if b == 32 { is_delimiter = true; } // space
            }
            if is_delimiter {
                if i > start {
                    let len = i - start;
                    let class_hash = css_fnv1a(class_ptr + start as u64, len);
                    let slot = css_find_slot(class_hash, scope_id);
                    if slot != 0xFFFFFFFF {
                        apply_matching_rule(idx, slot, 10);
                    }
                }
                start = i + 1;
            }
            i = i + 1;
        }
    }

    // Probe 3: ID selector (specificity 100)
    let id_ptr = dom_get_id_ptr(idx);
    let id_len = dom_get_id_len(idx);
    if id_len > 0 {
        let id_hash = css_fnv1a(id_ptr, id_len);
        let slot = css_find_slot(id_hash, scope_id);
        if slot != 0xFFFFFFFF {
            apply_matching_rule(idx, slot, 100);
        }
    }
}

// Apply a matching rule's properties to the node, respecting specificity
fn apply_matching_rule(idx: u32, slot: u32, specificity: u16) {
    let s = slot as usize;

    // display
    if RULE_DISPLAY[s] != 255 {
        if specificity >= dom_get_spec_display(idx) {
            dom_set_style_display(idx, RULE_DISPLAY[s]);
            dom_set_spec_display(idx, specificity);
        }
    }

    // flex-direction
    if RULE_FLEX_DIR[s] != 255 {
        if specificity >= dom_get_spec_flex_dir(idx) {
            dom_set_style_flex_dir(idx, RULE_FLEX_DIR[s]);
            dom_set_spec_flex_dir(idx, specificity);
        }
    }

    // flex-grow
    if RULE_FLEX_GROW[s] != -1 {
        if specificity >= dom_get_spec_flex_grow(idx) {
            dom_set_style_flex_grow(idx, RULE_FLEX_GROW[s]);
            dom_set_spec_flex_grow(idx, specificity);
        }
    }

    // width
    if RULE_WIDTH[s] != -1 {
        if specificity >= dom_get_spec_width(idx) {
            dom_set_style_width(idx, RULE_WIDTH[s]);
            dom_set_spec_width(idx, specificity);
        }
    }

    // height
    if RULE_HEIGHT[s] != -1 {
        if specificity >= dom_get_spec_height(idx) {
            dom_set_style_height(idx, RULE_HEIGHT[s]);
            dom_set_spec_height(idx, specificity);
        }
    }

    // background color
    if RULE_BG_SET[s] == 1 {
        if specificity >= dom_get_spec_bg(idx) {
            dom_set_style_bg(idx, RULE_BG_R[s], RULE_BG_G[s], RULE_BG_B[s]);
            dom_set_spec_bg(idx, specificity);
        }
    }
    
    // Epic 54: Position properties
    if RULE_POSITION[s] != 255 {
        if specificity >= dom_get_spec_position(idx) {
            dom_set_style_position(idx, RULE_POSITION[s]);
            dom_set_spec_position(idx, specificity);
        }
    }
    if RULE_TOP[s] != -1 {
        if specificity >= dom_get_spec_top(idx) {
            dom_set_style_top(idx, RULE_TOP[s]);
            dom_set_spec_top(idx, specificity);
        }
    }
    if RULE_RIGHT[s] != -1 {
        if specificity >= dom_get_spec_right(idx) {
            dom_set_style_right(idx, RULE_RIGHT[s]);
            dom_set_spec_right(idx, specificity);
        }
    }
    if RULE_BOTTOM[s] != -1 {
        if specificity >= dom_get_spec_bottom(idx) {
            dom_set_style_bottom(idx, RULE_BOTTOM[s]);
            dom_set_spec_bottom(idx, specificity);
        }
    }
    if RULE_LEFT[s] != -1 {
        if specificity >= dom_get_spec_left(idx) {
            dom_set_style_left(idx, RULE_LEFT[s]);
            dom_set_spec_left(idx, specificity);
        }
    }
    if RULE_Z_INDEX_SET[s] != 0 {
        if specificity >= dom_get_spec_z_index(idx) {
            dom_set_style_z_index(idx, RULE_Z_INDEX[s]);
            dom_set_spec_z_index(idx, specificity);
        }
    }
    if RULE_MARGIN_SET[s] != 0 {
        if specificity >= dom_get_spec_margin(idx) {
            let mt = RULE_MARGIN_TOP[s];
            let mr = RULE_MARGIN_RIGHT[s];
            let mb = RULE_MARGIN_BOTTOM[s];
            let ml = RULE_MARGIN_LEFT[s];
            let mut cur_t = dom_get_margin_top(idx);
            let mut cur_r = dom_get_margin_right(idx);
            let mut cur_b = dom_get_margin_bottom(idx);
            let mut cur_l = dom_get_margin_left(idx);
            if mt != -1 { cur_t = mt; }
            if mr != -1 { cur_r = mr; }
            if mb != -1 { cur_b = mb; }
            if ml != -1 { cur_l = ml; }
            dom_set_style_margin(idx, cur_t, cur_r, cur_b, cur_l);
            dom_set_spec_margin(idx, specificity);
        }
    }
    if RULE_PAD_SET[s] != 0 {
        if specificity >= dom_get_spec_padding(idx) {
            let pt = RULE_PAD_TOP[s];
            let pr = RULE_PAD_RIGHT[s];
            let pb = RULE_PAD_BOTTOM[s];
            let pl = RULE_PAD_LEFT[s];
            let mut cur_t = dom_get_padding_top(idx);
            let mut cur_r = dom_get_padding_right(idx);
            let mut cur_b = dom_get_padding_bottom(idx);
            let mut cur_l = dom_get_padding_left(idx);
            if pt != -1 { cur_t = pt; }
            if pr != -1 { cur_r = pr; }
            if pb != -1 { cur_b = pb; }
            if pl != -1 { cur_l = pl; }
            dom_set_style_padding(idx, cur_t, cur_r, cur_b, cur_l);
            dom_set_spec_padding(idx, specificity);
        }
    }
    
    // border-width
    if RULE_BORDER_SET[s] != 0 {
        if specificity >= dom_get_spec_border_w(idx) {
            dom_set_style_border_width(idx, RULE_BORDER_W_TOP[s], RULE_BORDER_W_RIGHT[s], RULE_BORDER_W_BOTTOM[s], RULE_BORDER_W_LEFT[s]);
            dom_set_spec_border_w(idx, specificity);
        }
    }
    // box-sizing
    if RULE_BOX_SIZING[s] != 255 {
        if specificity >= dom_get_spec_box_sizing(idx) {
            dom_set_style_box_sizing(idx, RULE_BOX_SIZING[s]);
            dom_set_spec_box_sizing(idx, specificity);
        }
    }
    // min-width
    if RULE_MIN_WIDTH[s] != -1 {
        if specificity >= dom_get_spec_min_width(idx) {
            dom_set_style_min_width(idx, RULE_MIN_WIDTH[s]);
            dom_set_spec_min_width(idx, specificity);
        }
    }
    // max-width
    if RULE_MAX_WIDTH[s] != -1 {
        if specificity >= dom_get_spec_max_width(idx) {
            dom_set_style_max_width(idx, RULE_MAX_WIDTH[s]);
            dom_set_spec_max_width(idx, specificity);
        }
    }
    // visibility
    if RULE_VISIBILITY[s] != 255 {
        if specificity >= dom_get_spec_visibility(idx) {
            dom_set_style_visibility(idx, RULE_VISIBILITY[s]);
            dom_set_spec_visibility(idx, specificity);
        }
    }
    // line-height
    if RULE_LINE_HEIGHT[s] != -1.0 {
        if specificity >= dom_get_spec_line_height(idx) {
            dom_set_style_line_height(idx, RULE_LINE_HEIGHT[s]);
            dom_set_spec_line_height(idx, specificity);
        }
    }
    // white-space
    if RULE_WHITE_SPACE[s] != 255 {
        if specificity >= dom_get_spec_white_space(idx) {
            dom_set_style_white_space(idx, RULE_WHITE_SPACE[s]);
            dom_set_spec_white_space(idx, specificity);
        }
    }
    // flex-wrap
    if RULE_FLEX_WRAP[s] != 255 {
        if specificity >= dom_get_spec_flex_wrap(idx) {
            dom_set_style_flex_wrap(idx, RULE_FLEX_WRAP[s]);
            dom_set_spec_flex_wrap(idx, specificity);
        }
    }
    // text-align
    if RULE_TEXT_ALIGN[s] != 255 {
        if specificity >= dom_get_spec_text_align(idx) {
            dom_set_style_text_align(idx, RULE_TEXT_ALIGN[s]);
            dom_set_spec_text_align(idx, specificity);
        }
    }
    // vertical-align
    if RULE_VERTICAL_ALIGN[s] != 255 {
        if specificity >= dom_get_spec_v_align(idx) {
            dom_set_style_vertical_align(idx, RULE_VERTICAL_ALIGN[s]);
            dom_set_spec_v_align(idx, specificity);
        }
    }
    // font-size
    if RULE_FONT_SIZE[s] != 0.0 {
        if specificity >= dom_get_spec_font_size(idx) {
            dom_set_style_font_size(idx, RULE_FONT_SIZE[s]);
            dom_set_spec_font_size(idx, specificity);
        }
    }
    // font-weight
    if RULE_FONT_WEIGHT[s] != 255 {
        if specificity >= dom_get_spec_font_weight(idx) {
            dom_set_style_font_weight(idx, RULE_FONT_WEIGHT[s]);
            dom_set_spec_font_weight(idx, specificity);
        }
    }
}

pub const CSS_PROP_UNKNOWN: u32 = 0xFFFFFFFF;

extern fn dom_set_style_color(idx: u32, r: u8, g: u8, b: u8);
extern fn dom_set_spec_color(idx: u32, val: u16);
extern fn parse_hex_to_rgb(ptr: u64, r: *mut u8, g: *mut u8, b: *mut u8);

extern fn dom_set_style_width(idx: u32, val: i32);
extern fn dom_set_spec_width(idx: u32, val: u16);
extern fn dom_set_style_height(idx: u32, val: i32);
extern fn dom_set_spec_height(idx: u32, val: u16);

fn apply_inline_property(node_idx: u32, ptr: u64, prop_start: u32, prop_len: u32, val_start: u32, val_len: u32) -> u32 {
    let pp = ptr + prop_start as u64;
    let vp = ptr + val_start as u64;
    let p0 = *((pp) as &u8) | 32;

    // "display"
    if p0 == 100 && prop_len == 7 {
        let v0 = *((vp) as &u8) | 32;
        if v0 == 102 && val_len == 4 { dom_set_style_display(node_idx, 2); } // flex
        else if v0 == 98 && val_len == 5 { dom_set_style_display(node_idx, 1); } // block
        else if v0 == 110 && val_len == 4 { dom_set_style_display(node_idx, 0); } // none
        else if v0 == 105 && val_len == 6 { dom_set_style_display(node_idx, 3); } // inline
        else if v0 == 105 && val_len == 12 { dom_set_style_display(node_idx, 5); } // inline-block
        dom_set_spec_display(node_idx, 1000);
        return 1;
    }

    // "margin" / "margin-top" etc
    if p0 == 109 && prop_len >= 6 {
        if prop_len == 6 { // "margin"
             let v = parse_int(vp, val_len);
             dom_set_style_margin(node_idx, v, v, v, v);
             dom_set_spec_margin(node_idx, 1000);
             return 1;
        } else if prop_len >= 10 {
            let p7 = *((pp + 7) as &u8) | 32;
            let v = parse_int(vp, val_len);
            let mut mt = dom_get_margin_top(node_idx);
            let mut mr = dom_get_margin_right(node_idx);
            let mut mb = dom_get_margin_bottom(node_idx);
            let mut ml = dom_get_margin_left(node_idx);
            if p7 == 116 { mt = v; } // top
            else if p7 == 98 { mb = v; } // bottom
            else if p7 == 108 { ml = v; } // left
            else if p7 == 114 { mr = v; } // right
            dom_set_style_margin(node_idx, mt, mr, mb, ml);
            dom_set_spec_margin(node_idx, 1000);
            return 1;
        }
    }

    // "padding"
    if p0 == 112 && prop_len == 7 {
        let v = parse_int(vp, val_len);
        dom_set_style_padding(node_idx, v, v, v, v);
        dom_set_spec_padding(node_idx, 1000);
        return 1;
    }

    // "border" / "border-width"
    if p0 == 98 && prop_len >= 6 {
        if prop_len == 6 || prop_len == 12 { // "border" or "border-width"
            let v = parse_int(vp, val_len);
            dom_set_style_border_width(node_idx, v, v, v, v);
            dom_set_spec_border_w(node_idx, 1000);
            return 1;
        }
    }

    // "width"
    if p0 == 119 && prop_len == 5 {
        dom_set_style_width(node_idx, parse_int(vp, val_len));
        dom_set_spec_width(node_idx, 1000);
        return 1;
    }
    
    // "height"
    if p0 == 104 && prop_len == 6 {
        dom_set_style_height(node_idx, parse_int(vp, val_len));
        dom_set_spec_height(node_idx, 1000);
        return 1;
    }

    // "color"
    if p0 == 99 && prop_len == 5 {
        let mut hex_start = vp;
        if *((vp) as &u8) == 35 { hex_start = vp + 1; }
        let mut r: u8 = 0; let mut g: u8 = 0; let mut b_c: u8 = 0;
        parse_hex_to_rgb(hex_start, (&mut r) as *mut u8, (&mut g) as *mut u8, (&mut b_c) as *mut u8);
        dom_set_style_color(node_idx, r, g, b_c);
        dom_set_spec_color(node_idx, 1000);
        return 1;
    }

    // "background-color"
    if p0 == 98 && prop_len >= 10 {
        let mut hex_start = vp;
        if *((vp) as &u8) == 35 { hex_start = vp + 1; }
        let mut r: u8 = 0; let mut g: u8 = 0; let mut b_c: u8 = 0;
        parse_hex_to_rgb(hex_start, (&mut r) as *mut u8, (&mut g) as *mut u8, (&mut b_c) as *mut u8);
        dom_set_style_bg(node_idx, r, g, b_c);
        dom_set_spec_bg(node_idx, 1000);
        return 1;
    }

    // "text-align"
    if p0 == 116 && prop_len == 10 {
        let v0 = *((vp) as &u8) | 32;
        if v0 == 108 { dom_set_style_text_align(node_idx, 0); } // left
        else if v0 == 114 { dom_set_style_text_align(node_idx, 1); } // right
        else if v0 == 99 { dom_set_style_text_align(node_idx, 2); } // center
        dom_set_spec_text_align(node_idx, 1000);
        return 1;
    }

    // "font-size"
    if p0 == 102 && prop_len == 9 {
        dom_set_style_font_size(node_idx, parse_float(vp, val_len));
        dom_set_spec_font_size(node_idx, 1000);
        return 1;
    }

    // "font-weight"
    if p0 == 102 && prop_len == 11 {
        let v0 = *((vp) as &u8) | 32;
        if v0 == 98 { dom_set_style_font_weight(node_idx, 1); } // bold
        else { dom_set_style_font_weight(node_idx, 0); } // normal
        dom_set_spec_font_weight(node_idx, 1000);
        return 1;
    }

    return CSS_PROP_UNKNOWN;
}

@no_mangle
pub fn css_lex_inline_style(node_idx: u32, ptr: u64, len: u32) {
    let mut cursor: u32 = 0;
    while cursor < len {
        while cursor < len {
            let b = *((ptr + cursor as u64) as &u8);
            if b != 32 && b != 9 && b != 10 && b != 13 { break; }
            cursor = cursor + 1;
        }
        if cursor >= len { break; }

        let prop_start = cursor;
        let mut prop_len: u32 = 0;
        while cursor < len {
            let b = *((ptr + cursor as u64) as &u8);
            if b == 58 || b == 59 || b == 125 { break; }
            prop_len = prop_len + 1;
            cursor = cursor + 1;
        }

        while prop_len > 0 {
            let tail = *((ptr + (prop_start + prop_len - 1) as u64) as &u8);
            if tail == 32 || tail == 9 { prop_len = prop_len - 1; } else { break; }
        }

        if cursor >= len { break; }
        let sep = *((ptr + cursor as u64) as &u8);
        if sep == 59 || sep == 125 {
            cursor = cursor + 1;
            continue;
        }

        cursor = cursor + 1; // skip ':'

        while cursor < len {
            let b = *((ptr + cursor as u64) as &u8);
            if b != 32 && b != 9 && b != 10 && b != 13 { break; }
            cursor = cursor + 1;
        }

        let val_start = cursor;
        let mut val_len: u32 = 0;
        while cursor < len {
            let b = *((ptr + cursor as u64) as &u8);
            if b == 59 || b == 125 { break; }
            val_len = val_len + 1;
            cursor = cursor + 1;
        }

        while val_len > 0 {
            let tail = *((ptr + (val_start + val_len - 1) as u64) as &u8);
            if tail == 32 || tail == 9 || tail == 13 || tail == 10 { val_len = val_len - 1; } else { break; }
        }

        if prop_len > 0 && val_len > 0 {
            let property_id = apply_inline_property(node_idx, ptr, prop_start, prop_len, val_start, val_len);
            if property_id == CSS_PROP_UNKNOWN {
                while cursor < len {
                    let c = *((ptr + cursor as u64) as &u8);
                    if c == 59 || c == 125 { break; }
                    cursor = cursor + 1;
                }
            }
        }

        if cursor < len {
            let b = *((ptr + cursor as u64) as &u8);
            if b == 59 || b == 125 { cursor = cursor + 1; }
        }
    }
}

@no_mangle
pub fn css_set_rule_display(slot: u32, val: u8) {
    if slot < 4096 { RULE_DISPLAY[slot as usize] = val; }
}

@no_mangle
pub fn css_set_rule_padding(slot: u32, t: i32, r: i32, b: i32, l: i32) {
    if slot < 4096 {
        RULE_PAD_TOP[slot as usize] = t;
        RULE_PAD_RIGHT[slot as usize] = r;
        RULE_PAD_BOTTOM[slot as usize] = b;
        RULE_PAD_LEFT[slot as usize] = l;
        RULE_PAD_SET[slot as usize] = 1;
    }
}

@no_mangle
pub fn css_set_rule_margin(slot: u32, t: i32, r: i32, b: i32, l: i32) {
    if slot < 4096 {
        RULE_MARGIN_TOP[slot as usize] = t;
        RULE_MARGIN_RIGHT[slot as usize] = r;
        RULE_MARGIN_BOTTOM[slot as usize] = b;
        RULE_MARGIN_LEFT[slot as usize] = l;
        RULE_MARGIN_SET[slot as usize] = 1;
    }
}

@no_mangle
pub fn css_set_rule_font(slot: u32, size: f32, weight: u8) {
    if slot < 4096 {
        if size > 0.0 { RULE_FONT_SIZE[slot as usize] = size; }
        if weight != 255 { RULE_FONT_WEIGHT[slot as usize] = weight; }
    }
}

@no_mangle
pub fn css_set_rule_width(slot: u32, val: i32) {
    if slot < 4096 { RULE_WIDTH[slot as usize] = val; }
}

@no_mangle
pub fn css_set_rule_border_width(slot: u32, val: i32) {
    if slot < 4096 {
        RULE_BORDER_W_TOP[slot as usize] = val;
        RULE_BORDER_W_RIGHT[slot as usize] = val;
        RULE_BORDER_W_BOTTOM[slot as usize] = val;
        RULE_BORDER_W_LEFT[slot as usize] = val;
        RULE_BORDER_SET[slot as usize] = 1;
    }
}
