pub global FRAME_COUNT: u64 = 0;
pub global MAX_TEST_FRAMES: u64 = 1800; // 30 seconds at 60fps for testing
pub global DOM_CONTENT_LOADED_FIRED: u8 = 0; // Epic 61: Tracks if DOMContentLoaded has fired

@no_mangle
pub fn set_max_test_frames(frames: u64) {
    MAX_TEST_FRAMES = frames;
}

// Epic 68 Multi-Process IPC replaces these global arrays
extern fn ext_history_push(url_ptr: u64, url_len: u32, state_ptr: u64, state_len: u32);
