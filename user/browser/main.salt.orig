@no_mangle
pub fn sys_ipc_send_post_message(target_node: u32, payload_ptr: u64, payload_len: u32) {
    // CMD_POST_MESSAGE is 4 in renderer->main IPC protocol (Epic 69)
    sys_ipc_send_r2m_command_with_payload(4, target_node as u64, payload_ptr, payload_len);
}

