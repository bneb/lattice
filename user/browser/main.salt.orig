@no_mangle
pub fn sys_browser_navigate(url_ptr: u64, url_len: u32) {
    js_engine_teardown();
    init_arrays();
    airlock_init_allocator();
    sys_jsc_init();
    
    let new_root = create_node(0); // TAG_ROOT
    let mut nav_bit: u64 = 1;
    nav_bit = nav_bit << 62;
    let multiplexed_id = nav_bit | new_root;
    
    push_get_request(multiplexed_id, url_ptr, url_len);
    
    user.browser.chrome.OMNIBOX_LEN = 0; 
    
    // Hard navigate implies we push state internally (or maybe the fresh page boot does)
    ext_history_push(url_ptr, url_len, 0, 0);
}

pub const FRAME_DEADLINE_NANOS: i64 = 16666666; 

global NETWORK_INGEST_BUFFER: [u8; 1048576] = [0; 1048576];
global NETWORK_INGEST_STATE: u32 = 0; 
global NETWORK_INGEST_CURSOR: u32 = 0;
@no_mangle
pub fn inject_test_key(key_val: u8) {
    if key_val == 10 || key_val == 13 { // Enter
        js_engine_teardown();
        init_arrays();
        airlock_init_allocator();
        sys_jsc_init();
        let new_root = create_node(0); // TAG_ROOT
        
        // Push Navigation Array (Flag bit 62)
        let mut nav_bit: u64 = 1;
        nav_bit = nav_bit << 62;
        let multiplexed_id = nav_bit | new_root;
        
        push_get_request(multiplexed_id, (&chrome.OMNIBOX_URL[0]) as u64, chrome.OMNIBOX_LEN);
        chrome.OMNIBOX_LEN = 0; 
    } else {
        if chrome.OMNIBOX_LEN < 1024 {
            chrome.OMNIBOX_URL[chrome.OMNIBOX_LEN as usize] = key_val;
            chrome.OMNIBOX_LEN = chrome.OMNIBOX_LEN + 1;
        }
    }
}

global NETWORK_INGEST_NODE_ID: u64 = 0;
global NETWORK_INGEST_EXPECTED_LEN: u32 = 0;

extern fn js_dequeue_script_ptr() -> u64;
extern fn js_dequeue_script_len() -> u32;

@no_mangle
pub fn sys_js_pump_script_queue() {
    while true {
        let s_ptr = js_dequeue_script_ptr();
        if s_ptr == 0 { break; }
        let s_len = js_dequeue_script_len();
        sys_jsc_evaluate_script(s_ptr, s_len, 0);
    }
}

global WS_TEMP_DECODE: [u8; 8192] = [0; 8192];

pub fn pump_websocket_frames() {
    let mut socket_id: u32 = 0;
    while socket_id < 16 {
        if net.WS_STATE[socket_id as usize] == 2 { // OPEN
            let head = net.WS_HEAD[socket_id as usize];
            let tail = net.WS_TAIL[socket_id as usize];
            let available = tail - head;
            
            // Basic RFC 6455 parsing (requires at least 2 bytes for header)
            if available >= 2 {
                let offset = socket_id * 65536;
                let b0 = net.WS_RING_BUFFER[(offset + (head % 65536)) as usize];
                let b1 = net.WS_RING_BUFFER[(offset + ((head + 1) % 65536)) as usize];
                
                let mut payload_len = (b1 & 0x7F) as u32;
                let is_masked = (b1 & 0x80) != 0;
                
                let mut header_len: u32 = 2;
                
                if payload_len == 126 {
                    if available >= 4 {
                        let hb = net.WS_RING_BUFFER[(offset + ((head + 2) % 65536)) as usize] as u32;
                        let lb = net.WS_RING_BUFFER[(offset + ((head + 3) % 65536)) as usize] as u32;
                        payload_len = (hb << 8) | lb;
                        header_len = 4;
                    }
                } else if payload_len == 127 {
                    if available >= 10 {
                        // Just taking the bottom 32 bits since we don't handle >4GB packets
                        let b6 = net.WS_RING_BUFFER[(offset + ((head + 6) % 65536)) as usize] as u32;
                        let b7 = net.WS_RING_BUFFER[(offset + ((head + 7) % 65536)) as usize] as u32;
                        let b8 = net.WS_RING_BUFFER[(offset + ((head + 8) % 65536)) as usize] as u32;
                        let b9 = net.WS_RING_BUFFER[(offset + ((head + 9) % 65536)) as usize] as u32;
                        payload_len = (b6 << 24) | (b7 << 16) | (b8 << 8) | b9;
                        header_len = 10;
                    }
                }
                
                let mut mask_key: [u8; 4] = [0; 4];
                if is_masked {
                    if available >= header_len + 4 {
                        mask_key[0] = net.WS_RING_BUFFER[(offset + ((head + header_len) % 65536)) as usize];
                        mask_key[1] = net.WS_RING_BUFFER[(offset + ((head + header_len + 1) % 65536)) as usize];
                        mask_key[2] = net.WS_RING_BUFFER[(offset + ((head + header_len + 2) % 65536)) as usize];
                        mask_key[3] = net.WS_RING_BUFFER[(offset + ((head + header_len + 3) % 65536)) as usize];
                        header_len = header_len + 4;
                    } else {
                        header_len = 999999; 
                    }
                }
                
                let frame_total_length = header_len + payload_len;
                
                if header_len != 999999 && available >= frame_total_length {
                    // Extract payload to a temporary linear buffer
                    let mut i: u32 = 0;
                    while i < payload_len {
                        let mut p_byte = net.WS_RING_BUFFER[(offset + ((head + header_len + i) % 65536)) as usize];
                        if is_masked {
                            let m_byte = mask_key[(i % 4) as usize];
                            p_byte = p_byte ^ m_byte;
                        }
                        if i < 8192 {
                            WS_TEMP_DECODE[i as usize] = p_byte;
                        }
                        i = i + 1;
                    }
                    
                    net.WS_HEAD[socket_id as usize] = head + frame_total_length;
                    
                    let mut payload_cap = payload_len;
                    if payload_cap > 8192 { payload_cap = 8192; }
                    
                    js_bridge_dispatch_websocket_message(socket_id, (&WS_TEMP_DECODE) as u64, payload_cap);
                    
                    sys_jsc_flush_microtasks();
                }
            }
        }
        socket_id = socket_id + 1;
    }
}

