package user.browser.html_serializer

// ============================================================================
// innerHTML Serializer — Topological SoA Walker
// ============================================================================
// Reconstructs an HTML string from the flat SoA DOM arrays by performing a
// depth-first traversal of DOM_NODE_FIRST_CHILD / DOM_NODE_NEXT_SIBLING.
//
// CRITICAL: We do NOT import user.browser.dom. Salt's import system creates
// duplicate `internal` copies of globals, which silently diverge from the
// canonical globals that create_node/append_child write to. Instead, we use
// @no_mangle getter functions exposed by dom.salt as our FFI surface.
// ============================================================================

// --- Airlock FFI ---
extern fn airlock_allocate(size: u32) -> u32;
extern fn airlock_get_ptr() -> u64;

// --- DOM SoA Getter FFI (dom.salt @no_mangle functions) ---
extern fn dom_get_tag(idx: u32) -> u32;
extern fn dom_get_generation(idx: u32) -> u32;
extern fn dom_get_first_child(idx: u32) -> u64;
extern fn dom_get_next_sibling(idx: u32) -> u64;
extern fn dom_get_text_ptr(idx: u32) -> u64;
extern fn dom_get_text_len(idx: u32) -> u32;
extern fn dom_get_id_ptr(idx: u32) -> u64;
extern fn dom_get_id_len(idx: u32) -> u32;
extern fn dom_get_class_ptr(idx: u32) -> u64;
extern fn dom_get_class_len(idx: u32) -> u32;
extern fn dom_get_custom_tag_ptr(idx: u32) -> u64;
extern fn dom_get_custom_tag_len(idx: u32) -> u32;

// --- Tag Constants (mirrored from dom.salt) ---
pub const TAG_TEXT: u32 = 0;
pub const TAG_DIV:  u32 = 4;
pub const TAG_SPAN: u32 = 5;
pub const TAG_P:    u32 = 6;
pub const TAG_A:    u32 = 7;
pub const TAG_IMG:  u32 = 8;
pub const TAG_H1:   u32 = 9;
pub const TAG_HTML: u32 = 1;
pub const TAG_HEAD: u32 = 2;
pub const TAG_BODY: u32 = 3;
pub const TAG_CUSTOM_ELEMENT: u32 = 96;
pub const TAG_SCRIPT: u32 = 99;

// ============================================================================
// Entry Point
// ============================================================================

@no_mangle
pub fn js_serialize_children(node_id: u64) -> u64 {
    let max_len: u32 = 131072;
    let offset = airlock_allocate(max_len);
    if offset == 0xFFFFFFFF { return 0; }

    // Resolve the airlock base pointer ONCE in this @no_mangle entry point,
    // then thread it through all private helpers.
    let base_ptr = airlock_get_ptr();

    let mut cursor: u32 = 0;

    let u_idx = (node_id & 0xFFFF) as u32;
    let expected_gen = ((node_id >> 16) & 0xFFFFFFFF) as u32;
    let actual_gen = dom_get_generation(u_idx);
    if u_idx < 65536 && actual_gen == expected_gen {
        let mut child = dom_get_first_child(u_idx);
        while child != 0 {
            cursor = serialize_recursive(child, base_ptr, offset, cursor, max_len);
            let c_idx = (child & 0xFFFF) as u32;
            let c_expected = ((child >> 16) & 0xFFFFFFFF) as u32;
            let c_actual = dom_get_generation(c_idx);
            if c_idx < 65536 && c_actual == c_expected {
                child = dom_get_next_sibling(c_idx);
            } else {
                child = 0;
            }
        }
    }
    return ((cursor as u64) << 32) | (offset as u64);
}

// ============================================================================
// Primitive Writers
// ============================================================================

fn append_char(base_ptr: u64, offset: u32, cursor: u32, max_len: u32, byte: u8) -> u32 {
    if cursor >= max_len { return cursor; }
    *((base_ptr + (offset as u64) + (cursor as u64)) as *mut u8) = byte;
    return cursor + 1;
}

fn append_bytes(base_ptr: u64, src_ptr: u64, src_len: u32, offset: u32, mut cursor: u32, max_len: u32) -> u32 {
    let mut i: u32 = 0;
    while i < src_len {
        if cursor >= max_len { return cursor; }
        let byte = *((src_ptr + (i as u64)) as &u8);
        *((base_ptr + (offset as u64) + (cursor as u64)) as *mut u8) = byte;
        cursor = cursor + 1;
        i = i + 1;
    }
    return cursor;
}

// ============================================================================
// Tag Name Lookup
// ============================================================================

fn append_tag_name(base_ptr: u64, tag: u32, offset: u32, cursor: u32, max_len: u32, idx: u32) -> u32 {
    let mut s_div: [u8; 3] = [100, 105, 118];
    let mut s_span: [u8; 4] = [115, 112, 97, 110];
    let mut s_p: [u8; 1] = [112];
    let mut s_a: [u8; 1] = [97];
    let mut s_img: [u8; 3] = [105, 109, 103];
    let mut s_h1: [u8; 2] = [104, 49];
    let mut s_script: [u8; 6] = [115, 99, 114, 105, 112, 116];
    let mut s_html: [u8; 4] = [104, 116, 109, 108];
    let mut s_head: [u8; 4] = [104, 101, 97, 100];
    let mut s_body: [u8; 4] = [98, 111, 100, 121];

    if tag == TAG_DIV { return append_bytes(base_ptr, (&s_div) as u64, 3, offset, cursor, max_len); }
    if tag == TAG_SPAN { return append_bytes(base_ptr, (&s_span) as u64, 4, offset, cursor, max_len); }
    if tag == TAG_P { return append_bytes(base_ptr, (&s_p) as u64, 1, offset, cursor, max_len); }
    if tag == TAG_A { return append_bytes(base_ptr, (&s_a) as u64, 1, offset, cursor, max_len); }
    if tag == TAG_IMG { return append_bytes(base_ptr, (&s_img) as u64, 3, offset, cursor, max_len); }
    if tag == TAG_H1 { return append_bytes(base_ptr, (&s_h1) as u64, 2, offset, cursor, max_len); }
    if tag == TAG_HTML { return append_bytes(base_ptr, (&s_html) as u64, 4, offset, cursor, max_len); }
    if tag == TAG_HEAD { return append_bytes(base_ptr, (&s_head) as u64, 4, offset, cursor, max_len); }
    if tag == TAG_BODY { return append_bytes(base_ptr, (&s_body) as u64, 4, offset, cursor, max_len); }
    if tag == TAG_SCRIPT { return append_bytes(base_ptr, (&s_script) as u64, 6, offset, cursor, max_len); }
    
    if tag == TAG_CUSTOM_ELEMENT {
        let tag_ptr = dom_get_custom_tag_ptr(idx as u32);
        let tag_len = dom_get_custom_tag_len(idx as u32);
        if tag_ptr != 0 && tag_len > 0 {
            return append_bytes(base_ptr, tag_ptr, tag_len, offset, cursor, max_len);
        }
    }
    
    return append_bytes(base_ptr, (&s_div) as u64, 3, offset, cursor, max_len);
}

// ============================================================================
// Recursive Depth-First Serializer
// ============================================================================

fn serialize_recursive(node_id: u64, base_ptr: u64, offset: u32, mut cursor: u32, max_len: u32) -> u32 {
    let u_idx = (node_id & 0xFFFF) as u32;
    let expected_gen = ((node_id >> 16) & 0xFFFFFFFF) as u32;
    let actual_gen = dom_get_generation(u_idx);
    if u_idx >= 65536 || actual_gen != expected_gen { return cursor; }

    let tag_id = dom_get_tag(u_idx);

    // === Text Nodes: emit raw text content, no tags ===
    if tag_id == TAG_TEXT {
        let txt_ptr = dom_get_text_ptr(u_idx);
        let txt_len = dom_get_text_len(u_idx);
        cursor = append_bytes(base_ptr, txt_ptr, txt_len, offset, cursor, max_len);
        return cursor;
    }

    // === Element Nodes: <tag [attrs]>children</tag> ===

    // Opening: '<'
    cursor = append_char(base_ptr, offset, cursor, max_len, 60);
    // Modified signature passing u_idx
    cursor = append_tag_name(base_ptr, tag_id, offset, cursor, max_len, u_idx);

    // Attribute: id="..."
    let id_ptr = dom_get_id_ptr(u_idx);
    let id_len = dom_get_id_len(u_idx);
    if id_len > 0 {
        // ' id="'
        let mut s_id: [u8; 5] = [32, 105, 100, 61, 34];
        cursor = append_bytes(base_ptr, (&s_id) as u64, 5, offset, cursor, max_len);
        cursor = append_bytes(base_ptr, id_ptr, id_len, offset, cursor, max_len);
        // '"'
        cursor = append_char(base_ptr, offset, cursor, max_len, 34);
    }

    // Attribute: class="..."
    let class_ptr = dom_get_class_ptr(u_idx);
    let class_len = dom_get_class_len(u_idx);
    if class_len > 0 {
        // ' class="'
        let mut s_cls: [u8; 8] = [32, 99, 108, 97, 115, 115, 61, 34];
        cursor = append_bytes(base_ptr, (&s_cls) as u64, 8, offset, cursor, max_len);
        cursor = append_bytes(base_ptr, class_ptr, class_len, offset, cursor, max_len);
        // '"'
        cursor = append_char(base_ptr, offset, cursor, max_len, 34);
    }

    // Close opening tag: '>'
    cursor = append_char(base_ptr, offset, cursor, max_len, 62);

    // === Recurse into children ===
    let mut child = dom_get_first_child(u_idx);
    while child != 0 {
        cursor = serialize_recursive(child, base_ptr, offset, cursor, max_len);
        let c_idx = (child & 0xFFFF) as u32;
        let c_expected = ((child >> 16) & 0xFFFFFFFF) as u32;
        let c_actual = dom_get_generation(c_idx);
        if c_idx < 65536 && c_actual == c_expected {
            child = dom_get_next_sibling(c_idx);
        } else {
            child = 0;
        }
    }

    // Closing tag: '</' + tagname + '>'
    let mut s_slash: [u8; 2] = [60, 47];
    cursor = append_bytes(base_ptr, (&s_slash) as u64, 2, offset, cursor, max_len);
    cursor = append_tag_name(base_ptr, tag_id, offset, cursor, max_len, u_idx);
    cursor = append_char(base_ptr, offset, cursor, max_len, 62);

    return cursor;
}
