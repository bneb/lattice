// Z3 Contract Test: Forall quantifier + concrete sortedness proof
//
// Demonstrates end-to-end forall verification:
// 1. forall with constant bounds expands to conjunctions (Phase 1)
// 2. forall with symbolic bounds emits Z3 ForAll (Phase 1+)
// 3. for-loop invariants checked at entry (Phase 2)

package basalt.test_insertion_sort

// Test 1: Constant-bound forall in ensures — expansion to conjunction
fn make_sorted(arr: Ptr<i32>)
    ensures forall i in 0..3 => arr[i] <= arr[i+1]
{
    unsafe {
        arr[0] = 1;
        arr[1] = 2;
        arr[2] = 3;
        arr[3] = 4;
    }
}

// Test 2: Symbolic-bound forall in requires (Z3 ForAll)
fn check_sorted(arr: Ptr<i32>, n: i64)
    requires forall i in 0..(n-1) => arr[i] <= arr[i+1]
    requires n > 0
{
    return;
}

// Test 3: For-loop invariant (simple property that holds at entry)
fn count_up(n: i64) -> i64
    requires n >= 0
{
    let mut sum: i64 = 0;
    for i in 0..n {
        invariant i >= 0;
        sum = sum + i;
    }
    return sum;
}

fn main() -> i32 {
    return 0;
}
