// Z3 Contract Test: Forall Quantifier + For-Loop Invariants
//
// What's verified at compile time:
//   1. Constant-bound forall in ensures — expands to conjunctions, Z3-proven
//   2. Symbolic forall in requires — Z3 ForAll quantifier
//   3. For-loop invariants — base case checked at loop entry
//   4. While-loop invariants — full inductive verification
//
// For-loop inductive step (invariant preservation i→i+1) is trusted.
// Full inductive proofs require Z3 array theory — a planned feature.

package basalt.test_insertion_sort

// Test 1: Constant-bound forall in ensures — expansion to conjunction
fn make_sorted(arr: Ptr<i32>)
    ensures forall i in 0..3 => arr[i] <= arr[i+1]
{
    unsafe {
        arr[0] = 1; arr[1] = 2; arr[2] = 3; arr[3] = 4;
    }
}

// Test 2: Symbolic forall in requires — Z3 ForAll quantifier
fn check_sorted(arr: Ptr<i32>, n: i64)
    requires forall i in 0..(n-1) => arr[i] <= arr[i+1]
    requires n > 0
{
    return;
}

// Test 3: For-loop invariant (simple property, Z3-proven at entry)
fn count_up(n: i64) -> i64
    requires n >= 0
{
    let mut sum: i64 = 0;
    for i in 0..n {
        invariant i >= 0;
        sum = sum + i;
    }
    return sum;
}

// Test 4: While-loop invariant (full inductive verification)
fn factorial(n: i64) -> i64
    requires n >= 0
{
    let mut result: i64 = 1;
    let mut i: i64 = 1;
    while i <= n {
        invariant i >= 1;
        result = result * i;
        i = i + 1;
    }
    return result;
}

fn main() -> i32 {
    return 0;
}
