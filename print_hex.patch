--- kernel/core/ist_test.salt
+++ kernel/core/ist_test.salt
@@ -106,6 +106,30 @@
     outb(0x3F8, 0x21); // '!'
     outb(0x3F8, 0x0A); // '\n'
 
+    // Print RIP in hex
+    outb(0x3F8, 0x52); // 'R'
+    outb(0x3F8, 0x49); // 'I'
+    outb(0x3F8, 0x50); // 'P'
+    outb(0x3F8, 0x3D); // '='
+    let mut i: u64 = 60;
+    while true {
+        let nibble: u64 = (rip >> i) & 0xF;
+        if nibble < 10 {
+            outb(0x3F8, (48 + nibble) as u8);
+        } else {
+            outb(0x3F8, (55 + nibble) as u8);
+        }
+        if i == 0 {
+            break;
+        }
+        i = i - 4;
+    }
+    outb(0x3F8, 0x0A); // '\n'
+    
+    // Spin forever to prevent returning to triple fault
+    while true {
+        // wait
+    }
+
     serial.print("[FATAL] DOUBLE FAULT (#DF)\n");
     serial.print("[FATAL]   RIP=");
