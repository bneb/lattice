// =============================================================================
// kernel/core/ring_abi.salt
// Asynchronous Ring-Buffer ABI — io_uring-style Submission/Completion Queues
// =============================================================================
//
// Each Ring 3 process may opt into the ring-buffer ABI via sys_ring_map.
// This allocates two shared-memory pages:
//   - SQ (Submission Queue): user-space produces SQEs, kernel consumes
//   - CQ (Completion Queue): kernel produces CQEs, user-space consumes
//
// The kernel drains the SQ at every scheduling point (yield, preempt,
// context switch), processes each SQE, and posts a CQE with the result.
// This eliminates SYSCALL/SYSRET overhead for the I/O hot path.
//
// Memory layout per page:
//   [0..63]   RingHeader (head, tail, capacity, mask, padding)
//   [64..]    Entry array (SQE: 64 bytes each, CQE: 32 bytes each)
//
// Concurrency model: SPSC (Single Producer, Single Consumer)
//   SQ: user = producer (writes head), kernel = consumer (writes tail)
//   CQ: kernel = producer (writes head), user = consumer (writes tail)
// =============================================================================

package kernel.core.ring_abi

import kernel.drivers.serial
import kernel.core.process
import kernel.core.pmm
import kernel.core.memory
import kernel.core.vma
import kernel.mem.user_paging
import kernel.core.exec_user

extern fn is_valid_user_ptr(ptr: u64, len: u64) -> bool;

// =============================================================================
// Constants
// =============================================================================
const PAGE_SIZE: u64 = 4096;
const RING_CAPACITY: u64 = 32;     // Power of 2, fits in 1 page with header
const RING_MASK: u64 = 31;         // RING_CAPACITY - 1
const HEADER_SIZE: u64 = 64;       // RingHeader is 64 bytes
const SQE_SIZE: u64 = 64;          // KernelSQE is 64 bytes (8 x u64)
const CQE_SIZE: u64 = 32;          // KernelCQE is 32 bytes (4 x u64)
const MAX_PROCS: u64 = 16;
const USER_PAGE_FLAGS: u64 = 0x7;  // PRESENT | WRITE | USER

// SQE op codes
pub const OP_NOP: u64      = 0;
pub const OP_WRITE: u64    = 1;
pub const OP_READ: u64     = 2;
pub const OP_YIELD: u64    = 3;
pub const OP_EXIT: u64     = 4;
pub const OP_BRK: u64      = 5;
pub const OP_MMAP: u64     = 6;
pub const OP_IPC_SEND: u64 = 7;
pub const OP_SHM_GRANT: u64 = 8;
pub const OP_SPAWN: u64 = 9;

// User VA where rings are mapped (high user-half, below canonical hole)
pub const RING_SQ_USER_VA: u64 = 0x00007FFFF0000000;
pub const RING_CQ_USER_VA: u64 = 0x00007FFFF0001000;

// =============================================================================
// Shared-Memory Layout Offsets (raw pointer arithmetic, not Salt structs)
// =============================================================================

// RingHeader layout (64 bytes at start of shared page):
//   offset 0:  head (u64) — written by producer, read by consumer
//   offset 8:  tail (u64) — written by consumer, read by producer
//   offset 16: capacity (u64)
//   offset 24: mask (u64)
//   offset 32..63: padding
const HDR_HEAD: u64     = 0;
const HDR_TAIL: u64     = 8;
const HDR_CAPACITY: u64 = 16;
const HDR_MASK: u64     = 24;

// KernelSQE layout (64 bytes):
//   offset 0:  op_code (u64)
//   offset 8:  fd (u64)
//   offset 16: buffer_addr (u64)
//   offset 24: length (u64)
//   offset 32: user_data (u64)
//   offset 40: flags (u64)
//   offset 48: _pad0 (u64)
//   offset 56: _pad1 (u64)
const SQE_OPCODE: u64   = 0;
const SQE_FD: u64       = 8;
const SQE_BUFFER: u64   = 16;
const SQE_LENGTH: u64   = 24;
const SQE_USERDATA: u64 = 32;
const SQE_FLAGS: u64    = 40;

// KernelCQE layout (32 bytes):
//   offset 0:  user_data (u64)
//   offset 8:  result (i64 stored as u64)
//   offset 16: flags (u64)
//   offset 24: _pad0 (u64)
const CQE_USERDATA: u64 = 0;
const CQE_RESULT: u64   = 8;
const CQE_FLAGS: u64    = 16;

// User address limit (must match syscall.salt)
const USER_ADDR_LIMIT: u64 = 0x0000800000000000;

// IPC process states (must match process.salt)
const PROC_FREE: u64 = 0;
const PROC_IPC_BLOCKED: u64 = 4;
const PROC_READY: u64 = 1;
const MAX_PROCS: u64 = 16;

// SMP CAS for IPC atomics
extern fn smp_cas_u64(addr: u64, expected: u64, desired: u64) -> u64;

// =============================================================================
// Per-Process Ring Table (kernel-side bookkeeping, NOT in shared memory)
// =============================================================================
struct ProcessRing {
    sq_kern: u64,       // Kernel VA of SQ page
    cq_kern: u64,       // Kernel VA of CQ page
    sq_phys: u64,       // Physical addr of SQ page
    cq_phys: u64,       // Physical addr of CQ page
    active: u64,        // 1 if ring is mapped
}

global RING_TABLE: [ProcessRing; 16] = [ProcessRing {
    sq_kern: 0, cq_kern: 0, sq_phys: 0, cq_phys: 0, active: 0
}; 16];

// =============================================================================
// FFI — Atomics and TLB
// =============================================================================
extern fn salt_atomic_load_i64(ptr: u64) -> i64;
extern fn salt_atomic_store_i64(ptr: u64, val: i64);
extern fn read_cr3() -> u64;
extern fn invlpg_addr(vaddr: u64);

// =============================================================================
// zero_page — Zero a 4KB page via kernel VA
// =============================================================================
fn zero_page(kern_va: u64) {
    let mut i: u64 = 0;
    while i < PAGE_SIZE {
        *((kern_va + i) as &mut u8) = 0;
        i = i + 1;
    }
}

// =============================================================================
// init_header — Write the RingHeader at the start of a shared page
// =============================================================================
fn init_header(kern_va: u64) {
    *((kern_va + HDR_HEAD) as &mut u64) = 0;
    *((kern_va + HDR_TAIL) as &mut u64) = 0;
    *((kern_va + HDR_CAPACITY) as &mut u64) = RING_CAPACITY;
    *((kern_va + HDR_MASK) as &mut u64) = RING_MASK;
}

// =============================================================================
// init_ring — Allocate and map SQ/CQ pages for a process
// =============================================================================
// Called from sys_ring_map. Returns the user VA of the SQ page.
// The user derives the CQ VA as SQ_VA + PAGE_SIZE.
// =============================================================================
pub fn init_ring(slot: u64) -> u64 {
    // 1. Allocate physical pages
    let sq_phys = pmm.alloc();
    if sq_phys == 0 {
        serial.print("[ring_abi] FATAL: OOM allocating SQ page\n");
        return 0;
    }
    let cq_phys = pmm.alloc();
    if cq_phys == 0 {
        serial.print("[ring_abi] FATAL: OOM allocating CQ page\n");
        pmm.free(sq_phys);
        return 0;
    }

    // 2. Convert to kernel VA via higher-half direct map
    let sq_kern = memory.phys_to_virt_raw(sq_phys);
    let cq_kern = memory.phys_to_virt_raw(cq_phys);

    // 3. Zero both pages
    zero_page(sq_kern);
    zero_page(cq_kern);

    // 4. Initialize ring headers
    init_header(sq_kern);
    init_header(cq_kern);

    // 5. Map into user address space
    let pml4 = process.get_pml4(slot);
    user_paging.map_user_page(pml4, RING_SQ_USER_VA, sq_phys, USER_PAGE_FLAGS);
    user_paging.map_user_page(pml4, RING_CQ_USER_VA, cq_phys, USER_PAGE_FLAGS);

    // 6. Flush TLB for the newly mapped pages
    invlpg_addr(RING_SQ_USER_VA);
    invlpg_addr(RING_CQ_USER_VA);

    // 7. Store bookkeeping in RING_TABLE
    RING_TABLE[slot].sq_kern = sq_kern;
    RING_TABLE[slot].cq_kern = cq_kern;
    RING_TABLE[slot].sq_phys = sq_phys;
    RING_TABLE[slot].cq_phys = cq_phys;
    RING_TABLE[slot].active = 1;

    serial.print("[ring_abi] init slot=");
    serial.print_u64(slot);
    serial.print(" sq_kern=0x");
    serial.print_u64(sq_kern);
    serial.print(" cq_kern=0x");
    serial.print_u64(cq_kern);
    serial.print("\n");

    return RING_SQ_USER_VA;
}

// =============================================================================
// is_active — Check if a process has the ring ABI mapped
// =============================================================================
pub fn is_active(slot: u64) -> bool {
    return RING_TABLE[slot].active == 1;
}

// =============================================================================
// drain_sq — Pop all pending SQEs and dispatch them
// =============================================================================
// Called at every scheduling point (yield, preempt, context switch).
// The kernel is the SQ consumer: we read head atomically (user writes it),
// and we write tail atomically (user reads it).
// =============================================================================
pub fn drain_sq(slot: u64) {
    if RING_TABLE[slot].active != 1 {
        return;
    }

    let sq_kern = RING_TABLE[slot].sq_kern;

    // Read our tail (local — we are the only writer)
    let mut tail = *((sq_kern + HDR_TAIL) as &u64);

    // Read head atomically (user-space is the producer)
    let head = salt_atomic_load_i64(sq_kern + HDR_HEAD) as u64;

    // Process all pending SQEs
    while tail < head {
        let index = tail & RING_MASK;
        let entry = sq_kern + HEADER_SIZE + (index * SQE_SIZE);

        // Read SQE fields
        let op_code     = *((entry + SQE_OPCODE) as &u64);
        let fd          = *((entry + SQE_FD) as &u64);
        let buffer_addr = *((entry + SQE_BUFFER) as &u64);
        let length      = *((entry + SQE_LENGTH) as &u64);
        let user_data   = *((entry + SQE_USERDATA) as &u64);

        // Dispatch
        dispatch_sqe(slot, op_code, fd, buffer_addr, length, user_data);

        // Advance tail and publish atomically
        tail = tail + 1;
        salt_atomic_store_i64(sq_kern + HDR_TAIL, tail as i64);
    }
}

// =============================================================================
// dispatch_sqe — Route an SQE to the appropriate kernel handler
// =============================================================================
fn dispatch_sqe(slot: u64, op: u64, fd: u64, buf: u64, len: u64, udata: u64) {
    if op == OP_NOP {
        post_cqe(slot, udata, 0, 0);
    } else if op == OP_WRITE {
        let result = ring_write(slot, fd, buf, len);
        post_cqe(slot, udata, result, 0);
    } else if op == OP_BRK {
        // buf = new_brk address
        let result = ring_brk(slot, buf);
        post_cqe(slot, udata, result as i64, 0);
    } else if op == OP_YIELD {
        // Yield is a no-op here — the drain itself happens at a yield point
        post_cqe(slot, udata, 0, 0);
    } else if op == OP_EXIT {
        // Exit is special — post CQE first, then exit (never returns)
        post_cqe(slot, udata, 0, 0);
        serial.print("[ring_abi] OP_EXIT from slot=");
        serial.print_u64(slot);
        serial.print("\n");
    } else if op == OP_MMAP {
        // SQE fields: buf=length, len=prot
        let result = ring_mmap(slot, buf, len);
        post_cqe(slot, udata, result as i64, 0);
    } else if op == OP_IPC_SEND {
        // SQE fields: fd=target_pid, buf=msg0, len=msg1, flags(offset 40)=msg2
        let result = ring_ipc_send(slot, fd, buf, len);
        post_cqe(slot, udata, result, 0);
    } else if op == OP_SHM_GRANT {
        // SQE fields: fd=target_pid, buf=src_vaddr, len=dst_vaddr
        // flags field (at SQE offset 40) encodes num_pages
        let result = ring_shm_grant(slot, fd, buf, len);
        post_cqe(slot, udata, result, 0);
    } else if op == OP_SPAWN {
        // SQE fields: buf = manifest pointer (user VA)
        let result = ring_spawn(slot, buf);
        post_cqe(slot, udata, result as i64, 0);
    } else {
        // Unknown op — return error
        serial.print("[ring_abi] unknown op=");
        serial.print_u64(op);
        serial.print("\n");
        post_cqe(slot, udata, 0 - 1, 0);
    }
}

// =============================================================================
// ring_write — KPTI-safe write to serial (mirrors sys_write in syscall.salt)
// =============================================================================
// Translates user virtual addresses through the process's page tables,
// then reads via the kernel's higher-half direct map.
// Returns bytes written as i64, or negative on error.
// =============================================================================
fn ring_write(slot: u64, fd: u64, buf: u64, len: u64) -> i64 {
    // Only fd=1 (stdout → serial) is supported
    if fd != 1 {
        return 0 - 1;
    }
    if len == 0 {
        return 0;
    }

    let mut actual_len = len;
    if actual_len > 4096 {
        actual_len = 4096;
    }

    // Validate user pointer
    if buf >= USER_ADDR_LIMIT {
        return 0 - 1;
    }
    let end = buf + actual_len;
    if end < buf {
        return 0 - 1;
    }
    if end > USER_ADDR_LIMIT {
        return 0 - 1;
    }

    // KPTI: Walk user page tables to translate, read via kernel direct map
    let user_pml4 = process.get_pml4(slot);
    let mut remaining = actual_len;
    let mut current_va = buf;

    while remaining > 0 {
        let phys = user_paging.translate_user_addr(user_pml4, current_va);
        if phys == 0 {
            return (actual_len - remaining) as i64;
        }

        let offset_in_page = current_va & 0xFFF;
        let bytes_to_page_end = PAGE_SIZE - offset_in_page;
        let mut chunk_size = remaining;
        if chunk_size > bytes_to_page_end {
            chunk_size = bytes_to_page_end;
        }

        let kern_ptr = memory.phys_to_virt_raw(phys);
        serial.print_buf(kern_ptr, chunk_size);

        current_va = current_va + chunk_size;
        remaining = remaining - chunk_size;
    }

    return actual_len as i64;
}

// =============================================================================
// ring_brk — Heap growth via ring buffer (mirrors sys_brk logic)
// =============================================================================
fn ring_brk(slot: u64, new_brk: u64) -> u64 {
    let current_brk = process.get_brk_current(slot);
    let brk_base = process.get_brk_base(slot);

    if new_brk == 0 {
        return current_brk;
    }
    if new_brk < brk_base {
        return current_brk;
    }

    let current_page_end = (current_brk + 0xFFF) & 0xFFFFFFFFFFFFF000;
    let new_page_end = (new_brk + 0xFFF) & 0xFFFFFFFFFFFFF000;

    if new_page_end > current_page_end {
        let pml4 = process.get_pml4(slot);
        let mut cursor = current_page_end;
        while cursor < new_page_end {
            let paddr = pmm.alloc();
            if paddr == 0 {
                serial.print("[ring_abi] brk OOM\n");
                return current_brk;
            }
            user_paging.map_user_page(pml4, cursor, paddr, USER_PAGE_FLAGS);
            invlpg_addr(cursor);
            cursor = cursor + PAGE_SIZE;
        }
    }

    process.set_brk_current(slot, new_brk);
    return new_brk;
}

// =============================================================================
// ring_mmap — Memory mapping via ring buffer (mirrors sys_mmap in syscall.salt)
// =============================================================================
// SQE fields: buf=length (bytes), len=prot (protection flags)
// Returns: virtual address of mapped region, or 0 on failure
// =============================================================================
fn ring_mmap(slot: u64, length: u64, prot: u64) -> u64 {
    // 1. Page-align the requested length
    let aligned_length = (length + 0xFFF) & 0xFFFFFFFFFFFFF000;
    if aligned_length == 0 {
        return 0;
    }

    // 2. Bump-allocate a virtual address range
    let start_vaddr = process.get_mmap_base(slot);
    let end_vaddr = start_vaddr + aligned_length;

    // 3. Allocate VMA tracking metadata
    let vma_ptr = vma.alloc(start_vaddr, end_vaddr, prot);
    if vma_ptr == 0 {
        serial.print("[ring_abi] mmap OOM: VMA slab exhausted\n");
        return 0;
    }

    // 4. Map physical pages into the user's address space
    let pml4 = process.get_pml4(slot);
    let mut cursor = start_vaddr;

    while cursor < end_vaddr {
        let paddr = pmm.alloc();
        if paddr == 0 {
            serial.print("[ring_abi] mmap OOM at 0x");
            serial.print_u64(cursor);
            serial.print("\n");
            return 0;
        }
        user_paging.map_user_page(pml4, cursor, paddr, USER_PAGE_FLAGS);
        invlpg_addr(cursor);
        cursor = cursor + PAGE_SIZE;
    }

    // 5. Advance mmap high-water mark
    process.set_mmap_base(slot, end_vaddr);

    // 6. Prepend VMA to linked list
    let current_head = process.get_vma_list_head(slot);
    let next_field_ptr = (vma_ptr + 24) as &mut u64;
    *next_field_ptr = current_head;
    process.set_vma_list_head(slot, vma_ptr);

    serial.print("[ring_abi] mmap slot=");
    serial.print_u64(slot);
    serial.print(" vaddr=0x");
    serial.print_u64(start_vaddr);
    serial.print(" len=");
    serial.print_u64(aligned_length);
    serial.print("\n");

    return start_vaddr;
}

// =============================================================================
// ring_ipc_send — Fast-path IPC via ring buffer
// =============================================================================
// SQE fields: fd=target_pid, buf=msg0, len=msg1
// Returns: 0 on success, -1 on invalid/not-blocked target
// =============================================================================
fn ring_ipc_send(slot: u64, target_pid: u64, msg0: u64, msg1: u64) -> i64 {
    if target_pid >= MAX_PROCS {
        serial.print("[ring_abi] ipc_send REJECT: target out of range\n");
        return 0 - 1;
    }
    let target_state = process.get_state(target_pid);
    if target_state == PROC_FREE {
        serial.print("[ring_abi] ipc_send REJECT: target free\n");
        return 0 - 1;
    }

    // SMP-safe CAS to atomically unblock the target
    let state_addr = process.get_state_addr(target_pid);
    let old = smp_cas_u64(state_addr, PROC_IPC_BLOCKED, PROC_READY);
    if old == PROC_IPC_BLOCKED {
        // We won the race — exclusive access to PCB IPC fields
        process.set_ipc_msg(target_pid, slot, msg0, msg1, 0);
        serial.print("[ring_abi] ipc_send delivered to slot=");
        serial.print_u64(target_pid);
        serial.print("\n");
        return 0;
    }

    // Target not blocked or another core unblocked it first
    return 0 - 1;
}

// =============================================================================
// ring_shm_grant — Zero-copy shared memory via ring buffer
// =============================================================================
// SQE fields: fd=target_pid, buf=src_vaddr, len=dst_vaddr
// The number of pages is fixed at 1 for ring-buffer submissions.
// For multi-page grants, submit multiple SQEs or use the syscall path.
// Returns: 0 on success, -1 on error
// =============================================================================
fn ring_shm_grant(slot: u64, target_pid: u64, src_vaddr: u64, dst_vaddr: u64) -> i64 {
    // 1. Target validation
    if target_pid >= MAX_PROCS {
        return 0 - 1;
    }
    let target_state = process.get_state(target_pid);
    if target_state == PROC_FREE {
        return 0 - 1;
    }

    // 2. Alignment enforcement (page-aligned)
    if (src_vaddr & 0xFFF) != 0 || (dst_vaddr & 0xFFF) != 0 {
        return 0 - 1;
    }

    // 3. User-half enforcement
    if src_vaddr >= USER_ADDR_LIMIT || dst_vaddr >= USER_ADDR_LIMIT {
        return 0 - 1;
    }
    let src_end = src_vaddr + PAGE_SIZE;
    let dst_end = dst_vaddr + PAGE_SIZE;
    if src_end > USER_ADDR_LIMIT || dst_end > USER_ADDR_LIMIT {
        return 0 - 1;
    }

    // 4. Get PML4s
    let src_pml4 = process.get_pml4(slot);
    if src_pml4 == 0 {
        return 0 - 1;
    }
    let target_pml4 = process.get_pml4(target_pid);
    if target_pml4 == 0 {
        return 0 - 1;
    }

    // 5. Resolve physical frame from sender's page tables
    let src_pte = user_paging.get_user_pte(src_pml4, src_vaddr);
    if (src_pte & user_paging.PTE_PRESENT) == 0 {
        return 0 - 1;
    }
    let phys_frame = src_pte & 0x000FFFFFFFFFF000;

    // 6. Verify target does not already have mapping
    let existing_pte = user_paging.get_user_pte(target_pml4, dst_vaddr);
    if (existing_pte & user_paging.PTE_PRESENT) != 0 {
        serial.print("[ring_abi] shm_grant REJECT: target already mapped\n");
        return 0 - 1;
    }

    // 7. Inherit write permission from source
    let mut target_flags = user_paging.PTE_PRESENT | user_paging.PTE_USER;
    if (src_pte & user_paging.PTE_WRITE) != 0 {
        target_flags = target_flags | user_paging.PTE_WRITE;
    }

    // 8. Map the physical frame into the target's address space
    user_paging.map_user_page(target_pml4, dst_vaddr, phys_frame, target_flags);

    serial.print("[ring_abi] shm_grant: frame=0x");
    serial.print_u64(phys_frame);
    serial.print(" -> target=");
    serial.print_u64(target_pid);
    serial.print(" dst=0x");
    serial.print_u64(dst_vaddr);
    serial.print("\n");

    return 0;
}

// =============================================================================
// post_cqe — Push a completion entry to the process's CQ
// =============================================================================
// The kernel is the CQ producer: we read tail atomically (user reads it),
// and we write head atomically (user writes nothing to head — it reads it).
// =============================================================================
pub fn post_cqe(slot: u64, user_data: u64, result: i64, flags: u64) {
    if RING_TABLE[slot].active != 1 {
        return;
    }

    let cq_kern = RING_TABLE[slot].cq_kern;

    // Read our head (local — we are the only writer)
    let head = *((cq_kern + HDR_HEAD) as &u64);

    // Read tail atomically (user-space is the consumer)
    let tail = salt_atomic_load_i64(cq_kern + HDR_TAIL) as u64;

    // Check for full ring
    if (head - tail) >= RING_CAPACITY {
        serial.print("[ring_abi] CQ full, dropping completion\n");
        return;
    }

    // Calculate entry address
    let index = head & RING_MASK;
    let entry = cq_kern + HEADER_SIZE + (index * CQE_SIZE);

    // Write CQE fields
    *((entry + CQE_USERDATA) as &mut u64) = user_data;
    *((entry + CQE_RESULT) as &mut u64) = result as u64;
    *((entry + CQE_FLAGS) as &mut u64) = flags;

    // Publish: store head atomically so user-space sees the new entry
    salt_atomic_store_i64(cq_kern + HDR_HEAD, (head + 1) as i64);
}

// =============================================================================
// destroy_ring — Unmap and free ring pages on process exit
// =============================================================================
pub fn destroy_ring(slot: u64) {
    if RING_TABLE[slot].active != 1 {
        return;
    }

    // Free physical pages
    let sq_phys = RING_TABLE[slot].sq_phys;
    let cq_phys = RING_TABLE[slot].cq_phys;

    if sq_phys != 0 {
        pmm.free(sq_phys);
    }
    if cq_phys != 0 {
        pmm.free(cq_phys);
    }

    // Clear bookkeeping
    RING_TABLE[slot].sq_kern = 0;
    RING_TABLE[slot].cq_kern = 0;
    RING_TABLE[slot].sq_phys = 0;
    RING_TABLE[slot].cq_phys = 0;
    RING_TABLE[slot].active = 0;

    serial.print("[ring_abi] destroyed ring for slot=");
    serial.print_u64(slot);
    serial.print("\n");
}

// =============================================================================
// ring_spawn — Read SpawnManifest and create a new process
// =============================================================================
fn ring_spawn(slot: u64, manifest_vaddr: u64) -> u64 {
    // 1. Validate user pointer for SpawnManifest (16 bytes)
    if !is_valid_user_ptr(manifest_vaddr, 16) {
        return process.MAX_PROCS;
    }

    // 2. Translate pointer via user page tables (KPTI)
    let user_pml4 = process.get_pml4(slot);
    let phys = user_paging.translate_user_addr(user_pml4, manifest_vaddr);
    if phys == 0 {
        return process.MAX_PROCS; // Page fault
    }
    
    // 3. Read manifest from kernel direct map
    let kern_va = memory.phys_to_virt_raw(phys) + (manifest_vaddr & 0xFFF);
    let elf_vaddr = *(kern_va as &u64);
    let namespace_flags = *((kern_va + 8) as &u64);

    // 4. Validate elf_vaddr
    if !is_valid_user_ptr(elf_vaddr, 1) {
        return process.MAX_PROCS;
    }

    // 5. Spawn the process!
    // Since spawn_process requires the elf_base to be a valid *virtual* address mapped in kernel space,
    // and we only have the *user virtual address*, we must translate it.
    let elf_phys = user_paging.translate_user_addr(user_pml4, elf_vaddr);
    if elf_phys == 0 {
        return process.MAX_PROCS;
    }
    let elf_kern_va = memory.phys_to_virt_raw(elf_phys) + (elf_vaddr & 0xFFF);

    // Get the global Kernel PML4
    // Read CR3 (since kernel is executing, CR3 is either kernel PML4 or user PML4 if mapped higher-half).
    // The safest way is to use a known good kernel PML4. We will grab it from slot 0 (kernel idle thread) if possible.
    // Wait, let's just pass `user_pml4` as the kernel_pml4 for `spawn_process`, since `spawn_process`
    // actually needs the *kernel* PML4 base to copy into the new `user_pml4`.
    // Wait, `user_paging.create_user_pml4(kernel_pml4)` just needs the physical address of the kernel PML4
    // to clone the higher-half mappings. We can get this from `read_cr3()`.
    let current_cr3 = read_cr3();
    let kernel_pml4 = current_cr3 & 0xFFFFFFFFFFFFF000;
    
    let child_pid = exec_user.spawn_process(elf_kern_va, kernel_pml4);
    if child_pid == process.MAX_PROCS {
        return process.MAX_PROCS; // Spawn failed
    }

    // 6. Inherit or Isolate Namespaces
    // NS_ISOLATE_FS = 1, NS_ISOLATE_NET = 2
    if (namespace_flags & 1) != 0 {
        process.set_fs_namespace_id(child_pid, child_pid); // new isolate
    } else {
        process.set_fs_namespace_id(child_pid, process.get_fs_namespace_id(slot));
    }

    if (namespace_flags & 2) != 0 {
        process.set_net_namespace_id(child_pid, child_pid); // new isolate
    } else {
        process.set_net_namespace_id(child_pid, process.get_net_namespace_id(slot));
    }

    serial.print("[ring_abi] OP_SPAWN: slot=");
    serial.print_u64(slot);
    serial.print(" spawned child=");
    serial.print_u64(child_pid);
    serial.print(" (fs_ns=");
    serial.print_u64(process.get_fs_namespace_id(child_pid));
    serial.print(" net_ns=");
    serial.print_u64(process.get_net_namespace_id(child_pid));
    serial.print(")\n");

    return child_pid;
}

@no_mangle
pub fn ring_abi_destroy_ring(slot: u64) { destroy_ring(slot); }
@no_mangle
pub fn ring_abi_drain_sq(slot: u64) { drain_sq(slot); }
