// ============================================================================
// kernel/core/teardown.salt
// Hardware-Fenced Reclaim Protocol — Hardware-Fenced O(1) Process Exits
// ============================================================================
//
// The 4-Phase Teardown completely eliminates recursive memory walks, lock
// contention, and resource leaking on process kill. It guarantees that a
// terminated process holds zero kernel resources and that all hardware DMA
// is fenced before physical frames are returned to the PMM Treiber stack.
//
// 1. SPSC Ring Drain: Clear pending IPC descriptors.
// 2. NIC Ring Disable: Halt DMA (preventing use-after-free).
// 3. MMU Unmap: Flat bitmap sweep, skipping recursive page tables.
// 4. Frame Release: Bulk push to PmmShard.
// ============================================================================

package kernel.core.teardown

import kernel.core.process
import kernel.mem.vmm
import kernel.mem.pmm_sharded
import kernel.sched.bitmap_disp

// Generic architecture HAL abstraction for TLB shootdown
extern fn tlb_flush_all();

// Stub for Network DMA controls
extern fn disable_dma_queues(queue_mask: u64);

// ============================================================================
// sys_exit — Terminate current process and reclaim all resources
// ============================================================================
pub fn sys_exit(exit_code: i32) {
    let proc = process.get_current_process();
    if proc as u64 == 0 {
        return;
    }

    let pid = process.get_pid(proc);

    // ------------------------------------------------------------------------
    // PHASE 1: SPSC Ring Drain (Software Fence)
    // ------------------------------------------------------------------------
    // Clear all pending descriptors to prevent dangling pointer faults
    // for other processes listening on shared rings.
    process.drain_all_mapped_rings(proc);

    // ------------------------------------------------------------------------
    // PHASE 2: NIC Ring Disable (Hardware Fence)
    // ------------------------------------------------------------------------
    // Stop the physical network card from executing DMA writes to this
    // process's pages while we return them to the PMM allocator.
    let nic_mask = process.get_nic_queue_mask(proc);
    if nic_mask != 0 {
        disable_dma_queues(nic_mask);
    }

    // ------------------------------------------------------------------------
    // PHASE 3: MMU Unmap and Atomic Page Sweep
    // ------------------------------------------------------------------------
    // Flat bitmap sweep, no recursive walks.
    let pml4 = process.get_pml4(proc);
    if pml4 != 0 {
        vmm.unmap_flat_bitmap(pml4);
        
        // Architecture-agnostic full TLB flush via HAL intrinsic
        tlb_flush_all();
    }

    // ------------------------------------------------------------------------
    // PHASE 4: Frame & Kernel Resource Release
    // ------------------------------------------------------------------------
    // Return frames in bulk to the lock-free sharded PMM Treiber stack
    let frames = process.get_allocated_frames(proc);
    let count = process.get_allocated_frame_count(proc);
    if count > 0 {
        pmm_sharded.bulk_free(frames, count);
    }

    // ------------------------------------------------------------------------
    // FINALIZATION: O(1) Scheduler Takedown
    // ------------------------------------------------------------------------
    // Clear the task's runnable bit in the 2-level hierarchy
    bitmap_disp.clear_runnable(pid);
    
    // Mark process struct as zombie
    process.mark_dead(proc, exit_code);
    
    // Yield CPU permanently — this function never returns
    process.yield();
}
