// =============================================================================
// kernel/core/main.salt — Kernel Entry Point
// =============================================================================
// Boot functions extracted to boot_helpers.salt to keep this file under 500 lines.
// IMPORT POLICY: Only import modules with tiny globals (< 1KB). All other
// cross-module calls use extern fn with the exact symbol names exported by
// each module (most use @no_mangle for unmangled C-ABI symbols).

package kernel.core.main

import kernel.sys.ramfs
import kernel.drivers.serial
import kernel.arch.x86.idt

