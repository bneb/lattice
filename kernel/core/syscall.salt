// =============================================================================
// User Pointer Validation
// =============================================================================
// Local copies of process.salt constants (avoids cross-TU addressof failure)
const MAX_PROCS: u64 = 64;
const PROC_FREE: u64   = 0;
const PROC_READY: u64  = 1;
const PROC_RUNNING: u64 = 2;
const PROC_ZOMBIE: u64 = 3;
const PROC_IPC_BLOCKED: u64 = 4;
const PROC_BLOCKED_ACCEPT: u64 = 5;
const PROC_BLOCKED_RECV: u64 = 6;

const PAGE_SIZE: u64 = 4096;
const USER_PAGE_FLAGS: u64 = 0x7;  // PRESENT | WRITE | USER

const USER_ADDR_LIMIT: u64 = 0x0000800000000000;


@no_mangle
pub fn is_valid_user_ptr(ptr: u64, len: u64) -> bool {
    if ptr >= USER_ADDR_LIMIT {
        return false;
    }
    let end = ptr + len;
    if end < ptr {
        return false;
    }
    if end > USER_ADDR_LIMIT {
        return false;
    }
    return true;
}

// =============================================================================
// Syscall Dispatch — Returns value to Ring 3 via RAX
// =============================================================================
// Syscall numbers follow Linux x86_64 convention:
//   0  = noop (fast path in asm)
//   1  = sys_write
//   9  = sys_mmap
//   12 = sys_brk
//   60 = sys_exit (handled in asm, never reaches here)
//   119 = sched_yield
@no_mangle
pub fn handle_syscall(num: u64, arg0: u64, arg1: u64, arg2: u64) -> u64 {
    if num != 119 && num != 0 && num != 1 {
        serial.print("[syscall] num=");
        serial.print_u64(num);
        serial.print(" from slot=");
        serial.print_u64(process.current());
        serial.print("\n");
    }
    if num == 0 {
        return sys_read(arg0, arg1, arg2);
    } else if num == 1 {
        return sys_write(arg0, arg1, arg2);
    } else if num == 2 {
        return sys_open(arg0, arg1);
    } else if num == 9 {
        return sys_mmap(arg0, arg1);
    } else if num == 12 {
        return sys_brk(arg0);
    } else if num == 10 {
        // SYS_CAP_BIND: arg0=flags
        return sys_cap_bind(arg0);
    } else if num == 11 {
        // SYS_RING_MAP: Initialize ring-buffer ABI for the calling process
        // arg0 = capability_id (must have CAP_FLAG_RING_ABI)
        let pid = process.current();
        let cap_flags = capability.get_flags(pid, arg0);
        if (cap_flags & capability.CAP_FLAG_RING_ABI) == 0 {
            serial.print("[syscall] sys_ring_map REJECT: capability missing or invalid\n");
            return 0;
        }
        return ring_abi.init_ring(pid);
    } else if num == 13 {
        // SYS_CORE_ACQUIRE: arg0=target_core_id
        return sys_core_acquire(arg0);
    } else if num == 14 {
        // SYS_IPC_REG_SEND: arg0=cap_id, arg1=payload_offset, arg2=payload_len
        // Fast-path register IPC — zero-copy capability handoff to kernel
        fastpath_handoff_syscall(arg0, arg1 as u32, arg2 as u32);
        return 0;
    } else if num == 15 {
        // SYS_IPC_AWAIT: fast-path await, pending implementation
        return 0 - 1;
    } else if num == 16 {
        // SYS_PS: arg0 = buf_ptr
        return sys_ps(arg0);
    } else if num == 17 {
        // SYS_MEMINFO: arg0 = buf_ptr
        return sys_meminfo(arg0);
    } else if num == 18 {
        // SYS_UPTIME: no args
        return sys_uptime();
    } else if num == 19 {
        // SYS_GETPID: no args
        return sys_getpid();
    } else if num == 20 {
        // SYS_PING: arg0 = dst_ip (u32), returns RTT in ms or 0 on timeout
        return sys_ping(arg0 as u32);
    } else if num == 21 {
        // SYS_TCP_CONNECT: arg0 = dst_ip (u32), returns conn_id or 0 on failure
        return sys_tcp_connect(arg0 as u32);
    } else if num == 22 {
        // SYS_TCP_SEND: arg0 = conn_id, arg1 = buf, arg2 = len
        return sys_tcp_send(arg0, arg1, arg2);
    } else if num == 23 {
        // SYS_TCP_RECV: arg0 = conn_id, arg1 = buf, arg2 = len
        return sys_tcp_recv(arg0, arg1, arg2);
    } else if num == 24 {
        // SYS_TCP_CLOSE: arg0 = conn_id
        sys_tcp_close(arg0);
        return 0;
    } else if num == 25 {
        // SYS_TCP_LISTEN: arg0 = port (u16)
        return sys_tcp_listen(arg0 as u16);
    } else if num == 26 {
        // SYS_TCP_ACCEPT: arg0 = listen_slot
        return sys_tcp_accept(arg0);
    } else if num == 119 {
        // Ring ABI: drain submission queue before yielding
        let yield_pid = process.current();
        ring_abi.drain_sq(yield_pid);
        moe.drain_bar();             // TX bridge: flush pending WQE before yielding
        netcore_poll_all();          // RX bridge: poll for incoming packets
        // I/O Pump: Safe VMEXIT via VirtIO Queue Notify (PCI PIO).
        // This traps to KVM without enabling interrupts — no #DF risk.
        virtio_notify_rx();          // Queue 0: remind QEMU to inject RX frames
        virtio_notify_tx();          // Queue 1: remind QEMU to drain TX descriptors
        // --------------------------------

        // NO sched_yield() here — we are inside invoke_preemptive_thread's
        // IRETQ context. Calling sched_yield() would corrupt ctx_ptr via
        // stale IRETQ re-entry. SYSRET returns to Ring 3 naturally.

        // Second RX poll — drain any frames QEMU deposited during the VMEXITs above.
        // The first poll (line 94) runs BEFORE QEMU processes anything.
        // The VMEXITs at lines 97-98 trigger QEMU's main loop which may
        // inject new RX frames. This second poll catches those.
        let rx2 = netcore_poll_all();
        if rx2 > 0 {
            serial.print("[DIAG] Post-VMEXIT RX poll caught ");
            serial.print_u64(rx2 as u64);
            serial.print(" frames\n");
        }

        return 0;
    } else if num == 200 {
        // SYS_IPC_SEND: arg0=target_pid, arg1=msg0, arg2=msg1
        // NOTE: arg3 (msg2) arrives via R10 but handle_syscall only gets 3 args
        // from the slow path. The fast-path in assembly handles the full 4-arg dispatch.
        return sys_ipc_send(arg0, arg1, arg2, 0);
    } else if num == 201 {
        // SYS_IPC_RECV: block until message arrives
        return sys_ipc_recv();
    } else if num == 202 {
        // SYS_SHM_GRANT: arg0=target_pid, arg1=src_vaddr, arg2=dst_vaddr
        // Slow path doesn't receive R10 (num_pages), default to 1 page.
        return sys_shm_grant(arg0, arg1, arg2, 1);
    } else if num == 99 {
        // SYS_SHUTDOWN: Drain any pending WQE, then ACPI exit
        moe.drain_bar();
        outw(0x604, 0x2000);
        return 0;
    } else if num >= 128 && num <= 131 {
        // SYS_REACTOR_* are deprecated in favor of sys_ipc_await (14/15)
        // and KeuOSPoller. Return ENOSYS (-1) to signal userspace.
        return 0 - 1;
    } else if num == 400 {
        // SYS_SPAWN: arg0 = path_ptr, arg1 = path_len
        return sys_spawn(arg0, arg1);
    } else if num == 401 {
        // SYS_WAIT: arg0 = target_pid
        return sys_wait(arg0);
    } else if num == 402 {
        // SYS_ENTITY_EXIT: arg0 = exit_code
        return sys_entity_exit(arg0);
    } else if num == 403 {
        // SYS_ENTITY_WAIT: arg0 = entity_val
        return sys_entity_wait(arg0);
    } else if num == 404 {
        // SYS_ENTITY_WRITE: arg0 = entity_val, arg1 = buf_ptr, arg2 = buf_len
        return sys_entity_write(arg0, arg1, arg2);
    } else if num == 405 {
        // SYS_ENTITY_MAP: arg0 = parent_slot, arg1 = size
        return sys_entity_map(arg0, arg1);
    } else if num == 406 {
        // SYS_ENTITY_BRK: arg0 = entity_val, arg1 = new_size
        return sys_entity_brk(arg0, arg1);
    }
    return 0;
}

// =============================================================================
// sys_write
// =============================================================================
extern fn copy_from_user(dst_kern: u64, src_user: u64, len: u64) -> i64;
extern fn copy_to_user(dst_user: u64, src_kern: u64, len: u64) -> i64;
extern fn sys_write(fd: u64, buf: u64, len: u64) -> u64;
extern fn sys_read(fd: u64, buf: u64, len: u64) -> u64;
extern fn sys_open(path: u64, flags: u64) -> u64;

// =============================================================================
// process_exit — Full process lifecycle cleanup. NEVER RETURNS.
// =============================================================================
extern fn destroy_fd_table(slot: u64);

@no_mangle
pub fn process_exit(exit_code: u64) {
    let slot = process.current();
    serial.print("[sys_exit] slot=");
    serial.print_u64(slot);
    serial.print(" code=");
    serial.print_u64(exit_code);
    serial.print("\n");

    let user_pml4 = process.get_pml4(slot);
    switch_cr3(KERNEL_PML4);
    user_paging.destroy_user_pml4(user_pml4);

    destroy_fd_table(slot);
    ring_abi.destroy_ring(slot);

    process.set_ipc_msg(slot, 0, exit_code, 0, 0);
    process.set_state(slot, PROC_ZOMBIE);
    process.dec_count();

    let entity = process.get_ecs_entity(slot);
    if entity != 0 {
        ecs_bridge.ecs_bridge_destroy_thread(entity);
    }

    switch_to_next_ready(slot);
}

// Kernel PML4 saved at init
global KERNEL_PML4: u64 = 0;

pub fn set_kernel_pml4(pml4: u64) {
    KERNEL_PML4 = pml4;
}

@no_mangle
pub fn syscall_set_kernel_pml4(pml4: u64) { set_kernel_pml4(pml4); }

extern fn copy_fd_obj(fd_obj_addr: u64) -> u64;
extern fn duplicate_fd_table(parent_slot: u64, child_slot: u64);

@no_mangle
pub fn sys_spawn(path_ptr: u64, path_len: u64) -> u64 {
    let mut buf_len = path_len;
    if buf_len > 255 { buf_len = 255; }
    
    let kern_buf = kernel.core.pmm.alloc();
    if kern_buf == 0 { return 0 - 1; }
    let buf_va = kernel.core.memory.phys_to_virt_raw(kern_buf);
    
    let bytes_copied = copy_from_user(buf_va as u64, path_ptr, buf_len);
    if bytes_copied <= 0 {
        kernel.core.pmm.free(kern_buf);
        return 0 - 1;
    }
    
    // Null-terminate the string
    let p = buf_va as Ptr<u8>;
    p.offset(bytes_copied).write(0);
    
    // Lookup in VFS
    let inode = vfs.sys_vfs_lookup(buf_va as u64);
    if inode == 0 {
        kernel.core.pmm.free(kern_buf);
        return 0 - 2; // ENOENT
    }
    
    // Spawn process
    let child_slot = exec_user.exec_spawn_process_from_inode(inode, KERNEL_PML4);
    kernel.core.pmm.free(kern_buf);
    
    if child_slot >= MAX_PROCS {
        return 0 - 1; // EAGAIN
    }
    
    // Set parent
    let caller_slot = process.current();
    let caller_pid = process.get_pid(caller_slot);
    process.set_parent_pid(child_slot, caller_pid);
    
    // Duplicate FDs
    duplicate_fd_table(caller_slot, child_slot);
    
    return process.get_pid(child_slot);
}

// =============================================================================
// sys_ps — Enumerate running processes (SYS_PS, num=16)
// =============================================================================
fn sys_ps(buf_ptr: u64) -> u64 {
    if !is_valid_user_ptr(buf_ptr, (1 + MAX_PROCS * 2) * 8) {
        return 0;
    }
    let phys = kernel.core.pmm.alloc();
    if phys == 0 { return 0; }
    let kern_va = kernel.core.memory.phys_to_virt_raw(phys);
    let p = kern_va as Ptr<u64>;
    let count = process.get_count();
    p.write(count);
    let mut slot: u64 = 0;
    let mut idx: u64 = 0;
    while slot < MAX_PROCS {
        let state = process.get_state(slot);
        if state != PROC_FREE {
            let pid = process.get_pid(slot);
            let base = 1 + idx * 2;
            p.offset(base as i64).write(pid);
            p.offset((base + 1) as i64).write(state);
            idx = idx + 1;
        }
        slot = slot + 1;
    }
    copy_to_user(buf_ptr, kern_va, (1 + idx * 2) * 8);
    kernel.core.pmm.free(phys);
    return idx;
}

// =============================================================================
// sys_meminfo — Physical memory statistics (SYS_MEMINFO, num=17)
// =============================================================================
fn sys_meminfo(buf_ptr: u64) -> u64 {
    if !is_valid_user_ptr(buf_ptr, 24) {
        return 0 - 1;
    }
    let phys = kernel.core.pmm.alloc();
    if phys == 0 { return 0 - 1; }
    let kern_va = kernel.core.memory.phys_to_virt_raw(phys);
    let p = kern_va as Ptr<u64>;
    let total = kernel.core.pmm.get_total_pages();
    let free = kernel.core.pmm.available_total();
    let used = total - free;
    p.write(total);
    p.offset(1).write(free);
    p.offset(2).write(used);
    copy_to_user(buf_ptr, kern_va, 24);
    kernel.core.pmm.free(phys);
    return 0;
}

// =============================================================================
// sys_uptime — Monotonic tick count since boot (SYS_UPTIME, num=18)
// =============================================================================
fn sys_uptime() -> u64 {
    return pulse.get_tick();
}

// =============================================================================
// sys_getpid — Return PID of the calling process (SYS_GETPID, num=19)
// =============================================================================
fn sys_getpid() -> u64 {
    return process.current();
}

// =============================================================================
// sys_ping — Send ICMP Echo Request and wait for reply (SYS_PING, num=20)
// =============================================================================
extern fn netcore_send_icmp_request(dst_ip: u32) -> bool;
extern fn netcore_icmp_reply_received() -> u32;
extern fn netcore_clear_icmp_reply();
extern fn netcore_poll_all() -> u32;

fn sys_ping(dst_ip: u32) -> u64 {
    netcore_clear_icmp_reply();
    if !netcore_send_icmp_request(dst_ip) {
        return 0;  // send failed
    }

    // Poll for reply with timeout (~3 seconds at 100 ticks/sec)
    let mut waited: u64 = 0;
    while waited < 300 {
        netcore_poll_all();
        let reply_ip = netcore_icmp_reply_received();
        if reply_ip != 0 {
            return waited * 10;  // ticks → ms (100 Hz = 10ms per tick)
        }
        // Busy-wait one tick
        let mut spin: u64 = 0;
        while spin < 50000 { spin = spin + 1; }
        waited = waited + 1;
    }
    return 0;  // timeout
}

// =============================================================================
// sys_tcp_connect — TCP active open (SYS_TCP_CONNECT, num=21)
// =============================================================================
extern fn tcp_client_connect(dst_ip: u32, dst_port: u16) -> u64;

fn sys_tcp_connect(dst_ip: u32) -> u64 {
    return tcp_client_connect(dst_ip, 8080);
}

// =============================================================================
// sys_tcp_send — TCP send data (SYS_TCP_SEND, num=22)
// =============================================================================
extern fn tcp_send_data(conn_id: u64, buf: u64, len: u64) -> u64;

fn sys_tcp_send(conn_id: u64, buf: u64, len: u64) -> u64 {
    if !is_valid_user_ptr(buf, len) { return 0; }
    return tcp_send_data(conn_id, buf, len);
}

// =============================================================================
// sys_tcp_recv — TCP receive data (SYS_TCP_RECV, num=23)
// Blocks until data arrives or FIN is received.
// =============================================================================
extern fn tcp_recv_data(conn_id: u64, buf: u64, len: u64) -> u64;

fn sys_tcp_recv(conn_id: u64, buf: u64, len: u64) -> u64 {
    if !is_valid_user_ptr(buf, len) { return 0; }
    // Drain loopback before checking — data may be queued from sender
    let _ = netcore_poll_all();
    return tcp_recv_data(conn_id, buf, len);
}

// =============================================================================
// sys_tcp_close — TCP close connection (SYS_TCP_CLOSE, num=24)
// =============================================================================
extern fn tcp_close_conn(conn_id: u64);

fn sys_tcp_close(conn_id: u64) {
    tcp_close_conn(conn_id);
}

// =============================================================================
// sys_tcp_listen — TCP passive open (SYS_TCP_LISTEN, num=25)
// =============================================================================
extern fn tcp_listen_extern(port: u16, owner_pid: u64) -> u64;
extern fn tcp_accept_extern(slot: u64) -> u64;

fn sys_tcp_listen(port: u16) -> u64 {
    let slot = process.current();
    let r = tcp_listen_extern(port, slot);
    return r;
}

fn sys_tcp_accept(listen_slot: u64) -> u64 {
    let mut result = tcp_accept_extern(listen_slot);
    while result == 0xFFFFFFFFFFFFFFFF {
        // No pending connection — block until sched_wake_accept wakes us
        let slot = process.current();
        process.set_ipc_msg(slot, 0, listen_slot, 0, 0);
        process.set_state(slot, PROC_BLOCKED_ACCEPT);
        schedule_next();
        // When we return here, we've been woken — re-check
        result = tcp_accept_extern(listen_slot);
    }
    return result;
}
