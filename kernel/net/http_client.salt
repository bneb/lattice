// =============================================================================
// kernel/net/http_client.salt — Simple HTTP GET via TCP
// =============================================================================

package kernel.net.http_client

import kernel.drivers.serial
import kernel.drivers.virtio_net
import kernel.net.eth
import kernel.net.ip
import kernel.net.arp
import kernel.net.netd_tcp_parse
import kernel.core.pmm
import kernel.core.memory

const FLAG_SYN: u16 = 0x0002;
const FLAG_ACK: u16 = 0x0010;
const FLAG_PSH: u16 = 0x0008;
const OUR_IP: u32 = 0x0A00020F;

global HTTP_RESP_RECEIVED: bool = false;
global HTTP_ROUND: u64 = 0;

// =============================================================================
// send_tcp_pkt — Build and transmit a TCP segment
// =============================================================================
fn send_tcp_pkt(dst_ip: u32, src_port: u16, dst_port: u16,
                seq_num: u32, ack_num: u32, flags: u16,
                payload: u64, payload_len: u32) {
    let pkt_phys = pmm.alloc();
    if pkt_phys == 0 { return; }
    let pkt = memory.phys_to_virt_raw(pkt_phys);

    let m = virtio_net.get_mac();
    let our_mac: [u8; 6] = [m[0], m[1], m[2], m[3], m[4], m[5]];

    let mut dst_mac: [u8; 6] = [0xFF as u8; 6];
    let mut arp_buf: [u8; 6] = [0; 6];
    if arp.arp_lookup(dst_ip, &mut arp_buf) { dst_mac = arp_buf; }

    let eth_sz = eth.eth_build(pkt, dst_mac, our_mac, 0x0800);
    let ip_sz = ip.ip_build(pkt + eth_sz as u64, OUR_IP, dst_ip, 6, (20 + payload_len) as u16);
    let tcp = pkt + eth_sz as u64 + ip_sz as u64;

    netd_tcp_parse.build_tcp(tcp, src_port, dst_port, seq_num, ack_num, flags, 8192);

    if payload_len > 0 && payload != 0 {
        let mut pi: u32 = 0;
        while pi < payload_len {
            *((tcp + 20 + pi as u64) as &mut u8) = *((payload + pi as u64) as &u8);
            pi = pi + 1;
        }
    }

    let csum = netd_tcp_parse.tcp_checksum(tcp, 20, payload_len, OUR_IP, dst_ip);
    *((tcp + 16) as &mut u8) = (csum >> 8) as u8;
    *((tcp + 17) as &mut u8) = (csum & 0xFF) as u8;

    let total = eth_sz + ip_sz + 20 + payload_len;
    virtio_net.net_tx_send(pkt, total);
    pmm.free(pkt_phys);
}

// =============================================================================
// handle_incoming — Called from netcore for each TCP packet
// =============================================================================
@no_mangle
pub fn http_handle_incoming(buf: u64, len: u32, src_ip: u32, dst_ip: u32) -> bool {
    if len < 20 { return false; }
    let tcp = netd_tcp_parse.parse_tcp(buf, len as u64);
    let flags = tcp.flags;

    // SYN-ACK from server
    if (flags & (FLAG_SYN | FLAG_ACK)) == (FLAG_SYN | FLAG_ACK) {
        if tcp.src_port == 80 && tcp.dst_port == 42069 {
            send_tcp_pkt(src_ip, 42069, 80, tcp.ack_num, tcp.seq_num + 1,
                         FLAG_ACK, 0, 0);
            serial.print("[HTTP] Handshake complete\n");
            return true;
        }
    }

    // Data from server
    if (flags & FLAG_ACK) != 0 && tcp.src_port == 80 && tcp.dst_port == 42069 {
        let data_off = (tcp.data_offset as u32) * 4;
        if len > data_off {
            HTTP_RESP_RECEIVED = true;
            HTTP_ROUND = HTTP_ROUND + 1;
        }
        return true;
    }

    return false;
}

// =============================================================================
// poll_loop — Spin-poll the network for incoming packets
// =============================================================================
fn poll_loop(max_wait: u64) {
    let mut waited: u64 = 0;
    while waited < max_wait {
        netcore_poll_all();
        if HTTP_RESP_RECEIVED { break; }
        let mut spin: u64 = 0;
        while spin < 50000 { spin = spin + 1; }
        waited = waited + 1;
    }
}

extern fn netcore_poll_all() -> u32;

// =============================================================================
// http_get — Full HTTP GET request with TCP handshake
// =============================================================================
@no_mangle
pub fn http_get(dst_ip: u32, dst_port: u16) -> u32 {
    let client_isn: u32 = 0xB00BFACE;
    HTTP_RESP_RECEIVED = false;

    serial.print("[HTTP] Sending SYN to ");
    serial.print_u64(dst_ip as u64);
    serial.print(":");
    serial.print_u64(dst_port as u64);
    serial.print("\n");

    // Send SYN
    send_tcp_pkt(dst_ip, 42069, dst_port, client_isn, 0, FLAG_SYN, 0, 0);
    serial.print("[HTTP] SYN sent, polling...\n");

    // Poll for handshake (short timeout — QEMU SLIRP responds quickly for ICMP)
    poll_loop(50);

    // Send HTTP GET request
    let req: [u8; 53] = [
        71,69,84,32,47,32,72,84,84,80,47,49,46,48,13,10,
        72,111,115,116,58,32,49,48,46,48,46,50,46,50,13,10,
        67,111,110,110,101,99,116,105,111,110,58,32,99,108,111,115,101,13,10,13,10,
    ];
    send_tcp_pkt(dst_ip, 42069, dst_port, client_isn + 1, 0,
                 FLAG_ACK | FLAG_PSH, (&req) as u64, 53);

    // Poll for response
    poll_loop(80);

    if HTTP_RESP_RECEIVED { return 1; }
    return 0;
}
