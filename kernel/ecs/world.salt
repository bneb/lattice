package kernel.ecs.world

import kernel.ecs.entity.{Entity, EntityAllocator, new_entity_allocator}
import kernel.ecs.sparse_set.SparseSet

pub struct MemoryMap {
    pub size: u64,
    pub pml4_phys: u64,
}

pub struct SchedulingPriority {
    pub level: u32,
    pub tickets: u32,
}

pub struct ThreadState {
    pub status: u32,
    pub stack_ptr: u64,
}

pub struct World {
    pub alloc: EntityAllocator,
    pub mem_maps: SparseSet<MemoryMap>,
    pub priorities: SparseSet<SchedulingPriority>,
    pub threads: SparseSet<ThreadState>,
}

pub fn new_world() -> World {
    return World {
        alloc: new_entity_allocator(),
        mem_maps: SparseSet::<MemoryMap>::new(),
        priorities: SparseSet::<SchedulingPriority>::new(),
        threads: SparseSet::<ThreadState>::new(),
    };
}
