package kernel.ecs.entity

pub struct Entity {
    pub id: u32,
    pub gen: u32,
}

pub const MAX_ENTITIES: u32 = 65536;

pub struct EntityAllocator {
    pub generations: [u32; 65536],
    pub free_indices: [u32; 65536],
    pub free_count: u32,
    pub next_fresh_id: u32,
}

pub fn new_entity_allocator() -> EntityAllocator {
    return EntityAllocator {
        generations: [0; 65536],
        free_indices: [0; 65536],
        free_count: 0,
        next_fresh_id: 0,
    };
}

impl EntityAllocator {
    pub fn allocate(self: &mut EntityAllocator) -> Entity {
        if self.free_count > 0 {
            self.free_count = self.free_count - 1;
            let id = self.free_indices[self.free_count as usize];
            return Entity { id: id, gen: self.generations[id as usize] };
        }
        
        let id = self.next_fresh_id;
        if id >= MAX_ENTITIES {
            return Entity { id: 0xFFFFFFFF, gen: 0 };
        }
        self.next_fresh_id = self.next_fresh_id + 1;
        return Entity { id: id, gen: self.generations[id as usize] };
    }
    
    pub fn free(self: &mut EntityAllocator, e: Entity) {
        if e.id < MAX_ENTITIES && self.generations[e.id as usize] == e.gen {
            self.generations[e.id as usize] = self.generations[e.id as usize] + 1;
            self.free_indices[self.free_count as usize] = e.id;
            self.free_count = self.free_count + 1;
        }
    }
}
