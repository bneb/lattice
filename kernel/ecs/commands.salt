package kernel.ecs.commands

import kernel.ecs.world.World
import kernel.ecs.components.{SchedulingPriority, MemoryMap, ThreadState}
import kernel.ecs.entity.{Entity, entity_allocator_allocate}
import kernel.ecs.sparse_set.{thread_set_insert, priority_set_insert}

pub const CMD_SPAWN_THREAD: u32 = 1;
pub const CMD_UPDATE_PRIORITY: u32 = 2;

pub struct Command {
    pub cmd_type: u32,
    pub target: Entity,
    pub priority: SchedulingPriority,
    pub mem_map: MemoryMap,
    pub thread_state: ThreadState,
}

pub struct Commands {
    pub buffer: [Command; 1024],
    pub count: u32,
}

extern fn malloc(size: i64) -> u64;

pub fn new_commands() -> Ptr<Commands> {
    let ptr = malloc(32784) as Ptr<Commands>; // ~32KB for the struct
    let cmd_ptr = ptr[0] as &mut Commands;
    cmd_ptr.count = 0;
    
    // Initialize the first element just in case
    cmd_ptr.buffer[0] = Command { 
        cmd_type: 0, 
        target: Entity { id: 0, gen: 0 }, 
        priority: SchedulingPriority { level: 0, tickets: 0 }, 
        mem_map: MemoryMap { size: 0, pml4_phys: 0 }, 
        thread_state: ThreadState { status: 0, stack_ptr: 0 } 
    };
    
    return ptr;
}

impl Commands {
    pub fn push(self: &mut Commands, cmd: Command) {
        if self.count < 1024 {
            self.buffer[self.count as i64] = cmd;
            self.count = self.count + 1;
        }
    }
    
    pub fn apply(self: &mut Commands, w_ptr: Ptr<World>) {
        let w = w_ptr[0];
        let mut i: u32 = 0;
        while i < self.count {
            let cmd = self.buffer[i as i64];
            if cmd.cmd_type == CMD_SPAWN_THREAD {
                let e = entity_allocator_allocate(w.alloc);
                thread_set_insert(w.threads, e, cmd.thread_state);
                priority_set_insert(w.priorities, e, cmd.priority);
            } else if cmd.cmd_type == CMD_UPDATE_PRIORITY {
                priority_set_insert(w.priorities, cmd.target, cmd.priority);
            }
            i = i + 1;
        }
        self.count = 0;
    }
}
