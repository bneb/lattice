package kernel.ecs.sparse_set

import kernel.ecs.entity.{Entity, MAX_ENTITIES}
import std.core.mem.size_of

extern fn malloc(size: i64) -> u64;

pub struct SparseSet<T> {
    pub dense: Ptr<T>,
    pub sparse: Ptr<u32>,
    pub entity_map: Ptr<Entity>,
    pub count: u32,
}

impl SparseSet<T> {
    pub fn new() -> SparseSet<T> {
        let t_size = size_of::<T>();
        let ent_size = size_of::<Entity>();
        
        let dense_ptr = malloc((MAX_ENTITIES as i64) * t_size) as Ptr<T>;
        let sparse_ptr = malloc((MAX_ENTITIES as i64) * 4) as Ptr<u32>;
        let emap_ptr = malloc((MAX_ENTITIES as i64) * ent_size) as Ptr<Entity>;
        
        // Initialize sparse array with u32::MAX
        let mut i: u32 = 0;
        while i < MAX_ENTITIES {
            sparse_ptr[i as i64] = 0xFFFFFFFF;
            i = i + 1;
        }
        
        return SparseSet::<T> {
            dense: dense_ptr,
            sparse: sparse_ptr,
            entity_map: emap_ptr,
            count: 0,
        };
    }

    pub fn insert(self: &mut SparseSet<T>, entity: Entity, component: T) {
        if entity.id >= MAX_ENTITIES { return; }
        
        let existing = self.sparse[entity.id as i64];
        if existing != 0xFFFFFFFF {
            // Check if generation matches
            if self.entity_map[existing as i64].gen == entity.gen {
                self.dense[existing as i64] = component;
                return;
            }
        }
        
        let c = self.count;
        if c >= MAX_ENTITIES { return; }
        
        self.dense[c as i64] = component;
        self.entity_map[c as i64] = entity;
        self.sparse[entity.id as i64] = c;
        self.count = c + 1;
    }
    
    pub fn get(self: &SparseSet<T>, entity: Entity) -> Ptr<T> {
        if entity.id >= MAX_ENTITIES { return 0 as Ptr<T>; }
        
        let dense_idx = self.sparse[entity.id as i64];
        if dense_idx != 0xFFFFFFFF {
            if self.entity_map[dense_idx as i64].gen == entity.gen {
                return self.dense.offset(dense_idx as i64);
            }
        }
        return 0 as Ptr<T>;
    }
    
    pub fn get_mut(self: &mut SparseSet<T>, entity: Entity) -> Ptr<T> {
        if entity.id >= MAX_ENTITIES { return 0 as Ptr<T>; }
        
        let dense_idx = self.sparse[entity.id as i64];
        if dense_idx != 0xFFFFFFFF {
            if self.entity_map[dense_idx as i64].gen == entity.gen {
                return self.dense.offset(dense_idx as i64);
            }
        }
        return 0 as Ptr<T>;
    }
    
    pub fn remove(self: &mut SparseSet<T>, entity: Entity) {
        if entity.id >= MAX_ENTITIES { return; }
        
        let dense_idx = self.sparse[entity.id as i64];
        if dense_idx != 0xFFFFFFFF {
            if self.entity_map[dense_idx as i64].gen == entity.gen {
                // Swap and pop
                let last_idx = self.count - 1;
                let last_entity = self.entity_map[last_idx as i64];
                
                self.dense[dense_idx as i64] = self.dense[last_idx as i64];
                self.entity_map[dense_idx as i64] = last_entity;
                self.sparse[last_entity.id as i64] = dense_idx;
                
                self.sparse[entity.id as i64] = 0xFFFFFFFF;
                self.count = last_idx;
            }
        }
    }
}
