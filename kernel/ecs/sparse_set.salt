package kernel.ecs.sparse_set

import kernel.ecs.entity.{Entity, MAX_ENTITIES}
import std.core.mem.size_of
import kernel.drivers.serial
import kernel.ecs.components.{ThreadState, SchedulingPriority}

extern fn malloc(size: i64) -> u64;

pub struct ThreadSparseSet {
    pub dense: Ptr<ThreadState>,
    pub sparse: Ptr<u32>,
    pub entity_map: Ptr<Entity>,
    pub count: u32,
}

pub fn new_thread_set() -> Ptr<ThreadSparseSet> {
    let t_size = size_of::<ThreadState>();
    let d_ptr = malloc((MAX_ENTITIES as i64) * t_size) as Ptr<ThreadState>;
    let s_ptr = malloc((MAX_ENTITIES as i64) * 4) as Ptr<u32>;
    let e_ptr = malloc((MAX_ENTITIES as i64) * 8) as Ptr<Entity>;
    
    let mut i: u32 = 0;
    while i < MAX_ENTITIES {
        s_ptr[i as i64] = 0xFFFFFFFF;
        i = i + 1;
    }
    
    let p = malloc(32) as Ptr<ThreadSparseSet>;
    p[0] = ThreadSparseSet { dense: d_ptr, sparse: s_ptr, entity_map: e_ptr, count: 0 };
    return p;
}

pub fn thread_set_insert(set: Ptr<ThreadSparseSet>, entity: Entity, component: ThreadState) {
    let sid = entity.id;
    if sid >= MAX_ENTITIES { return; }
    let s_ptr = set[0].sparse;
    let existing = s_ptr[sid as i64];
    if existing != 0xFFFFFFFF {
        set[0].dense[existing as i64] = component;
        set[0].entity_map[existing as i64] = entity;
        return;
    }
    let c = set[0].count;
    if c >= MAX_ENTITIES { return; }
    set[0].dense[c as i64] = component;
    set[0].entity_map[c as i64] = entity;
    s_ptr[sid as i64] = c;
    set[0].count = c + 1;
}

pub fn thread_set_get_mut(set: Ptr<ThreadSparseSet>, entity: Entity) -> Ptr<ThreadState> {
    let sid = entity.id;
    if sid >= MAX_ENTITIES { return 0 as Ptr<ThreadState>; }
    let dense_idx = set[0].sparse[sid as i64];
    if dense_idx != 0xFFFFFFFF {
        if set[0].entity_map[dense_idx as i64].gen == entity.gen {
            return set[0].dense.offset(dense_idx as i64);
        }
    }
    return 0 as Ptr<ThreadState>;
}

pub struct PrioritySparseSet {
    pub dense: Ptr<SchedulingPriority>,
    pub sparse: Ptr<u32>,
    pub entity_map: Ptr<Entity>,
    pub count: u32,
}

pub fn new_priority_set() -> Ptr<PrioritySparseSet> {
    let t_size = size_of::<SchedulingPriority>();
    let d_ptr = malloc((MAX_ENTITIES as i64) * t_size) as Ptr<SchedulingPriority>;
    let s_ptr = malloc((MAX_ENTITIES as i64) * 4) as Ptr<u32>;
    let e_ptr = malloc((MAX_ENTITIES as i64) * 8) as Ptr<Entity>;
    
    let mut i: u32 = 0;
    while i < MAX_ENTITIES {
        s_ptr[i as i64] = 0xFFFFFFFF;
        i = i + 1;
    }
    
    let p = malloc(32) as Ptr<PrioritySparseSet>;
    p[0] = PrioritySparseSet { dense: d_ptr, sparse: s_ptr, entity_map: e_ptr, count: 0 };
    return p;
}

pub fn priority_set_insert(set: Ptr<PrioritySparseSet>, entity: Entity, component: SchedulingPriority) {
    let sid = entity.id;
    if sid >= MAX_ENTITIES { return; }
    let s_ptr = set[0].sparse;
    let existing = s_ptr[sid as i64];
    if existing != 0xFFFFFFFF {
        set[0].dense[existing as i64] = component;
        set[0].entity_map[existing as i64] = entity;
        return;
    }
    let c = set[0].count;
    if c >= MAX_ENTITIES { return; }
    set[0].dense[c as i64] = component;
    set[0].entity_map[c as i64] = entity;
    s_ptr[sid as i64] = c;
    set[0].count = c + 1;
}

pub fn priority_set_get(set: Ptr<PrioritySparseSet>, entity: Entity) -> Ptr<SchedulingPriority> {
    let sid = entity.id;
    if sid >= MAX_ENTITIES { return 0 as Ptr<SchedulingPriority>; }
    let dense_idx = set[0].sparse[sid as i64];
    if dense_idx != 0xFFFFFFFF {
        if set[0].entity_map[dense_idx as i64].gen == entity.gen {
            return set[0].dense.offset(dense_idx as i64);
        }
    }
    return 0 as Ptr<SchedulingPriority>;
}
