}

pub fn new_perf_counters_set() -> Ptr<PerfCountersSparseSet> {
    let t_size = size_of::<PerfCounters>();
    let d_ptr = malloc((MAX_ENTITIES as i64) * t_size) as Ptr<PerfCounters>;
    let s_ptr = malloc((MAX_ENTITIES as i64) * 4) as Ptr<u32>;
    let e_ptr = malloc((MAX_ENTITIES as i64) * 8) as Ptr<Entity>;
    
    let mut i: u32 = 0;
    while i < MAX_ENTITIES {
        (*(( (s_ptr as u64) + (i as u64) * 4 ) as &mut u32)) = 0xFFFFFFFF;
        i = i + 1;
    }
    
    let p = malloc(size_of::<PerfCountersSparseSet>() as i64) as Ptr<PerfCountersSparseSet>;
