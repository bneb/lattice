// =============================================================================
// kernel/mem/slab.salt
// Sovereign Slab Allocator for Fiber Stacks — ABA-Proof Lock-Free Treiber Stack
// =============================================================================
//
// Two-phase O(1) allocator:
//   1. Fast path: Pop from a lock-free Treiber stack of recycled slots.
//   2. Fallback:  Atomic bump allocate from the virgin slab region.
//
// ABA Protection:
//   On x86_64, virtual addresses use only the bottom 48 bits. We pack a
//   16-bit generation counter into bits 48-63 of the FREE_STACK_HEAD pointer.
//   This allows a standard 64-bit cmpxchg (lock cmpxchgq) while remaining
//   100% ABA-proof without needing cmpxchg16b.
//
// Memory layout:
//   SLAB_BASE (0xFFFFFFFF90000000)
//   ├── Slot 0:  [next_packed_ptr | 16KB stack space]
//   ├── Slot 1:  [next_packed_ptr | 16KB stack space]
//   └── ...
//   └── Slot 10239
//
// Invariants (verified by slab_reclaim_bench):
//   - pop_stack returns addresses aligned to SLOT_SIZE (16KB)
//   - push_stack only accepts addresses within the slab region
//   - FRESH_ALLOC_COUNT plateaus once recycling kicks in
// =============================================================================

package kernel.mem

use kernel.drivers.serial

// Constants derived from kernel/mem/mm_layout.salt (single source of truth).
const SLAB_BASE: u64 = 0xFFFFFFFF90000000;
const SLOT_SIZE: u64 = 16384;
const MAX_SLOTS: i32 = 10240;
const SLAB_END: u64  = 0xFFFFFFFF9A000000;

// Mask for the 48-bit address portion of a packed pointer.
const ADDR_MASK: u64 = 0x0000FFFFFFFFFFFF;

// =============================================================================
// Packed Pointer Helpers
// =============================================================================
// Bits 0-47:  Memory address (the actual pointer)
// Bits 48-63: Generation counter (prevents the ABA problem)

fn get_ptr(packed: u64) -> u64 { return packed & ADDR_MASK; }
fn get_gen(packed: u64) -> u64 { return packed >> 48; }
fn pack(ptr: u64, gen: u64) -> u64 { return (ptr & ADDR_MASK) | (gen << 48); }

// =============================================================================
// Global State
// =============================================================================

// Head of the Treiber stack. Packed: [16-bit gen | 48-bit addr].
// Zero means the free-list is empty.
pub global FREE_STACK_HEAD: u64 = 0;

// Fresh allocation counter — high-water mark of virgin slot consumption.
// Atomic for SMP safety on the bump allocator.
pub global FRESH_ALLOC_COUNT: Atomic<i32> = 0;

// =============================================================================
// pop_stack — O(1) Lock-Free Stack Allocation
// =============================================================================
// Returns the BASE address of a 16KB slot, or 0 if exhausted.
// Phase 1: Try the recycle free-list (CAS pop with ABA protection).
// Phase 2: Fall back to atomic bump allocation from virgin region.
// =============================================================================
@no_mangle
pub fn pop_stack() -> u64 {
    // Phase 1: Try recycle free-list
    loop {
        let current_packed = FREE_STACK_HEAD;
        let current_ptr = get_ptr(current_packed);
        let current_gen = get_gen(current_packed);

        // Empty free-list — fall through to bump allocator
        if current_ptr == 0 {
            // Phase 2: Atomic bump allocate a virgin slot
            let idx = FRESH_ALLOC_COUNT.fetch_add(1);
            if idx >= MAX_SLOTS {
                serial.print("SLAB EXHAUSTED\n");
                return 0;
            }
            return SLAB_BASE + ((idx as u64) * SLOT_SIZE);
        }

        // Read the next packed pointer from first 8 bytes of the head block
        let link = current_ptr as &u64;
        let next_ptr = get_ptr(link[0]);

        // Create new state: next pointer with incremented generation
        let new_packed = pack(next_ptr, current_gen + 1);

        // Hardware CAS: Attempt to swing head from current to next
        let (old, success) = cmpxchg(&FREE_STACK_HEAD, current_packed, new_packed);
        if success {
            return current_ptr;
        }
        // CAS failed (concurrent modification) — retry
    }

    return 0;
}

// =============================================================================
// push_stack — O(1) Lock-Free Stack Reclamation
// =============================================================================
// Returns a 16KB slot to the recycle free-list. Uses the first 8 bytes
// of the freed block to store the next pointer in the LIFO chain.
// =============================================================================
@no_mangle
pub fn push_stack(ptr: u64) {
    // Defensive: reject null or out-of-range addresses
    if ptr == 0 {
        return;
    }
    if ptr < SLAB_BASE {
        return;
    }
    if ptr >= SLAB_END {
        return;
    }

    let link = ptr as &mut u64;

    loop {
        // Snapshot current head
        let current_packed = FREE_STACK_HEAD;
        let current_ptr = get_ptr(current_packed);
        let current_gen = get_gen(current_packed);

        // Chain the freed block to the current head
        link[0] = current_ptr;

        // Create new state: this block as head with incremented generation
        let new_packed = pack(ptr, current_gen + 1);

        // Hardware CAS: Attempt to swing head to this block
        let (old, success) = cmpxchg(&FREE_STACK_HEAD, current_packed, new_packed);
        if success {
            return;
        }
        // CAS failed — retry
    }
}

// =============================================================================
// slab_watermark — Diagnostic: fresh allocation count
// =============================================================================
// Returns the total number of fresh (bump) allocations made.
// If push/pop recycling works, this number plateaus after generation 1.
// =============================================================================
@no_mangle
pub fn slab_watermark() -> i32 {
    // Atomic load via fetch_add(0) identity — returns current value
    return FRESH_ALLOC_COUNT.fetch_add(0);
}
