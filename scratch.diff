+@no_mangle
+pub fn sys_layout_solve_matrix() {
+    let limit = dom.get_dom_node_count();
+    let mut style_i: u64 = 1;
+    while style_i < limit {
+        if dom.DIRTY_STYLE[style_i as usize] == 1 {
+            recompute_style(style_i as u32);
+        }
+        style_i = style_i + 1;
+    }
+    user.browser.transpiler.transpile_dom_tree(1);
+    apply_cascade_to_tree(); 
+    layout_tree(); 
+    sys_jsc_flush_microtasks();
+}
