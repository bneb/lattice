// =============================================================================
// test_std_io_ring.salt — End-to-End Test for std.io.ring
// =============================================================================
//
// Tests the user-facing IoRing stdlib API:
//   1. IoRing::map() to allocate the ring
//   2. SQE::nop() and ring.submit() to push submissions
//   3. ring.flush() to trigger kernel drain
//   4. ring.reap() to pop completions
//   5. Convenience methods (write, nop)
//   6. sq_available() and has_completions() queries
//
// This test validates that the stdlib wrapper correctly abstracts
// the raw ring-buffer ABI pointer arithmetic.
// =============================================================================

package main

use std.io.ring.{IoRing, SQE, CQE}

fn main() -> i32 {
    println("=== std.io.ring Test ===");

    // --- Test 1: IoRing::map ---
    let mut ring = IoRing::map();
    if !ring.is_valid() {
        println("FAIL: IoRing::map returned invalid ring");
        return 1;
    }
    println("  map OK");

    // --- Test 2: Check initial state ---
    let avail = ring.sq_available();
    if avail != ring.capacity {
        println("FAIL: sq_available should equal capacity initially");
        return 2;
    }
    if ring.has_completions() {
        println("FAIL: should have no completions initially");
        return 3;
    }
    println("  initial state OK");

    // --- Test 3: Submit a NOP via SQE::nop ---
    let sqe = SQE::nop(42);
    let ok = ring.submit(sqe);
    if !ok {
        println("FAIL: submit NOP");
        return 4;
    }
    // Available should decrease by 1
    let avail2 = ring.sq_available();
    if avail2 != ring.capacity - 1 {
        println("FAIL: sq_available should decrease after submit");
        return 5;
    }
    println("  submit NOP OK");

    // --- Test 4: Flush and reap ---
    ring.flush();
    if !ring.has_completions() {
        println("FAIL: should have completions after flush");
        return 6;
    }
    let cqe = ring.reap();
    if cqe.user_data != 42 {
        println("FAIL: CQE user_data mismatch");
        return 7;
    }
    if cqe.result != 0 {
        println("FAIL: CQE result should be 0 for NOP");
        return 8;
    }
    println("  reap NOP OK");

    // --- Test 5: Verify CQ is empty after consuming ---
    if ring.has_completions() {
        println("FAIL: CQ should be empty after reap");
        return 9;
    }
    let empty_cqe = ring.reap();
    if empty_cqe.user_data != 0xFFFFFFFFFFFFFFFF {
        println("FAIL: reap on empty CQ should return sentinel");
        return 10;
    }
    println("  empty reap OK");

    // --- Test 6: Batch submit via convenience method ---
    let mut i: u64 = 0;
    while i < 5 {
        let ok2 = ring.nop(100 + i);
        if !ok2 {
            println("FAIL: batch nop");
            return 11;
        }
        i = i + 1;
    }
    ring.flush();

    let mut count: u64 = 0;
    while ring.has_completions() {
        let c = ring.reap();
        if c.user_data < 100 || c.user_data > 104 {
            println("FAIL: unexpected user_data in batch");
            return 12;
        }
        count = count + 1;
    }
    if count != 5 {
        println("FAIL: expected 5 completions from batch");
        return 13;
    }
    println("  batch submit OK");

    // --- Test 7: SQE::write convenience ---
    let write_sqe = SQE::write(1, 0, 0, 777);
    let ok3 = ring.submit(write_sqe);
    if !ok3 {
        println("FAIL: submit write SQE");
        return 14;
    }
    ring.flush();
    let w_cqe = ring.reap();
    if w_cqe.user_data != 777 {
        println("FAIL: write CQE user_data mismatch");
        return 15;
    }
    println("  write submit OK");

    // --- Test 8: SQE::brk convenience ---
    let brk_sqe = SQE::brk(0, 888);
    let ok4 = ring.submit(brk_sqe);
    if !ok4 {
        println("FAIL: submit brk SQE");
        return 16;
    }
    ring.flush();
    let b_cqe = ring.reap();
    if b_cqe.user_data != 888 {
        println("FAIL: brk CQE user_data mismatch");
        return 17;
    }
    println("  brk submit OK");

    // --- Test 9: submit_and_flush convenience ---
    let ok5 = ring.submit_and_flush(SQE::nop(999));
    if !ok5 {
        println("FAIL: submit_and_flush");
        return 18;
    }
    let final_cqe = ring.reap();
    if final_cqe.user_data != 999 {
        println("FAIL: submit_and_flush CQE mismatch");
        return 19;
    }
    println("  submit_and_flush OK");

    println("SUCCESS!");
    return 0;
}
