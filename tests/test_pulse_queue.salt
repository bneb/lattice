// =============================================================================
// tests/test_pulse_queue.salt (Standalone)
// TDD Tests: PulseEvent Ring Buffer Behavioral Contracts
// =============================================================================
//
// Validates SPSC ring buffer: push, pop, overflow, is_empty, tick.
// Uses a mocked ring buffer in heap memory instead of kernel globals.
//
// Ring buffer mock layout:
//   [0..6144)     RING: 256 events × 24 bytes (3 × u64 per event)
//   [6144..6152)  HEAD (u64) — write position
//   [6152..6160)  TAIL (u64) — read position
//   [6160..6168)  TICK_COUNTER (u64)
//   [6168..6176)  DROP_COUNT (u64)
//
// Exit codes:
//   0  = all passed
//   1  = alloc failure
//   2  = empty pop should return 0
//   3  = push-pop roundtrip failed
//   4  = overflow handling failed
//   5  = is_empty state incorrect
//   6  = tick monotonic increment failed
// =============================================================================

package main

extern fn malloc(size: i64) -> Ptr<u8>;
extern fn free(ptr: u64);

const RING_SIZE: u64 = 256;
const RING_OFFSET:    u64 = 0;
const HEAD_OFFSET:    u64 = 6144;
const TAIL_OFFSET:    u64 = 6152;
const TICK_OFFSET:    u64 = 6160;
const DROP_OFFSET:    u64 = 6168;
const TOTAL_SIZE:     u64 = 6176;

const PULSE_TIMER:    u64 = 1;
const PULSE_KEYBOARD: u64 = 2;

fn pulse_push(ring: u64, event_type: u64, data: u64) -> u64 {
    let head: u64 = *((ring + HEAD_OFFSET) as &u64);
    let tail: u64 = *((ring + TAIL_OFFSET) as &u64);
    let next_head: u64 = (head + 1) % RING_SIZE;

    if next_head == tail {
        // Ring full — drop
        let drops: u64 = *((ring + DROP_OFFSET) as &u64);
        *((ring + DROP_OFFSET) as &mut u64) = drops + 1;
        return 0;
    }

    let base: u64 = ring + RING_OFFSET + head * 24;
    *((base) as &mut u64) = event_type;
    *((base + 8) as &mut u64) = data;
    let tick: u64 = *((ring + TICK_OFFSET) as &u64);
    *((base + 16) as &mut u64) = tick;

    *((ring + HEAD_OFFSET) as &mut u64) = next_head;
    return 1;
}

fn pulse_pop(ring: u64, out_data: u64, out_timestamp: u64) -> u64 {
    let head: u64 = *((ring + HEAD_OFFSET) as &u64);
    let tail: u64 = *((ring + TAIL_OFFSET) as &u64);

    if head == tail { return 0; }

    let base: u64 = ring + RING_OFFSET + tail * 24;
    let event_type: u64 = *((base) as &u64);
    *((out_data) as &mut u64) = *((base + 8) as &u64);
    *((out_timestamp) as &mut u64) = *((base + 16) as &u64);

    *((ring + TAIL_OFFSET) as &mut u64) = (tail + 1) % RING_SIZE;
    return event_type;
}

fn pulse_is_empty(ring: u64) -> bool {
    return *((ring + HEAD_OFFSET) as &u64) == *((ring + TAIL_OFFSET) as &u64);
}

fn pulse_tick(ring: u64) {
    let t: u64 = *((ring + TICK_OFFSET) as &u64);
    *((ring + TICK_OFFSET) as &mut u64) = t + 1;
}

fn pulse_get_tick(ring: u64) -> u64 {
    return *((ring + TICK_OFFSET) as &u64);
}

fn pulse_get_drop_count(ring: u64) -> u64 {
    return *((ring + DROP_OFFSET) as &u64);
}

fn main() -> i32 {
    let ring: u64 = malloc(TOTAL_SIZE as i64);
    if ring == 0 { return 1; }
    let mut zi: u64 = 0;
    while zi < TOTAL_SIZE { *((ring + zi) as &mut u8) = 0; zi = zi + 1; }

    // Allocate out-ptrs
    let out_data: u64 = malloc(8);
    let out_ts: u64 = malloc(8);
    if out_data == 0 || out_ts == 0 { free(ring); return 1; }

    // =========================================================================
    // Test 1: Empty queue pop returns 0
    // =========================================================================
    let et: u64 = pulse_pop(ring, out_data, out_ts);
    if et != 0 { free(ring); free(out_data); free(out_ts); return 2; }

    // =========================================================================
    // Test 2: Push-pop round-trip preserves data
    // =========================================================================
    let r2: u64 = pulse_push(ring, PULSE_TIMER, 42);
    if r2 != 1 { free(ring); free(out_data); free(out_ts); return 3; }

    let et2: u64 = pulse_pop(ring, out_data, out_ts);
    if et2 != PULSE_TIMER { free(ring); free(out_data); free(out_ts); return 3; }
    if *((out_data) as &u64) != 42 { free(ring); free(out_data); free(out_ts); return 3; }

    if !pulse_is_empty(ring) { free(ring); free(out_data); free(out_ts); return 3; }

    // =========================================================================
    // Test 3: Queue overflow drops events gracefully
    // =========================================================================
    let mut i: u64 = 0;
    while i < 255 {
        let r: u64 = pulse_push(ring, PULSE_TIMER, i);
        if r != 1 { free(ring); free(out_data); free(out_ts); return 4; }
        i = i + 1;
    }

    // 256th push should fail
    let overflow: u64 = pulse_push(ring, PULSE_TIMER, 999);
    if overflow != 0 { free(ring); free(out_data); free(out_ts); return 4; }

    if pulse_get_drop_count(ring) == 0 { free(ring); free(out_data); free(out_ts); return 4; }

    // Drain
    while pulse_pop(ring, out_data, out_ts) != 0 { }

    // =========================================================================
    // Test 4: is_empty reflects state
    // =========================================================================
    if !pulse_is_empty(ring) { free(ring); free(out_data); free(out_ts); return 5; }

    pulse_push(ring, PULSE_KEYBOARD, 0x1E);
    if pulse_is_empty(ring) { free(ring); free(out_data); free(out_ts); return 5; }

    pulse_pop(ring, out_data, out_ts);
    if !pulse_is_empty(ring) { free(ring); free(out_data); free(out_ts); return 5; }

    // =========================================================================
    // Test 5: Tick counter increments monotonically
    // =========================================================================
    let before: u64 = pulse_get_tick(ring);
    pulse_tick(ring);
    let after: u64 = pulse_get_tick(ring);
    if after != before + 1 { free(ring); free(out_data); free(out_ts); return 6; }

    pulse_tick(ring);
    pulse_tick(ring);
    let after3: u64 = pulse_get_tick(ring);
    if after3 != before + 3 { free(ring); free(out_data); free(out_ts); return 6; }

    free(ring);
    free(out_data);
    free(out_ts);
    return 0;
}
