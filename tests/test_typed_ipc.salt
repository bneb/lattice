// =============================================================================
// test_typed_ipc.salt — Test Typed IPC over Ring Buffers
// =============================================================================
//
// Tests the std.ipc.typed_channel abstraction:
//   1. IpcMessage construction (all well-known types)
//   2. IpcMessage type queries (is_ping, is_data, etc.)
//   3. TypedChannel::send via ring buffer
//   4. CQE delivery for IPC send results
//   5. Custom message types
//   6. Batch IPC sends
//
// Note: IPC sends will fail at the kernel level (no blocked receiver)
// but the test validates the full user-space → ring → kernel → CQE path.
// =============================================================================

package main

use std.io.ring.{IoRing, SQE, CQE}
use std.ipc.typed_channel.{TypedChannel, IpcMessage, MSG_PING, MSG_PONG, MSG_DATA, MSG_SHUTDOWN, MSG_CUSTOM}

fn main() -> i32 {
    println("=== Typed IPC Test ===");

    // --- Test 1: IpcMessage construction ---
    let ping = IpcMessage::ping(42);
    if ping.msg_type != MSG_PING {
        println("FAIL: ping msg_type");
        return 1;
    }
    if ping.payload_0 != 42 {
        println("FAIL: ping payload_0");
        return 2;
    }
    println("  IpcMessage::ping OK");

    let pong = IpcMessage::pong(42);
    if pong.msg_type != MSG_PONG {
        println("FAIL: pong msg_type");
        return 3;
    }
    println("  IpcMessage::pong OK");

    let data = IpcMessage::data(0x1000, 256);
    if data.msg_type != MSG_DATA {
        println("FAIL: data msg_type");
        return 4;
    }
    if data.payload_0 != 0x1000 || data.payload_1 != 256 {
        println("FAIL: data payloads");
        return 5;
    }
    println("  IpcMessage::data OK");

    let shutdown = IpcMessage::shutdown();
    if shutdown.msg_type != MSG_SHUTDOWN {
        println("FAIL: shutdown msg_type");
        return 6;
    }
    println("  IpcMessage::shutdown OK");

    // --- Test 2: Type queries ---
    if !ping.is_ping() {
        println("FAIL: is_ping");
        return 7;
    }
    if ping.is_pong() {
        println("FAIL: ping should not be pong");
        return 8;
    }
    if !data.is_data() {
        println("FAIL: is_data");
        return 9;
    }
    if !shutdown.is_shutdown() {
        println("FAIL: is_shutdown");
        return 10;
    }
    println("  type queries OK");

    // --- Test 3: Custom message types ---
    let custom = IpcMessage::custom(0xABCD, 100, 200);
    if !custom.is_custom() {
        println("FAIL: is_custom");
        return 11;
    }
    if custom.custom_tag() != 0xABCD {
        println("FAIL: custom_tag");
        return 12;
    }
    if custom.payload_0 != 100 || custom.payload_1 != 200 {
        println("FAIL: custom payloads");
        return 13;
    }
    println("  custom messages OK");

    // --- Test 4: TypedChannel::send via ring buffer ---
    let mut ring = IoRing::map();
    if !ring.is_valid() {
        println("FAIL: ring map");
        return 14;
    }

    let mut ch = TypedChannel::new(&mut ring);

    // Send a ping to pid=15 (will fail at kernel, but exercises the path)
    let ok1 = ch.send(15, IpcMessage::ping(1));
    if !ok1 {
        println("FAIL: TypedChannel send");
        return 15;
    }
    ch.ring.flush();

    // Reap the result — should have user_data=0 (first sequence number)
    let result1 = ch.reap_result();
    if result1.user_data != 0 {
        println("FAIL: first send should have user_data=0");
        return 16;
    }
    // Result will be -1 (target not blocked) — but CQE delivery works
    println("  TypedChannel send OK");

    // --- Test 5: Batch sends ---
    let ok2 = ch.send(15, IpcMessage::ping(2));
    let ok3 = ch.send(15, IpcMessage::data(0x2000, 512));
    let ok4 = ch.send(15, IpcMessage::shutdown());
    if !ok2 || !ok3 || !ok4 {
        println("FAIL: batch send");
        return 17;
    }
    ch.ring.flush();

    // Reap all 3 results
    let mut count: u64 = 0;
    while ch.has_results() {
        let r = ch.reap_result();
        count = count + 1;
    }
    if count != 3 {
        println("FAIL: expected 3 batch results");
        return 18;
    }
    println("  batch sends OK");

    // --- Test 6: pending_sends counter ---
    if ch.pending_sends != 4 {
        println("FAIL: pending_sends should be 4");
        return 19;
    }
    println("  pending_sends counter OK");

    // --- Test 7: send_and_flush convenience ---
    let ok5 = ch.send_and_flush(15, IpcMessage::pong(99));
    if !ok5 {
        println("FAIL: send_and_flush");
        return 20;
    }
    let r5 = ch.reap_result();
    if r5.user_data != 4 {
        println("FAIL: send_and_flush user_data should be 4");
        return 21;
    }
    println("  send_and_flush OK");

    println("SUCCESS!");
    return 0;
}
