package tests.test_js_events

// Link into critical DOM symbols (From dom.salt @no_mangle)
extern fn init_arrays();
extern fn create_node(tag: i32) -> u64;
extern fn resolve_node_by_id(ptr: u64, len: u32) -> u64;
extern fn js_set_id(node_id: u64, id_ptr: u64, id_len: u32);
extern fn js_get_node_executable(node_id: u64) -> u8;
extern fn js_get_class_ptr(node_id: i32) -> u64;
extern fn js_get_class_len(node_id: i32) -> u32;
extern fn js_get_style_w(node_id: u64) -> i32;
extern fn js_get_style_h(node_id: u64) -> i32;
extern fn js_get_style_flex_grow(node_id: u64) -> i32;

// Link into QuickJS bridge (From js_quickjs.salt)
extern fn js_quickjs_eval_string(ptr: u64, len: u32);

// Link into airlock (From airlock.salt @no_mangle)
extern fn airlock_init_allocator();

// Link into JS Dom Bridge (From C side)
extern fn js_init_quickjs();
extern fn js_get_test_script_events(buf: u64);
extern fn js_get_test_script_events_len() -> u32;
extern fn js_bridge_dispatch_event(node_id: u64, type_ptr: u64, type_len: u32);

pub fn main() -> i32 {
    println("--- Phase 5: Event Dispatch & Security Test ---");
    
    airlock_init_allocator();
    init_arrays();
    
    // Create #hero node (TAG_DIV = 4)
    let hero_id = create_node(4);
    let mut hero_str: [u8; 4] = [104, 101, 114, 111]; // "hero"
    js_set_id(hero_id, (&hero_str) as u64, 4);
    
    // Init QuickJS
    js_init_quickjs();
    
    // Load Event Test Script
    let mut script_buf: [u8; 1024] = [0; 1024];
    js_get_test_script_events((&script_buf) as u64);
    let script_len = js_get_test_script_events_len();
    js_quickjs_eval_string((&script_buf) as u64, script_len);
    
    println("[Test] Script evaluated. Dispatching click to #hero...");
    
    // Simulate Hardware Click
    let mut click_type: [u8; 5] = [99, 108, 105, 99, 107]; // "click"
    js_bridge_dispatch_event(hero_id, (&click_type) as u64, 5);
    
    // Check Result: className should be 'clicked'
    let hero_idx = (hero_id & 0xFFFF) as i32;
    let class_ptr = js_get_class_ptr(hero_idx);
    let class_len = js_get_class_len(hero_idx);
    
    if class_len == 7 {
        println("[Test] SUCCESS: 'clicked' class detected on #hero!");
    } else {
        println("[Test] FAILURE: Unexpected class length.");
        return 1;
    }
    
    // Check Security: untrusted node should have executable = 0
    let mut untrusted_str: [u8; 9] = [117, 110, 116, 114, 117, 115, 116, 101, 100]; // "untrusted"
    let untrusted_node = resolve_node_by_id((&untrusted_str) as u64, 9);
    
    if untrusted_node != -1 {
        let can_exec = js_get_node_executable(untrusted_node as u64);
        if can_exec == 0 {
            println("[Test] SUCCESS: Security flag is 0 for untrusted innerHTML node!");
        } else {
            println("[Test] FAILURE: Untrusted node is still executable!");
            return 1;
        }
    } else {
        println("[Test] FAILURE: Could not find untrusted node!");
        return 1;
    }
    
    // Check Dimension / Layout bindings
    println("[Test] Verifying bounds layout via QuickJS...");
    let w = js_get_style_w(hero_id);
    let h = js_get_style_h(hero_id);
    let flex_grow = js_get_style_flex_grow(hero_id);
    if w == 400 && h == 50 && flex_grow == 1 {
        println("[Test] SUCCESS: C-FFI correctly mutated internal size matrices!");
    } else {
        println("[Test] FAILURE: Engine failed to set flex bounds correctly from JS.");
        return 1;
    }
    
    println("--- Test Completed Successfully ---");
    return 0;
}
