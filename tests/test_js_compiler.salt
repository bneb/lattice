// =============================================================================
// Test: zero-allocation exact JavaScript bytecode compilation
// =============================================================================

package tests.test_js_compiler

import user.browser.js_tokens
import user.browser.js_bytecode
import user.browser.js_lexer
import user.browser.js_compiler

@no_mangle
pub fn main() -> i32 {
    let mut source_buf: [u8; 32] = [0; 32];
    source_buf[0] = 0x31; // '1'
    source_buf[1] = 0x30; // '0'
    source_buf[2] = 0x20; // ' '
    source_buf[3] = 0x2B; // '+'
    source_buf[4] = 0x20; // ' '
    source_buf[5] = 0x32; // '2'
    source_buf[6] = 0x30; // '0'
    source_buf[7] = 0x20; // ' '
    source_buf[8] = 0x2A; // '*'
    source_buf[9] = 0x20; // ' '
    source_buf[10] = 0x33; // '3'
    source_buf[11] = 0x30; // '0'
    let source_len: u32 = 12;
    
    let mut bytecode_arena: [u8; 1024] = [0; 1024];
    let mut const_arena: [u8; 1024] = [0; 1024];
    
    let mut state = js_lexer.JsCompilerState {
        source: js_lexer.ByteSpan {
            ptr: (&source_buf) as u64,
            len: source_len,
        },
        cursor: 0,
        bytecode_arena: js_lexer.OpCodeSpan {
            ptr: (&bytecode_arena) as u64,
            len: 64, // (1024 / 16) max opcodes safely
        },
        bytecode_count: 0,
        const_arena: js_lexer.F64Span {
            ptr: (&const_arena) as u64,
            len: 128, // max 128 constants
        },
        const_count: 0,
    };
    
    // Parse "10 + 20 * 30"
    js_compiler.compile_expression(&mut state, 0);
    
    // Execution checks
    if state.bytecode_count != 5 {
        return 1; 
    }
    
    if state.const_count != 3 {
        return 2;
    }
    
    // Passed deterministically parsing JS into purely linear arrays
    return 0;
}
