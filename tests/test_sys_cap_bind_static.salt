// =============================================================================
// Test: Boot-Time Silicon Verification + O(1) Capability Lookup
// =============================================================================
// Full end-to-end test of the Static Capability Manifest flow:
//
//   1. Build a mock 2-device hardware manifest (NVMe + RDMA NIC)
//   2. Mock ECAM region with matching silicon at exact bus/device
//   3. Run verify_and_mint() — should succeed and populate registry
//   4. Run O(1) sys_cap_bind() — should return BAR addresses
//   5. Test mismatch detection (wrong vendor → boot panic)
//   6. Test OOB capability request → returns 0
//
// Exit codes:
//   0 = all passed
//   1 = allocation failure
//   2 = verify_and_mint failed (should have succeeded)
//   3 = cap 0 returned wrong BAR
//   4 = cap 1 returned wrong BAR
//   5 = OOB cap did not return 0
//   6 = mismatch detection failed (should have returned 0)
// =============================================================================

package main

use std.core.ptr.Ptr

extern fn malloc(size: i64) -> u64;
extern fn free(ptr: u64);

// ============================================================================
// Inline structs & functions (self-contained test)
// ============================================================================

struct HardwareNode {
    bus: u32,
    device: u32,
    expected_vendor: u32,
    expected_device: u32,
}

// ECAM read helper
fn ecam_read(base: Ptr<u32>, bus: u32, device: u32, reg: u32) -> u32 {
    let byte_off: u32 = (bus << 20) | (device << 15) | (0 << 12) | reg;
    let word_off: i64 = (byte_off / 4) as i64;
    return base.offset(word_off).read();
}

// ECAM write helper
fn ecam_write(base: Ptr<u32>, bus: u32, device: u32, reg: u32, val: u32) {
    let byte_off: u32 = (bus << 20) | (device << 15) | (0 << 12) | reg;
    let word_off: i64 = (byte_off / 4) as i64;
    base.offset(word_off).write(val);
}

// Boot-time verifier: iterates manifest, checks silicon, extracts BARs
// Returns: 1 = success, 0 = hardware mismatch (kernel panic)
fn verify_and_mint(
    ecam: Ptr<u32>,
    manifest_addr: u64,
    node_count: u32,
    registry: Ptr<u64>
) -> u32 {
    let mut i: u32 = 0;
    while i < node_count {
        // Read manifest node (4 u32 fields × 4 bytes = 16 bytes per node)
        let node_base: u64 = manifest_addr + ((i as u64) * 16);
        let bus: u32 = *((node_base + 0) as &u32);
        let device: u32 = *((node_base + 4) as &u32);
        let expected_vendor: u32 = *((node_base + 8) as &u32);
        let expected_device: u32 = *((node_base + 12) as &u32);

        // O(1) targeted read — no bus scanning
        let id_reg: u32 = ecam_read(ecam, bus, device, 0);
        let vendor: u32 = id_reg & 0xFFFF;
        let dev_id: u32 = (id_reg >> 16) & 0xFFFF;

        // Hardware Firewall: silicon MUST match manifest
        if vendor != expected_vendor {
            return 0;
        }
        if dev_id != expected_device {
            return 0;
        }

        // Extract 64-bit BAR0
        let bar0_low: u32 = ecam_read(ecam, bus, device, 0x10);
        let bar0_high: u32 = ecam_read(ecam, bus, device, 0x14);
        let phys_low: u64 = (bar0_low & 0xFFFFFFF0) as u64;
        let phys_high: u64 = (bar0_high as u64) << 32;
        let physical_addr: u64 = phys_high | phys_low;

        // Lock into registry at index i (the CapabilityID)
        registry.offset(i as i64).write(physical_addr);

        i = i + 1;
    }
    return 1;
}

// O(1) sys_cap_bind — pure bounds-checked lookup
fn sys_cap_bind_static(registry: Ptr<u64>, cap_id: u32, capacity: u32) -> u64 {
    if cap_id >= capacity {
        return 0;
    }
    let addr: u64 = registry.offset(cap_id as i64).read();
    return addr;
}

fn main() -> i32 {
    // =========================================================================
    // Allocate: ECAM (4MB) + Manifest (2 nodes × 16B = 32B) + Registry (16 × 8B)
    // =========================================================================
    let ecam_size: i64 = 4 * 1024 * 1024;
    let ecam_addr: u64 = malloc(ecam_size);
    if ecam_addr == 0 { return 1; }

    let manifest_addr: u64 = malloc(64);
    if manifest_addr == 0 { free(ecam_addr); return 1; }

    let reg_addr: u64 = malloc(128);
    if reg_addr == 0 { free(ecam_addr); free(manifest_addr); return 1; }

    // Fill ECAM with 0xFF (no devices)
    let mut i: i64 = 0;
    while i < ecam_size {
        *((ecam_addr + (i as u64)) as &mut u8) = 0xFF;
        i = i + 1;
    }

    // Zero the registry
    let mut r: i64 = 0;
    while r < 16 {
        (reg_addr as Ptr<u64>).offset(r).write(0);
        r = r + 1;
    }

    let ecam: Ptr<u32> = ecam_addr as Ptr<u32>;
    let registry: Ptr<u64> = reg_addr as Ptr<u64>;

    // =========================================================================
    // Build manifest: 2 nodes
    //   Node 0: NVMe   — Bus 0, Dev 1, Samsung 0x144D:0xA808
    //   Node 1: RDMA   — Bus 1, Dev 0, Mellanox 0x15B3:0x1017
    // =========================================================================
    // Node 0
    *((manifest_addr + 0) as &mut u32) = 0;        // bus
    *((manifest_addr + 4) as &mut u32) = 1;        // device
    *((manifest_addr + 8) as &mut u32) = 0x144D;   // vendor (Samsung)
    *((manifest_addr + 12) as &mut u32) = 0xA808;  // device

    // Node 1
    *((manifest_addr + 16) as &mut u32) = 1;        // bus
    *((manifest_addr + 20) as &mut u32) = 0;        // device
    *((manifest_addr + 24) as &mut u32) = 0x15B3;   // vendor (Mellanox)
    *((manifest_addr + 28) as &mut u32) = 0x1017;   // device

    // =========================================================================
    // Plant matching silicon in ECAM
    // =========================================================================
    // NVMe at Bus 0, Dev 1
    ecam_write(ecam, 0, 1, 0x00, 0xA808144D);      // VendorID|DeviceID
    ecam_write(ecam, 0, 1, 0x10, 0xE0000004);      // BAR0 Low (64-bit, prefetchable)
    ecam_write(ecam, 0, 1, 0x14, 0x00000003);      // BAR0 High
    // Expected BAR: 0x0000_0003_E000_0000

    // RDMA NIC at Bus 1, Dev 0
    ecam_write(ecam, 1, 0, 0x00, 0x101715B3);      // VendorID|DeviceID
    ecam_write(ecam, 1, 0, 0x10, 0xC0000004);      // BAR0 Low
    ecam_write(ecam, 1, 0, 0x14, 0x00000005);      // BAR0 High
    // Expected BAR: 0x0000_0005_C000_0000

    // =========================================================================
    // T1: verify_and_mint — should succeed
    // =========================================================================
    let boot_ok: u32 = verify_and_mint(ecam, manifest_addr, 2, registry);
    if boot_ok != 1 {
        free(ecam_addr);
        free(manifest_addr);
        free(reg_addr);
        return 2;
    }

    // =========================================================================
    // T2: O(1) lookup — Cap 0 (NVMe BAR)
    // =========================================================================
    let bar0: u64 = sys_cap_bind_static(registry, 0, 16);
    if bar0 != 0x00000003E0000000 {
        free(ecam_addr);
        free(manifest_addr);
        free(reg_addr);
        return 3;
    }

    // =========================================================================
    // T3: O(1) lookup — Cap 1 (RDMA BAR)
    // =========================================================================
    let bar1: u64 = sys_cap_bind_static(registry, 1, 16);
    if bar1 != 0x00000005C0000000 {
        free(ecam_addr);
        free(manifest_addr);
        free(reg_addr);
        return 4;
    }

    // =========================================================================
    // T4: OOB capability request — should return 0
    // =========================================================================
    let oob: u64 = sys_cap_bind_static(registry, 99, 16);
    if oob != 0 {
        free(ecam_addr);
        free(manifest_addr);
        free(reg_addr);
        return 5;
    }

    // =========================================================================
    // T5: Hardware mismatch detection
    // Corrupt the NVMe vendor in ECAM, re-verify — should fail
    // =========================================================================
    ecam_write(ecam, 0, 1, 0x00, 0xA8088086);      // Wrong vendor (Intel 0x8086)
    let mismatch: u32 = verify_and_mint(ecam, manifest_addr, 2, registry);
    if mismatch != 0 {
        free(ecam_addr);
        free(manifest_addr);
        free(reg_addr);
        return 6;
    }

    free(ecam_addr);
    free(manifest_addr);
    free(reg_addr);
    return 0;
}
