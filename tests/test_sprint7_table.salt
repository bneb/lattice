package tests.test_sprint7_table

import user.browser.dom

extern fn layout_inject_dom_pointers();
extern fn compute_layout(node_idx: u32, offset_x: i32, offset_y: i32, max_width: i32) -> i32;

// Sprint 7: Table Layout (Google Footer Links)
// Tests: <table> with <tr>/<td> renders columns side-by-side
// with correct x-offsets and auto-sized column widths.

@no_mangle
pub fn main() -> i32 {
    // Setup: 10 nodes (1-9 used)
    // 1: root div
    // 2: <table>
    //   3: <tr> (row 1)
    //     4: <td> w=100
    //     5: <td> w=150
    //     6: <td> w=80
    //   7: <tr> (row 2)
    //     8: <td> w=120
    //     9: <td> w=100

    let mut i: u32 = 0;
    while i < 10 {
        dom.sanitize_node_slot(i);
        i = i + 1;
    }

    dom.DOM_NODE_COUNT = 10;
    layout_inject_dom_pointers();

    // Node 1: Root
    dom.DOM_NODE_TAG[1] = 4;
    dom.STYLE_DISPLAY[1] = 1; // block
    dom.STYLE_W[1] = 800;
    dom.DOM_NODE_PARENT[1] = 999999;
    dom.STYLE_PARENT[1] = 999999;
    dom.DOM_NODE_FIRST_CHILD[1] = 2;
    dom.DOM_NODE_NEXT_SIBLING[1] = 999999;

    // Node 2: <table>
    dom.DOM_NODE_TAG[2] = 12; // TAG_TABLE
    dom.STYLE_DISPLAY[2] = 6; // DISPLAY_TABLE
    dom.DOM_NODE_PARENT[2] = 1;
    dom.STYLE_PARENT[2] = 1;
    dom.DOM_NODE_FIRST_CHILD[2] = 3;
    dom.DOM_NODE_NEXT_SIBLING[2] = 999999;

    // Node 3: <tr> (row 1)
    dom.DOM_NODE_TAG[3] = 13; // TAG_TR
    dom.STYLE_DISPLAY[3] = 7; // DISPLAY_TABLE_ROW
    dom.DOM_NODE_PARENT[3] = 2;
    dom.STYLE_PARENT[3] = 2;
    dom.DOM_NODE_FIRST_CHILD[3] = 4;
    dom.DOM_NODE_NEXT_SIBLING[3] = 7;

    // Node 4: <td> cell (0,0) — width 100
    dom.DOM_NODE_TAG[4] = 14; // TAG_TD
    dom.STYLE_DISPLAY[4] = 8; // DISPLAY_TABLE_CELL
    dom.STYLE_W[4] = 100;
    dom.STYLE_H[4] = 30;
    dom.DOM_NODE_PARENT[4] = 3;
    dom.STYLE_PARENT[4] = 3;
    dom.DOM_NODE_FIRST_CHILD[4] = 999999;
    dom.DOM_NODE_NEXT_SIBLING[4] = 5;

    // Node 5: <td> cell (0,1) — width 150
    dom.DOM_NODE_TAG[5] = 14;
    dom.STYLE_DISPLAY[5] = 8;
    dom.STYLE_W[5] = 150;
    dom.STYLE_H[5] = 30;
    dom.DOM_NODE_PARENT[5] = 3;
    dom.STYLE_PARENT[5] = 3;
    dom.DOM_NODE_FIRST_CHILD[5] = 999999;
    dom.DOM_NODE_NEXT_SIBLING[5] = 6;

    // Node 6: <td> cell (0,2) — width 80
    dom.DOM_NODE_TAG[6] = 14;
    dom.STYLE_DISPLAY[6] = 8;
    dom.STYLE_W[6] = 80;
    dom.STYLE_H[6] = 25;
    dom.DOM_NODE_PARENT[6] = 3;
    dom.STYLE_PARENT[6] = 3;
    dom.DOM_NODE_FIRST_CHILD[6] = 999999;
    dom.DOM_NODE_NEXT_SIBLING[6] = 999999;

    // Node 7: <tr> (row 2)
    dom.DOM_NODE_TAG[7] = 13; // TAG_TR
    dom.STYLE_DISPLAY[7] = 7;
    dom.DOM_NODE_PARENT[7] = 2;
    dom.STYLE_PARENT[7] = 2;
    dom.DOM_NODE_FIRST_CHILD[7] = 8;
    dom.DOM_NODE_NEXT_SIBLING[7] = 999999;

    // Node 8: <td> cell (1,0) — width 120
    dom.DOM_NODE_TAG[8] = 14;
    dom.STYLE_DISPLAY[8] = 8;
    dom.STYLE_W[8] = 120;
    dom.STYLE_H[8] = 35;
    dom.DOM_NODE_PARENT[8] = 7;
    dom.STYLE_PARENT[8] = 7;
    dom.DOM_NODE_FIRST_CHILD[8] = 999999;
    dom.DOM_NODE_NEXT_SIBLING[8] = 9;

    // Node 9: <td> cell (1,1) — width 100
    dom.DOM_NODE_TAG[9] = 14;
    dom.STYLE_DISPLAY[9] = 8;
    dom.STYLE_W[9] = 100;
    dom.STYLE_H[9] = 35;
    dom.DOM_NODE_PARENT[9] = 7;
    dom.STYLE_PARENT[9] = 7;
    dom.DOM_NODE_FIRST_CHILD[9] = 999999;
    dom.DOM_NODE_NEXT_SIBLING[9] = 999999;

    // ── Run layout ──
    compute_layout(1 as u32, 0 as i32, 0 as i32, 800 as i32);

    // ═══════════════════════════════════════════════════
    // Phase 1: Column widths are max(cell widths per column)
    // Column 0: max(100, 120) = 120
    // Column 1: max(150, 100) = 150
    // Column 2: max(80) = 80
    // ═══════════════════════════════════════════════════

    // Row 1 cells: x offsets should be 0, 120, 270
    if dom.LAYOUT_X[4] != 0 { return 1; }    // cell (0,0) at x=0
    if dom.LAYOUT_X[5] != 120 { return 2; }  // cell (0,1) at x=120
    if dom.LAYOUT_X[6] != 270 { return 3; }  // cell (0,2) at x=270

    // Row 1: all cells should have column max widths
    if dom.LAYOUT_W[4] != 120 { return 4; }  // expanded to col 0 max
    if dom.LAYOUT_W[5] != 150 { return 5; }
    if dom.LAYOUT_W[6] != 80 { return 6; }

    // Row 2 cells
    if dom.LAYOUT_X[8] != 0 { return 7; }    // cell (1,0) at x=0
    if dom.LAYOUT_X[9] != 120 { return 8; }  // cell (1,1) at x=120
    if dom.LAYOUT_W[8] != 120 { return 9; }
    if dom.LAYOUT_W[9] != 150 { return 10; } // expanded to col 1 max

    // ═══════════════════════════════════════════════════
    // Phase 2: Row heights are max(cell heights in row)
    // Row 0: max(30, 30, 25) = 30
    // Row 1: max(35, 35) = 35
    // ═══════════════════════════════════════════════════

    // Row 1 y position = 0
    if dom.LAYOUT_Y[4] != 0 { return 20; }
    // All row 1 cells same height = 30
    if dom.LAYOUT_H[4] != 30 { return 21; }
    if dom.LAYOUT_H[5] != 30 { return 22; }
    if dom.LAYOUT_H[6] != 30 { return 23; } // stretched from 25 to row max 30

    // Row 2 y position = 30 (after row 1)
    if dom.LAYOUT_Y[8] != 30 { return 24; }
    if dom.LAYOUT_Y[9] != 30 { return 25; }
    if dom.LAYOUT_H[8] != 35 { return 26; }
    if dom.LAYOUT_H[9] != 35 { return 27; }

    // ═══════════════════════════════════════════════════
    // Phase 3: Table total dimensions
    // ═══════════════════════════════════════════════════
    // Width = 120 + 150 + 80 = 350
    // Height = 30 + 35 = 65
    if dom.LAYOUT_W[2] != 350 { return 30; }
    if dom.LAYOUT_H[2] != 65 { return 31; }

    return 0;
}

pub fn render_pipeline_e2e_test() {}
