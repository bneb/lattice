package tests.test_e2e_positioning

import user.browser.dom

extern fn c_bridge_positioning_e2e_test() -> i32;
extern fn dom_hit_test(node_idx: u32, target_x: i32, target_y: i32) -> u32;
extern fn compute_layout(node_idx: u32, offset_x: i32, offset_y: i32, max_width: i32) -> i32;



pub fn main() -> i32 {
    println("--- Epic 55: E2E Positional Geometry & Stacking Context ---");
    
    // Evaluate the JS simulation to construct the DOM
    c_bridge_positioning_e2e_test();
    
    // Find Container, Modal, Button via ID Array
    let limit = 1000;
    
    let mut cont_idx: u32 = 0;
    let mut btn_idx: u32 = 0;
    let mut mod_idx: u32 = 0;
    
    let mut i: u32 = 1;
    while i < limit {
        if dom.DOM_ID_LEN[i as usize] == 1 {
            let b0 = *((dom.DOM_ID_PTR[i as usize]) as &u8);
            if b0 == 99 { cont_idx = i; } // 'c'
            if b0 == 98 { btn_idx = i; }  // 'b'
            if b0 == 109 { mod_idx = i; } // 'm'
        }
        i = i + 1;
    }
    
    if cont_idx == 0 || btn_idx == 0 || mod_idx == 0 {
        return 1;
    }
    
    // Run geometric layout specifically on container (simulate starting at 8, 8 origin)
    compute_layout(cont_idx, 8, 8, 1904);
    
    // Validate geometric locations
    let c_x = dom.LAYOUT_X[cont_idx as usize];
    let c_y = dom.LAYOUT_Y[cont_idx as usize];
    
    // Container has top:50, left:50, position:relative.
    // Origin is 8, 8 + 50 = 58
    if c_x != 58 || c_y != 58 { return 2; }
    
    let m_x = dom.LAYOUT_X[mod_idx as usize];
    let m_y = dom.LAYOUT_Y[mod_idx as usize];
    
    // Modal has top:10, left:10, position:absolute relative to container
    // So expected X = 58 + 10 = 68
    if m_x != 68 || m_y != 68 { return 3; }
    
    let b_x = dom.LAYOUT_X[btn_idx as usize];
    let b_y = dom.LAYOUT_Y[btn_idx as usize];
    
    // Button is static flow inside Container
    // So expected X = 58
    if b_x != 58 || b_y != 58 { return 4; }
    
    // Validate Out of Flow bypass: Container height should ONLY be Button height (50), not Modal!
    // Wait, the container has explicit height 500px! So it evaluates to 500.
    // So layout_h for container should be 500.
    let c_h = dom.LAYOUT_H[cont_idx as usize];
    if c_h != 500 { return 5; }
    
    // Raycaster Stacking Context validation
    // Fire click at 69, 69. It hits both button and modal, but modal is z-index 999.
    // Button spans (58, 58) -> (158, 108).
    // Modal spans (68, 68) -> (268, 268)
    // 75, 75 hits both.
    let hit_idx = dom_hit_test(cont_idx, 75, 75);
    if hit_idx != mod_idx { return 6; }
    
    // Fire click at 60, 60. It only hits Button, not Modal.
    let hit_idx2 = dom_hit_test(cont_idx, 60, 60);
    if hit_idx2 != btn_idx { return 7; }
    
    println("SUCCESS");
    return 0;
}
