package tests.test_js_nav

import user.os.ipc_ring

// Link into critical DOM symbols (From dom.salt @no_mangle)
extern fn init_arrays();
extern fn create_node(tag: i32) -> u64;
extern fn resolve_node_by_id(ptr: u64, len: u32) -> u64;

// Link into airlock (From airlock.salt @no_mangle)
extern fn airlock_init_allocator();

// Link into JS Dom Bridge (From C side)
extern fn js_quickjs_init() -> i32;
extern fn js_teardown() -> i32;

// Main browser pump
extern fn run_loop();
extern fn set_max_test_frames(frames: u64);

// Link into main.salt injection
extern fn inject_test_key(key: u8);

pub fn main() -> i32 {
    println("--- Phase 7: Navigation Matrix Test ---");
    
    airlock_init_allocator();
    init_arrays();
    ipc_ring.init_shared_ring();
    
    // Create old #hero node
    let old_hero_id = create_node(4);
    
    // Init QuickJS
    js_quickjs_init();
    
    // Configure max frames
    set_max_test_frames(2);
    
    println("[Test] Simulating 1st Frame: Intercepting Enter key via Omnibox...");
    inject_test_key(10);
    
    println("[Test] Draining Outbound VirtIO Stream...");
    let mut b: u8 = 0;
    while ipc_ring.ipc_read_byte((&mut b) as u64) == 1 {
        // Discard byte (the GET request to our url)
    }
    
    println("[Test] Pushing Mocked Inbound NetD HTML payload...");
    // Let's invent a raw HTML string with a new root.
    // `<div id="success"></div>` length = 24
    let mut html_str: [u8; 24] = [60, 100, 105, 118, 32, 105, 100, 61, 34, 115, 117, 99, 99, 101, 115, 115, 34, 62, 60, 47, 100, 105, 118, 62];
    let html_len: u32 = 24;
    
    // Recreate the matching Multiplex Nav ID: bit 62 | new_root
    // Note: since all memory was zeroed, `create_node(0)` returned `1`.
    let new_root_raw: u64 = 1;
    let mut nav_bit: u64 = 1;
    nav_bit = nav_bit << 62;
    let multiplexed_id = nav_bit | new_root_raw;
    
    // Write 8-byte Multiplexed ID
    let mut i: u32 = 0;
    while i < 8 {
        let shift = i * 8;
        let v = ((multiplexed_id >> shift) & 0xFF) as u8;
        ipc_ring.ipc_push_byte(v);
        i = i + 1;
    }
    
    // Write 4-byte Length
    i = 0;
    while i < 4 {
        let shift = i * 8;
        let v = ((html_len >> shift) & 0xFF) as u8;
        ipc_ring.ipc_push_byte(v);
        i = i + 1;
    }
    
    // Write URL Payload
    i = 0;
    while i < html_len {
        let val = *(((&html_str) as u64 + (i as u64)) as &u8);
        ipc_ring.ipc_push_byte(val);
        i = i + 1;
    }
    
    println("[Test] Simulating 2nd Frame: Network Ingestion & Native HTML Lexing...");
    set_max_test_frames(4); // Run 2 more frames (3 and 4)
    run_loop();
    
    println("[Test] Verifying Total Context Teardown and Fresh Injection...");
    
    let mut id_str: [u8; 7] = [115, 117, 99, 99, 101, 115, 115]; // "success"
    let id_len: u32 = 7;
    
    let found_node = resolve_node_by_id((&id_str) as u64, id_len);
    if found_node != -1 && found_node != 0xFFFFFFFF {
        println("[Test] SUCCESS: 'success' node securely injected and parsed natively!");
        return 0;
    } else {
        println("[Test] FAILURE: Lexer failed to recreate the fresh DOM tree.");
        return 1;
    }
}
