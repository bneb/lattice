// =============================================================================
// Test: NetD Socket Hijacking Vulnerability
// =============================================================================
// Validates that CMD_ACCEPT enforces the IPC sender PID matches the owner PID
// established during CMD_BIND.

import user.netd
import user.lib.socket_protocol
import user.lib.syscall

fn main() -> i32 {
    let mut next_fd: u64 = 100;
    let mut binding_storage: [u64; 64] = [0; 64]; 
    let bindings = (&binding_storage) as u64;

    let legitimate_pid: u64 = 42;
    let malicious_pid: u64 = 99;
    let test_port: u64 = 8080;

    // 1. Legitimate PID binds the port
    let fd = netd.handle_bind(legitimate_pid, test_port, bindings, &mut next_fd);
    if fd == 0xFFFFFFFFFFFFFFFF {
        return 1; // Bind failed
    }

    // 2. Malicious PID attempts to ACCEPT on the legitimate FD
    // Note: handle_accept normally uses ipc_send to reply. Since we are testing
    // synchronously, we will just verify that the slot state does not transition
    // to LISTENING.
    netd.handle_accept(malicious_pid, fd, bindings);

    // Verify the slot is still BIND_BOUND and NOT BIND_LISTENING
    let slot = bindings + (0 * 32);
    let state = *((slot + 24) as &u64);

    if state == netd.BIND_LISTENING {
        return 2; // Vulnerable to Hijacking!
    }

    // 3. Legitimate PID attempts to ACCEPT on the FD
    netd.handle_accept(legitimate_pid, fd, bindings);
    let state2 = *((slot + 24) as &u64);
    if state2 != netd.BIND_LISTENING {
        return 3; // Legitimate accept failed
    }

    // 4. Malicious PID attempts to CLOSE
    netd.handle_close(malicious_pid, fd, bindings);
    let state3 = *((slot + 24) as &u64);
    if state3 == netd.BIND_FREE {
        return 4; // Vulnerable to malicious close!
    }

    return 0; // Success
}
