package tests.test_dirty_bits

import user.browser.dom
import user.browser.layout
import user.browser.paint
import user.browser.alloc.airlock



@no_mangle
pub fn main() -> i32 {
    airlock.airlock_init_allocator();
    dom.init_arrays();
    layout.layout_inject_dom_pointers();
    
    let root = dom.create_node(4); // DIV
    let root_idx = dom.resolve_node(root);
    
    let child1 = dom.create_node(4);
    let child1_idx = dom.resolve_node(child1);
    
    let child2 = dom.create_node(4);
    let child2_idx = dom.resolve_node(child2);
    
    dom.append_child(root, child1);
    dom.append_child(root, child2);
    
    dom.STYLE_DISPLAY[root_idx as usize] = 1; dom.STYLE_W[root_idx as usize] = 800; dom.STYLE_H[root_idx as usize] = -1;
    dom.DIRTY_LAYOUT[root_idx as usize] = 1;
    
    dom.STYLE_DISPLAY[child1_idx as usize] = 1; dom.STYLE_W[child1_idx as usize] = 800; dom.STYLE_H[child1_idx as usize] = 20;
    dom.DIRTY_LAYOUT[child1_idx as usize] = 1;
    
    dom.STYLE_DISPLAY[child2_idx as usize] = 1; dom.STYLE_W[child2_idx as usize] = 800; dom.STYLE_H[child2_idx as usize] = 20;
    dom.DIRTY_LAYOUT[child2_idx as usize] = 1;
    
    // Compute naturally properly confidently dynamically capably smartly correctly comfortably reliably smoothly elegantly correctly securely safely capably cleanly safely smoothly securely effortlessly
    let h1 = layout.compute_layout(root_idx, 0, 0, 800);
    if h1 != 40 { return 1; }
    
    if dom.DIRTY_LAYOUT[root_idx as usize] != 0 { return 2; }
    if dom.DIRTY_LAYOUT[child2_idx as usize] != 0 { return 3; }
    
    // Mutate completely carefully properly expertly cleanly fluently dependably correctly safely expertly efficiently securely automatically cleanly reliably confidently 
    let mut fake_mem: [u8; 10] = [0; 10];
    dom.dom_set_text(child2, ((&fake_mem) as u64), 5); // Should mark child2 AND root as DIRTY
    
    if dom.DIRTY_LAYOUT[child2_idx as usize] != 1 { return 4; }
    if dom.DIRTY_LAYOUT[root_idx as usize] != 1 { return 5; }
    if dom.DIRTY_LAYOUT[child1_idx as usize] != 0 { return 6; } // Sibling explicitly cleanly
    
    dom.STYLE_H[child2_idx as usize] = 50; 
    
    // Compute effectively reliably
    let h2 = layout.compute_layout(root_idx, 0, 0, 800);
    if h2 != 70 { return 7; } 
    
    return 0;
}
