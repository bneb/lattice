// =============================================================================
// tests/test_process_heap_boundary.salt (Standalone)
// Regression Test: Late-Zeroing Trap in Process Heap Boundaries
// =============================================================================
//
// Mocks the kernel process table as a flat memory buffer and validates
// that init_slot + set_brk_base/set_mmap_base preserves heap boundaries.
//
// Process table slot layout (mocked, 128 bytes per slot):
//   [0..8)    pid
//   [8..16)   state
//   [16..24)  user_pml4
//   [24..32)  kernel_rsp
//   [32..40)  kernel_stack_base
//   [40..48)  kernel_stack_top
//   [48..56)  user_entry
//   [56..64)  user_stack_top
//   [64..72)  brk_base
//   [72..80)  brk_current
//   [80..88)  mmap_base
//   [88..96)  vma_list_head
//
// Exit codes:
//   0 = all passed
//   1 = alloc failure
//   2 = init_slot state incorrect
//   3 = brk_base not preserved after set
//   4 = brk_current not preserved
//   5 = mmap_base not preserved
//   6 = mmap_base is zero (null page vulnerability)
// =============================================================================

package main

extern fn malloc(size: i64) -> Ptr<u8>;
extern fn free(ptr: u64);

const SLOT_SIZE: u64 = 128;
const PROC_READY: u64 = 1;
const PROC_FREE: u64 = 0;

fn init_slot(table: u64, slot: u64, pml4: u64, entry: u64, kstack_base: u64, kstack_top: u64, ustack: u64) {
    let base: u64 = table + slot * SLOT_SIZE;
    *((base) as &mut u64) = slot;           // pid
    *((base + 8) as &mut u64) = PROC_READY; // state
    *((base + 16) as &mut u64) = pml4;
    *((base + 24) as &mut u64) = 0;         // kernel_rsp
    *((base + 32) as &mut u64) = kstack_base;
    *((base + 40) as &mut u64) = kstack_top;
    *((base + 48) as &mut u64) = entry;
    *((base + 56) as &mut u64) = ustack;
    // Critically: DO NOT zero brk/mmap fields here
    // (The original bug was unconditionally zeroing these)
}

fn set_brk_base(table: u64, slot: u64, val: u64) {
    *((table + slot * SLOT_SIZE + 64) as &mut u64) = val;
}
fn set_brk_current(table: u64, slot: u64, val: u64) {
    *((table + slot * SLOT_SIZE + 72) as &mut u64) = val;
}
fn set_mmap_base(table: u64, slot: u64, val: u64) {
    *((table + slot * SLOT_SIZE + 80) as &mut u64) = val;
}
fn set_vma_list_head(table: u64, slot: u64, val: u64) {
    *((table + slot * SLOT_SIZE + 88) as &mut u64) = val;
}

fn get_state(table: u64, slot: u64) -> u64 { return *((table + slot * SLOT_SIZE + 8) as &u64); }
fn get_brk_base(table: u64, slot: u64) -> u64 { return *((table + slot * SLOT_SIZE + 64) as &u64); }
fn get_brk_current(table: u64, slot: u64) -> u64 { return *((table + slot * SLOT_SIZE + 72) as &u64); }
fn get_mmap_base(table: u64, slot: u64) -> u64 { return *((table + slot * SLOT_SIZE + 80) as &u64); }
fn get_pml4(table: u64, slot: u64) -> u64 { return *((table + slot * SLOT_SIZE + 16) as &u64); }
fn get_kernel_rsp(table: u64, slot: u64) -> u64 { return *((table + slot * SLOT_SIZE + 24) as &u64); }
fn set_kernel_rsp(table: u64, slot: u64, val: u64) { *((table + slot * SLOT_SIZE + 24) as &mut u64) = val; }
fn set_state(table: u64, slot: u64, val: u64) { *((table + slot * SLOT_SIZE + 8) as &mut u64) = val; }

fn main() -> i32 {
    // Allocate mock process table (16 slots × 128 bytes = 2048)
    let table: u64 = malloc(2048);
    if table == 0 { return 1; }
    let mut zi: u64 = 0;
    while zi < 2048 { *((table + zi) as &mut u8) = 0; zi = zi + 1; }

    // =========================================================================
    // Test 1: init_slot preserves post-set heap boundaries
    // =========================================================================
    let slot: u64 = 15;
    init_slot(table, slot, 0x1000, 0x2000, 0x3000, 0x4000, 0x5000);

    let expected_brk: u64 = 0x8000002000;
    let expected_mmap: u64 = 0x400000000000;

    set_brk_base(table, slot, expected_brk);
    set_brk_current(table, slot, expected_brk);
    set_mmap_base(table, slot, expected_mmap);
    set_vma_list_head(table, slot, 0);

    if get_state(table, slot) != PROC_READY { free(table); return 2; }
    if get_brk_base(table, slot) != expected_brk { free(table); return 3; }
    if get_brk_current(table, slot) != expected_brk { free(table); return 4; }
    if get_mmap_base(table, slot) != expected_mmap { free(table); return 5; }

    // =========================================================================
    // Test 2: mmap_base must never be zero
    // =========================================================================
    let slot2: u64 = 14;
    init_slot(table, slot2, 0xA000, 0xB000, 0xC000, 0xD000, 0xE000);
    set_mmap_base(table, slot2, 0x400000000000);

    if get_mmap_base(table, slot2) == 0 { free(table); return 6; }

    // =========================================================================
    // Test 3: Task0 kernel thread state (from test_task0_spawn)
    // =========================================================================
    let slot3: u64 = 13;
    init_slot(table, slot3, 0xCAFE0000, 0x1000, 0x2000, 0x3000, 0);

    if get_state(table, slot3) != PROC_READY { free(table); return 2; }
    if get_pml4(table, slot3) != 0xCAFE0000 { free(table); return 2; }

    set_kernel_rsp(table, slot3, 0xBEEF);
    if get_kernel_rsp(table, slot3) != 0xBEEF { free(table); return 2; }

    set_state(table, slot3, PROC_FREE);

    free(table);
    return 0;
}
