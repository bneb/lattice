package tests.test_scroll

import user.browser.dom
import user.browser.events
import user.browser.paint
import user.browser.compositor
import user.browser.layout
import user.browser.alloc.airlock
import user.browser.event_loop
import user.browser.hit_test

@no_mangle
pub fn main() -> i32 {
    println("--- Epic 15: Scroll Physics & Hit-Test Compensation ---");
    
    airlock.airlock_init_allocator();
    dom.init_arrays();
    paint.salt_paint_inject_dom_pointers();
    
    // =========================================================================
    // TEST 1: Scroll state clamping (floor at 0)
    // =========================================================================
    event_loop.ext_diag_set_max_height(3000.0);
    event_loop.ext_engine_init_viewport(1080.0);
    event_loop.ext_engine_process_scroll(-999999.0);
    
    // Test floor clamp: apply negative scroll 
    event_loop.ext_engine_process_scroll(-200.0);
    if event_loop.ext_diag_get_scroll_y() != 0.0 {
        println(f"FAIL: test_scroll should be 0, got {event_loop.ext_diag_get_scroll_y()}");
        return -1;
    }
    println("PASS: Test 1 - Scroll floor clamped at 0");
    
    // =========================================================================
    // TEST 2: Scroll state clamping (ceiling at doc_height - viewport)
    // =========================================================================
    event_loop.ext_engine_process_scroll(5000.0); // Way past end of document
    if event_loop.ext_diag_get_scroll_y() != 1920.0 { // 3000 - 1080 = 1920
        println(f"FAIL: Expected max_scroll=1920, got {event_loop.ext_diag_get_scroll_y()}");
        return -2;
    }
    println("PASS: Test 2 - Scroll ceiling clamped at DOCUMENT_HEIGHT - VIEWPORT_HEIGHT");
    
    // =========================================================================
    // TEST 3: Hit-test with scroll compensation
    // =========================================================================
    // Organically create the node using the engine API
    println("Executing Test 3...");
    let node_id = dom.create_node(1); // 1 = HTML tag
    println("Resolved ID");
    let idx = dom.resolve_node(node_id);
    println("Setting Layout...");
    dom.LAYOUT_X[idx as usize] = 100;
    dom.LAYOUT_Y[idx as usize] = 2000;
    dom.LAYOUT_W[idx as usize] = 200;
    dom.LAYOUT_H[idx as usize] = 100;
    dom.STYLE_BG_R[idx as usize] = 255;
    dom.STYLE_Z_INDEX[idx as usize] = 0;
    dom.STYLE_POINTER_EVENTS[idx as usize] = 1;
    
    // Generate a display command to populate hit_test
    println("paint.begin_frame()");
    paint.begin_frame();
    println("paint.emit_rect()");
    paint.emit_rect(100, 2000, 200, 100, idx);
    let cmd_count = paint.get_cmd_count();
    println(f"CMD_COUNT is: {cmd_count}");
    
    println("hit_test()");
    let hit_idx = hit_test.salt_hit_test(150.0, 100.0, 0);
    println(f"Test 3 hit_idx returned: {hit_idx}");
    if hit_idx == 0 {
        println(f"FAIL: Expected hit at scrolled position, got 0");
        return -3;
    }
    println("PASS: Test 3 - Click hit-test compensated for scroll offset");
    
    // =========================================================================
    // TEST 4: Hit-test miss without scroll compensation
    // =========================================================================
    // Same click position but reset scroll_y to 0
    event_loop.ext_engine_process_scroll(-999999.0);
    // Adjusted Y = 100 + 0 = 100, which is NOT inside (2000..2100)
    let hit_idx2 = hit_test.salt_hit_test(150.0, 100.0, 0);
    println(f"Test 4 hit_idx2 returned: {hit_idx2}");
    if hit_idx2 != 0 {
        println("FAIL: Should NOT have hit the rect with scroll_y=0");
        return -4;
    }
    println("PASS: Test 4 - Click correctly misses when not scrolled");
    
    // =========================================================================
    // TEST 5: Scroll does not affect short documents
    // =========================================================================
    event_loop.ext_diag_set_max_height(500.0); // Shorter than viewport
    event_loop.ext_engine_init_viewport(1080.0);
    event_loop.ext_engine_process_scroll(-999999.0);
    event_loop.ext_engine_process_scroll(100.0);
    
    if event_loop.ext_diag_get_scroll_y() != 0.0 {
        println(f"FAIL: SCROLL_Y should be 0 for short documents, got {event_loop.ext_diag_get_scroll_y()}");
        return -5;
    }
    println("PASS: Test 5 - Scroll locked to 0 for documents shorter than viewport");
    
    println("ALL SCROLL TESTS PASSED.");
    return 0;
}
