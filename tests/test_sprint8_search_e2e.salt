package tests.test_sprint8_search_e2e

import user.browser.dom
import user.browser.net
import user.os.ipc_ring

extern fn layout_inject_dom_pointers();

extern fn test_push_scroll_ipc(delta_y: i32);
extern fn test_simulate_click(x: i32, y: i32);
extern fn test_get_last_nav_url_ptr() -> u64;
extern fn test_get_last_nav_url_len() -> u32;
extern fn sys_print_float(f: f64);
extern fn sys_hit_test(x: f32, y: f32, root_node: u32) -> u32;

extern fn dom_add_scroll_y(delta_y: i32);
extern fn dom_get_layout_scroll_y(node_id: u32) -> f32;

@no_mangle
pub fn main() -> i32 {
    dom.sanitize_node_slot(0);
    dom.sanitize_node_slot(1);
    dom.sanitize_node_slot(2);
    dom.DOM_NODE_COUNT = 3;
    layout_inject_dom_pointers();

    // Node 1: Root <HTML>
    dom.DOM_NODE_TAG[1] = 1;
    dom.STYLE_DISPLAY[1] = 1;
    dom.STYLE_POINTER_EVENTS[1] = 1;
    dom.LAYOUT_X[1] = 0;
    dom.LAYOUT_Y[1] = 0;
    dom.LAYOUT_W[1] = 1920;
    dom.LAYOUT_H[1] = 1080;
    dom.DOM_NODE_PARENT[1] = 999999;
    dom.STYLE_PARENT[1] = 999999;
    dom.DOM_NODE_FIRST_CHILD[1] = 2;
    dom.DOM_NODE_NEXT_SIBLING[1] = 0;

    // Node 2: <a> Link
    dom.DOM_NODE_TAG[2] = 7; // TAG_A
    dom.STYLE_DISPLAY[2] = 1;
    dom.STYLE_POINTER_EVENTS[2] = 1;
    dom.LAYOUT_X[2] = 100;
    dom.LAYOUT_Y[2] = 100;
    dom.LAYOUT_W[2] = 200;
    dom.LAYOUT_H[2] = 50;
    dom.DOM_NODE_PARENT[2] = 1;
    dom.STYLE_PARENT[2] = 1;
    dom.DOM_NODE_FIRST_CHILD[2] = 0;
    dom.DOM_NODE_NEXT_SIBLING[2] = 0;

    // Add attributes
    let href: [u8; 18] = [104, 116, 116, 112, 115, 58, 47, 47, 103, 111, 111, 103, 108, 101, 46, 99, 111, 109]; // "https://google.com"
    let href_key: [u8; 4] = [104, 114, 101, 102]; // "href"

    dom.ATTR_NODE_ID[0] = 2;
    dom.ATTR_KEY_PTR[0] = (&href_key) as u64;
    dom.ATTR_KEY_LEN[0] = 4;
    dom.ATTR_VAL_PTR[0] = (&href) as u64;
    dom.ATTR_VAL_LEN[0] = 18;
    dom.ATTR_COUNT = 1;

    // DEBUG: print hit_test result
    let ht = sys_hit_test(150.0, 120.0, 1);
    sys_print_float(ht as f64);
    
    // Part 1: Simulate Click on the anchor tag
    // Inside LAYOUT bounds of node 2 (100, 100) -> (300, 150)
    test_simulate_click(150, 120);

    let nav_ptr = test_get_last_nav_url_ptr();
    let nav_len = test_get_last_nav_url_len();
    
    // DEBUG: print nav_len
    sys_print_float(nav_len as f64);

    if nav_len != 18 { return 1; }
    // Check first and last bytes 'h' and 'm'
    if *((nav_ptr + 0) as &u8) != 104 { return 2; }
    if *((nav_ptr + 17) as &u8) != 109 { return 3; }

    // Part 2: Simulate Scroll
    // Calling via C bridge bypasses inlining bugs in Salt compiler
    test_push_scroll_ipc(-300);

    let final_scroll = dom.LAYOUT_SCROLL_Y[1 as usize] as i32;
    if final_scroll != -300 { return 4; }
    
    // Check dirty paint
    if dom.DIRTY_PAINT[1] != 1 { return 5; }

    return 0; // Success
}
