package tests.test_sprint8_search_e2e

import user.browser.dom
import user.browser.net
import user.browser.layout

extern fn sys_print_float(f: f64);

@no_mangle
pub fn main() -> i32 {
    dom.DOM_NODE_COUNT = 3;

    // Node 1: Root <HTML>
    dom.DOM_NODE_TAG[1] = 1;
    dom.STYLE_DISPLAY[1] = 1;
    dom.STYLE_POINTER_EVENTS[1] = 1;
    dom.LAYOUT_X[1] = 0;
    dom.LAYOUT_Y[1] = 0;
    dom.LAYOUT_W[1] = 1920;
    dom.LAYOUT_H[1] = 1080;
    dom.DOM_NODE_PARENT[1] = 999999;
    dom.STYLE_PARENT[1] = 999999;
    dom.DOM_NODE_FIRST_CHILD[1] = 2;
    dom.DOM_NODE_NEXT_SIBLING[1] = 0;

    // Node 2: <a> Link
    dom.DOM_NODE_TAG[2] = 7; // TAG_A
    dom.STYLE_DISPLAY[2] = 1;
    dom.STYLE_POINTER_EVENTS[2] = 1;
    dom.LAYOUT_X[2] = 100;
    dom.LAYOUT_Y[2] = 100;
    dom.LAYOUT_W[2] = 200;
    dom.LAYOUT_H[2] = 50;
    dom.DOM_NODE_PARENT[2] = 1;
    dom.STYLE_PARENT[2] = 1;
    dom.DOM_NODE_FIRST_CHILD[2] = 0;
    dom.DOM_NODE_NEXT_SIBLING[2] = 999999;

    return 0;
}

// Sentinel for bridge auto-detection
pub fn sprint8_search_e2e_test() {}
