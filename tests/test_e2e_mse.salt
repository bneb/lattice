package tests.test_e2e_mse

import std.core.str;

extern fn airlock_init_allocator();
extern fn init_arrays();
extern fn js_engine_init();
extern fn create_node(tag: i32) -> u64;
extern fn js_lex_html_chunk(root_id: u64, ptr: u64, len: u32, can_exec: u8);

extern fn sys_jsc_evaluate_script(script_ptr: u64, script_len: u32, source_url_ptr: u64);
extern fn sys_jsc_pump_idb_open(); // Microtask pumping
extern fn paint_node(node_id: u32, focus: u64, frame: u64, scrolly: i32, vh: i32);
extern fn resolve_node(id: u64) -> u32;

@no_mangle
pub fn mse_e2e_test() -> i32 {
    airlock_init_allocator();
    init_arrays();
    
    // Epic 86: Initialize modern JSC engine
    js_engine_init();
    
    let root_node = create_node(3); // BODY
    
    let mut html: [u8; 73] = [
        60, 100, 105, 118, 32, 105, 100, 61, 34, 97, 112, 112, 34, 62, 60, 118, 
        105, 100, 101, 111, 32, 105, 100, 61, 34, 112, 108, 97, 121, 101, 114, 34, 
        32, 119, 105, 100, 116, 104, 61, 34, 49, 50, 56, 48, 34, 32, 104, 101, 
        105, 103, 104, 116, 61, 34, 55, 50, 48, 34, 62, 60, 47, 118, 105, 100, 
        101, 111, 62, 60, 47, 100, 105, 118, 62
    ];
    js_lex_html_chunk(root_node, (&html) as u64, 73, 1);
    
    // Epic 86: Expose a known valid minimal Annex B stream (SPS, PPS, IDR frame) to JavaScript
    let mut h264_stream: [u8; 31] = [
        // SPS
        0x00, 0x00, 0x00, 0x01, 0x67, 0x42, 0x00, 0x0a, 0xf8, 0x41, 0xa2,
        // PPS
        0x00, 0x00, 0x00, 0x01, 0x68, 0xce, 0x38, 0x80,
        // Dummy IDR Frame (NAL Type 5)
        0x00, 0x00, 0x00, 0x01, 0x65, 0x88, 0x84, 0x00, 0x00, 0x00, 0x00, 0x01 /* ending boundary so parser completes the NAL */
    ];
    let js_code = "
        const ms = new MediaSource();
        const video = document.getElementById('player');
        video.src = URL.createObjectURL(ms);
        const sb = ms.addSourceBuffer('video/mp4; codecs=\"avc1.42E01E\"');
        
        // Define our Annex B chunk exactly as in the arrays
        const chunk = new Uint8Array([
            0x00, 0x00, 0x00, 0x01, 0x67, 0x42, 0x00, 0x0a, 0xf8, 0x41, 0xa2,
            0x00, 0x00, 0x00, 0x01, 0x68, 0xce, 0x38, 0x80,
            0x00, 0x00, 0x00, 0x01, 0x65, 0x88, 0x84, 0x00, 0x00, 0x00, 0x00, 0x01
        ]);
        
        sb.appendBuffer(chunk.buffer);
    ";
    
    sys_jsc_evaluate_script(js_code.ptr as u64, js_code.len as u32, 0);
    
    // Pump Javascript Microtasks & Event Loop
    sys_jsc_pump_idb_open(); // Reuse this loop mechanic to flush microtasks
    
    // Simulate one run of the compositor to flush the GPU bindings
    let body_idx = resolve_node(root_node);
    paint_node(body_idx, 0, 0, 0, 600);
    
    println("[Test] SUCCESS: MSE Hardware Decoder E2E Pipeline Validated!");
    return 0;
}

@no_mangle
pub fn main() -> i32 {
    let ret = mse_e2e_test();
    return ret;
}
