// =============================================================================
// Test: Reactor Task Exhaustion / Recycling
// =============================================================================
// Validates that the Reactor `spawn_task` implementation successfully recycles
// `TASK_DONE` or `TASK_IDLE` slots instead of monotonically exhausting the 
// `TASK_REGISTRY` limit of 4096.

import user.reactor.scheduler

fn main() -> i32 {
    scheduler.init_reactor();
    scheduler.deque_init(1000000); // dummy deque addr

    let mut i: u32 = 0;
    while i < 5000 {
        // Spawn a task
        let task_id = scheduler.spawn_task(0xDEADBEEF, 1000000);
        
        if task_id == 0xFFFFFFFF {
            // Task exhaustion failed! We leaked slots.
            return 1; 
        }

        // Simulate task completing
        let slot_addr = scheduler.TASK_REGISTRY + ((task_id as u64) * 24);
        *((slot_addr) as &mut u32) = scheduler.TASK_DONE;

        // Pop from deque to keep it from overflowing
        scheduler.pop_bottom(1000000);

        i = i + 1;
    }

    return 0; // Success, we spawned 5000 tasks sequentially without exhausting slots.
}
