// =============================================================================
// Test: Telemetry Truth — Quicksort + 10K CDF (v3.2.1)
// =============================================================================
//
// Assertions:
//   T1: Quicksort unit — [20,3,15,1,8,17,2,19,6,12,10,4,18,7,14,5,16,9,11,13]
//       → [1,2,3,...,20], exact ascending order
//   T2: Quicksort edge — already sorted [1..10] stays [1..10]
//   T3: Quicksort edge — reverse sorted [10..1] → [1..10]
//   T4: Quicksort single — [42] → [42]
//   T5: Static 4×4 matmul correctness
//   T6: Static 16×16 matmul correctness
//   T7: 10K harness — 1000 warmup + 10000 measured with quicksort CDF
//   T8: CDF monotonicity — p0 ≤ p25 ≤ p50 ≤ p75 ≤ p99 ≤ p100
//   T9: Deep tail chain — p99.99 ≥ p99.9 ≥ p99
//   T10: CPE scaling — 16×16 / 4×4 ratio < 200×
//
// Exit codes:
//   0  = all passed
//   1  = allocation failure
//   2  = quicksort basic failed
//   3  = quicksort edge case failed
//   4  = matmul 4×4 incorrect
//   5  = matmul 16×16 incorrect
//   6  = harness failed
//   7  = CDF not monotonic
//   8  = deep tail chain broken
//   9  = CPE ratio too large
// =============================================================================

package main

use std.core.ptr.Ptr

extern fn malloc(size: i64) -> u64;
extern fn free(ptr: u64);
extern fn rdtsc() -> i64;

// ============================================================================
// Inline iterative quicksort (mirrors sort.salt)
// ============================================================================
fn qsort(arr: u64, initial_low: i64, initial_high: i64) {
    if initial_high <= initial_low { return; }

    let stack: u64 = malloc(1024);
    if stack == 0 { return; }
    let mut top: i64 = -1;

    top = top + 1;
    *((stack + (top as u64)*8) as &mut i64) = initial_low;
    top = top + 1;
    *((stack + (top as u64)*8) as &mut i64) = initial_high;

    while top >= 0 {
        let high: i64 = *((stack + (top as u64)*8) as &i64);
        top = top - 1;
        let low: i64 = *((stack + (top as u64)*8) as &i64);
        top = top - 1;

        if low >= high { } else {
            // Median-of-three pivot
            let mid: i64 = low + (high - low) / 2;
            let vl: i64 = *((arr + (low as u64)*8) as &i64);
            let vm: i64 = *((arr + (mid as u64)*8) as &i64);
            let vh: i64 = *((arr + (high as u64)*8) as &i64);

            if (vl <= vm && vm <= vh) || (vh <= vm && vm <= vl) {
                *((arr + (mid as u64)*8) as &mut i64) = vh;
                *((arr + (high as u64)*8) as &mut i64) = vm;
            } else if (vm <= vl && vl <= vh) || (vh <= vl && vl <= vm) {
                *((arr + (low as u64)*8) as &mut i64) = vh;
                *((arr + (high as u64)*8) as &mut i64) = vl;
            }

            let pivot: i64 = *((arr + (high as u64)*8) as &i64);
            let mut i: i64 = low - 1;
            let mut j: i64 = low;
            while j < high {
                let vj: i64 = *((arr + (j as u64)*8) as &i64);
                if vj <= pivot {
                    i = i + 1;
                    let vi: i64 = *((arr + (i as u64)*8) as &i64);
                    *((arr + (i as u64)*8) as &mut i64) = vj;
                    *((arr + (j as u64)*8) as &mut i64) = vi;
                }
                j = j + 1;
            }
            i = i + 1;
            let vi: i64 = *((arr + (i as u64)*8) as &i64);
            *((arr + (i as u64)*8) as &mut i64) = pivot;
            *((arr + (high as u64)*8) as &mut i64) = vi;

            let p: i64 = i;
            if p - 1 > low {
                top = top + 1;
                *((stack + (top as u64)*8) as &mut i64) = low;
                top = top + 1;
                *((stack + (top as u64)*8) as &mut i64) = p - 1;
            }
            if p + 1 < high {
                top = top + 1;
                *((stack + (top as u64)*8) as &mut i64) = p + 1;
                top = top + 1;
                *((stack + (top as u64)*8) as &mut i64) = high;
            }
        }
    }
    free(stack);
}

// ============================================================================
// Inline matmul (static for loops)
// ============================================================================
fn matmul_4x4(a: u64, b: u64, c: u64) {
    for i in 0..4 {
        for j in 0..4 {
            let mut acc: f64 = 0.0;
            for k in 0..4 {
                let av: f64 = *((a + ((i*4+k) as u64)*8) as &f64);
                let bv: f64 = *((b + ((k*4+j) as u64)*8) as &f64);
                acc = acc + (av * bv);
            }
            *((c + ((i*4+j) as u64)*8) as &mut f64) = acc;
        }
    }
}

fn matmul_16x16(a: u64, b: u64, c: u64) {
    for i in 0..16 {
        for j in 0..16 {
            let mut acc: f64 = 0.0;
            for k in 0..16 {
                let av: f64 = *((a + ((i*16+k) as u64)*8) as &f64);
                let bv: f64 = *((b + ((k*16+j) as u64)*8) as &f64);
                acc = acc + (av * bv);
            }
            *((c + ((i*16+j) as u64)*8) as &mut f64) = acc;
        }
    }
}

fn fill(addr: u64, n: u32, val: f64) {
    let mut i: u32 = 0;
    while i < n*n { *((addr + (i as u64)*8) as &mut f64) = val; i = i + 1; }
}
fn zero(addr: u64, n: u32) { fill(addr, n, 0.0); }

// ============================================================================
// CDF extraction (10K sorted → percentiles[101] + p99.9 + p99.99)
// ============================================================================
fn extract_cdf(sorted: u64, stats: u64) {
    let mut p: i32 = 0;
    while p < 100 {
        *((stats + (p as u64)*8) as &mut i64) = *((sorted + (p as u64)*100*8) as &i64);
        p = p + 1;
    }
    *((stats + 100*8) as &mut i64) = *((sorted + 9999*8) as &i64);   // p100
    *((stats + 101*8) as &mut i64) = *((sorted + 9990*8) as &i64);   // p99.9
    *((stats + 102*8) as &mut i64) = *((sorted + 9999*8) as &i64);   // p99.99
}

fn get_p(stats: u64, p: i32) -> i64 { return *((stats + (p as u64)*8) as &i64); }
fn get_p999(stats: u64) -> i64 { return *((stats + 101*8) as &i64); }
fn get_p9999(stats: u64) -> i64 { return *((stats + 102*8) as &i64); }

fn main() -> i32 {
    // =========================================================================
    // T1: Quicksort unit test — 20-element unsorted → exact ascending
    // =========================================================================
    let qa: u64 = malloc(160);  // 20 × 8
    if qa == 0 { return 1; }

    let vals: [i64; 20] = [20, 3, 15, 1, 8, 17, 2, 19, 6, 12, 10, 4, 18, 7, 14, 5, 16, 9, 11, 13];
    let mut vi: i32 = 0;
    while vi < 20 {
        *((qa + (vi as u64)*8) as &mut i64) = vals[vi as u64];
        vi = vi + 1;
    }

    qsort(qa, 0, 19);

    let mut ci: i32 = 0;
    while ci < 20 {
        let expected: i64 = (ci + 1) as i64;
        let got: i64 = *((qa + (ci as u64)*8) as &i64);
        if got != expected { free(qa); return 2; }
        ci = ci + 1;
    }
    free(qa);

    // =========================================================================
    // T2: Already sorted [1..10] stays sorted
    // =========================================================================
    let qb: u64 = malloc(80);
    if qb == 0 { return 1; }
    let mut si: i32 = 0;
    while si < 10 {
        *((qb + (si as u64)*8) as &mut i64) = (si + 1) as i64;
        si = si + 1;
    }
    qsort(qb, 0, 9);
    let mut si2: i32 = 0;
    while si2 < 10 {
        if *((qb + (si2 as u64)*8) as &i64) != (si2 + 1) as i64 { free(qb); return 3; }
        si2 = si2 + 1;
    }

    // =========================================================================
    // T3: Reverse sorted [10..1] → [1..10]
    // =========================================================================
    let mut ri: i32 = 0;
    while ri < 10 {
        *((qb + (ri as u64)*8) as &mut i64) = (10 - ri) as i64;
        ri = ri + 1;
    }
    qsort(qb, 0, 9);
    let mut ri2: i32 = 0;
    while ri2 < 10 {
        if *((qb + (ri2 as u64)*8) as &i64) != (ri2 + 1) as i64 { free(qb); return 3; }
        ri2 = ri2 + 1;
    }
    free(qb);

    // =========================================================================
    // T4: Single element [42] → [42]
    // =========================================================================
    let qs: u64 = malloc(8);
    if qs == 0 { return 1; }
    *((qs) as &mut i64) = 42;
    qsort(qs, 0, 0);
    if *((qs) as &i64) != 42 { free(qs); return 3; }
    free(qs);

    // =========================================================================
    // T5: Static 4×4 matmul — A=1, B=2, C[i,j]=8.0
    // =========================================================================
    let mat: u64 = malloc(6144);
    if mat == 0 { return 1; }
    let a4: u64 = mat;
    let b4: u64 = mat + 128;
    let c4: u64 = mat + 256;
    fill(a4, 4, 1.0);
    fill(b4, 4, 2.0);
    zero(c4, 4);
    matmul_4x4(a4, b4, c4);
    let c00: f64 = *((c4) as &f64);
    if c00 > 8.1 || c00 < 7.9 { free(mat); return 4; }

    // =========================================================================
    // T6: Static 16×16 matmul — A=1, B=3, C[i,j]=48.0
    // =========================================================================
    let a16: u64 = mat;
    let b16: u64 = mat + 2048;
    let c16: u64 = mat + 4096;
    fill(a16, 16, 1.0);
    fill(b16, 16, 3.0);
    zero(c16, 16);
    matmul_16x16(a16, b16, c16);
    let c00_16: f64 = *((c16) as &f64);
    if c00_16 > 48.1 || c00_16 < 47.9 { free(mat); return 5; }

    // =========================================================================
    // T7: 10K harness with quicksort CDF
    // =========================================================================
    let samples: u64 = malloc(80000);
    let stats: u64 = malloc(824);   // 103 × 8
    if samples == 0 || stats == 0 { free(mat); return 1; }

    // Warmup: 1000 unmeasured
    fill(a4, 4, 1.0);
    fill(b4, 4, 2.0);
    let mut wi: i32 = 0;
    while wi < 1000 {
        zero(c4, 4);
        matmul_4x4(a4, b4, c4);
        wi = wi + 1;
    }

    // Measure: 10000 iterations
    let mut mi: i32 = 0;
    while mi < 10000 {
        zero(c4, 4);
        let ts: i64 = rdtsc();
        matmul_4x4(a4, b4, c4);
        let te: i64 = rdtsc();
        *((samples + (mi as u64)*8) as &mut i64) = te - ts;
        mi = mi + 1;
    }

    // O(N log N) sort + CDF
    qsort(samples, 0, 9999);
    extract_cdf(samples, stats);

    let p50: i64 = get_p(stats, 50);
    let p99: i64 = get_p(stats, 99);
    let p999: i64 = get_p999(stats);
    let p9999: i64 = get_p9999(stats);
    let p0: i64 = get_p(stats, 0);
    let p100: i64 = get_p(stats, 100);

    if p50 < 0 { free(samples); free(stats); free(mat); return 6; }
    if p99 < p50 { free(samples); free(stats); free(mat); return 6; }

    // =========================================================================
    // T8: CDF monotonicity
    // =========================================================================
    let p25: i64 = get_p(stats, 25);
    let p75: i64 = get_p(stats, 75);
    if p0 > p25 || p25 > p50 || p50 > p75 || p75 > p99 || p99 > p100 {
        free(samples); free(stats); free(mat);
        return 7;
    }

    // =========================================================================
    // T9: Deep tail chain — p99.99 ≥ p99.9 ≥ p99
    // =========================================================================
    if p999 < p99 || p9999 < p999 {
        free(samples); free(stats); free(mat);
        return 8;
    }

    // =========================================================================
    // T10: CPE scaling — 16×16 / 4×4
    // =========================================================================
    let samples16: u64 = malloc(80000);
    let stats16: u64 = malloc(824);
    if samples16 == 0 || stats16 == 0 { free(samples); free(stats); free(mat); return 1; }

    fill(a16, 16, 1.0);
    fill(b16, 16, 3.0);
    let mut w16: i32 = 0;
    while w16 < 1000 { zero(c16, 16); matmul_16x16(a16, b16, c16); w16 = w16 + 1; }

    let mut m16: i32 = 0;
    while m16 < 10000 {
        zero(c16, 16);
        let ts: i64 = rdtsc();
        matmul_16x16(a16, b16, c16);
        let te: i64 = rdtsc();
        *((samples16 + (m16 as u64)*8) as &mut i64) = te - ts;
        m16 = m16 + 1;
    }

    qsort(samples16, 0, 9999);
    extract_cdf(samples16, stats16);
    let median_16: i64 = get_p(stats16, 50);

    if p50 > 0 {
        let ratio: i64 = median_16 / p50;
        if ratio > 200 {
            free(samples16); free(stats16); free(samples); free(stats); free(mat);
            return 9;
        }
    }

    free(samples16);
    free(stats16);
    free(samples);
    free(stats);
    free(mat);
    return 0;
}
