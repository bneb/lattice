// =============================================================================
// Test: Asynchronous RX & CQE Wakeup (v4.3.0)
// =============================================================================
//
// The distributed loop test: PENDING → IRQ → CQE_READY → scheduler → RUNNING
//
//   T1:  PIC remap — 12 outb calls in ICW sequence
//   T2:  PIC — master mask = 0xFB (cascade unmasked)
//   T3:  PIC — slave mask = 0xF3 (IRQ10+11 unmasked)
//   T4:  RX queue — 256 descriptors with WRITE flag
//   T5:  RX queue — all 256 in avail ring, avail.idx = 256
//   T6:  RX buffer — desc[0] points to buf_pool, len=2048
//   T7:  IRQ handler — CQE[42] = READY after packet with token=42
//   T8:  IRQ handler — task_id=42 pushed to deque
//   T9:  IRQ handler — EOI written
//   T10: IRQ handler — drained count = 1
//   T11: Two-packet drain — CQE[7] and CQE[99] both READY
//   T12: matmul wakeup — 16x16 matmul after CQE strike
//
// Exit codes: 0=pass, 1=alloc, 2=pic, 3=rx_init, 4=rx_buf,
//             5=irq, 6=cqe, 7=deque, 8=multi, 9=matmul
// =============================================================================

package main

use std.core.ptr.Ptr

extern fn malloc(size: i64) -> u64;
extern fn free(ptr: u64);
extern fn salt_atomic_load_i64(ptr: Ptr<i64>) -> i64;
extern fn salt_atomic_cas_i64(ptr: Ptr<i64>, expected: i64, desired: i64) -> i64;

// ============================================================================
// Mock I/O ring buffer (from UART test pattern)
// ============================================================================
const MOCK_IO_CAP: i32 = 256;
const MOCK_IO_SIZE: i64 = 1032;  // 8 + 256*4

global G_IO: u64 = 0;

fn mock_io_alloc() -> u64 {
    let buf: u64 = malloc(MOCK_IO_SIZE);
    let mut i: i64 = 0;
    while i < MOCK_IO_SIZE { *((buf + (i as u64)) as &mut u8) = 0; i = i + 1; }
    return buf;
}

fn mock_io_reset(buf: u64) {
    let mut i: i64 = 0;
    while i < MOCK_IO_SIZE { *((buf + (i as u64)) as &mut u8) = 0; i = i + 1; }
}

fn mock_io_count(buf: u64) -> i32 { return *((buf) as &i32); }

fn mock_io_port(buf: u64, i: i32) -> u16 {
    let off: u64 = 8 + (i as u64) * 4;
    return ((*((buf + off) as &u8) as u16) << 8) | ((*((buf + off + 1) as &u8)) as u16);
}

fn mock_io_data(buf: u64, i: i32) -> u8 {
    return *((buf + 8 + (i as u64) * 4 + 2) as &u8);
}

@no_mangle
pub fn kernel_outb(port: u16, data: u8) {
    if G_IO == 0 { return; }
    let idx: i32 = *((G_IO) as &i32);
    if idx >= MOCK_IO_CAP { return; }
    let off: u64 = 8 + (idx as u64) * 4;
    *((G_IO + off) as &mut u8) = ((port >> 8) & 0xFF) as u8;
    *((G_IO + off + 1) as &mut u8) = (port & 0xFF) as u8;
    *((G_IO + off + 2) as &mut u8) = data;
    *((G_IO) as &mut i32) = idx + 1;
}

@no_mangle
pub fn kernel_inb(port: u16) -> u8 { return 0xFF; }

// ============================================================================
// Arena and structure constants
// ============================================================================
const ARENA_SIZE: i64 = 655360;  // 640KB for test

const RX_DESC_OFFSET:    u64 = 0x30000;
const RX_AVAIL_OFFSET:   u64 = 0x31000;
const RX_USED_OFFSET:    u64 = 0x32000;
const RX_STATE_OFFSET:   u64 = 0x33000;
const CQE_ARRAY_OFFSET:  u64 = 0x34000;
const RX_BUFPOOL_OFFSET: u64 = 0x40000;
const DEQUE_OFFSET:      u64 = 0x1000;

const DESC_SIZE: u64 = 16;
const AVAIL_IDX_OFF: u64 = 2;
const AVAIL_RING_OFF: u64 = 4;
const USED_IDX_OFF: u64 = 2;
const USED_RING_OFF: u64 = 4;
const USED_ELEM_SIZE: u64 = 8;
const RX_BUF_SIZE: u64 = 2048;
const VRING_DESC_F_WRITE: u16 = 2;
const DEQUE_BOTTOM_OFF: u64 = 512;
const DEQUE_ARRAY_SIZE: i64 = 64;

const CQE_PENDING: u64 = 0;
const CQE_READY: u64 = 1;

fn zero_init(addr: u64, size: u64) {
    let mut i: u64 = 0;
    while i < size { *((addr + i) as &mut u8) = 0; i = i + 1; }
}

fn init_rx_queue(arena: u64) {
    let desc: u64 = arena + RX_DESC_OFFSET;
    let avail: u64 = arena + RX_AVAIL_OFFSET;
    let pool: u64 = arena + RX_BUFPOOL_OFFSET;

    zero_init(desc, 4096);
    zero_init(avail, 516);
    zero_init(arena + RX_STATE_OFFSET, 16);

    let mut i: u16 = 0;
    while i < 256 {
        let db: u64 = desc + (i as u64) * DESC_SIZE;
        *((db) as &mut u64) = pool + (i as u64) * RX_BUF_SIZE;
        *((db + 8) as &mut u32) = RX_BUF_SIZE as u32;
        *((db + 12) as &mut u16) = VRING_DESC_F_WRITE;
        *((db + 14) as &mut u16) = 0;
        *((avail + AVAIL_RING_OFF + (i as u64) * 2) as &mut u16) = i;
        i = i + 1;
    }
    *((avail + AVAIL_IDX_OFF) as &mut u16) = 256;
}

fn handle_virtio_irq(arena: u64, ack_addr: u64) -> u32 {
    let used_ring: u64 = arena + RX_USED_OFFSET;
    let rx_state: u64 = arena + RX_STATE_OFFSET;
    let pool: u64 = arena + RX_BUFPOOL_OFFSET;
    let cqe: u64 = arena + CQE_ARRAY_OFFSET;
    let deque: u64 = arena + DEQUE_OFFSET;

    let used_idx: u16 = *((used_ring + USED_IDX_OFF) as &u16);
    let last_seen: u16 = (*((rx_state) as &u64)) as u16;

    let mut drained: u32 = 0;
    let mut seen: u16 = last_seen;

    while seen != used_idx {
        let rp: u16 = seen % 256;
        let eo: u64 = USED_RING_OFF + (rp as u64) * USED_ELEM_SIZE;
        let desc_id: u32 = *((used_ring + eo) as &u32);
        let buf: u64 = pool + (desc_id as u64) * RX_BUF_SIZE;
        let token: u64 = *((buf) as &u64);

        if token < 256 {
            *((cqe + token * 8) as &mut u64) = CQE_READY;
        }

        let bp: Ptr<i64> = (deque + DEQUE_BOTTOM_OFF) as Ptr<i64>;
        let b: i64 = salt_atomic_load_i64(bp);
        let di: i64 = b % DEQUE_ARRAY_SIZE;
        *((deque + (di as u64) * 8) as &mut i64) = token as i64;
        let _: i64 = salt_atomic_cas_i64(bp, b, b + 1);

        seen = seen + 1;
        drained = drained + 1;
    }

    *((rx_state) as &mut u64) = seen as u64;
    let pc: u64 = *((rx_state + 8) as &u64);
    *((rx_state + 8) as &mut u64) = pc + (drained as u64);

    *((ack_addr) as &mut u8) = 0x20;
    return drained;
}

fn remap_pic() {
    let _m1: u8 = kernel_inb(0x21);
    let _m2: u8 = kernel_inb(0xA1);
    kernel_outb(0x20, 0x11);
    kernel_outb(0xA0, 0x11);
    kernel_outb(0x21, 0x20);
    kernel_outb(0xA1, 0x28);
    kernel_outb(0x21, 0x04);
    kernel_outb(0xA1, 0x02);
    kernel_outb(0x21, 0x01);
    kernel_outb(0xA1, 0x01);
    kernel_outb(0x21, 0xFB);
    kernel_outb(0xA1, 0xF3);
}

fn inject_packet(arena: u64, used_slot: u16, desc_id: u32, token: u64) {
    let pool: u64 = arena + RX_BUFPOOL_OFFSET;
    let buf: u64 = pool + (desc_id as u64) * RX_BUF_SIZE;
    *((buf) as &mut u64) = token;
    *((buf + 8) as &mut u32) = 512;
    *((buf + 12) as &mut u32) = 0;

    let used_ring: u64 = arena + RX_USED_OFFSET;
    let rp: u16 = used_slot % 256;
    let eo: u64 = USED_RING_OFF + (rp as u64) * USED_ELEM_SIZE;
    *((used_ring + eo) as &mut u32) = desc_id;
    *((used_ring + eo + 4) as &mut u32) = 528;

    *((used_ring + USED_IDX_OFF) as &mut u16) = used_slot + 1;
}

fn matmul_16x16(a: u64, b: u64, c: u64) {
    let mut i: i32 = 0;
    while i < 16 {
        let mut j: i32 = 0;
        while j < 16 {
            let mut sum: f64 = 0.0;
            let mut k: i32 = 0;
            while k < 16 {
                let av: f64 = *((a + ((i * 16 + k) as u64) * 8) as &f64);
                let bv: f64 = *((b + ((k * 16 + j) as u64) * 8) as &f64);
                sum = sum + av * bv;
                k = k + 1;
            }
            *((c + ((i * 16 + j) as u64) * 8) as &mut f64) = sum;
            j = j + 1;
        }
        i = i + 1;
    }
}

fn cleanup(a: u64, b: u64, c: u64) { free(a); free(b); free(c); }

fn main() -> i32 {
    let io: u64 = mock_io_alloc();
    if io == 0 { return 1; }
    G_IO = io;

    let arena: u64 = malloc(ARENA_SIZE);
    if arena == 0 { free(io); return 1; }
    zero_init(arena, ARENA_SIZE as u64);

    let ack: u64 = malloc(8);
    if ack == 0 { free(arena); free(io); return 1; }
    zero_init(ack, 8);

    // =========================================================================
    // T1-T3: PIC remap
    // =========================================================================
    mock_io_reset(io);
    remap_pic();

    let nc: i32 = mock_io_count(io);
    if nc != 10 { cleanup(io, arena, ack); return 2; }

    // T2: Master mask outb(0x21, 0xFB) — call index 8
    if mock_io_port(io, 8) != 0x0021 || mock_io_data(io, 8) != 0xFB {
        cleanup(io, arena, ack); return 2;
    }
    // T3: Slave mask outb(0xA1, 0xF3) — call index 9
    if mock_io_port(io, 9) != 0x00A1 || mock_io_data(io, 9) != 0xF3 {
        cleanup(io, arena, ack); return 2;
    }

    // =========================================================================
    // T4-T6: RX queue initialization
    // =========================================================================
    init_rx_queue(arena);

    // T4: Check descriptor[0] has WRITE flag
    let d0_flags: u16 = *((arena + RX_DESC_OFFSET + 12) as &u16);
    if d0_flags != VRING_DESC_F_WRITE { cleanup(io, arena, ack); return 3; }

    // T4b: Check descriptor[255]
    let d255_flags: u16 = *((arena + RX_DESC_OFFSET + 255 * DESC_SIZE + 12) as &u16);
    if d255_flags != VRING_DESC_F_WRITE { cleanup(io, arena, ack); return 3; }

    // T5: avail.idx = 256
    let avail_idx: u16 = *((arena + RX_AVAIL_OFFSET + AVAIL_IDX_OFF) as &u16);
    if avail_idx != 256 { cleanup(io, arena, ack); return 3; }

    // T5b: avail.ring[0] = 0, avail.ring[255] = 255
    let ar0: u16 = *((arena + RX_AVAIL_OFFSET + AVAIL_RING_OFF) as &u16);
    let ar255: u16 = *((arena + RX_AVAIL_OFFSET + AVAIL_RING_OFF + 255 * 2) as &u16);
    if ar0 != 0 || ar255 != 255 { cleanup(io, arena, ack); return 3; }

    // T6: desc[0] points to buf_pool, len=2048
    let d0_addr: u64 = *((arena + RX_DESC_OFFSET) as &u64);
    if d0_addr != arena + RX_BUFPOOL_OFFSET { cleanup(io, arena, ack); return 4; }
    let d0_len: u32 = *((arena + RX_DESC_OFFSET + 8) as &u32);
    if d0_len != 2048 { cleanup(io, arena, ack); return 4; }

    // =========================================================================
    // T7-T10: Single packet IRQ — token=42
    // =========================================================================
    // Inject a mock packet into desc[5] with token=42
    inject_packet(arena, 0, 5, 42);

    let drained: u32 = handle_virtio_irq(arena, ack);

    // T7: CQE[42] = READY
    let cqe42: u64 = *((arena + CQE_ARRAY_OFFSET + 42 * 8) as &u64);
    if cqe42 != CQE_READY { cleanup(io, arena, ack); return 6; }

    // T8: task_id=42 on deque (slot 0)
    let deque_val: i64 = *((arena + DEQUE_OFFSET) as &i64);
    if deque_val != 42 { cleanup(io, arena, ack); return 7; }

    // T8b: deque bottom = 1
    let dbp: Ptr<i64> = (arena + DEQUE_OFFSET + DEQUE_BOTTOM_OFF) as Ptr<i64>;
    let db: i64 = salt_atomic_load_i64(dbp);
    if db != 1 { cleanup(io, arena, ack); return 7; }

    // T9: EOI written
    let eoi: u8 = *((ack) as &u8);
    if eoi != 0x20 { cleanup(io, arena, ack); return 5; }

    // T10: drained = 1
    if drained != 1 { cleanup(io, arena, ack); return 5; }

    // =========================================================================
    // T11: Two-packet drain — tokens 7 and 99
    // =========================================================================
    zero_init(ack, 8);
    inject_packet(arena, 1, 10, 7);
    inject_packet(arena, 2, 20, 99);

    let drained2: u32 = handle_virtio_irq(arena, ack);
    if drained2 != 2 { cleanup(io, arena, ack); return 8; }

    let cqe7: u64 = *((arena + CQE_ARRAY_OFFSET + 7 * 8) as &u64);
    let cqe99: u64 = *((arena + CQE_ARRAY_OFFSET + 99 * 8) as &u64);
    if cqe7 != CQE_READY || cqe99 != CQE_READY { cleanup(io, arena, ack); return 8; }

    // =========================================================================
    // T12: matmul wakeup — CQE strike → 16x16 matmul
    // =========================================================================
    let mat_a: u64 = malloc(2048);  // 16×16×8 = 2048
    let mat_b: u64 = malloc(2048);
    let mat_c: u64 = malloc(2048);
    if mat_a == 0 || mat_b == 0 || mat_c == 0 { cleanup(io, arena, ack); return 1; }

    // Fill A=1.0, B=3.0
    let mut mi: i32 = 0;
    while mi < 256 {
        *((mat_a + (mi as u64) * 8) as &mut f64) = 1.0;
        *((mat_b + (mi as u64) * 8) as &mut f64) = 3.0;
        *((mat_c + (mi as u64) * 8) as &mut f64) = 0.0;
        mi = mi + 1;
    }

    // Simulate: CQE was struck → scheduler pops task → coroutine runs matmul
    let token_42_ready: u64 = *((arena + CQE_ARRAY_OFFSET + 42 * 8) as &u64);
    if token_42_ready != CQE_READY {
        free(mat_a); free(mat_b); free(mat_c);
        cleanup(io, arena, ack); return 9;
    }

    // Execute the polyhedral math
    matmul_16x16(mat_a, mat_b, mat_c);

    // C[0,0] = sum of 16 * (1.0 * 3.0) = 48.0
    let c00: f64 = *((mat_c) as &f64);
    if c00 != 48.0 {
        free(mat_a); free(mat_b); free(mat_c);
        cleanup(io, arena, ack); return 9;
    }
    // C[15,15] = same
    let c1515: f64 = *((mat_c + 255 * 8) as &f64);
    if c1515 != 48.0 {
        free(mat_a); free(mat_b); free(mat_c);
        cleanup(io, arena, ack); return 9;
    }

    free(mat_a); free(mat_b); free(mat_c);
    cleanup(io, arena, ack);
    return 0;
}
