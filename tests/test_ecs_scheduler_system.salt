// =============================================================================
// test_ecs_scheduler_system.salt — Scheduler System Unit Test
// =============================================================================
// RED-TO-GREEN: Validates priority and core-affinity aware dispatching.
// =============================================================================

package main

import kernel.ecs.entity.Entity
import kernel.ecs.world.{World, new_world, world_spawn}
import kernel.ecs.components.{ThreadState, SchedulingPriority, CpuAffinity}
import kernel.ecs.sparse_set.{
    thread_set_insert, priority_set_insert, affinity_set_insert, thread_set_get
}
import kernel.ecs.ecs_scheduler.{scheduler_system_tick}

extern fn println(s: Ptr<u8>);

fn main() -> i32 {
    let w = new_world();
    
    // Spawn 3 threads:
    // e1: RUNNABLE (status=1), priority level 2, affinity core 0
    // e2: RUNNABLE (status=1), priority level 1, affinity core 0 (highest on core 0)
    // e3: RUNNABLE (status=1), priority level 0, affinity core 1 (highest overall but different core)
    
    let e1 = world_spawn(w);
    let e2 = world_spawn(w);
    let e3 = world_spawn(w);
    
    thread_set_insert(w[0].threads, e1, ThreadState { status: 1, stack_ptr: 0x1000, stack_base: 0, step_fn: 0, task_frame: 0, ctx_ptr: 0x1000 });
    priority_set_insert(w[0].priorities, e1, SchedulingPriority { level: 2, tickets: 0 });
    affinity_set_insert(w[0].cpu_affinities, e1, CpuAffinity { core_id: 0, migration_count: 0 });
    
    thread_set_insert(w[0].threads, e2, ThreadState { status: 1, stack_ptr: 0x2000, stack_base: 0, step_fn: 0, task_frame: 0, ctx_ptr: 0x2000 });
    priority_set_insert(w[0].priorities, e2, SchedulingPriority { level: 1, tickets: 0 });
    affinity_set_insert(w[0].cpu_affinities, e2, CpuAffinity { core_id: 0, migration_count: 0 });
    
    thread_set_insert(w[0].threads, e3, ThreadState { status: 1, stack_ptr: 0x3000, stack_base: 0, step_fn: 0, task_frame: 0, ctx_ptr: 0x3000 });
    priority_set_insert(w[0].priorities, e3, SchedulingPriority { level: 0, tickets: 0 });
    affinity_set_insert(w[0].cpu_affinities, e3, CpuAffinity { core_id: 1, migration_count: 0 });
    
    // Tick scheduler for core 0 -> should select e2
    let selected = scheduler_system_tick(w, 0);
    if selected.id != e2.id {
        println("FAIL: Selected wrong thread for core 0");
        return 1;
    }
    
    // Verify e2 status transitioned to RUNNING (2)
    let t2 = thread_set_get(w[0].threads, e2);
    if t2[0].status != 2 {
        println("FAIL: Selected thread status not RUNNING");
        return 2;
    }
    
    // Tick scheduler for core 1 -> should select e3
    let selected_1 = scheduler_system_tick(w, 1);
    if selected_1.id != e3.id {
        println("FAIL: Selected wrong thread for core 1");
        return 3;
    }
    
    println("All ECS scheduler system tests PASSED!");
    return 0;
}
