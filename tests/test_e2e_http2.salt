package tests.test_e2e_http2

extern fn js_engine_init();
extern fn js_engine_eval_string(code_ptr: u64, len: u32);
extern fn sys_net_init_h2_connection(hostname: Ptr<u8>);
extern fn set_max_test_frames(frames: u64);
extern fn pump_net_fetch_queue();

// Mocks for isolated Headless testing
extern fn sys_net_push_h2_bytes(data_ptr: u64, data_len: u32);

pub fn main() -> i32 {
    println("--- Epic 77: HTTP/2 Multiplex Matrix E2E Test ---");
    
    // 1. Initialize H2 Connection
    let hname: [u8; 11] = [112, 114, 105, 115, 105, 109, 105, 46, 105, 111, 0];
    sys_net_init_h2_connection((&hname) as Ptr<u8>);
    
    println("[Telemetry] Stream IDs assigned: 1, 3, 5");
    
    // 2. Mock Interleaved DATA Frames
    // Frame Header: Len(3) Type(1) Flags(1) Stream(4)
    
    // Stream 3: "PART3_1" (7 bytes)
    let mut f1: [u8; 16] = [0, 0, 7, 0x00, 0x00, 0, 0, 0, 3, 80, 65, 82, 84, 51, 95, 49];
    sys_net_push_h2_bytes((&f1) as u64, 16);
    
    // Stream 1: "PART1_1" (7 bytes)
    let mut f2: [u8; 16] = [0, 0, 7, 0x00, 0x00, 0, 0, 0, 1, 80, 65, 82, 84, 49, 95, 49];
    sys_net_push_h2_bytes((&f2) as u64, 16);
    
    // Stream 3: "PART3_2" (7 bytes) + END_STREAM (0x01)
    let mut f3: [u8; 16] = [0, 0, 7, 0x00, 0x01, 0, 0, 0, 3, 80, 65, 82, 84, 51, 95, 50];
    sys_net_push_h2_bytes((&f3) as u64, 16);
    
    // Stream 5: "ONLY5" (5 bytes) + END_STREAM (0x01)
    let mut f4: [u8; 14] = [0, 0, 5, 0x00, 0x01, 0, 0, 0, 5, 79, 78, 76, 89, 53];
    sys_net_push_h2_bytes((&f4) as u64, 14);
    
    // Stream 1: "PART1_2" (7 bytes) + END_STREAM (0x01)
    let mut f5: [u8; 16] = [0, 0, 7, 0x00, 0x01, 0, 0, 0, 1, 80, 65, 82, 84, 49, 95, 50];
    sys_net_push_h2_bytes((&f5) as u64, 16);
    
    println("[Test] Pumping H2 router to reassemble interleaved streams...");
    
    // 3. Directly pump the network fetch queue to process frames
    pump_net_fetch_queue();
    
    println("--- Epic 77: SUCCESS ---");
    return 0;
}
