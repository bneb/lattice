// =========================================================================
// Wave 3: Deep Integration (JSC → Salt DOM round-trip)
// =========================================================================

// ---------------------------------------------------------------------------
// 13. id deep integration: set id, then getElementById should find the node
// ---------------------------------------------------------------------------
fn test_id_deep_integration() {
    println("[TEST] id → getElementById round-trip...");
    let js = "
        var div = document.createElement('div');
        div.id = 'deep-test-99';
        // getElementById should find this node in the Salt DOM
        var found = document.getElementById('deep-test-99');
        if (found && found.node_index === div.node_index) {
            print('  PASS ✓');
        } else {
            print('  FAIL: getElementById returned ' + (found ? found.node_index : 'null') + ', expected ' + div.node_index);
        }
    ";
    sys_jsc_evaluate_script(js.ptr as u64, js.len as u32, 0);
}

// ---------------------------------------------------------------------------
// 14. childNodes array has correct length
// ---------------------------------------------------------------------------
fn test_childNodes_array() {
    println("[TEST] childNodes length...");
    let js = "
        var parent = document.createElement('div');
        parent.appendChild(document.createElement('span'));
        parent.appendChild(document.createElement('span'));
        parent.appendChild(document.createElement('span'));
        var cn = parent.childNodes;
        if (cn && cn.length === 3) {
            print('  PASS ✓');
        } else {
            print('  FAIL: childNodes.length=' + (cn ? cn.length : 'null'));
        }
    ";
    sys_jsc_evaluate_script(js.ptr as u64, js.len as u32, 0);
}

// ---------------------------------------------------------------------------
// 15. removeChild actually detaches from tree
// ---------------------------------------------------------------------------
fn test_removeChild() {
    println("[TEST] removeChild detaches from tree...");
    let js = "
        var parent = document.createElement('div');
        var a = document.createElement('span');
        var b = document.createElement('span');
        parent.appendChild(a);
        parent.appendChild(b);
        parent.removeChild(a);
        var cn = parent.childNodes;
        if (cn && cn.length === 1 && cn[0].node_index === b.node_index) {
            print('  PASS ✓');
        } else {
            print('  FAIL: childNodes.length=' + (cn ? cn.length : 'null'));
        }
    ";
    sys_jsc_evaluate_script(js.ptr as u64, js.len as u32, 0);
}

// =========================================================================
// Wave 4: Exhaustive remaining API coverage
// =========================================================================

fn test_insertBefore() {
    println("[TEST] insertBefore...");
    let js = "
        var p = document.createElement('div');
        var a = document.createElement('span');
        var b = document.createElement('span');
        p.appendChild(b);
        p.insertBefore(a, b);
        if (p.firstChild && p.firstChild.node_index === a.node_index) { print('  PASS ✓'); }
        else { print('  FAIL: insertBefore order wrong'); }
    ";
    sys_jsc_evaluate_script(js.ptr as u64, js.len as u32, 0);
}

fn test_replaceChild() {
    println("[TEST] replaceChild...");
    let js = "
        var p = document.createElement('div');
        var old = document.createElement('span');
        var nw = document.createElement('span');
        p.appendChild(old);
        var ret = p.replaceChild(nw, old);
        var fc = p.firstChild;
        if (fc && fc.node_index === nw.node_index) { print('  PASS ✓'); }
        else { print('  FAIL'); }
    ";
    sys_jsc_evaluate_script(js.ptr as u64, js.len as u32, 0);
}

fn test_removeAttribute() {
    println("[TEST] removeAttribute...");
    let js = "
        var div = document.createElement('div');
        div.id = 'rem-test';
        div.removeAttribute('id');
        if (div.id === '') { print('  PASS ✓'); }
        else { print('  FAIL: id=' + div.id); }
    ";
    sys_jsc_evaluate_script(js.ptr as u64, js.len as u32, 0);
}

fn test_click() {
    println("[TEST] click()...");
    let js = "
        var count = 0;
