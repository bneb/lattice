package tests.test_e2e_bridge_port

// observer_e2e_test (bridge marker — reuse observer stubs for headless linking)

import std.core.str

// JSC bridge externs
extern fn sys_jsc_init();
extern fn sys_jsc_evaluate_script(ptr: u64, len: u32, filename: u64);

// ============================================================================
// Epic 80A: Bridge Migration — TDD Test Suite
// Tests DOM API surface that must be available through the JSC path.
// Each test is RED until the corresponding JSC binding is ported.
// ============================================================================

pub fn main() {
    println("=== Epic 80A: Bridge Migration — TDD Test Suite ===");
    println("");

    sys_jsc_init();

    test_add_event_listener();
    test_set_get_attribute();
    test_style_property();
    test_append_child();
    test_inner_html();
    test_class_list();

    // Wave 2
    test_sibling_traversal();
    test_id_property();
    test_className_property();
    test_remove_event_listener();
    test_style_position();
    test_create_text_node();

    // Wave 3: Deep integration (JSC → Salt DOM round-trip)
    test_id_deep_integration();
    test_childNodes_array();
    test_removeChild();

    // Wave 4: Remaining 37 APIs — exhaustive coverage
    test_insertBefore();
    test_replaceChild();
    test_removeAttribute();
    test_click();
    test_attachShadow();
    test_nodeValue();
    test_scrollTop();
    test_setInterval_clearInterval();
    test_clearTimeout();
    test_cancelAnimationFrame();
    test_style_transform();
    test_style_flexGrow();
    test_customElements_define();
    test_fetch_exists();
    test_websocket_constructor();
    test_worker_constructor();
    test_mediasource_constructor();
    test_audiocontext_constructor();
    test_getSelection();
    test_history_pushState();
    test_url_createObjectURL();
    test_indexedDB();
    test_sw_register();
    test_window_self_ref();
    test_window_addEventListener();
    test_document_addEventListener();
    test_document_body();
    test_postMessage();
    test_getContext();

    println("");
    println("=== Epic 80A Tests Complete ===");
}

// ---------------------------------------------------------------------------
// 1. addEventListener + dispatchEvent
//    RED: JSC path has no addEventListener on Node objects.
// ---------------------------------------------------------------------------
fn test_add_event_listener() {
    println("[TEST] addEventListener / dispatchEvent...");
    let js = "
        var clickCount = 0;
        var div = document.createElement('div');
        div.addEventListener('click', function(e) {
            clickCount++;
        });
        // Synthesize a click event
        var event = new Event('click');
        div.dispatchEvent(event);
        if (clickCount === 1) {
            print('  PASS ✓');
        } else {
            print('  FAIL: clickCount = ' + clickCount);
        }
    ";
    sys_jsc_evaluate_script(js.ptr as u64, js.len as u32, 0);
}

// ---------------------------------------------------------------------------
// 2. setAttribute / getAttribute
//    RED: JSC path has no attribute manipulation.
// ---------------------------------------------------------------------------
fn test_set_get_attribute() {
    println("[TEST] setAttribute / getAttribute...");
    let js = "
        var div = document.createElement('div');
        div.setAttribute('data-id', '42');
        var val = div.getAttribute('data-id');
        if (val === '42') {
            print('  PASS ✓');
        } else {
            print('  FAIL: getAttribute returned ' + val);
        }
    ";
    sys_jsc_evaluate_script(js.ptr as u64, js.len as u32, 0);
}

// ---------------------------------------------------------------------------
// 3. element.style.* property access
//    RED: JSC path has no style object.
// ---------------------------------------------------------------------------
fn test_style_property() {
    println("[TEST] element.style property...");
    let js = "
        var div = document.createElement('div');
        div.style.backgroundColor = 'red';
        div.style.width = '100px';
        // Just verify it doesn't crash and the object exists
        if (typeof div.style === 'object') {
            print('  PASS ✓');
        } else {
            print('  FAIL: style is ' + typeof div.style);
        }
    ";
    sys_jsc_evaluate_script(js.ptr as u64, js.len as u32, 0);
}

// ---------------------------------------------------------------------------
// 4. appendChild + parentNode + children
//    Tests tree manipulation through the JSC path.
//    Note: parentNode returns a NEW wrapper object, so we compare node_index
//    rather than object identity (===).
// ---------------------------------------------------------------------------
fn test_append_child() {
    println("[TEST] appendChild / parentNode / children...");
    let js = "
        var parent = document.createElement('div');
        var child = document.createElement('span');
        parent.appendChild(child);
        var pn = child.parentNode;
        if (pn && pn.node_index === parent.node_index) {
            print('  PASS ✓');
        } else {
            print('  FAIL: parentNode node_index=' + (pn ? pn.node_index : 'null') + ', expected=' + parent.node_index);
        }
    ";
    sys_jsc_evaluate_script(js.ptr as u64, js.len as u32, 0);
}

// ---------------------------------------------------------------------------
// 5. innerHTML (simplified: sets textContent, full HTML parse is Phase 2)
// ---------------------------------------------------------------------------
fn test_inner_html() {
    println("[TEST] innerHTML...");
    let js = "
        var div = document.createElement('div');
        div.innerHTML = '<span>hello</span>';
        // Phase 1: innerHTML delegates to textContent (no HTML parsing yet)
        // So we verify the raw string was stored and is retrievable
        var content = div.textContent;
        if (content && content.length > 0) {
            print('  PASS ✓');
        } else {
            print('  FAIL: innerHTML/textContent was empty');
        }
    ";
    sys_jsc_evaluate_script(js.ptr as u64, js.len as u32, 0);
}

// ---------------------------------------------------------------------------
// 6. classList (add / remove / contains / toggle)
//    RED: JSC path has no classList.
// ---------------------------------------------------------------------------
fn test_class_list() {
    println("[TEST] classList...");
    let js = "
        var div = document.createElement('div');
        div.classList.add('foo');
        div.classList.add('bar');
        if (div.classList.contains('foo') && div.classList.contains('bar')) {
            div.classList.remove('foo');
            if (!div.classList.contains('foo') && div.classList.contains('bar')) {
                print('  PASS ✓');
            } else {
                print('  FAIL: remove did not work');
            }
        } else {
            print('  FAIL: add did not work');
        }
    ";
    sys_jsc_evaluate_script(js.ptr as u64, js.len as u32, 0);
}

// =========================================================================
// Wave 2: DOM Traversal Properties + document.addEventListener
// =========================================================================

// ---------------------------------------------------------------------------
// 7. firstChild / nextSibling
// ---------------------------------------------------------------------------
fn test_sibling_traversal() {
    println("[TEST] firstChild / nextSibling...");
    let js = "
        var parent = document.createElement('div');
        var a = document.createElement('span');
        var b = document.createElement('span');
        parent.appendChild(a);
        parent.appendChild(b);
        var fc = parent.firstChild;
        if (fc && fc.node_index === a.node_index) {
            var ns = fc.nextSibling;
            if (ns && ns.node_index === b.node_index) {
                print('  PASS ✓');
            } else {
                print('  FAIL: nextSibling mismatch');
            }
        } else {
            print('  FAIL: firstChild mismatch, got ' + (fc ? fc.node_index : 'null'));
        }
    ";
    sys_jsc_evaluate_script(js.ptr as u64, js.len as u32, 0);
}

