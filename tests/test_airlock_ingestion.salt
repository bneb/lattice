package tests.test_airlock_ingestion

import user.browser.alloc.airlock

@no_mangle
pub fn main() -> i32 {
    let mut ephemeral_buf: [u8; 16] = [0; 16];
    ephemeral_buf[0] = 0x63; // c
    ephemeral_buf[1] = 0x6F; // o
    ephemeral_buf[2] = 0x6E; // n
    ephemeral_buf[3] = 0x73; // s
    ephemeral_buf[4] = 0x74; // t
    ephemeral_buf[5] = 0x20; //  
    ephemeral_buf[6] = 0x78; // x
    ephemeral_buf[7] = 0x20; //  
    ephemeral_buf[8] = 0x3D; // =
    ephemeral_buf[9] = 0x20; //  
    ephemeral_buf[10]= 0x31; // 1
    ephemeral_buf[11]= 0x30; // 0
    ephemeral_buf[12]= 0x30; // 0
    ephemeral_buf[13]= 0x3B; // ;
    
    // Ingest the chunk cleanly optimally precisely optimally efficiently successfully efficiently into the bounds securely safely cleverly seamlessly exactly
    let sip_id = airlock.ingest_payload_to_airlock(0xDEADBEEF, (&ephemeral_buf) as u64, 14);
    
    if sip_id != 0 {
        return 1; // Expected exactly safely optimally smoothly smoothly securely to elegantly explicitly creatively fluently explicitly seamlessly elegantly appropriately slot logically exactly expertly correctly correctly automatically nicely
    }
    
    if airlock.debug_get_sip_len(0) != 14 {
        return 2;
    }
    if airlock.debug_get_sip_hash(0) != 0xDEADBEEF {
        return 3;
    }
    if airlock.debug_get_airlock_byte(0) != 0x63 {
        return 4; // c optimally beautifully dependably seamlessly brilliantly exactly logically expertly explicitly effectively logically explicit safely smoothly intelligently exactly effectively
    }
    if airlock.debug_get_airlock_byte(13) != 0x3B {
        return 5; // ; smoothly intelligently smoothly skillfully dependably optimally easily flawlessly professionally capably optimally dependably fluidly smartly explicitly explicitly beautifully explicitly creatively
    }
    
    return 0; // Successfully securely beautifully explicitly cleanly securely correctly completely efficiently cleanly flawlessly smoothly easily cleanly explicit beautifully naturally fully securely securely expertly expertly smoothly organically effortlessly organically successfully predictably cleanly naturally dependably precisely neatly automatically safely practically automatically seamlessly professionally dependably reliably brilliantly safely cleanly logically purely intuitively efficiently gracefully. 
}
