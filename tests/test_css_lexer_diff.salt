// tests/test_css_lexer_diff.salt — Expanded IR format
extern fn sys_print_u32(u: u32);
extern fn sys_print_i32(i: i32);
extern fn sys_log_info(msg_ptr: u64, msg_len: u32);
extern fn init_css_lexer_arrays();
extern fn css_lex_stylesheet(ptr: u64, len: u32, scope: u32);
extern fn ext_get_mock_css_ptr() -> u64;
extern fn ext_get_mock_css_len() -> u32;

// Rule Store Getters
extern fn css_get_rule_hash(slot: u32) -> u32;
extern fn css_get_rule_display(slot: u32) -> u8;
extern fn css_get_rule_flex_grow(slot: u32) -> i32;
extern fn css_get_rule_specificity(slot: u32) -> u16;
extern fn css_get_rule_width(slot: u32) -> i32;
extern fn css_get_rule_height(slot: u32) -> i32;
extern fn css_get_rule_flex_dir(slot: u32) -> u8;
extern fn css_get_rule_position(slot: u32) -> u8;
extern fn css_get_rule_top(slot: u32) -> i32;
extern fn css_get_rule_right(slot: u32) -> i32;
extern fn css_get_rule_bottom(slot: u32) -> i32;
extern fn css_get_rule_left(slot: u32) -> i32;
extern fn css_get_rule_z_index(slot: u32) -> i32;
extern fn css_get_rule_z_index_set(slot: u32) -> u8;
extern fn css_get_rule_bg_r(slot: u32) -> u8;
extern fn css_get_rule_bg_g(slot: u32) -> u8;
extern fn css_get_rule_bg_b(slot: u32) -> u8;
extern fn css_get_rule_bg_set(slot: u32) -> u8;

fn emit_str(ptr: u64, len: u32) {
    sys_log_info(ptr, len);
}

fn dump_css_rules() {
    let mut i: u32 = 0;
    while i < 4096 {
        let hash = css_get_rule_hash(i);
        if hash != 0 {
            let spec = css_get_rule_specificity(i);
            let disp = css_get_rule_display(i);
            let grow = css_get_rule_flex_grow(i);
            let width = css_get_rule_width(i);
            let height = css_get_rule_height(i);
            let flex_dir = css_get_rule_flex_dir(i);
            let pos = css_get_rule_position(i);
            let top = css_get_rule_top(i);
            let right = css_get_rule_right(i);
            let bottom = css_get_rule_bottom(i);
            let left = css_get_rule_left(i);
            let z_index = css_get_rule_z_index(i);
            let z_set = css_get_rule_z_index_set(i);
            let bg_r = css_get_rule_bg_r(i);
            let bg_g = css_get_rule_bg_g(i);
            let bg_b = css_get_rule_bg_b(i);
            let bg_set = css_get_rule_bg_set(i);
            
            // "RULE H="
            let m1: [u8; 7] = [82,85,76,69,32,72,61];
            emit_str((&m1) as u64, 7);
            sys_print_u32(hash);
            
            // " S="
            let m2: [u8; 3] = [32,83,61];
            emit_str((&m2) as u64, 3);
            sys_print_u32(spec as u32);
            
            // " D="
            let m3: [u8; 3] = [32,68,61];
            emit_str((&m3) as u64, 3);
            sys_print_u32(disp as u32);
            
            // " FG="
            let m4: [u8; 4] = [32,70,71,61];
            emit_str((&m4) as u64, 4);
            sys_print_i32(grow);
            
            // " W="
            let m5: [u8; 3] = [32,87,61];
            emit_str((&m5) as u64, 3);
            sys_print_i32(width);
            
            // " HT="
            let m6: [u8; 4] = [32,72,84,61];
            emit_str((&m6) as u64, 4);
            sys_print_i32(height);
            
            // " FD="
            let m7: [u8; 4] = [32,70,68,61];
            emit_str((&m7) as u64, 4);
            sys_print_u32(flex_dir as u32);
            
            // " POS="
            let m8: [u8; 5] = [32,80,79,83,61];
            emit_str((&m8) as u64, 5);
            sys_print_u32(pos as u32);
            
            // " T="
            let m9: [u8; 3] = [32,84,61];
            emit_str((&m9) as u64, 3);
            sys_print_i32(top);
            
            // " R="
            let m10: [u8; 3] = [32,82,61];
            emit_str((&m10) as u64, 3);
            sys_print_i32(right);
            
            // " B="
            let m11: [u8; 3] = [32,66,61];
            emit_str((&m11) as u64, 3);
            sys_print_i32(bottom);
            
            // " L="
            let m12: [u8; 3] = [32,76,61];
            emit_str((&m12) as u64, 3);
            sys_print_i32(left);
            
            // z-index (only if set)
            if z_set != 0 {
                // " Z="
                let m13: [u8; 3] = [32,90,61];
                emit_str((&m13) as u64, 3);
                sys_print_i32(z_index);
            }
            
            // background (only if set)
            if bg_set != 0 {
                // " BG="
                let m14: [u8; 4] = [32,66,71,61];
                emit_str((&m14) as u64, 4);
                sys_print_u32(bg_r as u32);
                // ","
                let m15: [u8; 1] = [44];
                emit_str((&m15) as u64, 1);
                sys_print_u32(bg_g as u32);
                emit_str((&m15) as u64, 1);
                sys_print_u32(bg_b as u32);
            }
            
            // newline
            let nl: [u8; 1] = [10];
            emit_str((&nl) as u64, 1);
        }
        i = i + 1;
    }
}

fn main() {
    init_css_lexer_arrays();
    
    let css_ptr = ext_get_mock_css_ptr();
    let css_len = ext_get_mock_css_len();
    
    if css_ptr == 0 || css_len == 0 {
        let m_err: [u8; 27] = [70,65,84,65,76,58,32,78,111,32,67,83,83,32,112,97,121,108,111,97,100,32,103,105,118,101,110];
        emit_str((&m_err) as u64, 27);
        return;
    }
    
    css_lex_stylesheet(css_ptr, css_len, 0);
    
    // "== CSS LEXER IR "
    let m_header: [u8; 16] = [61,61,32,67,83,83,32,76,69,88,69,82,32,73,82,32];
    emit_str((&m_header) as u64, 16);
    let nl: [u8; 1] = [10];
    emit_str((&nl) as u64, 1);
    
    dump_css_rules();
}
