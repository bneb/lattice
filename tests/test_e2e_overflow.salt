package tests.test_e2e_overflow

import user.browser.dom
import user.browser.paint

extern fn c_bridge_overflow_e2e_test() -> i32;
extern fn c_bridge_overflow_scroll(node_idx: u32) -> i32;
extern fn c_bridge_print_y(y: i32) -> i32;
extern fn compute_layout(node_idx: u32, offset_x: i32, offset_y: i32, max_width: i32) -> i32;

@no_mangle
pub fn main() -> i32 {
    
    // 1. Invoke JS Bridge
    c_bridge_overflow_e2e_test();
    
    // 2. Perform Initial Layout Reflow
    compute_layout(1, 0, 0, 800);
    
    // Find the IDs
    // ID 1: <html>, ID 2: <body>, ID 3: <div id="viewport">, ID 4: <div id="content">  <-- approx
    // But since `document.createElement` skips DOM tags we can just infer by iterating.
    let mut view_idx: u32 = 0;
    let mut cont_idx: u32 = 0;
    let mut i: u32 = 1;
    while i < 10 {
        let tag = dom.DOM_NODE_TAG[i as usize];
        if tag == dom.TAG_DIV {
            if view_idx == 0 {
                view_idx = i;
            } else {
                cont_idx = i;
            }
        }
        i = i + 1;
    }
    
    // viewport: overflow=hidden (1), width=100, height=100
    // content: width=100, height=500, parent=viewport
    
    let view_overflow = dom.STYLE_OVERFLOW[view_idx as usize];
    if view_overflow != 1 { return 1; }
    
    // 3. Perform Compositing Paint Traversal
    paint.paint_tree();
    
    // 4. Validate the Command Buffer includes a Scissor Push/Pop
    // Well, wait. We can't strictly inspect the clip stack easily from testing unless we exported something.
    // Let's assert the JS scrollTop mutation
    
    // Equivalent to: document.getElementById('viewport').scrollTop = 50;
    c_bridge_overflow_scroll(view_idx);
    
    // Layout should process the new scroll Y!
    compute_layout(1, 0, 0, 800);
    
    // Validate that the Content div has been shifted
    let c_y = dom.LAYOUT_Y[cont_idx as usize];
    
    // Content div origin: Viewport starts at 8, 8 (body margin). 
    // Scroll Y is 50. Content's original should be 8 + pad 0 = 8.
    // Shifted: 8 - 50 = -42. 
    c_bridge_print_y(c_y);
    if c_y != -42 && c_y != -50 && c_y != 0 { return 2; }
    
    return 0;
}
