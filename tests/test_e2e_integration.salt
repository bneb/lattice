package tests.test_e2e_integration

extern fn sys_exec_capture_stdout(cmd: u64, out_buf: u64, max_len: u32, out_len: u64);
extern fn sys_print_str(ptr: u64, len: u32);

pub global STDOUT_BUF: [u8; 1048576] = [0; 1048576]; // 1MB buffer

@no_mangle
pub fn main() -> u32 {
    let mut out_len: u32 = 0;
    
    let header_1: [u8; 21] = [61, 61, 61, 61, 61, 61, 61, 61, 61, 61, 61, 32, 84, 69, 83, 84, 73, 78, 71, 58, 32];
    let header_2: [u8; 13] = [32, 61, 61, 61, 61, 61, 61, 61, 61, 61, 61, 61, 10];
    
    let yt_url: [u8; 23] = [104, 116, 116, 112, 115, 58, 47, 47, 119, 119, 119, 46, 121, 111, 117, 116, 117, 98, 101, 46, 99, 111, 109];
    
    sys_print_str((&header_1) as u64, 21);
    sys_print_str((&yt_url) as u64, 23);
    sys_print_str((&header_2) as u64, 13);
    
    let cmd1: [u8; 63] = [47, 116, 109, 112, 47, 115, 97, 108, 116, 95, 98, 117, 105, 108, 100, 47, 112, 114, 105, 115, 105, 109, 105, 95, 114, 101, 110, 100, 101, 114, 101, 114, 32, 45, 45, 117, 114, 108, 32, 104, 116, 116, 112, 115, 58, 47, 47, 119, 119, 119, 46, 121, 111, 117, 116, 117, 98, 101, 46, 99, 111, 109, 0];
    sys_exec_capture_stdout((&cmd1) as u64, (&STDOUT_BUF) as u64, 1048576, (&mut out_len) as u64);
    
    let nl: [u8; 1] = [10];
    if out_len > 0 {
        sys_print_str((&STDOUT_BUF) as u64, out_len);
        sys_print_str((&nl) as u64, 1);
    }
    
    out_len = 0;
    let mail_url: [u8; 23] = [104, 116, 116, 112, 115, 58, 47, 47, 109, 97, 105, 108, 46, 103, 111, 111, 103, 108, 101, 46, 99, 111, 109];
    
    sys_print_str((&header_1) as u64, 21);
    sys_print_str((&mail_url) as u64, 23);
    sys_print_str((&header_2) as u64, 13);
    
    let cmd2: [u8; 63] = [47, 116, 109, 112, 47, 115, 97, 108, 116, 95, 98, 117, 105, 108, 100, 47, 112, 114, 105, 115, 105, 109, 105, 95, 114, 101, 110, 100, 101, 114, 101, 114, 32, 45, 45, 117, 114, 108, 32, 104, 116, 116, 112, 115, 58, 47, 47, 109, 97, 105, 108, 46, 103, 111, 111, 103, 108, 101, 46, 99, 111, 109, 0];
    sys_exec_capture_stdout((&cmd2) as u64, (&STDOUT_BUF) as u64, 1048576, (&mut out_len) as u64);
    
    if out_len > 0 {
        sys_print_str((&STDOUT_BUF) as u64, out_len);
        sys_print_str((&nl) as u64, 1);
    }
    
    return 0;
}
