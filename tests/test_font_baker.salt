package tests.test_font_baker

import user.browser.font

extern fn airlock_init_allocator();
extern fn init_arrays();

pub fn main() -> i32 {
    println("--- Epic 35: Typography Matrix SDF Baker Test ---");

    airlock_init_allocator();
    init_arrays();
    
    // This calls bake_sdf_atlas() in C through the extern
    font.init_glyphs();
    
    // Verify some metrics were baked
    // Index 65 is 'A'
    let a_w = font.GLYPH_METRICS[65].width;
    let a_h = font.GLYPH_METRICS[65].height;
    
    if a_w > 0.0 && a_h > 0.0 {
        println("[OK] Baked SDF atlas for 'A'");
    } else {
        println("[FAIL] 'A' glyph metrics zero");
        return 1;
    }
    
    // Check texture has some non-zero data
    let mut check: u32 = 0;
    let mut i: u32 = 0;
    while i < 10000 {
        if font.SDF_ATLAS[i as usize] > 0 {
            check = 1;
        }
        i = i + 1;
    }
    
    if check == 1 {
        println("[OK] SDF Atlas buffer populated");
    } else {
        println("[FAIL] SDF Atlas empty");
        return 1;
    }

    println("[Test] SUCCESS: Typography matrix baked successfully!");
    return 0;
}
