package tests.test_e2e_js_dom

// Link into critical DOM symbols (From dom.salt @no_mangle)
extern fn init_arrays();
extern fn create_node(tag: i32) -> u64;
extern fn resolve_node_by_id(ptr: u64, len: u32) -> u64;

// Link into lexer
extern fn js_lex_html_chunk(root_id: u64, ptr: u64, len: u32, can_execute: u8);

// Link into layout FFI (QuickJS execution handles pending jobs)
extern fn js_execute_pending_jobs() -> i32;
extern fn js_init_quickjs();
extern fn airlock_init_allocator();
extern fn sys_js_pump_script_queue();

// Access arrays directly to verify tests
extern fn resolve_node(id: u64) -> u32;
extern fn dom_get_first_child(idx: u32) -> u64;

pub fn main() -> i32 {
    println("--- Epic 47: QuickJS DOM Bridge E2E Telemetry Validation ---");
    
    airlock_init_allocator();
    init_arrays();
    js_init_quickjs();
    
    let root_node = create_node(3); // BODY
    
    // Minimal HTML fixture
    // <div id="root"></div><script>let child = document.createElement("div"); document.getElementById("root").appendChild(child);</script>
    let mut html: [u8; 132] = [
        60, 100, 105, 118, 32, 105, 100, 61, 34, 114, 111, 111, 116, 34, 62, 60, 
        47, 100, 105, 118, 62, 60, 115, 99, 114, 105, 112, 116, 62, 108, 101, 116, 
        32, 99, 104, 105, 108, 100, 32, 61, 32, 100, 111, 99, 117, 109, 101, 110, 
        116, 46, 99, 114, 101, 97, 116, 101, 69, 108, 101, 109, 101, 110, 116, 40, 
        34, 100, 105, 118, 34, 41, 59, 32, 100, 111, 99, 117, 109, 101, 110, 116, 
        46, 103, 101, 116, 69, 108, 101, 109, 101, 110, 116, 66, 121, 73, 100, 40, 
        34, 114, 111, 111, 116, 34, 41, 46, 97, 112, 112, 101, 110, 100, 67, 104, 
        105, 108, 100, 40, 99, 104, 105, 108, 100, 41, 59, 60, 47, 115, 99, 114, 
        105, 112, 116, 62
    ];
    let html_len = 132;
    
    // Execute Lexer natively inside Salt (this builds the DOM tree and fires QuickJS sync evals)
    js_lex_html_chunk(root_node, (&html) as u64, html_len, 1);
    
    // Explicitly flush the synchronous script queue eval engine
    sys_js_pump_script_queue();
    
    // Resolve "root" node bounds
    let mut root_str: [u8; 4] = [114, 111, 111, 116];
    let root_id = resolve_node_by_id((&root_str) as u64, 4);
    
    if root_id != 0xFFFFFFFFFFFFFFFF {
        let r_idx = resolve_node(root_id);
        let first_child = dom_get_first_child(r_idx);
        
        let c_id = dom_get_first_child(resolve_node(root_node));
        
        if first_child != 0 {
            println("[Test] SUCCESS: Lexer properly dispatched JS bridge, child mapped directly into DOM matrix!");
        } else {
            println("[Test] FAILURE: JavaScript execution failed to append child natively to Layout Arrays.");
            return 1;
        }
    } else {
        println("[Test] FAILURE: Lexer failed to map id attributes correctly.");
        return 1;
    }
    
    return 0;
}
