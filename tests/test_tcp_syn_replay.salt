// =============================================================================
// Test: TCP SYN Cookie Replay Vulnerability
// =============================================================================
// Validates that replaying a valid SYN-ACK cookie does not exhaust the TCP
// connection pool, and instead correctly resolves to the existing TCB.

import kernel.net.netd_tcp

fn main() -> i32 {
    netd_tcp.init();

    let src_ip: u32 = 0xC0A80101;
    let dst_ip: u32 = 0xC0A8010A;
    let src_port: u16 = 50000;
    let dst_port: u16 = 80;
    let client_isn: u32 = 12345;
    
    // Simulate SYN to get cookie
    let cookie = netd_tcp.handle_syn(src_ip, dst_ip, src_port, dst_port, client_isn);

    // Simulate first valid ACK
    let slot1 = netd_tcp.handle_ack(src_ip, dst_ip, src_port, dst_port, client_isn, cookie);
    if slot1 == 0xFFFFFFFF {
        return 1; // Failed to allocate TCB on valid ACK
    }

    // Attempt to flood with 2000 replayed ACKs
    let mut i: u32 = 0;
    while i < 2000 {
        let slot2 = netd_tcp.handle_ack(src_ip, dst_ip, src_port, dst_port, client_isn, cookie);
        if slot2 != slot1 {
            return 2; // Vulnerable to SYN cookie replay pool exhaustion!
        }
        i = i + 1;
    }

    // Verify pool is not exhausted (active count should be 1)
    if netd_tcp.active_count() != 1 {
        return 3;
    }

    return 0; // Success
}
