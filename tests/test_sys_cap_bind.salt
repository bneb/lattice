// =============================================================================
// Test: SYS_CAP_BIND — Full End-to-End System Call
// =============================================================================
// Validates the complete flow:
//   1. Mock ECAM region with planted devices
//   2. Mock capability registry
//   3. Call sys_cap_bind() for a target device
//   4. Assert: valid CapabilityID returned
//   5. Assert: registry contains correct BAR address
//   6. Assert: second bind returns a different CapabilityID
//   7. Assert: missing device returns 0
//
// Exit codes:
//   0 = all passed
//   1 = allocation failure
//   2 = first cap_bind returned 0 (should find device)
//   3 = registry lookup returned wrong BAR address
//   4 = second cap_bind returned same ID as first
//   5 = missing device cap_bind returned non-zero
//   6 = second registry lookup wrong
// =============================================================================

package main

use std.core.ptr.Ptr

extern fn malloc(size: i64) -> u64;
extern fn free(ptr: u64);

// ============================================================================
// Inline CapabilityRegistry (same logic as kernel module)
// ============================================================================
struct CapRegistry {
    addresses: Ptr<u64>,
    next_id: u32,
    max_caps: u32,
}

fn registry_new(buffer_addr: u64, max_caps: u32) -> CapRegistry {
    let ptr: Ptr<u64> = buffer_addr as Ptr<u64>;
    let mut i: i64 = 0;
    while i < (max_caps as i64) {
        ptr.offset(i).write(0);
        i = i + 1;
    }
    return CapRegistry {
        addresses: ptr,
        next_id: 1,
        max_caps: max_caps,
    };
}

fn registry_mint(reg: &mut CapRegistry, physical_addr: u64) -> u32 {
    if reg.next_id >= reg.max_caps {
        return 0;
    }
    let id: u32 = reg.next_id;
    reg.addresses.offset(id as i64).write(physical_addr);
    reg.next_id = id + 1;
    return id;
}

fn registry_lookup(reg: &CapRegistry, cap_id: u32) -> u64 {
    if cap_id == 0 {
        return 0;
    }
    if cap_id >= reg.next_id {
        return 0;
    }
    return reg.addresses.offset(cap_id as i64).read();
}

// ============================================================================
// Inline sys_cap_bind (same logic as kernel module)
// ============================================================================
fn sys_cap_bind(
    ecam_base: Ptr<u32>,
    registry: &mut CapRegistry,
    vendor_id: u32,
    device_id: u32,
    max_bus: u32
) -> u32 {
    let mut bus: u32 = 0;
    while bus < max_bus {
        let mut dev: u32 = 0;
        while dev < 32 {
            let byte_off: u32 = (bus << 20) | (dev << 15) | (0 << 12) | 0;
            let word_off: i64 = (byte_off / 4) as i64;
            let id_reg: u32 = ecam_base.offset(word_off).read();

            let vendor: u32 = id_reg & 0xFFFF;
            let dev_id: u32 = (id_reg >> 16) & 0xFFFF;

            if vendor != 0xFFFF {
                if vendor == vendor_id {
                    if dev_id == device_id {
                        let bar0_byte_off: u32 = (bus << 20) | (dev << 15) | (0 << 12) | 0x10;
                        let bar0_low: u32 = ecam_base.offset((bar0_byte_off / 4) as i64).read();

                        let bar1_byte_off: u32 = (bus << 20) | (dev << 15) | (0 << 12) | 0x14;
                        let bar0_high: u32 = ecam_base.offset((bar1_byte_off / 4) as i64).read();

                        let phys_low: u64 = (bar0_low & 0xFFFFFFF0) as u64;
                        let phys_high: u64 = (bar0_high as u64) << 32;
                        let physical_addr: u64 = phys_high | phys_low;

                        return registry_mint(registry, physical_addr);
                    }
                }
            }

            dev = dev + 1;
        }
        bus = bus + 1;
    }
    return 0;
}

fn main() -> i32 {
    // =========================================================================
    // Allocate mock ECAM (16MB) + capability registry (8KB = 1024 u64 slots)
    // =========================================================================
    let ecam_size: i64 = 16 * 1024 * 1024;
    let ecam_base_addr: u64 = malloc(ecam_size);
    if ecam_base_addr == 0 {
        return 1;
    }

    let reg_size: i64 = 1024 * 8;
    let reg_addr: u64 = malloc(reg_size);
    if reg_addr == 0 {
        free(ecam_base_addr);
        return 1;
    }

    // Fill ECAM with 0xFF (no devices)
    let mut i: i64 = 0;
    while i < ecam_size {
        *((ecam_base_addr + (i as u64)) as &mut u8) = 0xFF;
        i = i + 1;
    }

    let ecam: Ptr<u32> = ecam_base_addr as Ptr<u32>;
    let mut registry: CapRegistry = registry_new(reg_addr, 1024);

    // =========================================================================
    // Plant Mellanox ConnectX-5 at Bus 1, Dev 4
    // Vendor 0x15B3, Device 0x1017
    // BAR0 = 0x0000_0002_C000_0000
    // =========================================================================
    let mlx_id_off: u32 = (1 << 20) | (4 << 15) | (0 << 12) | 0;
    ecam.offset((mlx_id_off / 4) as i64).write(0x101715B3);

    // BAR0 Low (reg 0x10): 0xC0000004 (64-bit, prefetchable)
    let mlx_bar0_off: u32 = (1 << 20) | (4 << 15) | (0 << 12) | 0x10;
    ecam.offset((mlx_bar0_off / 4) as i64).write(0xC0000004);

    // BAR0 High (reg 0x14): 0x00000002
    let mlx_bar1_off: u32 = (1 << 20) | (4 << 15) | (0 << 12) | 0x14;
    ecam.offset((mlx_bar1_off / 4) as i64).write(0x00000002);

    // =========================================================================
    // Plant NVIDIA GA102 at Bus 0, Dev 0
    // BAR0 = 0x0000_0000_D000_0000
    // =========================================================================
    let nv_id_off: u32 = (0 << 20) | (0 << 15) | (0 << 12) | 0;
    ecam.offset((nv_id_off / 4) as i64).write(0x220410DE);

    let nv_bar0_off: u32 = (0 << 20) | (0 << 15) | (0 << 12) | 0x10;
    ecam.offset((nv_bar0_off / 4) as i64).write(0xD0000000);

    let nv_bar1_off: u32 = (0 << 20) | (0 << 15) | (0 << 12) | 0x14;
    ecam.offset((nv_bar1_off / 4) as i64).write(0x00000000);

    // =========================================================================
    // T1: Bind Mellanox — should return CapID >= 1
    // =========================================================================
    let cap1: u32 = sys_cap_bind(ecam, &mut registry, 0x15B3, 0x1017, 4);
    if cap1 == 0 {
        free(ecam_base_addr);
        free(reg_addr);
        return 2;
    }

    // T2: Verify registry contains correct BAR
    // Expected: 0x0000_0002_C000_0000
    let bar1: u64 = registry_lookup(&registry, cap1);
    if bar1 != 0x00000002C0000000 {
        free(ecam_base_addr);
        free(reg_addr);
        return 3;
    }

    // =========================================================================
    // T3: Bind NVIDIA — should return a DIFFERENT CapID
    // =========================================================================
    let cap2: u32 = sys_cap_bind(ecam, &mut registry, 0x10DE, 0x2204, 4);
    if cap2 == cap1 {
        free(ecam_base_addr);
        free(reg_addr);
        return 4;
    }

    // T4: Verify NVIDIA BAR
    // Expected: 0x0000_0000_D000_0000
    let bar2: u64 = registry_lookup(&registry, cap2);
    if bar2 != 0x00000000D0000000 {
        free(ecam_base_addr);
        free(reg_addr);
        return 6;
    }

    // =========================================================================
    // T5: Bind non-existent device — should return 0
    // =========================================================================
    let cap_missing: u32 = sys_cap_bind(ecam, &mut registry, 0x8086, 0x9999, 4);
    if cap_missing != 0 {
        free(ecam_base_addr);
        free(reg_addr);
        return 5;
    }

    free(ecam_base_addr);
    free(reg_addr);
    return 0;
}
