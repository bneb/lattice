package tests.test_e2e_service_worker

import user.browser.net
import user.browser.ipc_shared

extern fn sys_jsc_evaluate_script(ptr: u64, len: u32, filename_ptr: u64);
extern fn sys_jsc_init();
extern fn js_resolve_fetch_impl(id: u64, ptr: u64, len: u32);
extern fn sys_log_info(ptr: u64, len: u32);
extern fn sys_init_arrays();

@no_mangle
pub fn custom_strlen(ptr: u64) -> u32 {
    let mut i: u32 = 0;
    while *((ptr + (i as u64)) as &u8) != 0 {
        i = i + 1;
    }
    return i;
}

@no_mangle
pub fn main() {
    println("--- Epic 76: Service Worker E2E Test ---");
    
    // 1. Initialize Browser Runtime
    sys_init_arrays();
    sys_jsc_init();
    
    // 2. Register Service Worker
    let register_code: [u8; 42] = [110, 97, 118, 105, 103, 97, 116, 111, 114, 46, 115, 101, 114, 118, 105, 99, 101, 87, 111, 114, 107, 101, 114, 46, 114, 101, 103, 105, 115, 116, 101, 114, 40, 39, 115, 119, 46, 106, 115, 39, 41, 59];
    sys_jsc_evaluate_script((&register_code) as u64, 42, 0);
    
    // Simulate Main Process notifying Renderer that SW is active
    net.HAS_ACTIVE_SERVICE_WORKER = 1;
    
    // 3. Perform Fetch Interception Test
    let fetch_code: [u8; 19] = [102, 101, 116, 99, 104, 40, 39, 47, 97, 112, 105, 47, 100, 97, 116, 97, 39, 41, 59];
    sys_jsc_evaluate_script((&fetch_code) as u64, 19, 0);
    
    // Step 4: Verify Interpretation
    // The Renderer's pump_net_fetch_queue should have intercepted the fetch
    net.pump_net_fetch_queue();
    
    // Find the fetch slot
    let mut slot: i32 = -1;
    let mut i: u32 = 0;
    while i < 256 {
        if net.FETCH_QUEUE_STATE[i as usize] == net.FETCH_PENDING_SW {
            slot = i as i32;
            break;
        }
        i = i + 1;
    }
    
    if slot >= 0 {
        println("[SW Test] SUCCESS: Fetch intercepted correctly (State=FETCH_PENDING_SW)");
        
        // Step 5: Simulate Worker Response
        let fetch_id = net.FETCH_QUEUE_FETCH_ID[slot as usize];
        let mock_response = "Offline Payload";
        let resp_ptr = (&mock_response) as u64;
        let resp_len = 15;
        
        println("[SW Test] Injecting mock response from worker...");
        net.complete_fetch(fetch_id, resp_ptr, resp_len);
        
        // Verify state is DONE
        if net.FETCH_QUEUE_STATE[slot as usize] == net.FETCH_DONE {
            println("[SW Test] SUCCESS: Fetch marked as DONE after worker response.");
            
            // Step 6: Verify JS value
            // In a real run-loop, js_resolve_fetch would be called.
            // In this test, we call it manually to verify the promise resolution.
            js_resolve_fetch_impl(fetch_id, resp_ptr, resp_len);
            
            println("[SW Test] E2E Pipeline Verified.");
        } else {
            println("[SW Test] FAILURE: Fetch not marked as DONE.");
        }
    } else {
        println("[SW Test] FAILURE: Fetch NOT intercepted.");
    }
}
