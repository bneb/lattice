// =============================================================================
// Test: UART Telemetry Uplink (v4.1.0)
// =============================================================================
//
// Validates the bare-metal serial stack in hosted mode using a mock
// I/O ring buffer that captures all outb(port, data) calls.
//
//   T1: UART init — 7 outb calls in exact register sequence
//   T2: serial_write_byte — spin-wait + THR write
//   T3: print_u64_hex(0x1A2B3C4D5E6F7890) — exact 18-byte ASCII
//   T4: print_u32_hex(0xDEADBEEF) — exact 10-byte ASCII
//   T5: print_str("OK") — byte-accurate emission
//   T6: print_newline — emits 0x0A
//   T7: print_dec(12345) — "12345"
//   T8: print_u64_hex(0) — "0x0000000000000000"
//
// Exit codes: 0=pass, 1=alloc, 2=init, 3=write, 4=hex64,
//             5=hex32, 6=str, 7=newline, 8=dec
// =============================================================================

package main

import std.core.ptr.Ptr

extern fn malloc(size: i64) -> Ptr<u8>;
extern fn free(ptr: u64);

// ============================================================================
// Mock ring buffer — captures all outb calls
// ============================================================================
// Layout (flat buffer):
//   [0..4)     write index (i32)
//   [4..8)     pad
//   [8+i*4]    entries: [port_hi, port_lo, data, pad]
// ============================================================================
const MOCK_CAP: i32 = 4096;
const MOCK_SIZE: i64 = 16392;  // 8 + 4096*4

fn mock_alloc() -> u64 {
    let buf: u64 = (malloc(MOCK_SIZE) as u64);
    let mut i: i64 = 0;
    while i < MOCK_SIZE { *((buf + (i as u64)) as &mut u8) = 0; i = i + 1; }
    return buf;
}

fn mock_reset(buf: u64) {
    let mut i: i64 = 0;
    while i < MOCK_SIZE { *((buf + (i as u64)) as &mut u8) = 0; i = i + 1; }
}

fn mock_idx(buf: u64) -> i32 {
    return *((buf) as &i32);
}

fn mock_port(buf: u64, i: i32) -> u16 {
    let off: u64 = 8 + (i as u64) * 4;
    let hi: u16 = (*((buf + off) as &u8)) as u16;
    let lo: u16 = (*((buf + off + 1) as &u8)) as u16;
    return (hi << 8) | lo;
}

fn mock_data(buf: u64, i: i32) -> u8 {
    let off: u64 = 8 + (i as u64) * 4 + 2;
    return *((buf + off) as &u8);
}

fn mock_record(buf: u64, port: u16, data: u8) {
    let idx: i32 = *((buf) as &i32);
    if idx >= MOCK_CAP { return; }
    let off: u64 = 8 + (idx as u64) * 4;
    *((buf + off) as &mut u8) = ((port >> 8) & 0xFF) as u8;
    *((buf + off + 1) as &mut u8) = (port & 0xFF) as u8;
    *((buf + off + 2) as &mut u8) = data;
    *((buf) as &mut i32) = idx + 1;
}

// Only extract THR data bytes into a separate buffer
fn extract_thr(buf: u64, out: u64, max: i32) -> i32 {
    let total: i32 = mock_idx(buf);
    let mut count: i32 = 0;
    let mut i: i32 = 0;
    while i < total && count < max {
        if mock_port(buf, i) == 0x3F8 {
            *((out + (count as u64)) as &mut u8) = mock_data(buf, i);
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

// ============================================================================
// Global mock buffer pointer (set by main, used by kernel_outb/inb)
// ============================================================================
global G_BUF: u64 = 0;

@no_mangle
pub fn kernel_outb(port: u16, data: u8) {
    if G_BUF != 0 { mock_record(G_BUF, port, data); }
}

@no_mangle
pub fn kernel_inb(port: u16) -> u8 {
    return 0x20;  // THRE always set
}

// ============================================================================
// UART mirrored inline
// ============================================================================
fn init_serial() {
    kernel_outb(0x3F9, 0x00);
    kernel_outb(0x3FB, 0x80);
    kernel_outb(0x3F8, 0x01);
    kernel_outb(0x3F9, 0x00);
    kernel_outb(0x3FB, 0x03);
    kernel_outb(0x3FA, 0xC7);
    kernel_outb(0x3FC, 0x0B);
}

fn emit(b: u8) {
    while (kernel_inb(0x3FD) & 0x20) == 0 { }
    kernel_outb(0x3F8, b);
}

fn print_u64_hex(val: u64) {
    emit(48);
    emit(120);
    let mut i: i32 = 0;
    while i < 16 {
        let shift: u64 = (60 - i * 4) as u64;
        let nibble: u64 = (val >> shift) & 0xF;
        if nibble < 10 { emit((nibble + 48) as u8); }
        else { emit((nibble + 55) as u8); }
        i = i + 1;
    }
}

fn print_u32_hex(val: u32) {
    emit(48);
    emit(120);
    let mut i: i32 = 0;
    while i < 8 {
        let shift: u32 = (28 - i * 4) as u32;
        let nibble: u32 = (val >> shift) & 0xF;
        if nibble < 10 { emit((nibble + 48) as u8); }
        else { emit((nibble + 55) as u8); }
        i = i + 1;
    }
}

fn print_str(s: u64, len: i32) {
    let mut i: i32 = 0;
    while i < len { emit(*((s + (i as u64)) as &u8)); i = i + 1; }
}

fn print_dec(val: u64) {
    if val == 0 { emit(48); return; }
    let mut temp: u64 = val;
    let mut count: i32 = 0;
    while temp > 0 { count = count + 1; temp = temp / 10; }
    temp = val;
    let mut div: u64 = 1;
    let mut j: i32 = 1;
    while j < count { div = div * 10; j = j + 1; }
    while div > 0 {
        let d: u64 = temp / div;
        emit((d + 48) as u8);
        temp = temp - (d * div);
        div = div / 10;
    }
}

fn main() -> i32 {
    let buf: u64 = mock_alloc();
    if buf == 0 { return 1; }
    G_BUF = buf;

    let out: u64 = (malloc(64) as u64);
    if out == 0 { free(buf); return 1; }

    // =========================================================================
    // T1: UART init — 7 outb calls
    // =========================================================================
    mock_reset(buf);
    init_serial();

    if mock_idx(buf) != 7 { free(out); free(buf); return 2; }
    if mock_port(buf, 0) != 0x3F9 || mock_data(buf, 0) != 0x00 { free(out); free(buf); return 2; }
    if mock_port(buf, 1) != 0x3FB || mock_data(buf, 1) != 0x80 { free(out); free(buf); return 2; }
    if mock_port(buf, 2) != 0x3F8 || mock_data(buf, 2) != 0x01 { free(out); free(buf); return 2; }
    if mock_port(buf, 3) != 0x3F9 || mock_data(buf, 3) != 0x00 { free(out); free(buf); return 2; }
    if mock_port(buf, 4) != 0x3FB || mock_data(buf, 4) != 0x03 { free(out); free(buf); return 2; }
    if mock_port(buf, 5) != 0x3FA || mock_data(buf, 5) != 0xC7 { free(out); free(buf); return 2; }
    if mock_port(buf, 6) != 0x3FC || mock_data(buf, 6) != 0x0B { free(out); free(buf); return 2; }

    // =========================================================================
    // T2: serial_write_byte — emits 'A' to THR
    // =========================================================================
    mock_reset(buf);
    emit(65);

    // The last outb should be THR (0x3F8) with data=65
    let n2: i32 = mock_idx(buf);
    if n2 < 1 { free(out); free(buf); return 3; }
    if mock_port(buf, n2 - 1) != 0x3F8 { free(out); free(buf); return 3; }
    if mock_data(buf, n2 - 1) != 65 { free(out); free(buf); return 3; }

    // =========================================================================
    // T3: print_u64_hex(0x1A2B3C4D5E6F7890) → "0x1A2B3C4D5E6F7890"
    // =========================================================================
    mock_reset(buf);
    print_u64_hex(0x1A2B3C4D5E6F7890);

    let n3: i32 = extract_thr(buf, out, 32);
    if n3 != 18 { free(out); free(buf); return 4; }
    // '0','x','1','A','2','B','3','C','4','D','5','E','6','F','7','8','9','0'
    let expected: [u8; 18] = [48, 120, 49, 65, 50, 66, 51, 67, 52, 68, 53, 69, 54, 70, 55, 56, 57, 48];
    let mut ei: i32 = 0;
    while ei < 18 {
        if *((out + (ei as u64)) as &u8) != expected[ei as u64] { free(out); free(buf); return 4; }
        ei = ei + 1;
    }

    // =========================================================================
    // T4: print_u32_hex(0xDEADBEEF) → "0xDEADBEEF"
    // =========================================================================
    mock_reset(buf);
    print_u32_hex(0xDEADBEEF);

    let n4: i32 = extract_thr(buf, out, 32);
    if n4 != 10 { free(out); free(buf); return 5; }
    let exp4: [u8; 10] = [48, 120, 68, 69, 65, 68, 66, 69, 69, 70];
    let mut fi: i32 = 0;
    while fi < 10 {
        if *((out + (fi as u64)) as &u8) != exp4[fi as u64] { free(out); free(buf); return 5; }
        fi = fi + 1;
    }

    // =========================================================================
    // T5: print_str("OK") — 2 bytes
    // =========================================================================
    mock_reset(buf);
    let ok_buf: u64 = (malloc(4) as u64);
    if ok_buf == 0 { free(out); free(buf); return 1; }
    *((ok_buf) as &mut u8) = 79;
    *((ok_buf+1) as &mut u8) = 75;
    print_str(ok_buf, 2);
    free(ok_buf);

    let n5: i32 = extract_thr(buf, out, 32);
    if n5 != 2 { free(out); free(buf); return 6; }
    if *((out) as &u8) != 79 || *((out+1) as &u8) != 75 { free(out); free(buf); return 6; }

    // =========================================================================
    // T6: newline — 0x0A
    // =========================================================================
    mock_reset(buf);
    emit(10);

    let n6: i32 = extract_thr(buf, out, 32);
    if n6 != 1 { free(out); free(buf); return 7; }
    if *((out) as &u8) != 10 { free(out); free(buf); return 7; }

    // =========================================================================
    // T7: print_dec(12345) → "12345"
    // =========================================================================
    mock_reset(buf);
    print_dec(12345);

    let n7: i32 = extract_thr(buf, out, 32);
    if n7 != 5 { free(out); free(buf); return 8; }
    let exp7: [u8; 5] = [49, 50, 51, 52, 53];
    let mut di: i32 = 0;
    while di < 5 {
        if *((out + (di as u64)) as &u8) != exp7[di as u64] { free(out); free(buf); return 8; }
        di = di + 1;
    }

    // =========================================================================
    // T8: print_u64_hex(0) → "0x0000000000000000"
    // =========================================================================
    mock_reset(buf);
    print_u64_hex(0);

    let n8: i32 = extract_thr(buf, out, 32);
    if n8 != 18 { free(out); free(buf); return 4; }
    if *((out) as &u8) != 48 { free(out); free(buf); return 4; }       // '0'
    if *((out+1) as &u8) != 120 { free(out); free(buf); return 4; }    // 'x'
    let mut zi: i32 = 2;
    while zi < 18 {
        if *((out + (zi as u64)) as &u8) != 48 { free(out); free(buf); return 4; }
        zi = zi + 1;
    }

    free(out);
    free(buf);
    return 0;
}
