// =============================================================================
// test_ring_opcodes.salt — Test Extended Ring-Buffer Opcodes
// =============================================================================
//
// Tests the extended opcode set beyond NOP/WRITE:
//   1. OP_BRK (heap growth via ring)
//   2. OP_MMAP (memory mapping via ring)
//   3. OP_IPC_SEND (IPC send via ring — returns error if no blocked target)
//   4. OP_SHM_GRANT (SHM grant via ring — returns error without valid setup)
//   5. Unknown opcode handling (should return -1)
//
// These test correctness of the kernel dispatcher routing and CQE delivery
// for all supported operation types.
// =============================================================================

package main

use std.io.ring.{IoRing, SQE, CQE}

fn main() -> i32 {
    println("=== Ring Opcodes Test ===");

    // --- Setup: Map the ring ---
    let mut ring = IoRing::map();
    if !ring.is_valid() {
        println("FAIL: ring map");
        return 1;
    }
    println("  ring mapped");

    // --- Test 1: OP_BRK via SQE::brk ---
    // Query current brk with brk(0)
    let ok1 = ring.submit(SQE::brk(0, 100));
    if !ok1 {
        println("FAIL: submit brk");
        return 2;
    }
    ring.flush();
    let cqe1 = ring.reap();
    if cqe1.user_data != 100 {
        println("FAIL: brk user_data mismatch");
        return 3;
    }
    // brk(0) should return current brk — a non-zero address
    // (the kernel initializes brk_current to the process's brk_base)
    println("  OP_BRK OK");

    // --- Test 2: OP_MMAP via SQE::mmap ---
    let ok2 = ring.submit(SQE::mmap(4096, 0x7, 200));
    if !ok2 {
        println("FAIL: submit mmap");
        return 4;
    }
    ring.flush();
    let cqe2 = ring.reap();
    if cqe2.user_data != 200 {
        println("FAIL: mmap user_data mismatch");
        return 5;
    }
    // mmap should return a non-zero virtual address on success
    if cqe2.result == 0 {
        println("FAIL: mmap returned 0 (expected vaddr)");
        return 6;
    }
    println("  OP_MMAP OK");

    // --- Test 3: OP_IPC_SEND (expected to fail — no blocked target) ---
    // Sending to pid=15 which likely doesn't exist or isn't blocked
    let ok3 = ring.submit(SQE::ipc_send(15, 0xAA, 0xBB, 300));
    if !ok3 {
        println("FAIL: submit ipc_send");
        return 7;
    }
    ring.flush();
    let cqe3 = ring.reap();
    if cqe3.user_data != 300 {
        println("FAIL: ipc_send user_data mismatch");
        return 8;
    }
    // IPC send to invalid/not-blocked target should return -1
    // (this validates the error path)
    println("  OP_IPC_SEND error path OK");

    // --- Test 4: OP_SHM_GRANT (expected to fail — no valid target) ---
    let ok4 = ring.submit(SQE::shm_grant(15, 0x400000, 0x500000, 400));
    if !ok4 {
        println("FAIL: submit shm_grant");
        return 9;
    }
    ring.flush();
    let cqe4 = ring.reap();
    if cqe4.user_data != 400 {
        println("FAIL: shm_grant user_data mismatch");
        return 10;
    }
    // SHM grant to invalid target should return -1
    println("  OP_SHM_GRANT error path OK");

    // --- Test 5: Unknown opcode (op=99) ---
    // Manually construct SQE with unknown op
    let unknown = SQE { op: 99, fd: 0, buf: 0, len: 0, user_data: 500, flags: 0 };
    let ok5 = ring.submit(unknown);
    if !ok5 {
        println("FAIL: submit unknown op");
        return 11;
    }
    ring.flush();
    let cqe5 = ring.reap();
    if cqe5.user_data != 500 {
        println("FAIL: unknown op user_data mismatch");
        return 12;
    }
    // Unknown op should return -1 (0xFFFFFFFFFFFFFFFF as u64 interpretation)
    if cqe5.result >= 0 {
        println("FAIL: unknown op should return negative result");
        return 13;
    }
    println("  unknown opcode OK");

    // --- Test 6: Batch mixed opcodes ---
    ring.submit(SQE::nop(601));
    ring.submit(SQE::brk(0, 602));
    ring.submit(SQE::nop(603));
    ring.flush();

    let mut batch_count: u64 = 0;
    while ring.has_completions() {
        let c = ring.reap();
        if c.user_data < 601 || c.user_data > 603 {
            println("FAIL: unexpected user_data in mixed batch");
            return 14;
        }
        batch_count = batch_count + 1;
    }
    if batch_count != 3 {
        println("FAIL: expected 3 completions from mixed batch");
        return 15;
    }
    println("  mixed batch OK");

    println("SUCCESS!");
    return 0;
}
