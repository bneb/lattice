package tests.test_js_fetch

import user.os.ipc_ring

// Link into critical DOM symbols (From dom.salt @no_mangle)
extern fn init_arrays();
extern fn create_node(tag: i32) -> u64;
extern fn resolve_node_by_id(ptr: u64, len: u32) -> u64;
extern fn js_set_id(node_id: u64, id_ptr: u64, id_len: u32);
extern fn js_get_class_ptr(node_id: i32) -> u64;
extern fn js_get_class_len(node_id: i32) -> u32;
extern fn js_get_text_ptr(node_id: i32) -> u64;
extern fn js_get_text_len(node_id: i32) -> u32;
extern fn dom_get_first_child(idx: u32) -> u64;

// Link into QuickJS bridge (From js_quickjs.salt)
extern fn js_quickjs_eval_string(ptr: u64, len: u32);

// Link into airlock (From airlock.salt @no_mangle)
extern fn airlock_init_allocator();

// Link into JS Dom Bridge (From C side)
extern fn js_init_quickjs();
extern fn js_get_test_script_fetch(buf: u64);
extern fn js_get_test_script_fetch_len() -> u32;

// Main browser pump
extern fn run_loop();
extern fn set_max_test_frames(frames: u64);

pub fn main() -> i32 {
    println("--- Phase 6: Asynchronous fetch() Matrix Test ---");
    
    airlock_init_allocator();
    init_arrays();
    ipc_ring.init_shared_ring();
    
    // Create #hero node (TAG_DIV = 4)
    let hero_id = create_node(4);
    let mut hero_str: [u8; 4] = [104, 101, 114, 111]; // "hero"
    js_set_id(hero_id, (&hero_str) as u64, 4);
    
    // Init QuickJS
    js_init_quickjs();
    
    // Load fetch test script
    let mut script_buf: [u8; 1024] = [0; 1024];
    js_get_test_script_fetch((&script_buf) as u64);
    let script_len = js_get_test_script_fetch_len();
    js_quickjs_eval_string((&script_buf) as u64, script_len);
    
    println("[Test] Script evaluated. Pumping main loop to fetch and block...");
    
    // Simulate NetD reading the outbound GET request
    let mut b: u8 = 0;
    while ipc_ring.ipc_read_byte((&mut b) as u64) == 1 {
        // Discard byte
    }
    
    // Simulate NetD receiving the request and pushing the JSON payload back
    // We mock a JSON payload: `{"message":"success"}`
    let mut json_str: [u8; 21] = [123, 34, 109, 101, 115, 115, 97, 103, 101, 34, 58, 34, 115, 117, 99, 99, 101, 115, 115, 34, 125];
    let json_len: u32 = 21;
    let fetch_id_raw: u64 = 1; 
    // Flag highest bit for fetch routing: 0x8000000000000000
    // Actually salt bitwise operations can do this simply
    let mut high_bit: u64 = 1;
    high_bit = high_bit << 63;
    let multiplexed_id = high_bit | fetch_id_raw;
    
    // Write 8-byte Node ID
    let mut i: u32 = 0;
    while i < 8 {
        let shift = i * 8;
        let v = ((multiplexed_id >> shift) & 0xFF) as u8;
        ipc_ring.ipc_push_byte(v);
        i = i + 1;
    }
    
    // Write 4-byte Length
    i = 0;
    while i < 4 {
        let shift = i * 8;
        let v = ((json_len >> shift) & 0xFF) as u8;
        ipc_ring.ipc_push_byte(v);
        i = i + 1;
    }
    
    // Write Payload
    i = 0;
    while i < json_len {
        let val = *(((&json_str) as u64 + (i as u64)) as &u8);
        ipc_ring.ipc_push_byte(val);
        i = i + 1;
    }
    
    println("[Test] Simulating 2 frames for ring ingestion and rendering cycle...");
    set_max_test_frames(2);
    run_loop();
    
    // Check Result: className should be 'fetched'
    let hero_idx = (hero_id & 0xFFFF) as i32;
    let class_ptr = js_get_class_ptr(hero_idx);
    let class_len = js_get_class_len(hero_idx);
    
    if class_len == 7 {
        println("[Test] SUCCESS: 'fetched' class detected on #hero!");
    } else {
        println("[Test] FAILURE: Unexpected class length. Promises did not resolve.");
        return 1;
    }
    
    println("--- Test Completed Successfully ---");
    return 0;
}
