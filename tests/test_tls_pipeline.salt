package tests.test_tls_pipeline

import user.os.ipc_ring

extern fn airlock_init_allocator();
extern fn init_arrays();
extern fn js_quickjs_init() -> i32;

// TLS bridge externs
extern fn netd_tls_acquire_slot() -> i32;
extern fn netd_tls_release_slot(slot: i32);
extern fn netd_tls_get_state(slot: i32) -> i32;
extern fn netd_tls_get_fd(slot: i32) -> i32;
extern fn netd_tls_get_multiplex_id(slot: i32) -> u64;

pub fn main() -> i32 {
    println("--- Epic 34: TLS/HTTPS Transport Pipeline Test ---");

    airlock_init_allocator();
    init_arrays();
    ipc_ring.init_shared_ring();
    js_quickjs_init();

    // ============================================================
    // Phase 1: Connection Matrix — Slot Acquisition
    // ============================================================
    println("[Phase 1] Connection Matrix slot acquisition");
    let slot0 = netd_tls_acquire_slot();
    if slot0 < 0 {
        println("[FAIL] Could not acquire TLS slot 0");
        return 1;
    }
    println("[OK] Acquired TLS slot 0");

    // Verify state is HANDSHAKING (1) after acquisition
    let state0 = netd_tls_get_state(slot0);
    if state0 == 1 {
        println("[OK] Slot 0 state = HANDSHAKING (1) after acquire");
    } else {
        println("[FAIL] Slot 0 state not HANDSHAKING after acquire");
        return 1;
    }

    // ============================================================
    // Phase 2: Slot Release and Re-acquisition
    // ============================================================
    println("[Phase 2] Slot release and re-acquisition");
    netd_tls_release_slot(slot0);

    let state_after = netd_tls_get_state(slot0);
    if state_after == 0 {
        println("[OK] Slot 0 released back to IDLE");
    } else {
        println("[FAIL] Slot not released properly");
        return 1;
    }

    // Re-acquire same slot
    let slot1 = netd_tls_acquire_slot();
    if slot1 >= 0 {
        println("[OK] Re-acquired slot after release");
    } else {
        println("[FAIL] Could not re-acquire slot");
        return 1;
    }
    netd_tls_release_slot(slot1);

    // ============================================================
    // Phase 3: Exhaust pool boundary test
    // ============================================================
    println("[Phase 3] Pool exhaustion boundary");
    let mut acquired: i32 = 0;
    let mut i: i32 = 0;
    while i < 64 {
        let s = netd_tls_acquire_slot();
        if s >= 0 {
            acquired = acquired + 1;
        }
        i = i + 1;
    }
    if acquired == 64 {
        println("[OK] All 64 TLS slots acquired");
    } else {
        println("[FAIL] Could not acquire all 64 slots");
        return 1;
    }

    // 65th slot should fail
    let overflow = netd_tls_acquire_slot();
    if overflow == -1 {
        println("[OK] 65th slot correctly returns -1 (pool exhausted)");
    } else {
        println("[FAIL] Pool overflow not detected");
        return 1;
    }

    // Release all slots
    i = 0;
    while i < 64 {
        netd_tls_release_slot(i);
        i = i + 1;
    }
    println("[OK] All slots released");

    println("[Test] SUCCESS: TLS Connection Matrix verified!");
    return 0;
}
