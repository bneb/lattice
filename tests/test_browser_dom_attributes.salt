// =============================================================================
// Test: Prisimi Z3 Hardware Matrix testing HTML element Attribute extraction
// =============================================================================

import user.browser.dom
import user.browser.lexer
import user.browser.alloc.airlock

pub fn main() -> i32 {
    airlock.airlock_init_allocator();
    dom.salt_init_arrays();
    let mock_node = dom.salt_create_node(4 as u32); // dom.TAG_DIV = 4
    
    let mut html: [u8; 34] = [0; 34];
    
    // Explicit simulation: `<table id="mock" class="itemlist">`
    html[0] = 0x3C; html[1] = 0x74; html[2] = 0x61; html[3] = 0x62; 
    html[4] = 0x6C; html[5] = 0x65; html[6] = 0x20; 
    
    // id="mock"
    html[7] = 0x69; html[8] = 0x64; html[9] = 0x3D; html[10] = 0x22; 
    html[11] = 0x6D; html[12] = 0x6F; html[13] = 0x63; html[14] = 0x6B; 
    html[15] = 0x22; html[16] = 0x20; 
    
    // class="itemlist"
    html[17] = 0x63; html[18] = 0x6C; html[19] = 0x61; html[20] = 0x73; 
    html[21] = 0x73; html[22] = 0x3D; html[23] = 0x22; 
    
    html[24] = 0x69; html[25] = 0x74; html[26] = 0x65; html[27] = 0x6D; 
    html[28] = 0x6C; html[29] = 0x69; html[30] = 0x73; html[31] = 0x74; 
    
    html[32] = 0x22; html[33] = 0x3E;
    
    lexer.lex_html((&html) as u64, 34 as u32, mock_node, 0 as u8);
    
    // The `<table...>` tag element should be instantiated as the first child of mock_node
    let mock_idx = dom.salt_resolve_node(mock_node) as usize;
    let table_id = dom.DOM_NODE_FIRST_CHILD[mock_idx];
    let table_idx = dom.salt_resolve_node(table_id) as usize;
    
    // Assert structural attributes parsed
    if dom.DOM_ID_LEN[table_idx] != 4 {
        return 2; 
    }
    
    if dom.DOM_CLASS_LEN[table_idx] != 8 {
        return 3; 
    }
    
    return 0; // Success
}
