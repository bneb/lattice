package tests.test_e2e_storage

// =============================================================================
// Epic 85: The Persistent Matrix — E2E Verification (JSC Engine)
// =============================================================================
// Tests the full IndexedDB lifecycle:
//   1. Initialize storage mmap
//   2. indexedDB.put("draft_1", "Persistent Matrix Online") → Promise resolves
//   3. indexedDB.get("draft_1") → Promise resolves with stored value
//   4. Assert globalThis.phase2_val === "Persistent Matrix Online"

extern fn js_engine_init();
extern fn js_engine_eval_string(code_ptr: u64, len: u32);
extern fn init_arrays();
extern fn ext_storage_init(filename_ptr: u64) -> i32;
extern fn pump_storage_queue();
extern fn sys_jsc_eval_to_number(script_ptr: u64, script_len: u32) -> f64;
extern fn sys_jsc_pump_idb_open();

@no_mangle
pub fn main() -> i32 {
    println("--- Epic 85: Persistent Matrix E2E Testing ---");

    // Phase 0: Initialize engine
    init_arrays();
    js_engine_init();

    // Phase 0b: Initialize mmap storage
    // '/tmp/prisimi_jsc_idb_test.dat\0'
    let mut db_path: [u8; 30] = [47, 116, 109, 112, 47, 112, 114, 105, 115, 105, 109, 105, 95, 106, 115, 99, 95, 105, 100, 98, 95, 116, 101, 115, 116, 46, 100, 97, 116, 0];
    let ret = ext_storage_init((&db_path) as u64);
    if ret != 0 {
        println("[FAIL] Storage init failed");
        return 1;
    }
    println("[Phase 0] Storage matrix initialized.");

    // Phase 1: Initialize JS global tracking variables
    // 'globalThis.phase1_done = 0; globalThis.phase2_done = 0; globalThis.phase2_val = "";'
    let mut init_script: [u8; 83] = [103, 108, 111, 98, 97, 108, 84, 104, 105, 115, 46, 112, 104, 97, 115, 101, 49, 95, 100, 111, 110, 101, 32, 61, 32, 48, 59, 32, 103, 108, 111, 98, 97, 108, 84, 104, 105, 115, 46, 112, 104, 97, 115, 101, 50, 95, 100, 111, 110, 101, 32, 61, 32, 48, 59, 32, 103, 108, 111, 98, 97, 108, 84, 104, 105, 115, 46, 112, 104, 97, 115, 101, 50, 95, 118, 97, 108, 32, 61, 32, 34, 34, 59];
    js_engine_eval_string((&init_script) as u64, 83);

    // Phase 2: PUT — Write "Persistent Matrix Online" to key "draft_1"
    // 'indexedDB.put("draft_1", "Persistent Matrix Online").then(function() { globalThis.phase1_done = 1; });'
    let mut put_script: [u8; 102] = [105, 110, 100, 101, 120, 101, 100, 68, 66, 46, 112, 117, 116, 40, 34, 100, 114, 97, 102, 116, 95, 49, 34, 44, 32, 34, 80, 101, 114, 115, 105, 115, 116, 101, 110, 116, 32, 77, 97, 116, 114, 105, 120, 32, 79, 110, 108, 105, 110, 101, 34, 41, 46, 116, 104, 101, 110, 40, 102, 117, 110, 99, 116, 105, 111, 110, 40, 41, 32, 123, 32, 103, 108, 111, 98, 97, 108, 84, 104, 105, 115, 46, 112, 104, 97, 115, 101, 49, 95, 100, 111, 110, 101, 32, 61, 32, 49, 59, 32, 125, 41, 59];
    js_engine_eval_string((&put_script) as u64, 102);
    println("[Phase 1] PUT dispatched to storage queue.");

    // Flush microtasks — JSC resolves .then() callbacks during the NEXT JSEvaluateScript call
    // 'globalThis.phase1_done'
    let mut check_phase1: [u8; 22] = [103, 108, 111, 98, 97, 108, 84, 104, 105, 115, 46, 112, 104, 97, 115, 101, 49, 95, 100, 111, 110, 101];
    let phase1_val = sys_jsc_eval_to_number((&check_phase1) as u64, 22);
    
    if phase1_val != 1.0 {
        println("[FAIL] Phase 1: PUT promise did not resolve.");
        return 2;
    }
    println("[Phase 1] SUCCESS: PUT promise resolved.");

    // Phase 3: GET — Read back "draft_1"
    // 'indexedDB.get("draft_1").then(function(val) { globalThis.phase2_val = val; globalThis.phase2_done = 1; });'
    let mut get_script: [u8; 106] = [105, 110, 100, 101, 120, 101, 100, 68, 66, 46, 103, 101, 116, 40, 34, 100, 114, 97, 102, 116, 95, 49, 34, 41, 46, 116, 104, 101, 110, 40, 102, 117, 110, 99, 116, 105, 111, 110, 40, 118, 97, 108, 41, 32, 123, 32, 103, 108, 111, 98, 97, 108, 84, 104, 105, 115, 46, 112, 104, 97, 115, 101, 50, 95, 118, 97, 108, 32, 61, 32, 118, 97, 108, 59, 32, 103, 108, 111, 98, 97, 108, 84, 104, 105, 115, 46, 112, 104, 97, 115, 101, 50, 95, 100, 111, 110, 101, 32, 61, 32, 49, 59, 32, 125, 41, 59];
    js_engine_eval_string((&get_script) as u64, 106);
    println("[Phase 2] GET dispatched to storage queue.");

    // Flush microtasks
    // 'globalThis.phase2_done'
    let mut check_phase2_done: [u8; 22] = [103, 108, 111, 98, 97, 108, 84, 104, 105, 115, 46, 112, 104, 97, 115, 101, 50, 95, 100, 111, 110, 101];
    let phase2_done = sys_jsc_eval_to_number((&check_phase2_done) as u64, 22);

    if phase2_done != 1.0 {
        println("[FAIL] Phase 2: GET promise did not resolve.");
        return 3;
    }
    println("[Phase 2] SUCCESS: GET promise resolved.");

    // Phase 4: Assert the retrieved value matches
    // 'globalThis.phase2_val === "Persistent Matrix Online" ? 1 : 0'
    let mut assert_script: [u8; 60] = [103, 108, 111, 98, 97, 108, 84, 104, 105, 115, 46, 112, 104, 97, 115, 101, 50, 95, 118, 97, 108, 32, 61, 61, 61, 32, 34, 80, 101, 114, 115, 105, 115, 116, 101, 110, 116, 32, 77, 97, 116, 114, 105, 120, 32, 79, 110, 108, 105, 110, 101, 34, 32, 63, 32, 49, 32, 58, 32, 48];
    let assert_val = sys_jsc_eval_to_number((&assert_script) as u64, 60);

    if assert_val != 1.0 {
        println("[FAIL] Phase 3: Value mismatch! Expected 'Persistent Matrix Online'.");
        return 4;
    }
    println("[Phase 3] SUCCESS: Value integrity verified.");
    println("--- Epic 85: ALL TESTS PASSED ---");
    return 0;
}
