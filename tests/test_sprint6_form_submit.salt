package tests.test_sprint6_form_submit

import user.browser.dom

extern fn layout_inject_dom_pointers();
extern fn compute_layout(node_idx: u32, offset_x: i32, offset_y: i32, max_width: i32) -> i32;

// C bridge externs
extern fn test_click_focus(node_idx: u32);
extern fn test_mutate_text(node_idx: u32, ch: u8, is_backspace: u8);
extern fn test_get_focus() -> u32;
extern fn test_find_form_ancestor(node_idx: u32) -> u32;
extern fn test_construct_and_get_url(
    action_ptr: u64, action_len: u32,
    name_ptr: u64, name_len: u32,
    value_ptr: u64, value_len: u32) -> u64;
extern fn test_get_last_nav_url_ptr() -> u64;
extern fn test_get_last_nav_url_len() -> u32;

// Sprint 6: Form Submission & URL Construction
// Validates: form data collection, URL encoding, navigation trigger

@no_mangle
pub fn main() -> i32 {
    dom.sanitize_node_slot(0);
    dom.sanitize_node_slot(1);
    dom.sanitize_node_slot(2);
    dom.sanitize_node_slot(3);
    dom.DOM_NODE_COUNT = 4;
    layout_inject_dom_pointers();

    // Node 0: Root
    dom.DOM_NODE_TAG[0] = 4;
    dom.STYLE_DISPLAY[0] = 1;
    dom.STYLE_W[0] = 1920;
    dom.DOM_NODE_PARENT[0] = 999999;
    dom.STYLE_PARENT[0] = 999999;
    dom.DOM_NODE_FIRST_CHILD[0] = 1;
    dom.DOM_NODE_NEXT_SIBLING[0] = 999999;

    // Node 1: <form action="/search">
    dom.DOM_NODE_TAG[1] = 21; // TAG_FORM
    dom.STYLE_DISPLAY[1] = 1;
    dom.DOM_NODE_PARENT[1] = 0;
    dom.STYLE_PARENT[1] = 0;
    dom.DOM_NODE_FIRST_CHILD[1] = 2;
    dom.DOM_NODE_NEXT_SIBLING[1] = 999999;

    // Node 2: <input name="q">
    dom.DOM_NODE_TAG[2] = 18; // TAG_INPUT
    dom.STYLE_DISPLAY[2] = 1;
    dom.STYLE_W[2] = 560;
    dom.STYLE_H[2] = 34;
    dom.DOM_NODE_PARENT[2] = 1;
    dom.STYLE_PARENT[2] = 1;
    dom.DOM_NODE_FIRST_CHILD[2] = 999999;
    dom.DOM_NODE_NEXT_SIBLING[2] = 3;

    // Node 3: <button> "Google Search"
    dom.DOM_NODE_TAG[3] = 20;
    dom.STYLE_DISPLAY[3] = 1;
    dom.DOM_NODE_PARENT[3] = 1;
    dom.STYLE_PARENT[3] = 1;
    dom.DOM_NODE_FIRST_CHILD[3] = 999999;
    dom.DOM_NODE_NEXT_SIBLING[3] = 999999;

    // ═══════════════════════════════════════════════════
    // Phase 1: Type "hello world" into the search input
    // ═══════════════════════════════════════════════════
    test_click_focus(2);
    if test_get_focus() != 2 { return 1; }

    // Type "hello world" (h=104 e=101 l=108 l=108 o=111 space=32 w=119 o=111 r=114 l=108 d=100)
    test_mutate_text(2, 104, 0);
    test_mutate_text(2, 101, 0);
    test_mutate_text(2, 108, 0);
    test_mutate_text(2, 108, 0);
    test_mutate_text(2, 111, 0);
    test_mutate_text(2, 32, 0);  // space
    test_mutate_text(2, 119, 0);
    test_mutate_text(2, 111, 0);
    test_mutate_text(2, 114, 0);
    test_mutate_text(2, 108, 0);
    test_mutate_text(2, 100, 0);

    if dom.DOM_TEXT_LEN[2] != 11 { return 2; }

    // ═══════════════════════════════════════════════════
    // Phase 2: URL Construction
    // ═══════════════════════════════════════════════════
    // action = "/search", name = "q", value = "hello world"
    // Expected URL: "/search?q=hello+world"

    let action: [u8; 7] = [47, 115, 101, 97, 114, 99, 104]; // "/search"
    let name: [u8; 1] = [113]; // "q"
    let value_ptr = dom.DOM_TEXT_PTR[2];
    let value_len = dom.DOM_TEXT_LEN[2];

    let url_ptr = test_construct_and_get_url(
        (&action) as u64, 7,
        (&name) as u64, 1,
        value_ptr, value_len);

    if url_ptr == 0 { return 10; }

    // Verify the constructed URL
    let nav_ptr = test_get_last_nav_url_ptr();
    let nav_len = test_get_last_nav_url_len();

    // Expected: "/search?q=hello+world" (21 bytes)
    if nav_len != 21 { return 11; }

    // Spot check: first byte = '/' (47)
    if *((nav_ptr + 0) as &u8) != 47 { return 12; }
    // '?' at position 7
    if *((nav_ptr + 7) as &u8) != 63 { return 13; }
    // 'q' at position 8
    if *((nav_ptr + 8) as &u8) != 113 { return 14; }
    // '=' at position 9
    if *((nav_ptr + 9) as &u8) != 61 { return 15; }
    // 'h' at position 10
    if *((nav_ptr + 10) as &u8) != 104 { return 16; }
    // '+' at position 15 (space → '+')
    if *((nav_ptr + 15) as &u8) != 43 { return 17; }
    // 'w' at position 16
    if *((nav_ptr + 16) as &u8) != 119 { return 18; }
    // 'd' at position 20
    if *((nav_ptr + 20) as &u8) != 100 { return 19; }

    // ═══════════════════════════════════════════════════
    // Phase 3: Form ancestor is correct
    // ═══════════════════════════════════════════════════
    let form = test_find_form_ancestor(2);
    if form != 1 { return 30; }

    return 0;
}

pub fn sprint6_form_test() {}
pub fn render_pipeline_e2e_test() {}
