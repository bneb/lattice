package tests.test_e2e_typography

import std.core.str
import user.browser.dom
import user.browser.paint
import user.browser.typography
import user.browser.events
import user.browser.layout

extern fn c_bridge_typography_e2e_test() -> i32;
extern fn c_bridge_check_rtl() -> i32;
extern fn sys_sleep_ms(ms: u32);

@no_mangle
pub fn main() -> i32 {
    c_bridge_typography_e2e_test();
    
    // Natively construct the Arabic text node without relying on deprecated JS engine
    let s = "مرحبا بالعالم";
    my_dom.DOM_NODE_TAG[1] = my_dom.TAG_TEXT;
    my_dom.DOM_TEXT_LEN[1] = 26; // Approx byte length
    my_dom.DOM_TEXT_PTR[1] = s.ptr as u64;
    my_dom.STYLE_DISPLAY[1] = 3; // INLINE
    my_dom.STYLE_PARENT[1] = 0; // Root child
    my_dom.DIRTY_LAYOUT[1] = 1;
    my_dom.DOM_NODE_COUNT = 2;

    layout.compute_layout_core(1, 0, 0, 800);
    
    // Find text node with Arabic:
    let mut search_idx: u32 = 0;
    let mut i: u32 = 1;
    while i < 100 {
        if my_dom.DOM_NODE_TAG[i as usize] == my_dom.TAG_TEXT {
            let clen = my_dom.DOM_TEXT_LEN[i as usize];
            if clen > 5 {
                search_idx = i;
                break;
            }
        }
        i = i + 1;
    }
    
    if search_idx == 0 { return 1; }
    
    // Node should be in state 2 (PENDING)
    if typography.SHAPE_RESULT_READY[search_idx as usize] != 2 { return 2; }
    
    // Wait for worker
    let mut waits = 0;
    while typography.SHAPE_RESULT_READY[search_idx as usize] == 2 && waits < 200 {
        sys_sleep_ms(10);
        waits = waits + 1;
    }
    
    if typography.SHAPE_RESULT_READY[search_idx as usize] != 1 { return 3; }
    
    let w = typography.SHAPE_RESULT_WIDTH[search_idx as usize];
    if w <= 0.0 { return 4; }
    
    if c_bridge_check_rtl() != 1 { return 5; } // Check HarfBuzz RTL
    
    // Next layout tick applies width
    layout.compute_layout_core(1, 0, 0, 800);
    
    let final_w = my_dom.LAYOUT_W[search_idx as usize];
    if (final_w as f32) < w - 1.0 || (final_w as f32) > w + 1.0 { return 6; }
    
    return 0; // Success
}
