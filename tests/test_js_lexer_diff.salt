// tests/test_js_lexer_diff.salt
extern fn sys_log_info(ptr: u64, len: u32);
extern fn sys_print_u32(u: u32);
extern fn ext_get_mock_js_ptr() -> u64;
extern fn ext_get_mock_js_len() -> u64;

use user.browser.js_lexer.set_lex_state;
use user.browser.js_lexer.next_token_global;
use user.browser.js_tokens.JsToken;
use user.browser.js_tokens.KeywordToken;
use user.browser.js_tokens.PunctToken;

fn emit_str(ptr: u64, len: u32) {
    sys_log_info(ptr, len);
}

fn main() {
    let js_ptr = ext_get_mock_js_ptr();
    let js_len = ext_get_mock_js_len();
    
    if js_ptr == 0 || js_len == 0 { return; }
    
    set_lex_state(js_ptr, js_len as u32);
    
    let hdr: [u8; 18] = [61,61,32,74,83,32,76,69,88,69,82,32,73,82,32,61,61,10]; // "== JS LEXER IR ==\n"
    emit_str((&hdr) as u64, 18);
    
    while true {
        let tok = next_token_global();
        
        let m_tok: [u8; 6] = [84, 79, 75, 69, 78, 32]; // "TOKEN "
        emit_str((&m_tok) as u64, 6);
        
        match tok {
            JsToken::EndOfFile => {
                break;
            }
            JsToken::Keyword(kw) => {
                let m_kw: [u8; 8] = [75, 101, 121, 119, 111, 114, 100, 40]; // "Keyword("
                emit_str((&m_kw) as u64, 8);
                match kw {
                    KeywordToken::Let => {
                        let s: [u8; 3] = [76, 101, 116]; // "Let"
                        emit_str((&s) as u64, 3);
                    }
                    _ => {
                        let s: [u8; 7] = [85, 110, 107, 110, 111, 119, 110];
                        emit_str((&s) as u64, 7);
                    }
                }
                let cp: [u8; 1] = [41]; // ")"
                emit_str((&cp) as u64, 1);
            }
            JsToken::Identifier(span) => {
                let s: [u8; 10] = [73, 100, 101, 110, 116, 105, 102, 105, 101, 114]; // "Identifier"
                emit_str((&s) as u64, 10);
            }
            JsToken::Number(val) => {
                let s: [u8; 6] = [78, 117, 109, 98, 101, 114]; // "Number"
                emit_str((&s) as u64, 6);
            }
            JsToken::Punctuation(p) => {
                let m_p: [u8; 12] = [80, 117, 110, 99, 116, 117, 97, 116, 105, 111, 110, 40]; // "Punctuation("
                emit_str((&m_p) as u64, 12);
                match p {
                    PunctToken::Plus => { let s: [u8; 4] = [80, 108, 117, 115]; emit_str((&s) as u64, 4); }
                    PunctToken::Minus => { let s: [u8; 5] = [77, 105, 110, 117, 115]; emit_str((&s) as u64, 5); }
                    PunctToken::Asterisk => { let s: [u8; 8] = [65, 115, 116, 101, 114, 105, 115, 107]; emit_str((&s) as u64, 8); }
                    PunctToken::Slash => { let s: [u8; 5] = [83, 108, 97, 115, 104]; emit_str((&s) as u64, 5); }
                    PunctToken::Assign => { let s: [u8; 6] = [65, 115, 115, 105, 103, 110]; emit_str((&s) as u64, 6); }
                    PunctToken::OpenParen => { let s: [u8; 9] = [79, 112, 101, 110, 80, 97, 114, 101, 110]; emit_str((&s) as u64, 9); }
                    PunctToken::CloseParen => { let s: [u8; 10] = [67, 108, 111, 115, 101, 80, 97, 114, 101, 110]; emit_str((&s) as u64, 10); }
                    PunctToken::SemiColon => { let s: [u8; 9] = [83, 101, 109, 105, 67, 111, 108, 111, 110]; emit_str((&s) as u64, 9); }
                }
                let cp: [u8; 1] = [41]; // ")"
                emit_str((&cp) as u64, 1);
            }
            _ => {
                let s: [u8; 7] = [85, 110, 107, 110, 111, 119, 110];
                emit_str((&s) as u64, 7);
            }
        }
        let nl: [u8; 1] = [10];
        emit_str((&nl) as u64, 1);
    }
}
