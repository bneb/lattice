

// All external calls - avoids module import symbol mangling issues
extern fn sys_print_float(f: f64);
extern fn sys_print_u32(u: u32);
extern fn sys_print_i32(i: i32);
extern fn sys_log_info(msg_ptr: u64, msg_len: u32);
extern fn init_arrays();
extern fn create_node(tag: i32) -> u64;
extern fn lex_html(html_ptr: u64, max_len: u32, root_id: u64, can_execute: u8);
extern fn ext_get_mock_html_ptr() -> u64;
extern fn ext_get_mock_html_len() -> u32;
extern fn ext_get_dom_node_count() -> u64;
extern fn ext_get_dom_node_tag(idx: u32) -> u32;
extern fn ext_get_dom_node_parent(idx: u32) -> u64;
extern fn ext_get_dom_text_len(idx: u32) -> u32;

extern fn get_attr_count() -> u32;
extern fn js_get_attr_node_id(idx: u32) -> u64;
extern fn js_get_attr_key_ptr(idx: u32) -> u64;
extern fn js_get_attr_key_len(idx: u32) -> u32;
extern fn js_get_attr_val_ptr(idx: u32) -> u64;
extern fn js_get_attr_val_len(idx: u32) -> u32;

// Walk the DOM tree and print each node using exact integer printing
fn dump_dom_tree() {
    let limit = ext_get_dom_node_count() as u32;
    let mut i: u32 = 1;
    while i < limit {
        let tag = ext_get_dom_node_tag(i);
        let parent_packed = ext_get_dom_node_parent(i);
        let parent_idx = (parent_packed & 0xFFFF) as u32;
        let text_len = ext_get_dom_text_len(i);
        
        if tag == 0 && text_len > 0 {
            let m_txt: [u8; 7] = [84,69,88,84,32,78,61]; // "TEXT N="
            sys_log_info((&m_txt) as u64, 7);
            sys_print_u32(i);
            let m_p: [u8; 3] = [32,80,61]; // " P="
            sys_log_info((&m_p) as u64, 3);
            sys_print_u32(parent_idx);
            let m_l: [u8; 5] = [32,76,69,78,61]; // " LEN="
            sys_log_info((&m_l) as u64, 5);
            sys_print_u32(text_len);
            let nl: [u8; 1] = [10];
            sys_log_info((&nl) as u64, 1);
        } else {
            let m_node: [u8; 7] = [78,79,68,69,32,78,61]; // "NODE N="
            sys_log_info((&m_node) as u64, 7);
            sys_print_u32(i);
            let m_t: [u8; 3] = [32,84,61]; // " T="
            sys_log_info((&m_t) as u64, 3);
            sys_print_u32(tag);
            let m_p2: [u8; 3] = [32,80,61]; // " P="
            sys_log_info((&m_p2) as u64, 3);
            sys_print_u32(parent_idx);
            let nl: [u8; 1] = [10];
            sys_log_info((&nl) as u64, 1);
            
            let attr_count = get_attr_count();
            let mut a: u32 = 0;
            while a < attr_count {
                let node_id = js_get_attr_node_id(a);
                if (node_id & 0xFFFF) as u32 == i {
                    let k_ptr = js_get_attr_key_ptr(a);
                    let k_len = js_get_attr_key_len(a);
                    let v_ptr = js_get_attr_val_ptr(a);
                    let v_len = js_get_attr_val_len(a);
                    
                    let m_attr: [u8; 7] = [65,84,84,82,32,78,61]; // "ATTR N="
                    sys_log_info((&m_attr) as u64, 7);
                    sys_print_u32(i);
                    
                    let m_k: [u8; 3] = [32,75,61]; // " K="
                    sys_log_info((&m_k) as u64, 3);
                    sys_log_info(k_ptr, k_len);
                    
                    let m_v: [u8; 3] = [32,86,61]; // " V="
                    sys_log_info((&m_v) as u64, 3);
                    if v_len > 0 && v_ptr != 0 {
                        sys_log_info(v_ptr, v_len);
                    }
                    
                    sys_log_info((&nl) as u64, 1);
                }
                a = a + 1;
            }
        }
        
        i = i + 1;
    }
    
    let m_total: [u8; 13] = [84,79,84,65,76,95,78,79,68,69,83,61,32]; // "TOTAL_NODES= "
    sys_log_info((&m_total) as u64, 13);
    sys_print_u32(limit);
    let nl2: [u8; 1] = [10];
    sys_log_info((&nl2) as u64, 1);
}

fn main() {
    init_arrays();
    
    let html_ptr = ext_get_mock_html_ptr();
    let html_len = ext_get_mock_html_len();
    
    if html_ptr == 0 || html_len == 0 {
        let m_err: [u8; 29] = [70,65,84,65,76,58,32,78,111,32,72,84,77,76,32,112,97,121,108,111,97,100,32,103,105,118,101,110,10];
        sys_log_info((&m_err) as u64, 29);
        return;
    }
    
    let root = create_node(1); // TAG_HTML
    lex_html(html_ptr, html_len, root, 1);
    
    let m_header: [u8; 18] = [61,61,32,83,65,76,84,32,76,69,88,69,82,32,73,82,32,61]; // "== SALT LEXER IR ="
    sys_log_info((&m_header) as u64, 18);
    let nl: [u8; 1] = [10];
    sys_log_info((&nl) as u64, 1);
    
    dump_dom_tree();
}
