package tests.test_css_opacity

import user.os.ipc_ring

extern fn init_arrays();
extern fn create_node(tag: i32) -> u64;
extern fn js_set_id(node_id: u64, id_ptr: u64, id_len: u32);
extern fn airlock_init_allocator();
extern fn js_quickjs_init() -> i32;
extern fn js_quickjs_eval_string(ptr: u64, len: u32) -> i32;
extern fn js_execute_pending_jobs() -> i32;
extern fn dom_get_transform_x(idx: u32) -> f32;
extern fn dom_get_transform_y(idx: u32) -> f32;
extern fn dom_get_opacity(idx: u32) -> f32;

pub fn main() -> i32 {
    println("--- Epic 29: GPU Compositing Matrix — CSS Opacity Test ---");
    
    airlock_init_allocator();
    init_arrays();
    ipc_ring.init_shared_ring();
    js_quickjs_init();
    
    let target_id = create_node(4); // DIV
    let mut id_str: [u8; 6] = [116, 97, 114, 103, 101, 116]; // "target"
    js_set_id(target_id, (&id_str) as u64, 6);
    
    let mut script: [u8; 115] = [108,101,116,32,116,32,61,32,100,111,99,117,109,101,110,116,46,103,101,116,69,108,101,109,101,110,116,66,121,73,100,40,34,116,97,114,103,101,116,34,41,59,32,116,46,115,116,121,108,101,46,116,114,97,110,115,102,111,114,109,61,34,116,114,97,110,115,108,97,116,101,51,100,40,53,48,112,120,44,32,55,53,112,120,44,32,48,41,34,59,32,116,46,115,116,121,108,101,46,111,112,97,99,105,116,121,61,34,48,46,50,53,34,59,0];
    js_quickjs_eval_string((&script) as u64, 114);
    
    js_execute_pending_jobs();
    
    let node_idx = (target_id & 0xFFFF) as u32;
    let ty = dom_get_transform_y(node_idx);
    let op = dom_get_opacity(node_idx);
    
    let mut ok = 1;
    if ty > 74.0 && ty < 76.0 {
        println("[OK] STYLE_TRANSFORM_Y = 75.0 confirmed");
    } else {
        println("[FAIL] STYLE_TRANSFORM_Y was never set through JS to 75.0");
        ok = 0;
    }
    
    if op > 0.24 && op < 0.26 {
        println("[OK] STYLE_OPACITY = 0.25 confirmed");
    } else {
        println("[FAIL] STYLE_OPACITY was never set through JS to 0.25");
        ok = 0;
    }
    
    if ok == 1 {
        println("[Test] SUCCESS: CSS Opacity securely bypassed flexbox layout phase");
        return 0;
    }
    return 1;
}
