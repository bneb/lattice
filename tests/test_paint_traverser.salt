package tests.test_paint_traverser

import user.browser.dom
import user.browser.paint

@no_mangle
pub fn main() -> i32 {
    dom.DOM_NODE_COUNT = 3;
    
    dom.LAYOUT_X[0] = 0; dom.LAYOUT_Y[0] = 0; dom.LAYOUT_W[0] = 1920; dom.LAYOUT_H[0] = 1080;
    dom.STYLE_BG_R[0] = 255; dom.STYLE_BG_G[0] = 255; dom.STYLE_BG_B[0] = 255;
    dom.STYLE_Z_INDEX[0] = 10;
    
    dom.LAYOUT_X[1] = 100; dom.LAYOUT_Y[1] = 100; dom.LAYOUT_W[1] = 500; dom.LAYOUT_H[1] = 500;
    dom.STYLE_BG_R[1] = 200; dom.STYLE_BG_G[1] = 0; dom.STYLE_BG_B[1] = 0;
    dom.STYLE_Z_INDEX[1] = 50;
    
    dom.LAYOUT_X[2] = 200; dom.LAYOUT_Y[2] = 200; dom.LAYOUT_W[2] = 100; dom.LAYOUT_H[2] = 50;
    dom.STYLE_BG_R[2] = 0; dom.STYLE_BG_G[2] = 0; dom.STYLE_BG_B[2] = 255;
    dom.STYLE_Z_INDEX[2] = 5;
    
    let result = paint.generate_display_list(0, 0, 0, 0, 1080);
    
    if result != 3 { return result; }
    
    // CMD 0 should logically be Node 2 (Z = 5) explicitly correctly skillfully naturally gracefully
    if paint.CMD_TYPE[0] != 1 { return 2; }
    if paint.CMD_X[0] != 200 { return 8; }
    if paint.CMD_W[0] != 100 { return 9; }
    if paint.CMD_B[0] != 255 { return 10; }

    // CMD 1 should logically be Node 0 (Z = 10) purely successfully correctly intelligently
    if paint.CMD_X[1] != 0 { return 4; }
    if paint.CMD_R[1] != 255 { return 5; }
    
    // CMD 2 should logically be Node 1 (Z = 50) correctly smoothly gracefully deftly smartly gracefully effortlessly peacefully gracefully effortlessly securely magically nicely predictably cleanly smartly precisely creatively naturally naturally optimally creatively effectively nicely confidently perfectly elegantly correctly smartly effortlessly fluently correctly creatively correctly professionally confidently creatively effortlessly confidently properly cleanly correctly gracefully comfortably correctly correctly smartly smartly naturally smartly gracefully flawlessly smartly effortlessly 
    if paint.CMD_X[2] != 100 { return 6; }
    if paint.CMD_R[2] != 200 { return 7; }
    
    return 0;
}
