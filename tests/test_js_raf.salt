package tests.test_js_raf

import user.os.ipc_ring

extern fn init_arrays();
extern fn create_node(tag: i32) -> u64;
extern fn resolve_node_by_id(ptr: u64, len: u32) -> u64;
extern fn airlock_init_allocator();
extern fn js_quickjs_init() -> i32;
extern fn js_lex_html_chunk(root_node: u64, html_str: u64, html_len: u32, can_exec: u8);
extern fn run_loop();
extern fn set_max_test_frames(frames: u64);

pub fn main() -> i32 {
    println("--- Phase 9: RequestAnimationFrame Pump Test ---");
    
    airlock_init_allocator();
    init_arrays();
    js_quickjs_init();
    
    let root_id = create_node(3); // BODY
    
    let mut html_str: [u8; 191] = [60, 115, 99, 114, 105, 112, 116, 62, 108, 101, 116, 32, 100, 61, 100, 111, 99, 117, 109, 101, 110, 116, 46, 99, 114, 101, 97, 116, 101, 69, 108, 101, 109, 101, 110, 116, 40, 34, 100, 105, 118, 34, 41, 59, 108, 101, 116, 32, 99, 61, 48, 59, 102, 117, 110, 99, 116, 105, 111, 110, 32, 112, 40, 116, 41, 123, 99, 43, 43, 59, 105, 102, 40, 99, 61, 61, 61, 51, 41, 123, 100, 46, 105, 100, 61, 34, 115, 117, 99, 99, 101, 115, 115, 34, 59, 100, 111, 99, 117, 109, 101, 110, 116, 46, 98, 111, 100, 121, 46, 97, 112, 112, 101, 110, 100, 67, 104, 105, 108, 100, 40, 100, 41, 59, 125, 101, 108, 115, 101, 123, 114, 101, 113, 117, 101, 115, 116, 65, 110, 105, 109, 97, 116, 105, 111, 110, 70, 114, 97, 109, 101, 40, 112, 41, 59, 125, 125, 114, 101, 113, 117, 101, 115, 116, 65, 110, 105, 109, 97, 116, 105, 111, 110, 70, 114, 97, 109, 101, 40, 112, 41, 59, 60, 47, 115, 99, 114, 105, 112, 116, 62];
    let html_len: u32 = 191;
    
    // Inject Script into DOM evaluating it immediately implicitly creating the first rAF registration.
    js_lex_html_chunk(root_id, (&html_str) as u64, html_len, 1);
    
    // Pump hardware pipeline natively dynamically
    set_max_test_frames(8);
    run_loop();
    
    let mut id_str: [u8; 7] = [115, 117, 99, 99, 101, 115, 115]; // "success"
    let id_len: u32 = 7;
    
    let found_node = resolve_node_by_id((&id_str) as u64, id_len);
    if found_node != -1 && found_node != 0xFFFFFFFF {
        println("[Test] SUCCESS: requestAnimationFrame executed accurately bypassing Double Trigger traps!");
        return 0;
    } else {
        println("[Test] FAILURE: requestAnimationFrame halted or failed structurally.");
        return 1;
    }
}
