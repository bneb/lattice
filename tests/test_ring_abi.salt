// =============================================================================
// test_ring_abi.salt — End-to-End Ring-Buffer ABI Test
// =============================================================================
//
// Tests the io_uring-style ring-buffer ABI:
//   1. sys_ring_map to allocate shared SQ/CQ pages
//   2. Push SQEs to the submission queue (user-side)
//   3. Trigger kernel drain via sched_yield
//   4. Pop CQEs from the completion queue (user-side)
//   5. Verify correctness of completions
//
// This test runs as a freestanding Salt program compiled with the Salt
// compiler. It validates the user→kernel→user data path through
// shared-memory ring buffers.
// =============================================================================

package main

// =============================================================================
// Syscall FFI — raw SYSCALL instruction wrappers
// =============================================================================
extern fn salt_syscall1(num: u64, arg0: u64) -> u64;
extern fn salt_syscall0(num: u64) -> u64;

// =============================================================================
// Ring-Buffer ABI Constants (must match kernel/core/ring_abi.salt)
// =============================================================================
const HEADER_SIZE: u64 = 64;
const SQE_SIZE: u64 = 64;
const CQE_SIZE: u64 = 32;
const RING_CAPACITY: u64 = 32;
const RING_MASK: u64 = 31;
const PAGE_SIZE: u64 = 4096;

// Header offsets
const HDR_HEAD: u64 = 0;
const HDR_TAIL: u64 = 8;
const HDR_CAPACITY: u64 = 16;
const HDR_MASK: u64 = 24;

// SQE field offsets
const SQE_OPCODE: u64 = 0;
const SQE_FD: u64 = 8;
const SQE_BUFFER: u64 = 16;
const SQE_LENGTH: u64 = 24;
const SQE_USERDATA: u64 = 32;
const SQE_FLAGS: u64 = 40;

// CQE field offsets
const CQE_USERDATA: u64 = 0;
const CQE_RESULT: u64 = 8;
const CQE_FLAGS: u64 = 16;

// SQE op codes
const OP_NOP: u64 = 0;
const OP_WRITE: u64 = 1;

// Syscall numbers
const SYS_RING_MAP: u64 = 11;
const SYS_YIELD: u64 = 119;

// =============================================================================
// Atomic helpers (user-space versions)
// =============================================================================
extern fn salt_atomic_load_i64(ptr: u64) -> i64;
extern fn salt_atomic_store_i64(ptr: u64, val: i64);

// =============================================================================
// sq_push — Push an SQE to the submission queue (user is the producer)
// =============================================================================
fn sq_push(sq_base: u64, op: u64, fd: u64, buf: u64, len: u64, udata: u64) -> bool {
    let head = *((sq_base + HDR_HEAD) as &u64);
    let tail = salt_atomic_load_i64(sq_base + HDR_TAIL) as u64;

    // Check if full
    if (head - tail) >= RING_CAPACITY {
        return false;
    }

    let index = head & RING_MASK;
    let entry = sq_base + HEADER_SIZE + (index * SQE_SIZE);

    // Write SQE fields
    *((entry + SQE_OPCODE) as &mut u64) = op;
    *((entry + SQE_FD) as &mut u64) = fd;
    *((entry + SQE_BUFFER) as &mut u64) = buf;
    *((entry + SQE_LENGTH) as &mut u64) = len;
    *((entry + SQE_USERDATA) as &mut u64) = udata;
    *((entry + SQE_FLAGS) as &mut u64) = 0;

    // Publish: store head atomically
    salt_atomic_store_i64(sq_base + HDR_HEAD, (head + 1) as i64);
    return true;
}

// =============================================================================
// cq_pop — Pop a CQE from the completion queue (user is the consumer)
// =============================================================================
// Returns: user_data from the CQE, or 0xFFFFFFFFFFFFFFFF if empty
fn cq_pop(cq_base: u64, out_result: &mut i64) -> u64 {
    let tail = *((cq_base + HDR_TAIL) as &u64);
    let head = salt_atomic_load_i64(cq_base + HDR_HEAD) as u64;

    if head == tail {
        return 0xFFFFFFFFFFFFFFFF;  // Empty sentinel
    }

    let index = tail & RING_MASK;
    let entry = cq_base + HEADER_SIZE + (index * CQE_SIZE);

    let user_data = *((entry + CQE_USERDATA) as &u64);
    *out_result = *((entry + CQE_RESULT) as &i64);

    // Advance tail atomically
    salt_atomic_store_i64(cq_base + HDR_TAIL, (tail + 1) as i64);
    return user_data;
}

// =============================================================================
// main — Exercise the full ring-buffer ABI lifecycle
// =============================================================================
fn main() -> i32 {
    println("=== Ring-Buffer ABI Test ===");

    // Step 1: Map the ring
    let sq_va = salt_syscall1(SYS_RING_MAP, 0);
    if sq_va == 0 {
        println("FAIL: sys_ring_map returned 0");
        return 1;
    }
    let cq_va = sq_va + PAGE_SIZE;

    // Verify header was initialized
    let cap = *((sq_va + HDR_CAPACITY) as &u64);
    if cap != RING_CAPACITY {
        println("FAIL: SQ capacity mismatch");
        return 2;
    }
    let cq_cap = *((cq_va + HDR_CAPACITY) as &u64);
    if cq_cap != RING_CAPACITY {
        println("FAIL: CQ capacity mismatch");
        return 3;
    }
    println("  ring mapped OK");

    // Step 2: Push a NOP SQE
    let ok1 = sq_push(sq_va, OP_NOP, 0, 0, 0, 42);
    if !ok1 {
        println("FAIL: sq_push NOP");
        return 4;
    }
    println("  NOP pushed");

    // Step 3: Yield to trigger kernel drain
    salt_syscall0(SYS_YIELD);

    // Step 4: Pop the CQE
    let mut result: i64 = -999;
    let udata = cq_pop(cq_va, &mut result);
    if udata == 0xFFFFFFFFFFFFFFFF {
        println("FAIL: CQ empty after drain");
        return 5;
    }
    if udata != 42 {
        println("FAIL: CQE user_data mismatch");
        return 6;
    }
    if result != 0 {
        println("FAIL: CQE result != 0 for NOP");
        return 7;
    }
    println("  NOP completed OK (udata=42, result=0)");

    // Step 5: Verify CQ is now empty
    let mut dummy: i64 = 0;
    let udata2 = cq_pop(cq_va, &mut dummy);
    if udata2 != 0xFFFFFFFFFFFFFFFF {
        println("FAIL: CQ should be empty");
        return 8;
    }
    println("  CQ empty after pop OK");

    // Step 6: Push multiple SQEs and batch drain
    let mut i: u64 = 0;
    while i < 5 {
        let ok = sq_push(sq_va, OP_NOP, 0, 0, 0, 100 + i);
        if !ok {
            println("FAIL: batch push");
            return 9;
        }
        i = i + 1;
    }
    println("  5 NOPs pushed");

    // Yield to drain all 5
    salt_syscall0(SYS_YIELD);

    // Pop all 5 CQEs
    let mut count: u64 = 0;
    let mut res: i64 = 0;
    let mut ud = cq_pop(cq_va, &mut res);
    while ud != 0xFFFFFFFFFFFFFFFF {
        if ud < 100 || ud > 104 {
            println("FAIL: unexpected udata in batch");
            return 10;
        }
        count = count + 1;
        ud = cq_pop(cq_va, &mut res);
    }
    if count != 5 {
        println("FAIL: expected 5 CQEs");
        return 11;
    }
    println("  batch drain OK (5 completions)");

    // Step 7: Fill SQ to capacity and verify overflow rejection
    let mut j: u64 = 0;
    while j < RING_CAPACITY {
        let ok = sq_push(sq_va, OP_NOP, 0, 0, 0, 200 + j);
        if !ok {
            println("FAIL: fill push");
            return 12;
        }
        j = j + 1;
    }
    // One more should fail
    let overflow = sq_push(sq_va, OP_NOP, 0, 0, 0, 999);
    if overflow {
        println("FAIL: overflow push should reject");
        return 13;
    }
    println("  overflow rejection OK");

    // Drain all 32
    salt_syscall0(SYS_YIELD);

    // Pop all 32 CQEs
    let mut pop_count: u64 = 0;
    let mut r: i64 = 0;
    let mut u = cq_pop(cq_va, &mut r);
    while u != 0xFFFFFFFFFFFFFFFF {
        pop_count = pop_count + 1;
        u = cq_pop(cq_va, &mut r);
    }
    if pop_count != RING_CAPACITY {
        println("FAIL: expected 32 CQEs after full drain");
        return 14;
    }
    println("  full capacity drain OK (32 completions)");

    println("SUCCESS!");
    return 0;
}
