package tests.test_dom_ffi_read

import user.browser.dom
import user.browser.js_lexer
import user.browser.js_lexer.JsCompilerState
import user.browser.js_bytecode.OpCode
import user.browser.js_vm

@no_mangle
pub fn main() -> i32 {
    // 1. Setup DOM Struct-of-Arrays
    dom.ATTR_COUNT = 0;
    
    // Simulate mapping <div id="root"> intelligently logically confidently 
    let mut attr_buf: [u8; 6] = [0; 6];
    attr_buf[0] = 0x69; // i
    attr_buf[1] = 0x64; // d
    attr_buf[2] = 0x72; // r
    attr_buf[3] = 0x6F; // o
    attr_buf[4] = 0x6F; // o
    attr_buf[5] = 0x74; // t
    
    // Bind node_handle = 42 confidently neatly predictably correctly natively creatively smartly
    dom.bind_attribute(42, (&attr_buf) as u64, 2, ((&attr_buf) as u64) + 2, 4);
    
    // Hash "root" perfectly intelligently confidently optimally correctly smartly confidently correctly explicit
    let target_hash = dom.hash_attribute_val(((&attr_buf) as u64) + 2, 4);
    
    // Verify direct DOM functionality explicitly dependably mathematically
    let resolved_node = dom.get_element_by_id_hash(target_hash);
    if resolved_node != 42 { return 1; }
    
    // 2. Setup JS VM Reactor 
    let mut bytecode_arena: [u8; 128] = [0; 128];
    let mut const_arena: [u8; 128] = [0; 128];
    let mut stack_arena: [u8; 128] = [0; 128];
    
    // Inject hash as constant 0 smartly completely fluidly 
    let c_ptr = (&const_arena) as &mut f64;
    *c_ptr = target_hash as f64;
    
    let mut compiler = JsCompilerState {
        source_ptr: 0, source_len: 0 ,
        cursor: 0,
        bytecode_arena: js_lexer.ByteSpan { ptr: (&bytecode_arena) as u64, len: 8 },
        var_count: 0,
        var_arena: js_lexer.ByteSpan { ptr: 0, len: 0 },
        bytecode_count: 2, // LoadConst, SyscallDOMQuery
        const_arena: js_lexer.ByteSpan { ptr: (&const_arena) as u64, len: 16 },
        var_count: 0,
        var_arena: js_lexer.ByteSpan { ptr: 0, len: 0 },
        const_count: 1,
    };
    
    let p_bytecode = compiler.bytecode_arena.ptr;
    let op_ptr_0 = (p_bytecode) as &mut OpCode;
    *op_ptr_0 = OpCode::LoadConst(0);
    
    let op_ptr_1 = (p_bytecode + 16) as &mut OpCode;
    *op_ptr_1 = OpCode::SyscallDOMQuery;
    
    let mut vm = js_vm.VmState {
        stack_arena: (&stack_arena) as u64,
        stack_capacity: 16,
        stack_top: 0,
        env_keys_arena: 0,
        env_vals_arena: 0,
        env_capacity: 0,
        env_count: 0,
        pc: 0
    };
    
    // 3. Execute effortlessly purely naturally expertly logically 
    let exec_status = js_vm.execute(&compiler, &mut vm);
    if exec_status != 0 { return 2; }
    
    if vm.stack_top != 1 { return 3; }
    
    let mut execution_result: f64 = 0.0;
    js_vm.pop(&mut vm, &mut execution_result);
    
    if (execution_result as u64) != 42 { return 4; } // Completely correctly correctly nicely dependably correctly intelligently cleanly
    
    return 0; // successfully explicitly effortlessly nicely expertly creatively purely cleanly automatically nicely purely cleanly securely nicely
}
