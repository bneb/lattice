package tests.test_shadow_dom

// Link into critical DOM symbols (From dom.salt @no_mangle)
extern fn init_arrays();
extern fn create_node(tag: i32) -> u64;
extern fn resolve_node_by_id(ptr: u64, len: u32) -> u64;

// Link into lexer and CSS
extern fn js_lex_html_chunk(root_id: u64, ptr: u64, len: u32, can_execute: u8);
extern fn apply_cascade_to_tree();
extern fn init_css_lexer_arrays();

// Link into layout FFI (QuickJS execution handles pending jobs)
extern fn js_execute_pending_jobs() -> i32;
extern fn js_init_quickjs();
extern fn js_quickjs_eval_string(ptr: u64, len: u32) -> i32;
extern fn airlock_init_allocator();
extern fn sys_js_pump_script_queue();

// Access arrays directly to verify tests
extern fn resolve_node(id: u64) -> u32;
extern fn dom_get_bg_r(idx: u32) -> u8;

pub fn main() -> i32 {
    println("--- Epic 64: Shadow DOM Matrix Testing ---");
    
    airlock_init_allocator();
    init_arrays();
    init_css_lexer_arrays();
    js_init_quickjs();
    
    let root_node = create_node(3); // BODY
    
    let mut html: [u8; 48] = [60, 100, 105, 118, 32, 105, 100, 61, 34, 104, 111, 115, 116, 34, 62, 60, 47, 100, 105, 118, 62, 60, 100, 105, 118, 32, 105, 100, 61, 34, 103, 108, 111, 98, 97, 108, 45, 100, 105, 118, 34, 62, 60, 47, 100, 105, 118, 62];
    let html_len = 48;
    
    // Evaluate HTML
    js_lex_html_chunk(root_node, (&html) as u64, html_len, 1);
    
    let mut js: [u8; 179] = [108, 101, 116, 32, 104, 111, 115, 116, 32, 61, 32, 100, 111, 99, 117, 109, 101, 110, 116, 46, 103, 101, 116, 69, 108, 101, 109, 101, 110, 116, 66, 121, 73, 100, 40, 34, 104, 111, 115, 116, 34, 41, 59, 32, 108, 101, 116, 32, 115, 104, 97, 100, 111, 119, 32, 61, 32, 104, 111, 115, 116, 46, 97, 116, 116, 97, 99, 104, 83, 104, 97, 100, 111, 119, 40, 49, 41, 59, 32, 115, 104, 97, 100, 111, 119, 46, 105, 110, 110, 101, 114, 72, 84, 77, 76, 32, 61, 32, 34, 60, 115, 116, 121, 108, 101, 62, 100, 105, 118, 32, 123, 32, 98, 97, 99, 107, 103, 114, 111, 117, 110, 100, 45, 99, 111, 108, 111, 114, 58, 32, 35, 102, 102, 48, 48, 48, 48, 59, 32, 125, 60, 47, 115, 116, 121, 108, 101, 62, 60, 100, 105, 118, 32, 105, 100, 61, 92, 34, 115, 104, 97, 100, 111, 119, 45, 100, 105, 118, 92, 34, 62, 60, 47, 100, 105, 118, 62, 34, 59];
    let js_len = 179;
    
    // QuickJS Eval directly
    js_quickjs_eval_string((&js) as u64, js_len);
    
    // Execute synchronous script eval which binds the shadow root and its innerHTML
    sys_js_pump_script_queue();
    
    // Apply CSS Cascade mapping
    apply_cascade_to_tree(); 
    
    // Resolve "shadow-div" node
    let mut shadow_div_str: [u8; 10] = [115, 104, 97, 100, 111, 119, 45, 100, 105, 118];
    let shadow_div_id = resolve_node_by_id((&shadow_div_str) as u64, 10);
    
    let mut global_div_str: [u8; 10] = [103, 108, 111, 98, 97, 108, 45, 100, 105, 118];
    let global_div_id = resolve_node_by_id((&global_div_str) as u64, 10);
    
    if shadow_div_id != 0xFFFFFFFFFFFFFFFF && global_div_id != 0xFFFFFFFFFFFFFFFF {
        let shadow_idx = resolve_node(shadow_div_id);
        let global_idx = resolve_node(global_div_id);
        
        let shadow_r = dom_get_bg_r(shadow_idx);
        let global_r = dom_get_bg_r(global_idx);
        
        if shadow_r == 255 && global_r == 0 {
            println("[Test] SUCCESS: CSS Cascade Boundary successfully encapsulated CSS styles within Shadow DOM!");
        } else {
            println("[Test] FAILURE: CSS leakage. shadow_r={}, global_r={}", shadow_r, global_r);
            return 1;
        }
    } else {
        println("[Test] FAILURE: Lexer failed to map id attributes correctly.");
        return 1;
    }
    
    return 0;
}
