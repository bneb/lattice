// =============================================================================
// test_ecs_sparse_set.salt — Sparse Set Unit Tests
// =============================================================================
// RED-TO-GREEN: Tests sparse set insert, get, mutate, and remove operations.
// =============================================================================

package main

import kernel.ecs.entity.{Entity, EntityAllocator, new_entity_allocator, entity_allocator_allocate, entity_allocator_free, entity_allocator_is_alive}
import kernel.ecs.components.{TestComponent}
import kernel.ecs.sparse_set.{TestSparseSet, new_test_set, test_set_insert, test_set_get, test_set_get_mut, test_set_remove, test_set_contains}

extern fn println(s: Ptr<u8>);

fn main() -> i32 {
    let alloc = new_entity_allocator();
    let set = new_test_set();
    
    let e1 = entity_allocator_allocate(alloc);
    let e2 = entity_allocator_allocate(alloc);

    // Test 1: Insert components
    test_set_insert(set, e1, TestComponent { val: 100 });
    test_set_insert(set, e2, TestComponent { val: 200 });

    // Test 2: Retrieve components (get)
    let c1 = test_set_get(set, e1);
    if c1.is_null() { println("FAIL: c1 is null"); return 1; }
    if c1[0].val != 100 { println("FAIL: c1[0].val != 100"); return 2; }

    let c2 = test_set_get(set, e2);
    if c2.is_null() { println("FAIL: c2 is null"); return 3; }
    if c2[0].val != 200 { println("FAIL: c2[0].val != 200"); return 4; }

    // Test 3: Mutate component in-place
    let c1_mut = test_set_get_mut(set, e1);
    c1_mut[0].val = 150;

    let c1_check = test_set_get(set, e1);
    if c1_check[0].val != 150 { println("FAIL: c1_check[0].val != 150"); return 5; }

    // Test 4: Contains check
    let has_e1 = test_set_contains(set, e1);
    if !has_e1 { println("FAIL: contains(e1) should be true"); return 6; }

    // Test 5: Remove component
    test_set_remove(set, e1);
    let has_e1_after = test_set_contains(set, e1);
    if has_e1_after { println("FAIL: contains(e1) should be false"); return 7; }

    let c1_after = test_set_get(set, e1);
    if !c1_after.is_null() { println("FAIL: c1_after should be null"); return 8; }

    // Test 6: Swap-remove correctness (e2 should still be there)
    let c2_after = test_set_get(set, e2);
    if c2_after.is_null() { println("FAIL: c2 should still be alive"); return 9; }
    if c2_after[0].val != 200 { println("FAIL: c2 value corrupted during swap-remove"); return 10; }

    println("All sparse set tests PASSED!");
    return 0;
}
