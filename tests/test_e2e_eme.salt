package tests.test_e2e_eme

import user.browser.main
import user.browser.ipc_shared
import user.os.process


// Externs for atomic access to shared memory and JSC init
extern fn sys_atomic_load_u32(ptr: u64) -> u32;
extern fn sys_atomic_store_u32(ptr: u64, val: u32);
extern fn js_engine_init();
extern fn ext_media_push_encrypted_chunk(ptr: u64, len: u32, sid: u32);
extern fn ext_media_set_arena_ptr(ptr: u64);


@no_mangle
pub fn main() {
    println("--- Epic 87: EME Sandbox Multi-Process E2E Test ---");
    
    // 1. Establish POSIX Shared Memory for Decryption Arena
    let mut shm_name: [u8; 19] = [47, 112, 114, 105, 115, 105, 109, 105, 95, 99, 100, 109, 95, 97, 114, 101, 110, 97, 0];
    let shm_fd = process.create_shm((&shm_name) as u64, 16777216); // 16MB

    if shm_fd < 0 {
        println("[EME Test] FAILURE: Could not create shared memory.");
        return;
    }
    
    let arena_base = process.mmap_fd(shm_fd, 16777216);
    if arena_base == 0 {
        println("[EME Test] FAILURE: Could not map shared memory.");
        return;
    }
    
    ext_media_set_arena_ptr(arena_base);

    
    // 2. Spawn the isolated CDM process
    // We pass the SHM handle via --ipc-fd for cdm_main to pick up
    // In our simplified spawn, we'll just handle it in the bridge or cdm_main logic
    let mut cdm_cmd: [u8; 11] = [46, 47, 99, 100, 109, 95, 109, 97, 105, 110, 0];
    let cdm_pid = process.spawn((&cdm_cmd) as u64);

    
    // 3. Boot the JSC Matrix
    js_engine_init();
    
    // 4. Synthesize JS Payload Test
    // For Epic 87, we verify the cross-process barrier.
    // Chunk starts at arena_base + 131072. Prefix header is at -4.
    let target_offset: u64 = 131072;
    let target_ptr = arena_base + target_offset;
    
    // Clear readiness signal
    sys_atomic_store_u32(target_ptr - 4, 0);
    
    // Write 0xAA to the arena.
    *((target_ptr) as &mut u8) = 0xAA;
    
    println("[EME Test] Triggering Cross-Process IPC Decrypt (0xAA)...");
    
    // 5. Trigger the IPC Decrypt
    // This utilizes the aligned barrier and spinloop governor in media.salt
    ext_media_push_encrypted_chunk(target_ptr, 1, 0x1337);
    
    // 6. Assert Validation
    let decrypted_val = *((target_ptr) as &u8);
    // 0xAA ^ 0xFF = 0x55
    if decrypted_val == 0x55 {
        println("[EME Test] SUCCESS: Cross-process decryption verified (Received 0x55).");
    } else {
        println(f"[EME Test] FAILURE: Decryption mismatch. Received: {decrypted_val:#02x}");
    }
    
    // 7. Annihilate Sandbox to prevent leaking orphan processes
    println("[EME Test] Shutting down CDM sandbox...");
    process.kill(cdm_pid);
    println("[EME Test] PASS");
}
