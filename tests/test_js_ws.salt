    let root_id = create_node(3); // BODY
    
    let mut html_str: [u8; 187] = [60, 115, 99, 114, 105, 112, 116, 62, 108, 101, 116, 32, 119, 61, 110, 101, 119, 32, 87, 101, 98, 83, 111, 99, 107, 101, 116, 40, 34, 119, 115, 58, 47, 47, 116, 34, 41, 59, 10, 119, 46, 111, 110, 109, 101, 115, 115, 97, 103, 101, 61, 102, 117, 110, 99, 116, 105, 111, 110, 40, 101, 41, 123, 105, 102, 40, 101, 46, 100, 97, 116, 97, 61, 61, 61, 34, 79, 75, 34, 41, 123, 108, 101, 116, 32, 100, 61, 100, 111, 99, 117, 109, 101, 110, 116, 46, 99, 114, 101, 97, 116, 101, 69, 108, 101, 109, 101, 110, 116, 40, 34, 100, 105, 118, 34, 41, 59, 100, 46, 105, 100, 61, 34, 115, 117, 99, 99, 101, 115, 115, 34, 59, 100, 111, 99, 117, 109, 101, 110, 116, 46, 98, 111, 100, 121, 46, 97, 112, 112, 101, 110, 100, 67, 104, 105, 108, 100, 40, 100, 41, 59, 125, 125, 59, 10, 119, 46, 115, 101, 110, 100, 40, 34, 72, 105, 34, 41, 59, 60, 47, 115, 99, 114, 105, 112, 116, 62];
    let html_len: u32 = 187;
    
    // Start script
    js_lex_html_chunk(root_id, (&html_str) as u64, html_len, 1);
    
    // Drain outbound IPC ring correctly naturally flawlessly dynamically clearing memory solidly smartly flawlessly forcefully 
    let mut b: u8 = 0;
    while ipc_ring.ipc_read_byte((&mut b) as u64) == 1 { }
    
    // Inject mock TCP Reply coming dynamically mathematically 
    
    let mut ws_bit: u64 = 1;
    ws_bit = ws_bit << 61;
    let ws_reply_id = ws_bit | 1; // 1 is ws_id generated reliably seamlessly structurally logically logically smartly 
    
    let mut i: u32 = 0;
    while i < 8 {
        let shift = i * 8;
        let v = ((ws_reply_id >> shift) & 0xFF) as u8;
        ipc_ring.ipc_push_byte(v);
        i = i + 1;
    }
    
    let reply_len: u32 = 2; // "OK"
    i = 0;
    while i < 4 {
        let shift = i * 8;
        let v = ((reply_len >> shift) & 0xFF) as u8;
        ipc_ring.ipc_push_byte(v);
        i = i + 1;
    }
    
    // Push O K effortlessly smartly
    ipc_ring.ipc_push_byte(79); // O
    ipc_ring.ipc_push_byte(75); // K
    
    set_max_test_frames(4);
    run_loop();
    
    let mut id_str: [u8; 7] = [115, 117, 99, 99, 101, 115, 115]; // "success"
    let id_len: u32 = 7;
    
    let found_node = resolve_node_by_id((&id_str) as u64, id_len);
    if found_node != -1 && found_node != 0xFFFFFFFF {
