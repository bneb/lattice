package tests.test_e2e_reflow

    
extern fn init_arrays();
extern fn create_node(tag: i32) -> u64;
extern fn resolve_node_by_id(ptr: u64, len: u32) -> u64;
extern fn js_lex_html_chunk(root_id: u64, ptr: u64, len: u32, can_execute: u8);
extern fn js_execute_pending_jobs() -> i32;
extern fn js_init_quickjs();
extern fn airlock_init_allocator();
extern fn sys_js_pump_script_queue();
extern fn js_eval_buffer(ptr: u64, len: u32) -> i32;
extern fn dom_clear_dirty_flags();
extern fn resolve_node(id: u64) -> u32;

extern fn compute_layout(node_idx: u32, offset_x: i32, offset_y: i32, max_width: i32) -> i32;
extern fn get_layout_eval_count() -> u32;
extern fn set_layout_eval_count(c: u32);


pub fn main() -> i32 {
    println("--- Epic 48: The Dirty-Bit Reflow Engine E2E Validation ---");
    
    airlock_init_allocator();
    init_arrays();
    js_init_quickjs();
    
    let root_node = create_node(3); // BODY
    
    // Inject seed container: <div id="root"></div>
    let mut html: [u8; 21] = [
        60, 100, 105, 118, 32, 105, 100, 61, 34, 114, 111, 111, 116, 34, 62, 60, 
        47, 100, 105, 118, 62
    ];
    js_lex_html_chunk(root_node, (&html) as u64, 21, 1);
    
    // Construct 1000-deep nested div tree in JS:
    // let r = document.getElementById('root'); let curr = r;
    // for(let i=0; i<1000; i++) { let c = document.createElement('div');
    //   if (i===500) globalThis.deep_child = c; curr.appendChild(c); curr = c; }
    let mut setup_script: [u8; 194] = [
        108,101,116,32,114,32,61,32,100,111,99,117,109,101,110,116,46,103,101,116,69,108,101,109,101,110,116,66,121,73,100,40,39,114,111,111,116,39,41,59,32,108,101,116,32,99,117,114,114,32,61,32,114,59,32,102,111,114,40,108,101,116,32,105,61,48,59,32,105,60,49,48,48,48,59,32,105,43,43,41,32,123,32,108,101,116,32,99,32,61,32,100,111,99,117,109,101,110,116,46,99,114,101,97,116,101,69,108,101,109,101,110,116,40,39,100,105,118,39,41,59,32,105,102,32,40,105,61,61,61,53,48,48,41,32,103,108,111,98,97,108,84,104,105,115,46,100,101,101,112,95,99,104,105,108,100,32,61,32,99,59,32,99,117,114,114,46,97,112,112,101,110,100,67,104,105,108,100,40,99,41,59,32,99,117,114,114,32,61,32,99,59,32,125
    ];
    js_eval_buffer((&setup_script) as u64, 194);
    
    // Run script evaluation and first full layout pass
    sys_js_pump_script_queue();
    
    set_layout_eval_count(0);
    compute_layout(resolve_node(root_node), 0, 0, 1024);
    
    let pass_1 = get_layout_eval_count();
    
    if pass_1 < 1000 {
        println("[Test] FAILURE: Initial layout did not traverse all nodes.");
        return 1;
    }
    
    // Clear dirty flags to simulate a clean frame boundary
    dom_clear_dirty_flags();
    
    // Inject a single geometric mutation 500 layers deep:
    // globalThis.deep_child.style.width = '500px';
    let mut mut_script: [u8; 44] = [
        103,108,111,98,97,108,84,104,105,115,46,100,101,101,112,95,99,104,105,108,100,46,115,116,121,108,101,46,119,105,100,116,104,32,61,32,39,53,48,48,112,120,39,59
    ];
    js_eval_buffer((&mut_script) as u64, 44);
    sys_js_pump_script_queue();
    
    // Re-run layout — should bypass untouched subtrees
    set_layout_eval_count(0);
    compute_layout(resolve_node(root_node), 0, 0, 1024);
    
    let pass_2 = get_layout_eval_count();
    
    // DEBUG
    println("pass_2 = {}", pass_2);
    
    if pass_2 < 600 && pass_2 > 0 {
        println("[Test] SUCCESS: Dirty-Bit invalidation optimally traversed exactly the affected O(log N) ancestral path, completely bypassing exactly the untouched child topologies!");
    } else {
        println("[Test] FAILURE: Engine failed to cache bypass topologies or broke ancestral bubble.");
        return 1;
    }
    
    return 0;
}
