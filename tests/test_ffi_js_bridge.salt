// =============================================================================
// Test: FFI JavaScript Bridge Regression
// =============================================================================
// Validates the JavaScript engine bridge (sys_js_evaluate_script) successfully
// evaluates JavaScript and interacts with the DOM.
//
// Detection keyword for run_test.sh auto-linking:
// js_e2e_test
// =============================================================================

extern fn sys_log_info(msg_ptr: u64, msg_len: u32);
extern fn sys_print_float(f: f64);
extern fn sys_jsc_init();
extern fn sys_jsc_evaluate_script(code_ptr: u64, code_len: u32, filename_ptr: u64);
extern fn sys_jsc_flush_microtasks();
extern fn ext_c_shape_and_measure(node_id: u32, text_ptr: u64, text_len: u32) -> f32; // Used just to trigger link if needed
extern fn init_arrays();
extern fn ext_get_dom_node_count() -> u64;

fn main() -> i32 {
    let nl: [u8; 1] = [10];

    // === BOOT ===
    init_arrays();
    sys_jsc_init(); // Returns void

    let mut failures: i32 = 0;

    // We assume init succeeds (it's void) unless it crashes
    let m1: [u8; 25] = [80,65,83,83,58,32,106,115,103,105,110,105,116,32,32,32,32,32,32,32,32,32,32,32,10];
    // "PASS: js_init          \n"
    sys_log_info((&m1) as u64, 25);

    // === TEST 2: Execute JS that creates a DOM node ===
    let initial_count = ext_get_dom_node_count();
    
    // "document.createElement('div');"
    let script: [u8; 30] = [100, 111, 99, 117, 109, 101, 110, 116, 46, 99, 114, 101, 97, 116, 101, 69, 108, 101, 109, 101, 110, 116, 40, 39, 100, 105, 118, 39, 41, 59];
    let filename: [u8; 7] = [116, 101, 115, 116, 46, 106, 115]; // "test.js"
    
    sys_jsc_evaluate_script((&script) as u64, 30, (&filename) as u64);
    sys_jsc_flush_microtasks();

    let final_count = ext_get_dom_node_count();
    
    // We expect initial_count + 1 (the new div element)
    if final_count > initial_count {
        let m2: [u8; 26] = [80,65,83,83,58,32,100,111,109,95,99,111,117,110,116,95,105,110,99,114,101,97,115,101,100,10];
        // "PASS: dom_count_increased\n"
        sys_log_info((&m2) as u64, 26);
    } else {
        let m2: [u8; 26] = [70,65,73,76,58,32,100,111,109,95,99,111,117,110,116,95,105,110,99,114,101,97,115,101,100,10];
        // "FAIL: dom_count_increased\n"
        sys_log_info((&m2) as u64, 26);
        failures = failures + 1;
        
        let m2_debug: [u8; 11] = [32,32,99,111,117,110,116,61,32,32,32];
        sys_log_info((&m2_debug) as u64, 11);
        sys_print_float(final_count as f64);
        sys_log_info((&nl) as u64, 1);
    }
    
    // === TEST 3: Execute JS that queries document.documentElement ===
    let initial_count_2 = ext_get_dom_node_count();
    
    // "document.documentElement.addEventListener('click', function(){}); document.createElement('span');"
    let script2: [u8; 97] = [100, 111, 99, 117, 109, 101, 110, 116, 46, 100, 111, 99, 117, 109, 101, 110, 116, 69, 108, 101, 109, 101, 110, 116, 46, 97, 100, 100, 69, 118, 101, 110, 116, 76, 105, 115, 116, 101, 110, 101, 114, 40, 39, 99, 108, 105, 99, 107, 39, 44, 32, 102, 117, 110, 99, 116, 105, 111, 110, 40, 41, 123, 125, 41, 59, 32, 100, 111, 99, 117, 109, 101, 110, 116, 46, 99, 114, 101, 97, 116, 101, 69, 108, 101, 109, 101, 110, 116, 40, 39, 115, 112, 97, 110, 39, 41, 59];
    let filename2: [u8; 8] = [116, 101, 115, 116, 50, 46, 106, 115]; // "test2.js"
    
    sys_jsc_evaluate_script((&script2) as u64, 97, (&filename2) as u64);
    sys_jsc_flush_microtasks();

    let final_count_2 = ext_get_dom_node_count();
    
    if final_count_2 > initial_count_2 {
        let m3: [u8; 26] = [80,65,83,83,58,32,100,111,99,117,109,101,110,116,69,108,101,109,101,110,116,95,111,107,10,0];
        sys_log_info((&m3) as u64, 25);
    } else {
        let m3: [u8; 26] = [70,65,73,76,58,32,100,111,99,117,109,101,110,116,69,108,101,109,101,110,116,95,111,107,10,0];
        sys_log_info((&m3) as u64, 25);
        failures = failures + 1;
    }

    // === SUMMARY ===
    if failures == 0 {
        let ok: [u8; 26] = [10,61,61,61,32,65,76,76,32,84,69,83,84,83,32,80,65,83,83,69,68,32,61,61,61,10];
        sys_log_info((&ok) as u64, 26);
    } else {
        let nok: [u8; 16] = [10,61,61,61,32,70,65,73,76,69,68,32,61,61,61,10];
        sys_log_info((&nok) as u64, 16);
    }

    return failures;
}
