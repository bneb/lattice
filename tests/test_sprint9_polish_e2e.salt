package tests.test_sprint9_polish_e2e

import user.browser.dom

extern fn paint_inject_dom_pointers();
extern fn ext_paint_begin_frame();
extern fn ext_paint_tree();
extern fn ext_paint_get_cmd_count() -> u32;

extern fn test_sys_on_mouse_move(x: i32, y: i32);
extern fn test_get_hovered_node() -> u32;
extern fn test_set_focused_node(node: u32);
extern fn sys_print_float(f: f64);
extern fn hit_test_inject_paint_pointers();

@no_mangle
pub fn main() -> i32 {
    dom.sanitize_node_slot(0);
    dom.sanitize_node_slot(1);
    dom.sanitize_node_slot(2);
    dom.DOM_NODE_COUNT = 3;

    // Node 1: Root <HTML>
    dom.DOM_NODE_TAG[1] = 1;
    dom.STYLE_DISPLAY[1] = 1;
    dom.STYLE_POINTER_EVENTS[1] = 1;
    dom.LAYOUT_X[1] = 0;
    dom.LAYOUT_Y[1] = 0;
    dom.LAYOUT_W[1] = 1920;
    dom.LAYOUT_H[1] = 1080;
    dom.DOM_NODE_PARENT[1] = 999999;
    dom.STYLE_PARENT[1] = 999999;
    dom.DOM_NODE_FIRST_CHILD[1] = 2;
    dom.DOM_NODE_NEXT_SIBLING[1] = 0;

    // Node 2: Button
    dom.DOM_NODE_TAG[2] = 20; // TAG_BUTTON
    dom.STYLE_DISPLAY[2] = 1;
    dom.STYLE_POINTER_EVENTS[2] = 1;
    dom.LAYOUT_X[2] = 100;
    dom.LAYOUT_Y[2] = 100;
    dom.LAYOUT_W[2] = 200;
    dom.LAYOUT_H[2] = 50;
    dom.DOM_NODE_PARENT[2] = 1;
    dom.STYLE_PARENT[2] = 1;
    dom.DOM_NODE_FIRST_CHILD[2] = 0;
    dom.DOM_NODE_NEXT_SIBLING[2] = 0;
    
    // Set colors for the button
    dom.STYLE_BG_R[2] = 200;
    dom.STYLE_BG_A[2] = 255;
    
    // Set border top
    dom.STYLE_BORDER_WIDTH_TOP[2] = 5; 
    dom.STYLE_BORDER_COLOR_R[2] = 255;

    dom.DIRTY_PAINT[1] = 1;
    dom.DIRTY_PAINT[2] = 1;

    paint_inject_dom_pointers();
    hit_test_inject_paint_pointers();

    // Pass 1: Render everything
    ext_paint_begin_frame();
    ext_paint_tree();
    let count1 = ext_paint_get_cmd_count();
    
    // Pass 2: Clean frame
    dom.DIRTY_PAINT[1] = 0;
    dom.DIRTY_PAINT[2] = 0;
    ext_paint_begin_frame();
    ext_paint_tree();
    let count2 = ext_paint_get_cmd_count(); // Should be 0 since dirty_paint is 0

    // Re-dirty for hit-test simulation
    dom.DIRTY_PAINT[1] = 1;
    dom.DIRTY_PAINT[2] = 1;
    ext_paint_begin_frame();
    ext_paint_tree();

    // Hover simulation
    test_sys_on_mouse_move(150, 125); // Inside button node (x:100, y:100, w:200, h:50)

    let hovered = test_get_hovered_node();
    if hovered != 2 {
        sys_print_float(hovered as f64);
        return 1; // FAILED: Hover node not correctly resolved
    }

    // Now DIRTY_PAINT[2] should be 1 because it's hovered
    ext_paint_begin_frame();
    ext_paint_tree();
    let count3 = ext_paint_get_cmd_count(); // Should emit button rect correctly
    
    if count1 == 0 { return 2; }
    if count2 != 0 { return 3; } // Did not skip paint
    if count3 == 0 { return 4; } // Did not paint hovered node

    test_set_focused_node(2);
    dom.DIRTY_PAINT[2] = 1;
    ext_paint_begin_frame();
    ext_paint_tree();
    let count4 = ext_paint_get_cmd_count();
    // Focus ring should generate additional rects

    return 0; // PASSED
}
