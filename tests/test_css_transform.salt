package tests.test_css_transform

import user.os.ipc_ring

extern fn init_arrays();
extern fn create_node(tag: i32) -> u64;
extern fn js_set_id(node_id: u64, id_ptr: u64, id_len: u32);
extern fn airlock_init_allocator();
extern fn js_quickjs_init() -> i32;
extern fn js_quickjs_eval_string(ptr: u64, len: u32) -> i32;
extern fn js_execute_pending_jobs() -> i32;
extern fn dom_get_transform_x(idx: u32) -> f32;
extern fn dom_get_transform_y(idx: u32) -> f32;
extern fn dom_get_opacity(idx: u32) -> f32;
extern fn dom_get_node_count() -> u64;

pub fn main() -> i32 {
    println("--- Epic 29: GPU Compositing Matrix — CSS Transform Test ---");
    
    airlock_init_allocator();
    init_arrays();
    ipc_ring.init_shared_ring();
    js_quickjs_init();
    
    let root_id = create_node(3); // BODY
    
    // Create the target node manually
    let target_id = create_node(4); // DIV
    let mut id_str: [u8; 6] = [116, 97, 114, 103, 101, 116]; // "target"
    js_set_id(target_id, (&id_str) as u64, 6);
    
    let mut script: [u8; 104] = [108,101,116,32,116,32,61,32,100,111,99,117,109,101,110,116,46,103,101,116,69,108,101,109,101,110,116,66,121,73,100,40,34,116,97,114,103,101,116,34,41,59,32,116,46,115,116,121,108,101,46,116,114,97,110,115,102,111,114,109,61,34,116,114,97,110,115,108,97,116,101,88,40,49,53,48,112,120,41,34,59,32,116,46,115,116,121,108,101,46,111,112,97,99,105,116,121,61,34,48,46,53,34,59];
    js_quickjs_eval_string((&script) as u64, 104);
    
    js_execute_pending_jobs();
    
    let node_idx = (target_id & 0xFFFF) as u32;
    let tx = dom_get_transform_x(node_idx);
    let op = dom_get_opacity(node_idx);
    
    let mut ok = 1;
    if tx > 149.0 && tx < 151.0 {
        println("[OK] STYLE_TRANSFORM_X = 150.0 confirmed");
    } else {
        println("[FAIL] STYLE_TRANSFORM_X was never set through JS to 150.0");
        ok = 0;
    }
    
    if op > 0.49 && op < 0.51 {
        println("[OK] STYLE_OPACITY = 0.5 confirmed");
    } else {
        println("[FAIL] STYLE_OPACITY was never set through JS to 0.5");
        ok = 0;
    }
    
    if ok == 1 {
        println("[Test] SUCCESS: GPU Compositing Matrix — transform and opacity bypass layout!");
        return 0;
    }
    return 1;
}
