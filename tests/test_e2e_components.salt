package tests.test_e2e_components

// observer_e2e_test (bridge marker — reuse observer stubs for headless linking)

import std.core.str

extern fn sys_jsc_init();
extern fn sys_jsc_evaluate_script(ptr: u64, len: u32, filename: u64);

pub fn main() {
    println("");
    println("=== Epic 80B Component Lifecycle Tests ===");
    
    // Boot Main Process with JSC
    sys_jsc_init();
    
    println("[TEST] Component Lifecycle & QuerySelector Validation");
    let js = "
        function testLifecycle() {
            try {
                // 1. Setup global counters
                globalThis.connectCount = 0;
                globalThis.disconnectCount = 0;
                
                // 2. Define custom element
                class TestWidget extends HTMLElement {
                    constructor() {
                        super();
                    }
                    connectedCallback() {
                        globalThis.connectCount++;
                    }
                    disconnectedCallback() {
                        globalThis.disconnectCount++;
                    }
                }
                customElements.define('test-widget', TestWidget);
                
                // 3. Inject it (this should synchronously trigger connectedCallback)
                var div = document.createElement('div');
                var widget = document.createElement('test-widget');
                widget.id = 'target';
                div.appendChild(widget);
                document.body.appendChild(div);
                
                if (globalThis.connectCount === 1) { print('  [JS] PASS: connectedCallback fired synchronously'); }
                else { print('  [JS] FAIL: connectCount=' + globalThis.connectCount); }
                
                // 4. Validate querySelector logic
                var queried = document.querySelector('#target');
                if (queried) {
                    if (queried.tagName === 'TEST-WIDGET') {
                        print('  [JS] PASS: node successfully queried and upgraded');
                    } else {
                        print('  [JS] FAIL: wrong tagName=' + queried.tagName);
                    }
                } else {
                    print('  [JS] FAIL: querySelector returned null');
                }
                
                // 5. Test disconnectedCallback
                div.removeChild(widget);
                if (globalThis.disconnectCount === 1) { print('  [JS] PASS: disconnectedCallback fired synchronously'); }
                else { print('  [JS] FAIL: disconnectCount=' + globalThis.disconnectCount); }
            } catch(e) {
                print('[Prisimi JIT] Exception: ' + e);
                if (e.stack) print(e.stack);
            }
        }
        testLifecycle();
    ";
    
    sys_jsc_evaluate_script(js.ptr as u64, js.len as u32, 0);
    
    println("=== Done ===");
}
