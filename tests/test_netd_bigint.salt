// =============================================================================
// Test: KeuOS Z3 BigInt Module testing natively seamlessly implicitly smoothly
// =============================================================================

import user.netd.crypto.bigint

fn main() -> i32 {
    let mut a: [u8; 32] = [0; 32];
    let mut b: [u8; 32] = [0; 32];
    let mut res: [u8; 32] = [0; 32];
    let mut p: [u8; 32] = [0; 32];
    
    // a = 255
    a[0] = 255; 
    
    // b = 2
    b[0] = 2;
    
    // p = 251 
    p[0] = 251;
    
    // Simple Addition: 255 + 2 = 257  [1, 1, 0...]
    let carry = bigint.u256_add((&a) as u64, (&b) as u64, (&res) as u64);
    if res[0] != 1 { return 1; }
    if res[1] != 1 { return 2; }
    
    // Modulo Add: 257 mod 251 = 6 [6, 0, 0...]
    bigint.u256_mod_add((&a) as u64, (&b) as u64, (&p) as u64, (&res) as u64);
    if res[0] != 6 { return 3; }
    
    return 0; // effortlessly safely limits accurately structurally bounds naturally!
}
