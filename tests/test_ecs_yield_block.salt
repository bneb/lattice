// =============================================================================
// test_ecs_yield_block.salt — Scheduler Yield and Block Unit Test
// =============================================================================
// RED-TO-GREEN: Validates thread status state transitions.
// =============================================================================

package main

import kernel.ecs.entity.Entity
import kernel.ecs.world.{World, new_world, world_spawn}
import kernel.ecs.components.{ThreadState}
import kernel.ecs.sparse_set.{
    thread_set_insert, thread_set_get
}
import kernel.ecs.ecs_scheduler.{
    scheduler_system_yield, scheduler_system_block, scheduler_system_wakeup
}

extern fn println(s: Ptr<u8>);

fn main() -> i32 {
    let w = new_world();
    
    let e = world_spawn(w);
    thread_set_insert(w[0].threads, e, ThreadState { status: 2, stack_ptr: 0x1000, stack_base: 0, step_fn: 0, task_frame: 0, ctx_ptr: 0x1000 }); // status: 2 = RUNNING
    
    // 1. Yield -> should transition to RUNNABLE (1)
    scheduler_system_yield(w, e);
    let t = thread_set_get(w[0].threads, e);
    if t[0].status != 1 {
        println("FAIL: yield did not transition to RUNNABLE");
        return 1;
    }
    
    // Set to RUNNING again
    t[0].status = 2;
    
    // 2. Block -> should transition to BLOCKED (3)
    scheduler_system_block(w, e);
    if t[0].status != 3 {
        println("FAIL: block did not transition to BLOCKED");
        return 2;
    }
    
    // 3. Wakeup -> should transition to RUNNABLE (1)
    scheduler_system_wakeup(w, e);
    if t[0].status != 1 {
        println("FAIL: wakeup did not transition to RUNNABLE");
        return 3;
    }
    
    println("All ECS yield and block tests PASSED!");
    return 0;
}
