package tests.test_caret_paint

import user.browser.dom
import user.browser.paint
import user.browser.alloc.airlock

pub fn main() -> i32 {
    airlock.airlock_init_allocator();
    dom.init_arrays();
    paint.salt_paint_inject_dom_pointers();
    
    // Create a text node with 2 chars
    let text_node = dom.create_text_node(0, 0); 
    let idx = dom.resolve_node(text_node);
    
    // Use a local buffer as the text arena
    let mut text_buf: [u8; 16] = [0; 16];
    text_buf[0] = 72;  // H
    text_buf[1] = 105; // i
    
    let arena_base = (&text_buf) as u64;
    dom.DOM_TEXT_PTR[idx as usize] = arena_base;
    dom.DOM_TEXT_LEN[idx as usize] = 2;
    dom.DOM_SELECTION_START[idx as usize] = 2;
    dom.DOM_SELECTION_END[idx as usize] = 2;
    
    dom.LAYOUT_X[idx as usize] = 100;
    dom.LAYOUT_Y[idx as usize] = 100;
    dom.LAYOUT_W[idx as usize] = 20; 
    dom.LAYOUT_H[idx as usize] = 20;
    
    // Pass frame_count=30 to test blink ON, scroll_y=0, viewport=1080
    let display_elements = paint.generate_display_list(idx as u32, text_node, 30, 0, 1080);
    
    // Expected: 1 base rect + 2 glyphs + 1 caret = 4
    if display_elements != 4 {
        println(f"FAIL: Caret paint count mismatch. Expected 4, got {display_elements}.");
        return 1;
    }
    
    println("PASS: Caret Render Geometry verified.");
    return 0;
}
