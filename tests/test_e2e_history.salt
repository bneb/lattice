package tests.test_e2e_history

// Imports removed to allow extern fns to emit correctly

extern fn js_execute_pending_jobs() -> i32;

extern fn sys_js_evaluate_script(code_ptr: u64, code_len: u32, filename_ptr: u64, filename_len: u32);
extern fn set_max_test_frames(frames: u64);
extern fn airlock_init_allocator();
extern fn init_arrays();
extern fn js_quickjs_init() -> i32;
extern fn create_node(tag: i32) -> u64;
extern fn sys_browser_navigate(url_ptr: u64, url_len: u32);
extern fn sys_ipc_push_command(cmd: u32, arg1: u64, arg2: u32);
extern fn run_loop();

pub global OMNIBOX_URL_PTR: u64 = 0;
pub global OMNIBOX_URL_LEN: u32 = 0;

@no_mangle
pub fn ext_mac_update_omnibox(ptr: u64, len: u32) {
    OMNIBOX_URL_PTR = ptr;
    OMNIBOX_URL_LEN = len;
}

@no_mangle
pub fn main() -> i32 {
    // 1. Boot the Sovereign Engine
    set_max_test_frames(1);
    
    airlock_init_allocator();
    init_arrays();
    js_quickjs_init();
    
    // Boot sequence
    let root = create_node(0); // TAG_ROOT
    let mut nav_bit: u64 = 1;
    nav_bit = nav_bit << 62;
    let multiplexed_id = nav_bit | root;
    
    // Initial fetch, hard navigate
    let url_str: [u8; 11] = [47, 105, 110, 100, 101, 120, 46, 104, 116, 109, 108]; // /index.html
    sys_browser_navigate((&url_str) as u64, 11);
    
    // Wait jobs
    let mut jobs: i32 = 1;
    while jobs > 0 { jobs = js_execute_pending_jobs(); }
    
    // 2. Execute JS: window.history.pushState({view: 'settings'}, "", "/settings");
    let script: [u8; 183] = [119, 105, 110, 100, 111, 119, 46, 104, 105, 115, 116, 111, 114, 121, 46, 112, 117, 115, 104, 83, 116, 97, 116, 101, 40, 123, 118, 105, 101, 119, 58, 32, 39, 115, 101, 116, 116, 105, 110, 103, 115, 39, 125, 44, 32, 34, 34, 44, 32, 34, 47, 115, 101, 116, 116, 105, 110, 103, 115, 34, 41, 59, 10, 119, 105, 110, 100, 111, 119, 46, 97, 100, 100, 69, 118, 101, 110, 116, 76, 105, 115, 116, 101, 110, 101, 114, 40, 39, 112, 111, 112, 115, 116, 97, 116, 101, 39, 44, 32, 40, 101, 41, 32, 61, 62, 32, 123, 10, 32, 32, 32, 32, 105, 102, 32, 40, 101, 46, 115, 116, 97, 116, 101, 32, 38, 38, 32, 101, 46, 115, 116, 97, 116, 101, 46, 118, 105, 101, 119, 32, 61, 61, 61, 32, 39, 115, 101, 116, 116, 105, 110, 103, 115, 39, 41, 32, 119, 105, 110, 100, 111, 119, 46, 95, 115, 117, 99, 99, 101, 115, 115, 32, 61, 32, 116, 114, 117, 101, 59, 10, 125, 41, 59];
    // Script is: window.history.pushState({view: 'settings'}, "", "/settings");\nwindow.addEventListener('popstate', (e) => {\n    if (e.state && e.state.view === 'settings') window._success = true;\n});
    let fname: [u8; 4] = [116, 101, 115, 116];
    sys_js_evaluate_script((&script) as u64, 183, (&fname) as u64, 4);
    
    jobs = 1;
    while jobs > 0 { jobs = js_execute_pending_jobs(); }
    
    // 3. Assert via telemetry that ext_mac_update_omnibox was invoked with "/settings"
    if OMNIBOX_URL_LEN != 9 {
        return 1;
    }
    let b1 = *((OMNIBOX_URL_PTR + 1) as &u8); // 's'
    let b2 = *((OMNIBOX_URL_PTR + 2) as &u8); // 'e'
    if b1 != 115 || b2 != 101 { return 1; }
    
    let script2: [u8; 56] = [119, 105, 110, 100, 111, 119, 46, 104, 105, 115, 116, 111, 114, 121, 46, 112, 117, 115, 104, 83, 116, 97, 116, 101, 40, 123, 118, 105, 101, 119, 58, 32, 39, 97, 98, 111, 117, 116, 39, 125, 44, 32, 34, 34, 44, 32, 34, 47, 97, 98, 111, 117, 116, 34, 41, 59];
    sys_js_evaluate_script((&script2) as u64, 56, (&fname) as u64, 4);
    
    sys_ipc_push_command(2, 0, 0); // GO_BACK
    
    // 5. Step W3C Run-loop
    run_loop();
    
    // Check if _success is true
    let script3: [u8; 15] = [
        119, 105, 110, 100, 111, 119, 46, 95, 115, 117, 99, 99, 101, 115, 115
    ]; // window._success
    
    // We can't directly read the JS global easily, but we can do a side-effect.
    // Let's use ext_mac_update_omnibox as our telemetry side-effect!
    let script4: [u8; 69] = [105, 102, 40, 119, 105, 110, 100, 111, 119, 46, 95, 115, 117, 99, 99, 101, 115, 115, 41, 32, 123, 119, 105, 110, 100, 111, 119, 46, 104, 105, 115, 116, 111, 114, 121, 46, 112, 117, 115, 104, 83, 116, 97, 116, 101, 40, 123, 125, 44, 32, 34, 34, 44, 32, 34, 47, 118, 97, 108, 105, 100, 97, 116, 101, 100, 34, 41, 59, 125]; 
    // if(window._success) {window.history.pushState({}, "", "/validated");}
    sys_js_evaluate_script((&script4) as u64, 69, (&fname) as u64, 4);
    
    jobs = 1;
    while jobs > 0 { jobs = js_execute_pending_jobs(); }
    
    if OMNIBOX_URL_LEN != 10 {
        return 1;
    }
    let v1 = *((OMNIBOX_URL_PTR + 1) as &u8); // 'v'
    if v1 != 118 { return 1; }
    
    println("[Test] SUCCESS: Sovereign History Integration Validated!");
    
    return 0;
}
