    let mut valid_buf: [u8; 6] = [0; 6];
    valid_buf[0] = 0x00;
    valid_buf[1] = 0x61;
    valid_buf[2] = 0x73;
    valid_buf[3] = 0x6D;
    valid_buf[4] = 0x02; // OP_BLOCK
    valid_buf[5] = 0x0B; // OP_END
    
    let sip_a = airlock.ingest_payload_to_airlock(0xAAAA, (&valid_buf) as u64, 6);
    if sip_a < 0 { return 1; }
    
    let val_a = validator.validate_sip(sip_a as u32);
