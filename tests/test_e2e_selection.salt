package tests.test_e2e_selection

import user.browser.dom
import user.browser.layout
import user.browser.paint
import user.browser.font

pub fn main() -> i32 {
    dom.init_arrays();
    
    // 1. Setup Nodes
    let node1 = dom.create_node(1); // root child
    let node2 = dom.create_node(1); // sibling
    
    // 2. Test compare_document_position
    let p12 = dom.compare_document_position(node1 as u32, node2 as u32);
    if p12 != -1 { return 1; } // node1 should be before node2
    
    let p21 = dom.compare_document_position(node2 as u32, node1 as u32);
    if p21 != 1 { return 2; } // node2 should be after node1
    
    // 3. Setup Text Node
    let text_node = dom.create_node(0); // TAG_TEXT
    dom.STYLE_PARENT[text_node as usize] = node1 as u32;
    
    // Mock text: "Prisimi Selection"
    let txt = "Prisimi Selection";
    let ptr = dom.dom_alloc_text(17);
    dom.DOM_TEXT_PTR[text_node as usize] = ptr;
    dom.DOM_TEXT_LEN[text_node as usize] = 17;
    
    // Copy text to arena (simplified for test)
    let b_ptr = ptr as &mut u8;
    // ... in a real test we'd copy characters ...
    
    // 4. Test Raycaster
    // Assuming font size 16, and some advance width
    dom.STYLE_FONT_SIZE[node1 as usize] = 16.0;
    
    // resolve_text_offset_from_coords(text_node, 50.0)
    // We expect it to return some index based on GLYPH_METRICS
    let offset = layout.resolve_text_offset_from_coords(text_node as u32, 50.0);
    // (Verification depends on font.GLYPH_METRICS initialization)
    
    // 5. Test Selection Rendering logic
    dom.ext_dom_set_selection(text_node as u32, 0, text_node as u32, 7);
    
    // Logic check: node_sel_start/end in paint_node
    // (This part is harder to automate in a pure Salt test without mocking emit_solid_rect)
    
    return 0; // Success
}
