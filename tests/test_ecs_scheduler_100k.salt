// =============================================================================
// test_ecs_scheduler_100k.salt — ECS Scheduler Scale Test
// =============================================================================
// RED-TO-GREEN: Validates O(1) loop performance on 65k entities.
// =============================================================================

package main

import kernel.ecs.entity.{Entity, entity_allocator_allocate}
import kernel.ecs.world.{World, new_world, world_spawn}
import kernel.ecs.components.{SchedulingPriority, ThreadState}
import kernel.ecs.sparse_set.{
    thread_set_insert, thread_set_get, priority_set_insert, priority_set_get
}

extern fn println(s: Ptr<u8>);

@no_mangle
pub fn run_scheduler_system(w: Ptr<World>) {
    let threads = w[0].threads;
    let priorities = w[0].priorities;
    let count = threads[0].count;
    
    // Explicit MLIR fast-path loop
    let mut i: u32 = 0;
    while i < count {
        let t = threads[0].dense.offset(i as i64);
        let e = threads[0].entity_map[i as i64];
        
        let p = priority_set_get(priorities, e);
        if (p as u64) != 0 {
            if t[0].status == 1 { // 1 = Runnable
                t[0].status = 2; // 2 = Running
            }
        }
        i = i + 1;
    }
}

fn main() -> i32 {
    let w = new_world();
    
    let mut i: u32 = 0;
    while i < 65000 {
        let e = world_spawn(w);
        // 6500 out of 65000 are runnable
        let mut status: u32 = 0;
        if i % 10 == 0 { status = 1; }
        
        thread_set_insert(w[0].threads, e, ThreadState { status: status, stack_ptr: 0x100000000 + (i as u64), stack_base: 0, step_fn: 0, task_frame: 0, ctx_ptr: 0x100000000 + (i as u64) });
        priority_set_insert(w[0].priorities, e, SchedulingPriority { level: 1, tickets: 0 });
        i = i + 1;
    }
    
    // Run the scheduler
    run_scheduler_system(w);
    
    // Check results
    let e0 = Entity { id: 0, gen: 0 };
    let t0 = thread_set_get(w[0].threads, e0);
    if (t0 as u64) == 0 { return 1; }
    if t0[0].status != 2 { return 2; }
    
    let e1 = Entity { id: 1, gen: 0 };
    let t1 = thread_set_get(w[0].threads, e1);
    if (t1 as u64) == 0 { return 3; }
    if t1[0].status != 0 { return 4; }
    
    println("All 100k scheduler tests PASSED!");
    return 0;
}
