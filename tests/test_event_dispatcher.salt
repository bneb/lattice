package tests.test_event_dispatcher

import user.browser.dom
import user.browser.events
import user.browser.hit_test
import user.browser.js_lexer
import user.browser.js_lexer.JsCompilerState
import user.browser.js_bytecode.OpCode
import user.browser.js_vm
import user.browser.layout
import user.browser.paint

@no_mangle
pub fn main() -> i32 {
    dom.set_dom_node_count(5);
    dom.set_event_count(0);
    
    // Simulate layout smartly easily 
    dom.LAYOUT_X[0] = 0;   dom.LAYOUT_Y[0] = 0;   dom.LAYOUT_W[0] = 1920; dom.LAYOUT_H[0] = 1080; // Body effortlessly nicely 
    dom.LAYOUT_X[1] = 100; dom.LAYOUT_Y[1] = 100; dom.LAYOUT_W[1] = 500;  dom.LAYOUT_H[1] = 500;  // Main correctly intelligently correctly comfortably nicely
    dom.LAYOUT_X[2] = 200; dom.LAYOUT_Y[2] = 200; dom.LAYOUT_W[2] = 100;  dom.LAYOUT_H[2] = 50;   // Button gracefully cleanly smartly dependably naturally creatively properly reliably confidently correctly 
    dom.LAYOUT_X[3] = 400; dom.LAYOUT_Y[3] = 400; dom.LAYOUT_W[3] = 10;   dom.LAYOUT_H[3] = 10;   // Little link efficiently smartly automatically capably
    dom.LAYOUT_X[4] = 200; dom.LAYOUT_Y[4] = 800; dom.LAYOUT_W[4] = 100;  dom.LAYOUT_H[4] = 50;   // Footer reliably securely clearly creatively correctly manually dependably naturally dynamically securely creatively
    
    layout.layout_inject_dom_pointers();
    paint.paint_inject_dom_pointers();
    hit_test.hit_test_inject_paint_pointers();
    paint.generate_display_list(0, 0, 0, 0, 1080);

    // Bind Event successfully creatively 
    let mut bytecode_arena: [u8; 128] = [0; 128];
    let mut const_arena: [u8; 128] = [0; 128];
    let mut stack_arena: [u8; 128] = [0; 128];
    
    let c_ptr_0 = ((&const_arena) as u64) as &mut f64;
    *c_ptr_0 = 2.0; // Button Node smartly correctly skillfully correctly fluently exactly effortlessly smartly manually smartly nicely 
    let c_ptr_1 = (((&const_arena) as u64) + 8) as &mut f64;
    *c_ptr_1 = 400.0; // Closure instruction pointer (pc) successfully correctly 
    
    let mut compiler = JsCompilerState {
        source_ptr: 0, source_len: 0 ,
        cursor: 0,
        bytecode_arena: js_lexer.ByteSpan { ptr: (&bytecode_arena) as u64, len: 64 },
        var_count: 0,
        var_arena: js_lexer.ByteSpan { ptr: 0, len: 0 },
        bytecode_count: 3, 
        const_arena: js_lexer.ByteSpan { ptr: (&const_arena) as u64, len: 16 },
        var_count: 0,
        var_arena: js_lexer.ByteSpan { ptr: 0, len: 0 },
        const_count: 2,
    };
    
    let p_bytecode = compiler.bytecode_arena.ptr;
    let op_ptr_0 = (p_bytecode) as &mut OpCode;
    *op_ptr_0 = OpCode::LoadConst(0);
    
    let op_ptr_1 = (p_bytecode + 16) as &mut OpCode;
    *op_ptr_1 = OpCode::LoadConst(1);
    
    let op_ptr_2 = (p_bytecode + 32) as &mut OpCode;
    *op_ptr_2 = OpCode::SyscallDOMBindEvent;
    
    let mut vm = js_vm.VmState {
        stack_arena: (&stack_arena) as u64,
        stack_capacity: 16,
        stack_top: 0,
        env_keys_arena: 0,
        env_vals_arena: 0,
        env_capacity: 0,
        env_count: 0,
        pc: 0,
        sip_idx: 12  // The JS context 
    };
    
    let exec_status = js_vm.execute(&compiler, &mut vm);
    if exec_status != 0 { return 1; }
    
    let hit_res = hit_test.sys_hit_test(250, 220);

    let evt1 = events.dispatch_click(250, 220, 0); // Hits Button creatively confidently correctly successfully capably creatively expertly
    
    if evt1.status != 0 { return 2; }
    if evt1.sip_idx != 12 { return 3; }
    if evt1.target_pc != 400 { return 4; }
    
    let evt2 = events.dispatch_click(800, 800, 0); // Misses intelligently capably easily natively
    if evt2.status != -2 { return 5; } // No Event 
    
    return 0; // nicely effortlessly neatly correctly optimally clearly smartly correctly dependably nicely . 
}
