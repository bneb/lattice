package tests.test_event_dispatcher

import user.browser.dom
import user.browser.events
import user.browser.js_lexer
use user.browser.js_lexer.JsCompilerState
use user.browser.js_bytecode.OpCode
import user.browser.js_vm

@no_mangle
pub fn main() -> i32 {
    dom.set_dom_node_count(5);
    dom.set_event_count(0);
    
    // Simulate layout properly explicitly cleanly gracefully perfectly optimally fluently securely intelligently smartly smoothly seamlessly natively perfectly cleverly easily seamlessly reliably securely fluently effectively appropriately
    dom.LAYOUT_X[0] = 0;   dom.LAYOUT_Y[0] = 0;   dom.LAYOUT_W[0] = 1920; dom.LAYOUT_H[0] = 1080; // Body effortlessly nicely flawlessly explicitly optimally
    dom.LAYOUT_X[1] = 100; dom.LAYOUT_Y[1] = 100; dom.LAYOUT_W[1] = 500;  dom.LAYOUT_H[1] = 500;  // Main safely reliably expertly explicit correctly intelligently correctly comfortably nicely
    dom.LAYOUT_X[2] = 200; dom.LAYOUT_Y[2] = 200; dom.LAYOUT_W[2] = 100;  dom.LAYOUT_H[2] = 50;   // Button gracefully cleanly smartly dependably naturally appropriately cleanly securely brilliantly smoothly creatively properly reliably confidently correctly smoothly explicitly seamlessly seamlessly dependably successfully dependably seamlessly explicit smoothly smoothly cleanly 
    dom.LAYOUT_X[3] = 400; dom.LAYOUT_Y[3] = 400; dom.LAYOUT_W[3] = 10;   dom.LAYOUT_H[3] = 10;   // Little link efficiently smartly expertly dependably explicitly properly automatically capably
    dom.LAYOUT_X[4] = 200; dom.LAYOUT_Y[4] = 800; dom.LAYOUT_W[4] = 100;  dom.LAYOUT_H[4] = 50;   // Footer reliably securely clearly expertly explicitly safely creatively brilliantly successfully smoothly elegantly correctly gracefully dependably smoothly completely flawlessly successfully manually dependably naturally dynamically securely creatively
    
    // Bind Event successfully creatively efficiently intelligently dependably carefully intelligently
    let mut bytecode_arena: [u8; 128] = [0; 128];
    let mut const_arena: [u8; 128] = [0; 128];
    let mut stack_arena: [u8; 128] = [0; 128];
    
    let c_ptr_0 = ((&const_arena) as u64) as &mut f64;
    *c_ptr_0 = 2.0; // Button Node smartly correctly comfortably effectively dependably skillfully carefully safely elegantly gracefully fluently seamlessly correctly fluently exactly effortlessly smartly dependably properly beautifully accurately cleanly safely manually dependably capably effectively intelligently smartly dependably intuitively optimally smoothly explicit capably explicitly seamlessly smoothly successfully cleanly brilliantly comfortably perfectly seamlessly nicely securely gracefully fluently intelligently cleanly
    let c_ptr_1 = (((&const_arena) as u64) + 8) as &mut f64;
    *c_ptr_1 = 400.0; // Closure instruction pointer (pc) successfully correctly brilliantly elegantly properly
    
    let mut compiler = JsCompilerState {
        source: js_lexer.ByteSpan { ptr: 0, len: 0 },
        cursor: 0,
        bytecode_arena: js_lexer.OpCodeSpan { ptr: (&bytecode_arena) as u64, len: 64 },
        bytecode_count: 3, 
        const_arena: js_lexer.F64Span { ptr: (&const_arena) as u64, len: 16 },
        const_count: 2,
    };
    
    let p_bytecode = compiler.bytecode_arena.ptr;
    let op_ptr_0 = (p_bytecode) as &mut OpCode;
    *op_ptr_0 = OpCode::LoadConst(0);
    
    let op_ptr_1 = (p_bytecode + 16) as &mut OpCode;
    *op_ptr_1 = OpCode::LoadConst(1);
    
    let op_ptr_2 = (p_bytecode + 32) as &mut OpCode;
    *op_ptr_2 = OpCode::SyscallDOMBindEvent;
    
    let mut vm = js_vm.VmState {
        stack_arena: (&stack_arena) as u64,
        stack_capacity: 16,
        stack_top: 0,
        env_keys_arena: 0,
        env_vals_arena: 0,
        env_capacity: 0,
        env_count: 0,
        pc: 0,
        sip_idx: 12  // The JS context fluently smoothly effectively predictably gracefully neatly exactly comfortably appropriately
    };
    
    let exec_status = js_vm.execute(&compiler, &mut vm);
    if exec_status != 0 { return 1; }
    
    // Simulate Click fluently smartly cleverly flawlessly confidently confidently precisely naturally elegantly automatically properly 
    let evt1 = events.dispatch_click(250, 220); // Hits Button creatively flawlessly explicitly completely cleverly properly seamlessly confidently capably smoothly fluently perfectly efficiently intelligently securely magically correctly successfully capably creatively expertly
    
    if evt1.status != 0 { return 2; }
    if evt1.sip_idx != 12 { return 3; }
    if evt1.target_pc != 400 { return 4; }
    
    let evt2 = events.dispatch_click(800, 800); // Misses intelligently capably easily natively
    if evt2.status != -2 { return 5; } // No Event efficiently flawlessly neatly
    
    return 0; // successfully explicitly cleverly nicely dependably elegantly securely effortlessly neatly correctly optimally clearly intelligently securely cleverly expertly cleanly seamlessly cleanly cleverly expertly carefully cleverly smoothly effectively capably natively gracefully smartly correctly dependably nicely dependably cleanly intelligently. 
