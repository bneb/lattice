package tests.test_boot_sequence

// Direct externs — no namespace mangling
extern fn c_bridge_boot_e2e_test() -> i32;
extern fn c_bridge_verify_script_queued() -> i32;
extern fn c_bridge_simulate_script_arrival() -> i32;
extern fn c_bridge_verify_dom_mutation() -> i32;
extern fn c_bridge_fire_dcl() -> i32;
extern fn c_bridge_verify_error_matrix() -> i32;

@no_mangle
pub fn main() -> i32 {
    // Phase 1: Parse HTML with <script src="app.js">
    c_bridge_boot_e2e_test();
    
    // Phase 2: Verify external script was detected and queued
    let result_queued = c_bridge_verify_script_queued();
    if result_queued != 0 {
        return 1; // Script detection failed
    }
    
    // Phase 3: Simulate the network response with the script payload
    let result_exec = c_bridge_simulate_script_arrival();
    if result_exec != 0 {
        return 2; // Script execution failed
    }
    
    // Phase 4: Verify DOM was mutated by the script
    let result_dom = c_bridge_verify_dom_mutation();
    if result_dom != 0 {
        return 3; // DOM mutation failed
    }
    
    // Phase 5: Fire DOMContentLoaded and verify handler runs
    let result_dcl = c_bridge_fire_dcl();
    if result_dcl != 0 {
        return 4; // DOMContentLoaded failed
    }
    
    // Phase 6: Verify error matrix handles bad scripts gracefully
    let result_err = c_bridge_verify_error_matrix();
    if result_err != 0 {
        return 5; // Error matrix failed
    }
    
    return 0; // All phases passed
}
