package tests.test_css_lexer

import user.os.ipc_ring

extern fn init_arrays();
extern fn create_node(tag: i32) -> u64;
extern fn airlock_init_allocator();
extern fn js_quickjs_init() -> i32;
extern fn css_lex_stylesheet(ptr: u64, len: u32);
extern fn css_fnv1a(ptr: u64, len: u32) -> u32;
extern fn css_get_rule_hash(slot: u32) -> u32;
extern fn css_get_rule_display(slot: u32) -> u8;
extern fn css_get_rule_flex_grow(slot: u32) -> i32;
extern fn css_get_rule_specificity(slot: u32) -> u16;
extern fn css_find_slot(hash: u32) -> u32;

pub fn main() -> i32 {
    println("--- Epic 32: CSSOM Matrix Lexer Test ---");

    airlock_init_allocator();
    init_arrays();
    ipc_ring.init_shared_ring();
    js_quickjs_init();

    // ============================================================
    // Phase 1: Parse a CSS rule and verify the hash table
    // ============================================================
    println("[Phase 1] Parsing .header CSS rule");
    let mut css: [u8; 40] = [46,104,101,97,100,101,114,32,123,32,100,105,115,112,108,97,121,58,32,102,108,101,120,59,32,102,108,101,120,45,103,114,111,119,58,32,49,59,32,125];
    css_lex_stylesheet((&css) as u64, 40);

    // Hash "header" (the class name without the dot)
    let mut hdr_str: [u8; 6] = [104,101,97,100,101,114];
    let hdr_hash = css_fnv1a((&hdr_str) as u64, 6);

    // Find the slot where this rule was stored
    let slot = css_find_slot(hdr_hash);
    if slot == 0xFFFFFFFF {
        println("[FAIL] Rule not found in hash table");
        return 1;
    }
    println("[OK] Rule found in hash table");

    // Verify specificity (class = 10)
    let spec = css_get_rule_specificity(slot);
    if spec == 10 {
        println("[OK] Specificity = 10 (class selector)");
    } else {
        println("[FAIL] Wrong specificity");
        return 1;
    }

    // Verify display = FLEX (2)
    let disp = css_get_rule_display(slot);
    if disp == 2 {
        println("[OK] RULE_DISPLAY = 2 (FLEX)");
    } else {
        println("[FAIL] RULE_DISPLAY != FLEX");
        return 1;
    }

    // Verify flex-grow = 1
    let fg = css_get_rule_flex_grow(slot);
    if fg == 1 {
        println("[OK] RULE_FLEX_GROW = 1");
    } else {
        println("[FAIL] RULE_FLEX_GROW != 1");
        return 1;
    }

    println("[Test] SUCCESS: CSSOM Matrix Lexer verified!");
    return 0;
}
