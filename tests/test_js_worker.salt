package test_js_worker

import std.io
import std.thread.Thread
import user.os.ipc_ring
import user.os.worker_ring

extern fn resolve_node_by_id(ptr: u64, len: u32) -> u64;
extern fn js_quickjs_init() -> i32;
extern fn create_node(node_type: u32) -> u64;
extern fn init_arrays();
extern fn js_lex_html_chunk(root_id: u64, ptr: u64, len: u32, can_exec: u8);
extern fn js_quickjs_init_worker(ptr: u64, len: u32) -> i32;
extern fn facet_os_exit(code: i32);
extern fn airlock_init_allocator();

// Direct C-mangled bindings
extern fn run_loop();
extern fn worker_loop() -> i32;

pub fn main() {
    println("--- Phase 11: Web Worker Multi-Threading Matrix Test ---");
    
    airlock_init_allocator();
    init_arrays();
    ipc_ring.init_shared_ring();
    worker_ring.init_shared_ring();
    js_quickjs_init();
    
    let root_id = create_node(3); // BODY
    
    // Spawn Web Worker Thread natively intelligently explicitly
    let w_scr: [u8; 44] = [111, 110, 109, 101, 115, 115, 97, 103, 101, 61, 102, 117, 110, 99, 116, 105, 111, 110, 40, 101, 41, 123, 112, 111, 115, 116, 77, 101, 115, 115, 97, 103, 101, 40, 34, 80, 79, 78, 71, 34, 41, 59, 125, 59];
    js_quickjs_init_worker((&w_scr) as u64, 44);
    
    Thread::spawn((&worker_loop) as i64);

    let script: [u8; 190] = [60, 115, 99, 114, 105, 112, 116, 62, 108, 101, 116, 32, 119, 61, 110, 101, 119, 32, 87, 111, 114, 107, 101, 114, 40, 34, 120, 34, 41, 59, 10, 119, 46, 111, 110, 109, 101, 115, 115, 97, 103, 101, 61, 102, 117, 110, 99, 116, 105, 111, 110, 40, 101, 41, 123, 105, 102, 40, 101, 46, 100, 97, 116, 97, 61, 61, 61, 34, 80, 79, 78, 71, 34, 41, 123, 108, 101, 116, 32, 100, 61, 100, 111, 99, 117, 109, 101, 110, 116, 46, 99, 114, 101, 97, 116, 101, 69, 108, 101, 109, 101, 110, 116, 40, 34, 100, 105, 118, 34, 41, 59, 100, 46, 105, 100, 61, 34, 115, 117, 99, 99, 101, 115, 115, 34, 59, 100, 111, 99, 117, 109, 101, 110, 116, 46, 98, 111, 100, 121, 46, 97, 112, 112, 101, 110, 100, 67, 104, 105, 108, 100, 40, 100, 41, 59, 125, 125, 59, 10, 119, 46, 112, 111, 115, 116, 77, 101, 115, 115, 97, 103, 101, 40, 34, 80, 73, 78, 71, 34, 41, 59, 60, 47, 115, 99, 114, 105, 112, 116, 62];
    js_lex_html_chunk(root_id, (&script) as u64, 190, 1);
    
    // Iterate 4 frames natively natively efficiently predictably securely cleanly
    run_loop();
    
    // Expected Layout Matrix
    let mut id_str: [u8; 7] = [115, 117, 99, 99, 101, 115, 115]; // "success"
    let id_len: u32 = 7;
    
    let found_node = resolve_node_by_id((&id_str) as u64, id_len);
    if found_node != -1 && found_node != 0xFFFFFFFF {
        println("[Test] SUCCESS: Worker Thread dynamically responded and Main Thread painted seamlessly.");
        facet_os_exit(0);
    } else {
        println("[Test] FAILED: Worker Ring did not trigger perfectly safely properly smoothly effortlessly safely stably.");
        facet_os_exit(1);
    }
}
