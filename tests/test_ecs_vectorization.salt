package main

import kernel.ecs.entity.Entity
import kernel.ecs.world.{World, new_world, SchedulingPriority}

extern fn println(s: Ptr<u8>);

@no_mangle
pub fn process_priorities(w: &mut World) {
    let priorities = &mut w.priorities;
    let count = priorities.count;
    
    // Explicit MLIR fast-path loop
    // By looping over the dense array directly, we guarantee contiguous access
    let mut i: u32 = 0;
    while i < count {
        let p = priorities.dense.offset(i as i64);
        p.tickets = p.tickets + p.level;
        i = i + 1;
    }
}

fn main() -> i32 {
    let mut w = new_world();
    let alloc = &mut w.alloc;
    let priorities = &mut w.priorities;
    
    let mut i: u32 = 0;
    while i < 10000 {
        let e = alloc.allocate();
        priorities.insert(e, SchedulingPriority { level: 1, tickets: 0 });
        i = i + 1;
    }
    
    process_priorities(&mut w);
    
    // Check one entity
    let e0 = Entity { id: 0, gen: 0 };
    let priorities_ref = &w.priorities;
    let p0 = priorities_ref.get(e0);
    if p0 as u64 == 0 { return 1; }
    if p0.tickets != 1 { return 2; }
    
    return 0;
}
