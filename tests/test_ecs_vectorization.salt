// =============================================================================
// test_ecs_vectorization.salt — ECS Contiguous Vectorization Test
// =============================================================================
// RED-TO-GREEN: Validates cache-friendly iteration and mutation of components.
// =============================================================================

package main

import kernel.ecs.entity.{Entity, entity_allocator_allocate}
import kernel.ecs.world.{World, new_world, world_spawn}
import kernel.ecs.components.{SchedulingPriority}
import kernel.ecs.sparse_set.{
    priority_set_insert, priority_set_get
}

extern fn println(s: Ptr<u8>);

@no_mangle
pub fn process_priorities(w: Ptr<World>) {
    let priorities = w[0].priorities;
    let count = priorities[0].count;
    
    // Explicit MLIR fast-path loop
    // By looping over the dense array directly, we guarantee contiguous access
    let mut i: u32 = 0;
    while i < count {
        let p = priorities[0].dense.offset(i as i64);
        p[0].tickets = p[0].tickets + p[0].level;
        i = i + 1;
    }
}

fn main() -> i32 {
    let w = new_world();
    
    let mut i: u32 = 0;
    while i < 10000 {
        let e = world_spawn(w);
        priority_set_insert(w[0].priorities, e, SchedulingPriority { level: 1, tickets: 0 });
        i = i + 1;
    }
    
    process_priorities(w);
    
    // Check one entity
    let e0 = Entity { id: 0, gen: 0 };
    let p0 = priority_set_get(w[0].priorities, e0);
    if (p0 as u64) == 0 { return 1; }
    if p0[0].tickets != 1 { return 2; }
    
    println("All vectorization tests PASSED!");
    return 0;
}
