// =============================================================================
// Test: Fabric-Aware MatMul — LOC_RDMA Compile-Only
// =============================================================================
// Proves that the MLIR pipeline can lower the RDMA code path.
// This is a compile-only test — it does NOT execute.
//
// The function constructs Tensor2D-style addressing with LOC_RDMA
// locality and calls matmul logic. The compiler must successfully
// generate MLIR → LLVM IR for the RDMA dispatch stubs.
//
// In v1.0, the RDMA stubs are identical to the arena path (standard
// CPU load/store). In production, these would lower to WQE hardware
// dispatch instructions.
// =============================================================================

package main

extern fn malloc(size: i64) -> Ptr<u8>;
extern fn free(ptr: u64);

// LOC_RDMA constant
const LOC_RDMA: u32 = 2;

// RDMA-dispatched read: in v1.0, same as arena path (stub)
fn fabric_read_f64(addr: u64, locality: u32, offset: u64) -> f64 {
    let target: u64 = addr + (offset * 8);

    if locality == 0 {
        return *((target) as &f64);
    }

    if locality == 1 {
        // NVMe DMA read stub
        return *((target) as &f64);
    }

    if locality == 2 {
        // RDMA READ stub — in production, posts RDMA_READ WQE
        return *((target) as &f64);
    }

    return 0.0;
}

// RDMA-dispatched write: in v1.0, same as arena path (stub)
fn fabric_write_f64(addr: u64, locality: u32, offset: u64, val: f64) {
    let target: u64 = addr + (offset * 8);

    if locality == 0 {
        *((target) as &mut f64) = val;
        return;
    }

    if locality == 1 {
        // NVMe DMA write stub
        *((target) as &mut f64) = val;
        return;
    }

    if locality == 2 {
        // RDMA WRITE stub — in production, posts RDMA_WRITE WQE
        *((target) as &mut f64) = val;
        return;
    }
}

// MatMul using RDMA-dispatched reads and writes
fn matmul_rdma(
    a_addr: u64, a_loc: u32, a_rows: u32, a_cols: u32,
    b_addr: u64, b_loc: u32, b_rows: u32, b_cols: u32,
    c_addr: u64, c_loc: u32, c_rows: u32, c_cols: u32
) {
    let mut i: u32 = 0;
    while i < a_rows {
        let mut j: u32 = 0;
        while j < b_cols {
            let mut sum: f64 = 0.0;
            let mut k: u32 = 0;
            while k < a_cols {
                let a_off: u64 = ((i * a_cols + k) as u64);
                let a_val: f64 = fabric_read_f64(a_addr, a_loc, a_off);

                let b_off: u64 = ((k * b_cols + j) as u64);
                let b_val: f64 = fabric_read_f64(b_addr, b_loc, b_off);

                sum = sum + (a_val * b_val);
                k = k + 1;
            }

            let c_off: u64 = ((i * c_cols + j) as u64);
            fabric_write_f64(c_addr, c_loc, c_off, sum);

            j = j + 1;
        }
        i = i + 1;
    }
}

// Main — instantiate RDMA tensors and call matmul
fn main() -> i32 {
    let size: i64 = 128;
    let a_addr: u64 = (malloc(size) as u64);
    let b_addr: u64 = (malloc(size) as u64);
    let c_addr: u64 = (malloc(size) as u64);

    // Call matmul with LOC_RDMA for all tensors
    // This proves the compiler can lower the RDMA path
    matmul_rdma(
        a_addr, LOC_RDMA, 4, 4,
        b_addr, LOC_RDMA, 4, 4,
        c_addr, LOC_RDMA, 4, 4
    );

    free(a_addr);
    free(b_addr);
    free(c_addr);
    return 0;
}
