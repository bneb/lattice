// =============================================================================
// TDD Test: q8_0 Dequantization
// =============================================================================
// Tests f16→f32 conversion and q8_0 dot product.
// Avoids nested loops to work around affine.for block-count limitation.
// =============================================================================

package main

import std.io.println
import std.core.ptr.Ptr

extern fn malloc(size: i64) -> Ptr<u8>;
extern fn free(ptr: Ptr<u8>);

@fast_math
fn f16_to_f32(bits: i32) -> f32 {
    let sign: i32 = (bits >> 15) & 1;
    let exp: i32 = (bits >> 10) & 31;
    let mant: i32 = bits & 1023;
    let mut result: f32 = 0.0f32;
    if exp == 0 {
        result = (mant as f32) / 1024.0f32;
        result = result * 0.000061035156f32;
    } else {
        if exp == 31 {
            result = 65504.0f32;
        } else {
            let m: f32 = 1.0f32 + (mant as f32) / 1024.0f32;
            let mut p: f32 = 1.0f32;
            if exp > 15 {
                for _i in 0..(exp - 15) { p = p * 2.0f32; }
            } else {
                for _i in 0..(15 - exp) { p = p / 2.0f32; }
            }
            result = m * p;
        }
    }
    if sign == 1 { result = 0.0f32 - result; }
    return result;
}

@fast_math
fn read_scale(buf: Ptr<u8>, off: i64) -> f32 {
    let lo: i32 = buf[off] as i32;
    let hi: i32 = buf[off + 1] as i32;
    return f16_to_f32(lo | (hi << 8));
}

// Dot one q8_0 block (32 elements) against x starting at x_off
@fast_math
fn dot_q8_block(buf: Ptr<u8>, buf_off: i64, x: Ptr<f32>, x_off: i64) -> f32 {
    let scale: f32 = read_scale(buf, buf_off);
    let mut sum: f32 = 0.0f32;
    for k in 0..32 {
        let raw: i32 = buf[buf_off + 2 + k] as i32;
        let sv: i32 = raw - ((raw >> 7) * 256);
        sum = sum + scale * (sv as f32) * x[x_off + k];
    }
    return sum;
}

fn assert_near(got: f32, expected: f32, tol: f32) -> i32 {
    let diff: f32 = got - expected;
    if diff > tol { return 1; }
    if diff < (0.0f32 - tol) { return 1; }
    return 0;
}

fn main() -> i32 {
    println("=== q8_0 Dequant Test ===");
    
    // Test 1: f16 → f32
    let f1: f32 = f16_to_f32(15360);  // 0x3C00 = 1.0
    if assert_near(f1, 1.0f32, 0.001f32) != 0 { println("FAIL: f16 1.0"); return 1; }
    let f2: f32 = f16_to_f32(14336);  // 0x3800 = 0.5
    if assert_near(f2, 0.5f32, 0.001f32) != 0 { println("FAIL: f16 0.5"); return 1; }
    let f3: f32 = f16_to_f32(16384);  // 0x4000 = 2.0
    if assert_near(f3, 2.0f32, 0.001f32) != 0 { println("FAIL: f16 2.0"); return 1; }
    println("PASS: f16_to_f32 (1.0, 0.5, 2.0)");
    
    // Test 2: Dequant single block (scale=1.0, vals=1..32)
    let buf = malloc(34);
    buf[0] = 0;
    buf[1] = 60;  // f16 1.0 = 0x3C00
    for i in 0..32 {
        buf[2 + i] = (i + 1) as u8;
    }
    let scale: f32 = read_scale(buf, 0);
    let out = malloc(128) as Ptr<f32>;
    for k in 0..32 {
        let raw: i32 = buf[2 + k] as i32;
        let sv: i32 = raw - ((raw >> 7) * 256);
        out[k] = scale * (sv as f32);
    }
    let mut pass2: i32 = 1;
    for i in 0..32 {
        if assert_near(out[i], (i + 1) as f32, 0.01f32) != 0 { pass2 = 0; }
    }
    free(buf);
    free(out as Ptr<u8>);
    if pass2 != 1 { println("FAIL: dequant block"); return 1; }
    println("PASS: dequant_block_q8 scale=1.0");
    
    // Test 3: Dot product (1 block, scale=1.0, vals=1, x=1.0 → sum=32.0)
    let row = malloc(34);
    row[0] = 0;
    row[1] = 60;
    for i in 0..32 { row[2 + i] = 1; }
    let x = malloc(128) as Ptr<f32>;
    for i in 0..32 { x[i] = 1.0f32; }
    let dot: f32 = dot_q8_block(row, 0, x, 0);
    free(row);
    free(x as Ptr<u8>);
    if assert_near(dot, 32.0f32, 0.1f32) != 0 { println("FAIL: q8 dot"); return 1; }
    println("PASS: q8 dot (1×32) = 32.0");
    
    // Test 4: Multi-block dot (2 blocks, scale=2.0, vals=1, x=1.0 → sum=128.0)
    let mat = malloc(68);  // 2 blocks × 34
    mat[0] = 0; mat[1] = 64;  // block 0: scale=2.0
    for i in 0..32 { mat[2 + i] = 1; }
    mat[34] = 0; mat[35] = 64;  // block 1: scale=2.0
    for i in 0..32 { mat[36 + i] = 1; }
    let x2 = malloc(256) as Ptr<f32>;
    for i in 0..64 { x2[i] = 1.0f32; }
    let d0: f32 = dot_q8_block(mat, 0, x2, 0);
    let d1: f32 = dot_q8_block(mat, 34, x2, 32);
    let total: f32 = d0 + d1;
    free(mat);
    free(x2 as Ptr<u8>);
    if assert_near(total, 128.0f32, 1.0f32) != 0 { println("FAIL: q8 multi-block"); return 1; }
    println("PASS: q8 multi-block dot (2×32) = 128.0");
    
    println("=== All q8_0 tests passed ===");
    return 0;
}
