package tests.test_css_cascade

import user.os.ipc_ring

extern fn init_arrays();
extern fn create_node(tag: i32) -> u64;
extern fn airlock_init_allocator();
extern fn js_quickjs_init() -> i32;
extern fn js_lex_html_chunk(root_node: u64, html_str: u64, html_len: u32, can_exec: u8);
extern fn apply_cascade_to_tree();
extern fn resolve_node_by_id(ptr: u64, len: u32) -> u64;
extern fn dom_get_style_display(idx: u32) -> u8;
extern fn dom_get_style_display_spec(idx: u32) -> u16;

pub fn main() -> i32 {
    println("--- Epic 32b: Cascade Matcher Test ---");

    airlock_init_allocator();
    init_arrays();
    ipc_ring.init_shared_ring();
    js_quickjs_init();

    let root_id = create_node(3); // BODY

    // Lex: <style>.box { display: flex; }</style><div class="box" id="hero"></div>
    println("[Phase 1] Lex HTML with embedded stylesheet");
    let mut html: [u8; 71] = [60,115,116,121,108,101,62,46,98,111,120,32,123,32,100,105,115,112,108,97,121,58,32,102,108,101,120,59,32,125,60,47,115,116,121,108,101,62,60,100,105,118,32,99,108,97,115,115,61,34,98,111,120,34,32,105,100,61,34,104,101,114,111,34,62,60,47,100,105,118,62];
    js_lex_html_chunk(root_id, (&html) as u64, 71, 1);

    // Deferred cascade pass
    println("[Phase 2] Running deferred cascade pass");
    apply_cascade_to_tree();

    // Find the hero div
    let mut id_str: [u8; 4] = [104, 101, 114, 111]; // "hero"
    let found = resolve_node_by_id((&id_str) as u64, 4);
    if found == 0 {
        println("[FAIL] Hero node not found");
        return 1;
    }
    let hero_idx = (found & 0xFFFF) as u32;

    // Verify display = FLEX (2) was applied from .box rule
    let disp = dom_get_style_display(hero_idx);
    if disp == 2 {
        println("[OK] STYLE_DISPLAY = FLEX via .box cascade");
    } else {
        println("[FAIL] STYLE_DISPLAY was not set to FLEX");
        return 1;
    }

    // Verify specificity was recorded as 10 (class)
    let spec = dom_get_style_display_spec(hero_idx);
    if spec == 10 {
        println("[OK] Display specificity = 10 (class selector)");
    } else {
        println("[FAIL] Display specificity incorrect");
        return 1;
    }

    println("[Test] SUCCESS: Cascade Matcher applied CSS rules to DOM nodes!");
    return 0;
}
