package tests.test_sprint3_layout

import user.browser.dom

extern fn layout_inject_dom_pointers();
extern fn compute_layout(node_idx: u32, offset_x: i32, offset_y: i32, max_width: i32) -> i32;
extern fn sys_print_float(v: f64);
@no_mangle
pub fn main() -> i32 {
    dom.sanitize_node_slot(0);
    dom.sanitize_node_slot(1);
    dom.sanitize_node_slot(2);
    dom.sanitize_node_slot(3);
    dom.sanitize_node_slot(4);

    // Initial setup
    dom.DOM_NODE_COUNT = 5;
    layout_inject_dom_pointers();

    // Node 0: Main Block (800x600 window)
    dom.DOM_NODE_TAG[0] = 4; // TAG_DIV
    dom.STYLE_DISPLAY[0] = 1; // Block
    dom.STYLE_W[0] = 800;
    dom.DOM_NODE_PARENT[0] = 999999;
    dom.DOM_NODE_FIRST_CHILD[0] = 1;
    dom.DOM_NODE_NEXT_SIBLING[0] = 999999;

    // Node 1: Block with auto margins (Centered Search Bar)
    // margin: 20px auto 30px auto
    dom.DOM_NODE_TAG[1] = 4;
    dom.STYLE_DISPLAY[1] = 1; // Block
    dom.STYLE_W[1] = 500;
    dom.STYLE_H[1] = 40;
    dom.STYLE_MARGIN_TOP[1] = 20;
    dom.STYLE_MARGIN_RIGHT[1] = -2; // auto
    dom.STYLE_MARGIN_BOTTOM[1] = 30;
    dom.STYLE_MARGIN_LEFT[1] = -2; // auto
    dom.STYLE_MIN_WIDTH[1] = 300; // should be ignored as W is greater
    dom.DOM_NODE_PARENT[1] = 0;
    dom.DOM_NODE_FIRST_CHILD[1] = 999999;
    dom.DOM_NODE_NEXT_SIBLING[1] = 2;

    // Node 2: Inline-Block Button 1
    dom.DOM_NODE_TAG[2] = 4;
    dom.STYLE_DISPLAY[2] = 5; // INLINE_BLOCK (Sprint 3)
    dom.STYLE_W[2] = 100;
    dom.STYLE_H[2] = 30;
    dom.DOM_NODE_PARENT[2] = 0;
    dom.DOM_NODE_FIRST_CHILD[2] = 999999;
    dom.DOM_NODE_NEXT_SIBLING[2] = 3;

    // Node 3: Inline-Block Button 2 (should sit next to Button 1)
    dom.DOM_NODE_TAG[3] = 4;
    dom.STYLE_DISPLAY[3] = 5;
    dom.STYLE_W[3] = 120;
    dom.STYLE_H[3] = 30;
    // Box model padding and border
    dom.STYLE_PADDING_LEFT[3] = 10;
    dom.STYLE_PADDING_RIGHT[3] = 10;
    dom.STYLE_BORDER_WIDTH_LEFT[3] = 5;
    dom.STYLE_BORDER_WIDTH_RIGHT[3] = 5;
    dom.STYLE_BOX_SIZING[3] = 1; // Border-box: width 120 includes padding+border
    // Actually, box-sizing will check if content_w is reduced.
    // Content width should be 120 - 20 (padding) - 10 (border) = 90
    dom.DOM_NODE_PARENT[3] = 0;
    dom.DOM_NODE_FIRST_CHILD[3] = 999999;
    dom.DOM_NODE_NEXT_SIBLING[3] = 4;

    // Node 4: Intrinsic Form Control (INPUT) with Max-Width Constraint
    // Intrinsic size logic sets input width to 173, max-width should clamp it to 150
    dom.DOM_NODE_TAG[4] = 18; // TAG_INPUT
    dom.STYLE_DISPLAY[4] = 1; // Block
    dom.STYLE_W[4] = -1; // Intrinsic generic unset indicator
    dom.STYLE_H[4] = -1; 
    dom.STYLE_MAX_WIDTH[4] = 150; 
    dom.STYLE_MIN_HEIGHT[4] = 40; // clamp height from intrinsic low 18px up to 40
    dom.DOM_NODE_PARENT[4] = 0;
    dom.DOM_NODE_FIRST_CHILD[4] = 999999;
    dom.DOM_NODE_NEXT_SIBLING[4] = 999999;
    
    
    compute_layout(0 as u32, 0 as i32, 0 as i32, 800 as i32);
    // Verify Node 1: margin-auto centering
    // W=500, Container=800 -> Free space=300 -> Margin L/R = 150
    // Y should be 0 + 20 (margin-top)
    if dom.LAYOUT_X[1] != 150 { return 1; }
    if dom.LAYOUT_Y[1] != 20 { return 2; }
    if dom.LAYOUT_W[1] != 500 { return 3; }
    if dom.LAYOUT_H[1] != 40 { return 4; }

    // Verify Node 2: INLINE_BLOCK
    // Block 1 consumes up to 20 + 40 + 30 = 90 in Y
    if dom.LAYOUT_X[2] != 0 { return 5; } // starts at left
    if dom.LAYOUT_Y[2] != 90 { return 6; } // below node 1's bottom margin
    if dom.LAYOUT_W[2] != 100 { return 7; }

    // Verify Node 3: INLINE_BLOCK wrap/continuation
    // Should be on the same line as Node 2
    if dom.LAYOUT_X[3] != 100 { return 8; } // starts right after Node 2
    if dom.LAYOUT_Y[3] != 90 { return 9; }
    if dom.LAYOUT_W[3] != 120 { return 10; } // overall laid-out width = 120
    
    // Verify Node 4: Form Constraints and Clamping
    // Previous row finishes at 90 line + 30 (nodes height)
    // Actually, Node 2 is H=120? Wait! 
    // Wait, Node 3 is H=30. Node 2 is H=30. So max line height is 30.
    // Line ends at Y = 90 + 30 = 120
    // So Node 4 is Y = 120!
    if dom.LAYOUT_Y[4] != 120 { return 11; }
    if dom.LAYOUT_W[4] != 150 { return 12; } // clamped max=150 (from intrinsic 173)
    if dom.LAYOUT_H[4] != 40 { return 13; } // clamped min=40 (from intrinsic padding calculation)

    return 0; // Success
}

// Sentinel for bridge auto-detection
pub fn render_pipeline_e2e_test() {}

