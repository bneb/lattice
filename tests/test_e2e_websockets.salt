package tests.test_e2e_websockets

import user.browser.websocket

extern fn c_bridge_websockets_e2e_test() -> i32;
extern fn c_bridge_push_ws(socket_id: u32, data_ptr: u64, data_len: u32) -> i32;
extern fn sys_jsc_flush_ws_events();

@no_mangle
pub fn main() -> i32 {
    c_bridge_websockets_e2e_test(); 
    
    websocket.WEBSOCKET_ACTIVE[1] = 1;
    websocket.WEBSOCKET_STATE[1] = 2;
    
    let mut frag1: [u8; 24] = [0; 24]; // 22 bytes + 2 header
    frag1[0] = 0x01; // FIN=0, Opcode=1
    frag1[1] = 22; // Length=22, No Mask
    
    let frag1_str = "Prisimi Socket Matrix ";
    let mut i = 0;
    while i < 22 {
        frag1[(i + 2) as usize] = *(((&frag1_str as u64) + (i as u64)) as &u8);
        i = i + 1;
    }
    c_bridge_push_ws(1, (&frag1) as u64, 24);
    
    websocket.sys_ws_pump_ingress(1);
    
    let mut ping: [u8; 6] = [0; 6];
    ping[0] = 0x89; // FIN=1, Opcode=9 Ping
    ping[1] = 4; // Length=4
    ping[2] = 1; ping[3] = 2; ping[4] = 3; ping[5] = 4; // Ping payload
    c_bridge_push_ws(1, (&ping) as u64, 6);
    
    websocket.sys_ws_pump_ingress(1);
    
    let pongs = websocket.ext_get_pong_replies();
    if pongs != 1 { return 1; }
    
    let mut frag2: [u8; 8] = [0; 8];
    frag2[0] = 0x80; // FIN=1, Opcode=0
    frag2[1] = 6; // Length
    frag2[2] = 79; // O
    frag2[3] = 110; // n
    frag2[4] = 108; // l
    frag2[5] = 105; // i
    frag2[6] = 110; // n
    frag2[7] = 101; // e
    
    c_bridge_push_ws(1, (&frag2) as u64, 8);
    
    websocket.sys_ws_pump_ingress(1);
    
    // Step the run-loop manually
    sys_jsc_flush_ws_events();
    
    return 0; // Success
}
