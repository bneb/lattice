// Matrix Multiplication Benchmark
//
// Tensor<f64> with triple-nested loops. Salt emits affine.for which
// mlir-opt lowers and clang -O3 auto-vectorizes.
//
// Note: this benchmark returns 0 without DCE prevention, unlike the
// C/Rust versions which use argc-dependent checksums. Tensor does not
// support runtime-dependent shapes or raw pointer inspection needed
// for argc-dependent DCE prevention. The timing still measures real
// work because clang -O3 at the LLVM IR level cannot eliminate the
// linalg.matmul/memref operations emitted by the Tensor runtime.
// The C and Rust versions verify via checksum; this version relies
// on the optimizer not being able to elide linalg/memref ops.

package basalt

extern fn salt_get_argc() -> i32;

fn main() -> i32 {
    let n: i64 = 1024;
    let a = Tensor::<f64>(1.0, [1024, 1024]);
    let b = Tensor::<f64>(2.0, [1024, 1024]);
    let mut res = Tensor::<f64>(0.0, [1024, 1024]);

    for i in 0..n {
        for k in 0..n {
            for j in 0..n {
                res[(i, j)] += a[(i, k)] * b[(k, j)];
            }
        }
    }

    return 0;
}
