// Matrix Multiplication Benchmark
//
// Tensor<f64> with triple-nested loops. Salt emits affine.for loops
// which mlir-opt lowers; clang -O3 auto-vectorizes the tight inner loop.
// At parity with C (clang -O3) on M4.

package basalt

fn main() -> i32 {
    let a = Tensor::<f64>(1.0, [1024, 1024]);
    let b = Tensor::<f64>(2.0, [1024, 1024]);
    let mut res = Tensor::<f64>(0.0, [1024, 1024]);

    for i in 0..1024 {
        for k in 0..1024 {
            for j in 0..1024 {
                res[(i, j)] += a[(i, k)] * b[(k, j)];
            }
        }
    }

    return 0;
}
