// Matrix Multiplication Benchmark
//
// Triple-nested loop with Tensor<f64>. Salt emits affine.for loops.
// On M4, at parity with C (clang -O3 -ffast-math -march=native)
// when both use the same i,j,k loop order.
//
// The @ operator (linalg.matmul) would provide automatic tiling and
// SIMD vectorization but has an MLIR type-mismatch bug with Tensor
// in the general benchmark pipeline. Tracked separately.

package basalt

extern fn salt_get_argc() -> i32;

fn main() -> i32 {
    let n: i64 = 1024;
    let seed: f64 = (salt_get_argc() as f64) + 1.0;
    let a = Tensor::<f64>(seed, [1024, 1024]);
    let b = Tensor::<f64>(2.0, [1024, 1024]);
    let mut res = Tensor::<f64>(0.0, [1024, 1024]);

    for i in 0..n {
        for j in 0..n {
            let mut sum: f64 = 0.0;
            for k in 0..n {
                sum += a[(i, k)] * b[(k, j)];
            }
            res[(i, j)] = sum;
        }
    }

    let check = res[(0, 0)] as i64;
    if check > 0 { return 0; }
    return 1;
}
